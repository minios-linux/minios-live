#. type: Plain text
#: minios-live.1:23
msgid ""
"\\f[B]Debian distributions:\\f[R] Buster (10), Bullseye (11), Bookworm (12), "
"Trixie (13)\\fR"
msgstr ""

#. type: Plain text
#: minios-live.1:25
msgid "\\f[B]Ubuntu distributions:\\f[R] Jammy (22.04), Noble (24.04)\\fR"
msgstr ""

#. type: Plain text
#: minios-live.1:27
msgid "\\f[B]Desktop environments:\\fR"
msgstr ""

#. type: Plain text
#: minios-live.1:31
msgid ""
"\\f[B]Debian:\\f[R] Xfce (standard), Flux (minimum), LXQt (Bookworm/Trixie "
"only)\\fR"
msgstr ""

#. type: Plain text
#: minios-live.1:33
msgid "\\f[B]Ubuntu:\\f[R] Xfce only\\fR"
msgstr ""

#. type: Plain text
#: minios-live.1:36
msgid "\\f[B]Package variants:\\fR"
msgstr ""

#. type: Plain text
