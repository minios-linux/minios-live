#. type: TH
#: minios-cmd.1:3
#, no-wrap
msgid "MiniOS Command-Line Builder"
msgstr "Générateur en ligne de commande MiniOS"

#. type: Plain text
#: minios-cmd.1:7
msgid ""
"minios-cmd - command-line utility for configuring and building customized "
"MiniOS system images"
msgstr ""
"minios-cmd \\- utilitaire en ligne de commande pour configurer et générer "
"des images système MiniOS personnalisées"

#. type: Plain text
#: minios-cmd.1:9
msgid "\\f[B]minios-cmd\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"
msgstr "\\f[B]minios-cmd\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"

#. type: Plain text
#: minios-cmd.1:15
msgid ""
"\\f[B]minios-cmd\\f[R] is a command-line utility designed to simplify the "
"process of configuring and building customized MiniOS system images.  Acting "
"as a frontend for \\f[B]minios-live\\f[R](1), it manages the configuration "
"and invokes \\f[B]minios-live\\f[R] to execute the actual build steps.\\fR"
msgstr ""
"\\f[B]minios-cmd\\f[R] est un utilitaire en ligne de commande conçu pour "
"simplifier la configuration et la génération d'images système MiniOS "
"personnalisées.  Agissant comme une interface pour \\f[B]minios-live\\f[R]"
"(1), il gère la configuration et invoque \\f[B]minios-live\\f[R] pour "
"exécuter les étapes de construction proprement dites.\\fR"

#. type: Plain text
#: minios-cmd.1:18
msgid ""
"With \\f[B]minios-cmd\\f[R], you can customize various aspects of your "
"MiniOS image, including:\\fR"
msgstr ""
"Avec \\f[B]minios-cmd\\f[R], vous pouvez personnaliser divers aspects de "
"votre image MiniOS, notamment :\\fR"

#. type: Plain text
#: minios-cmd.1:22
msgid ""
"\\f[B]Distribution:\\f[R] Choose from Debian releases (\\f[B]buster\\f[R], "
"\\f[B]bullseye\\f[R], \\f[B]bookworm\\f[R], \\f[B]trixie\\f[R]) and Ubuntu "
"releases (\\f[B]jammy\\f[R], \\f[B]noble\\f[R])\\fR"
msgstr ""
"\\f[B]Distribution :\\f[R] Choisissez parmi les versions Debian "
"(\\f[B]buster\\f[R], \\f[B]bullseye\\f[R], \\f[B]bookworm\\f[R], "
"\\f[B]trixie\\f[R]) et les versions Ubuntu (\\f[B]jammy\\f[R], "
"\\f[B]noble\\f[R])\\fR"

#. type: Plain text
#: minios-cmd.1:25
msgid ""
"\\f[B]Architecture:\\f[R] Specify the target architecture "
"(\\f[B]amd64\\f[R], \\f[B]i386\\f[R] for older distributions)\\fR"
msgstr ""
"\\f[B]Architecture :\\f[R] Indiquez l'architecture cible (\\f[B]amd64\\f[R], "
"\\f[B]i386\\f[R] pour les anciennes distributions)\\fR"

#. type: Plain text
#: minios-cmd.1:27
msgid "\\f[B]Desktop Environment:\\fR"
msgstr "\\f[B]Environnement de bureau :\\fR"

#. type: Plain text
#: minios-cmd.1:31
msgid ""
"\\f[B]Debian:\\f[R] \\f[B]xfce\\f[R] (standard), \\f[B]flux\\f[R] (minimum), "
"\\f[B]lxqt\\f[R] (bookworm/trixie only)\\fR"
msgstr ""
"\\f[B]Debian :\\f[R] \\f[B]xfce\\f[R] (standard), \\f[B]flux\\f[R] "
"(minimal), \\f[B]lxqt\\f[R] (bookworm/trixie uniquement)\\fR"

#. type: Plain text
#: minios-cmd.1:33
msgid "\\f[B]Ubuntu:\\f[R] \\f[B]xfce\\f[R] only\\fR"
msgstr "\\f[B]Ubuntu :\\f[R] \\f[B]xfce\\f[R] uniquement\\fR"

#. type: Plain text
#: minios-cmd.1:36
msgid "\\f[B]Package Variant:\\fR"
msgstr "\\f[B]Variante de paquets :\\fR"

#. type: Plain text
#: minios-cmd.1:40
msgid ""
"\\f[B]All Debian:\\f[R] \\f[B]standard\\f[R] (xfce), \\f[B]minimum\\f[R] "
"(flux)\\fR"
msgstr ""
"\\f[B]Toutes Debian :\\f[R] \\f[B]standard\\f[R] (xfce), \\f[B]minimum\\f[R] "
"(flux)\\fR"

#. type: Plain text
#: minios-cmd.1:42
msgid "\\f[B]Bookworm/Trixie only:\\f[R] \\f[B]toolbox\\f[R], \\f[B]ultra\\fR"
msgstr ""
"\\f[B]Bookworm/Trixie uniquement :\\f[R] \\f[B]toolbox\\f[R], \\f[B]ultra\\fR"

#. type: Plain text
#: minios-cmd.1:44
msgid "\\f[B]Ubuntu:\\f[R] \\f[B]standard\\f[R] only\\fR"
msgstr "\\f[B]Ubuntu :\\f[R] \\f[B]standard\\f[R] uniquement\\fR"

#. type: Plain text
#: minios-cmd.1:48
msgid ""
"\\f[B]Compression Type:\\f[R] Specify the image compression method "
"(\\f[B]zstd\\f[R])\\fR"
msgstr ""
"\\f[B]Type de compression :\\f[R] Indiquez la méthode de compression de "
"l'image (\\f[B]zstd\\f[R])\\fR"

#. type: Plain text
#: minios-cmd.1:51
msgid ""
"\\f[B]Kernel:\\f[R] Select a distribution or AUFS-enabled MiniOS kernel and "
"compile optional DKMS modules\\fR"
msgstr ""
"\\f[B]Noyau :\\f[R] Sélectionnez une distribution ou un noyau AUFS-activé "
"MiniOS et compilez éventuellement les modules DKMS\\fR"

#. type: Plain text
#: minios-cmd.1:54
msgid ""
"\\f[B]Locale and Timezone:\\f[R] Set the system locale and timezone with "
"multilingual support\\fR"
msgstr ""
"\\f[B]Langue et fuseau horaire :\\f[R] Définissez la langue système et le "
"fuseau horaire avec prise en charge multilingue\\fR"

#. type: SH
#: minios-cmd.1:54 condinapt.1:50
#, no-wrap
msgid "OPTIONS"
msgstr "OPTIONS"

#. type: SS
#: minios-cmd.1:55
#, no-wrap
msgid "Configuration Options"
msgstr "Options de configuration"

#. type: TP
#: minios-cmd.1:56
#, no-wrap
msgid "\\f[B]--config-file\\f[R] \\f[I]FILE\\fR"
msgstr "\\f[B]--config-file\\f[R] \\f[I]FILE\\fR"

#. type: Plain text
#: minios-cmd.1:60
msgid "Specify the configuration file path.  All other options are ignored."
msgstr ""
"Indiquez le chemin du fichier de configuration.  Toutes les autres options "
"sont ignorées."

#. type: TP
#: minios-cmd.1:60
#, no-wrap
msgid "\\f[B]--config-only\\fR"
msgstr "\\f[B]--config-only\\fR"

#. type: Plain text
#: minios-cmd.1:63
msgid ""
"Generate the configuration file only and do not start the build process."
msgstr ""
"Génère uniquement le fichier de configuration et ne lance pas le processus "
"de construction."

#. type: TP
#: minios-cmd.1:64
#, no-wrap
msgid "\\f[B]-b\\f[R], \\f[B]--build-dir\\f[R] \\f[I]DIR\\fR"
msgstr "\\f[B]-b\\f[R], \\f[B]--build-dir\\f[R] \\f[I]DIR\\fR"

#. type: Plain text
#: minios-cmd.1:67
msgid "Specify the build directory."
msgstr "Indiquez le répertoire de construction."

#. type: SS
#: minios-cmd.1:67
#, no-wrap
msgid "System Options"
msgstr "Options système"

#. type: Plain text
#: minios-cmd.1:70
msgid ""
"These options \\f[B]must be provided\\f[R] unless a configuration file is "
"used:\\fR"
msgstr ""
"Ces options \\f[B]doivent être fournies\\f[R] sauf si un fichier de "
"configuration est utilisé :\\fR"

#. type: TP
#: minios-cmd.1:70
#, no-wrap
msgid "\\f[B]-d\\f[R], \\f[B]--distribution\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-d\\f[R], \\f[B]--distribution\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:74
msgid "Specify the distribution name (e.g., `bookworm').  \\f[B]REQUIRED\\fR"
msgstr ""
"Indiquez le nom de la distribution (par exemple, \\[dq]bookworm\\[dq]).  "
"\\f[B]OBLIGATOIRE\\fR"

#. type: TP
#: minios-cmd.1:74
#, no-wrap
msgid "\\f[B]-a\\f[R], \\f[B]--architecture\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-a\\f[R], \\f[B]--architecture\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:78
msgid "Specify the architecture (e.g., `amd64').  \\f[B]REQUIRED\\fR"
msgstr ""
"Indiquez l'architecture (par exemple, \\[dq]amd64\\[dq]).  "
"\\f[B]OBLIGATOIRE\\fR"

#. type: TP
#: minios-cmd.1:78
#, no-wrap
msgid "\\f[B]-de\\f[R], \\f[B]--desktop-environment\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-de\\f[R], \\f[B]--desktop-environment\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:82
msgid "Specify the desktop environment (e.g., `xfce').  \\f[B]REQUIRED\\fR"
msgstr ""
"Indiquez l'environnement de bureau (par exemple, \\[dq]xfce\\[dq]).  "
"\\f[B]OBLIGATOIRE\\fR"

#. type: TP
#: minios-cmd.1:82
#, no-wrap
msgid "\\f[B]-pv\\f[R], \\f[B]--package-variant\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-pv\\f[R], \\f[B]--package-variant\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:86
msgid "Specify the package variant (e.g., `standard').  \\f[B]REQUIRED\\fR"
msgstr ""
"Indiquez la variante de paquet (par exemple, \\[dq]standard\\[dq]).  "
"\\f[B]OBLIGATOIRE\\fR"

#. type: TP
#: minios-cmd.1:86
#, no-wrap
msgid "\\f[B]-c\\f[R], \\f[B]--compression-type\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-c\\f[R], \\f[B]--compression-type\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:89
msgid "Specify the compression type (e.g., `zstd')."
msgstr "Indiquez le type de compression (par exemple, \\[dq]zstd\\[dq])."

#. type: SS
#: minios-cmd.1:89
#, no-wrap
msgid "Kernel Options"
msgstr "Options du noyau"

#. type: TP
#: minios-cmd.1:90
#, no-wrap
msgid "\\f[B]-kp\\f[R], \\f[B]--kernel-provider\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-kp\\f[R], \\f[B]--kernel-provider\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:93
msgid "Select the kernel provider (`distribution' or `minios')."
msgstr "Sélectionnez le fournisseur du noyau (« distribution » ou « minios »)."

#. type: TP
#: minios-cmd.1:93
#, no-wrap
msgid "\\f[B]-kf\\f[R], \\f[B]--kernel-flavour\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-kf\\f[R], \\f[B]--kernel-flavour\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:96
msgid "Specify the kernel flavour (e.g., `none')."
msgstr "Indiquez la variante du noyau (par exemple, \\[dq]none\\[dq])."

#. type: TP
#: minios-cmd.1:96
#, no-wrap
msgid "\\f[B]-mk\\f[R], \\f[B]--minios-kernel\\fR"
msgstr "\\f[B]-mk\\f[R], \\f[B]--minios-kernel\\fR"

#. type: Plain text
#: minios-cmd.1:99
msgid "Install the AUFS-enabled MiniOS kernel."
msgstr "Installez le noyau AUFS-activé MiniOS."

#. type: TP
#: minios-cmd.1:99
#, no-wrap
msgid "\\f[B]-mks\\f[R], \\f[B]--minios-kernel-series\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-mks\\f[R], \\f[B]--minios-kernel-series\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:103
msgid ""
"Select the MiniOS kernel series (`auto', `6.1', or `6.12') and use the "
"MiniOS provider."
msgstr ""
"Sélectionnez la série de noyaux MiniOS (`auto', `6.1' ou `6.12') et utilisez "
"le fournisseur MiniOS."

#. type: TP
#: minios-cmd.1:103
#, no-wrap
msgid "\\f[B]-kpm\\f[R], \\f[B]--kernel-payload-mode\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-kpm\\f[R], \\f[B]--kernel-payload-mode\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:106
msgid "Select the kernel payload mode (`runtime' or `full')."
msgstr ""
"Sélectionnez le mode de charge utile du noyau (« runtime » ou « full »)."

#. type: TP
#: minios-cmd.1:106
#, no-wrap
msgid "\\f[B]-dkms\\f[R], \\f[B]--kernel-build-dkms\\fR"
msgstr "\\f[B]-dkms\\f[R], \\f[B]--kernel-build-dkms\\fR"

#. type: Plain text
#: minios-cmd.1:109
msgid "Enable compilation of additional drivers during kernel installation."
msgstr ""
"Active la compilation de pilotes supplémentaires lors de l'installation du "
"noyau."

#. type: SS
#: minios-cmd.1:109
#, no-wrap
msgid "Locale and Timezone Options"
msgstr "Options de langue et de fuseau horaire"

#. type: TP
#: minios-cmd.1:110
#, no-wrap
msgid "\\f[B]-l\\f[R], \\f[B]--locale\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-l\\f[R], \\f[B]--locale\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:113
msgid "Specify the system locale (e.g., `en_US')."
msgstr "Indiquez la locale système (par exemple, \\[dq]en_US\\[dq])."

#. type: TP
#: minios-cmd.1:113
#, no-wrap
msgid "\\f[B]-ml\\f[R], \\f[B]--multilingual\\fR"
msgstr "\\f[B]-ml\\f[R], \\f[B]--multilingual\\fR"

#. type: Plain text
#: minios-cmd.1:116
msgid "Enable multilingual support."
msgstr "Active la prise en charge multilingue."

#. type: TP
#: minios-cmd.1:116
#, no-wrap
msgid "\\f[B]-kl\\f[R], \\f[B]--keep-locales\\fR"
msgstr "\\f[B]-kl\\f[R], \\f[B]--keep-locales\\fR"

#. type: Plain text
#: minios-cmd.1:119
msgid "Keep all available locales."
msgstr "Conserve toutes les locales disponibles."

#. type: TP
#: minios-cmd.1:119
#, no-wrap
msgid "\\f[B]-tz\\f[R], \\f[B]--timezone\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-tz\\f[R], \\f[B]--timezone\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:122
msgid "Specify the timezone (e.g., `Etc/UTC')."
msgstr "Indiquez le fuseau horaire (par exemple, \\[dq]Etc/UTC\\[dq])."

#. type: SS
#: minios-cmd.1:122
#, no-wrap
msgid "Boot Loader Options"
msgstr "Options du chargeur d'amorçage"

#. type: TP
#: minios-cmd.1:123
#, no-wrap
msgid "\\f[B]-ib\\f[R], \\f[B]--initramfs-builder\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-ib\\f[R], \\f[B]--initramfs-builder\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:126
msgid "Specify the initramfs builder (`livekit' or `dracut')."
msgstr "Indiquez le générateur d'initramfs (« livekit » ou « dracut »)."

#. type: SS
#: minios-cmd.1:126
#, no-wrap
msgid "Boot Menu Options"
msgstr "Options du menu de démarrage"

#. type: TP
#: minios-cmd.1:127
#, no-wrap
msgid "\\f[B]-mln\\f[R], \\f[B]--menu-language\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-mln\\f[R], \\f[B]--menu-language\\f[R] \\f[I]NOM\\fR"

#. type: Plain text
#: minios-cmd.1:131
msgid ""
"Specify the boot menu language (`multilang' for language selection or "
"specific language code like `ru_RU')."
msgstr ""
"Indiquez la langue du menu de démarrage (\\[dq]multilang\\[dq] pour la "
"sélection de la langue ou un code de langue spécifique comme \\[dq]ru_RU\\"
"[dq])."

#. type: SH
#: minios-cmd.1:131
#, no-wrap
msgid "DEFAULT SETTINGS"
msgstr "PARAMÈTRES PAR DÉFAUT"

#. type: SS
#: minios-cmd.1:132
#, no-wrap
msgid "Kernel Settings"
msgstr "Paramètres du noyau"

#. type: Plain text
#: minios-cmd.1:134
msgid "\\f[B]KERNEL_FLAVOUR\\f[R]: \\[lq]none\\[rq]\\fR"
msgstr "\\f[B]KERNEL_FLAVOUR\\f[R] : \\[lq]none\\[rq]\\fR"

#. type: Plain text
#: minios-cmd.1:137
msgid ""
"\\f[B]KERNEL_PROVIDER\\f[R]: \\[lq]distribution\\[rq] (automatically \\"
"[lq]minios\\[rq] for Trixie/Excalibur i386)\\fR"
msgstr ""
"\\f[B]KERNEL_PROVIDER\\f[R] : \\[lq]distribution\\[rq] (automatiquement \\"
"[lq]minios\\[rq] pour Trixie/Excalibur i386)\\fR"

#. type: Plain text
#: minios-cmd.1:139
msgid "\\f[B]MINIOS_KERNEL_SERIES\\f[R]: \\[lq]auto\\[rq]\\fR"
msgstr "\\f[B]MINIOS_KERNEL_SERIES\\f[R] : \\[lq]auto\\[rq]\\fR"

#. type: Plain text
#: minios-cmd.1:141
msgid "\\f[B]KERNEL_PAYLOAD_MODE\\f[R]: \\[lq]runtime\\[rq]\\fR"
msgstr "\\f[B]KERNEL_PAYLOAD_MODE\\f[R] : \\[lq]runtime\\[rq]\\fR"

#. type: SS
#: minios-cmd.1:141
#, no-wrap
msgid "Locale & Timezone Settings"
msgstr "Paramètres de langue et de fuseau horaire"

#. type: Plain text
#: minios-cmd.1:144
msgid ""
"\\f[B]LOCALE\\f[R]: \\[lq]en_US\\[rq] \\f[B]LIVE_TIMEZONE\\f[R]: \\[lq]Etc/"
"UTC\\[rq]\\fR"
msgstr ""
"\\f[B]LOCALE\\f[R] : \\[lq]en_US\\[rq] \\f[B]LIVE_TIMEZONE\\f[R] : \\[lq]Etc/"
"UTC\\[rq]\\fR"

#. type: SS
#: minios-cmd.1:144
#, no-wrap
msgid "Boot Loader Settings"
msgstr "Paramètres du chargeur d'amorçage"

#. type: Plain text
#: minios-cmd.1:146
msgid "\\f[B]INITRAMFS_BUILDER\\f[R]: \\[lq]dracut\\[rq]\\fR"
msgstr "\\f[B]INITRAMFS_BUILDER\\f[R] : \\[lq]dracut\\[rq]\\fR"

#. type: SS
#: minios-cmd.1:146
#, no-wrap
msgid "Boot Menu Settings"
msgstr "Paramètres du menu de démarrage"

#. type: Plain text
#: minios-cmd.1:148
msgid "\\f[B]MENU_LANG\\f[R]: \\[lq]multilang\\[rq]\\fR"
msgstr "\\f[B]MENU_LANG\\f[R] : \\[lq]multilang\\[rq]\\fR"

#. type: SH
#: minios-cmd.1:148
#, no-wrap
msgid "INTERACTION WITH MINIOS-LIVE"
msgstr "INTERACTION AVEC MINIOS-LIVE"

#. type: Plain text
#: minios-cmd.1:153
msgid ""
"\\f[B]minios-cmd\\f[R] prepares the build environment and generates a "
"\\f[B]build.conf\\f[R] configuration file based on the options provided.  It "
"then calls \\f[B]minios-live\\f[R] with the relevant environment variables, "
"delegating the build execution to \\f[B]minios-live\\f[R].\\fR"
msgstr ""
"\\f[B]minios-cmd\\f[R] prépare l'environnement de construction et génère un "
"fichier de configuration \\f[B]build.conf\\f[R] selon les options fournies. "
"Il appelle ensuite \\f[B]minios-live\\f[R] avec les variables "
"d'environnement appropriées, déléguant l'exécution de la construction à "
"\\f[B]minios-live\\f[R].\\fR"

#. type: Plain text
#: minios-cmd.1:155
msgid "Create a MiniOS Standard system image with default settings:"
msgstr ""
"Créer une image système MiniOS Standard avec les paramètres par défaut :"

#. type: Plain text
#: minios-cmd.1:158
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -c zstd -mk -dkms -kl\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -c zstd -mk -dkms -kl\n"

#. type: Plain text
#: minios-cmd.1:161
msgid "Create a MiniOS Toolbox system image with default settings:"
msgstr ""
"Créer une image système MiniOS Toolbox avec les paramètres par défaut :"

#. type: Plain text
#: minios-cmd.1:164
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -c zstd -mk -dkms -kl\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -c zstd -mk -dkms -kl\n"

#. type: Plain text
#: minios-cmd.1:167
msgid "Create a system image with Russian locale:"
msgstr "Créer une image système avec la langue russe :"

#. type: Plain text
#: minios-cmd.1:170
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -l ru_RU\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -l ru_RU\n"

#. type: Plain text
#: minios-cmd.1:173
msgid "Create a system image with LXQt desktop environment:"
msgstr "Créer une image système avec l'environnement de bureau LXQt :"

#. type: Plain text
#: minios-cmd.1:176
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de lxqt -pv standard\n"
msgstr "minios-cmd -d bookworm -a amd64 -de lxqt -pv standard\n"

#. type: Plain text
#: minios-cmd.1:179
msgid "Create a system image for 32-bit architecture:"
msgstr "Créer une image système pour une architecture 32 bits :"

#. type: Plain text
#: minios-cmd.1:182
#, no-wrap
msgid "minios-cmd -d buster -a i386 -de xfce -pv standard\n"
msgstr "minios-cmd -d buster -a i386 -de xfce -pv standard\n"

#. type: Plain text
#: minios-cmd.1:185
msgid "Create a system image with Ubuntu Jammy:"
msgstr "Créer une image système avec Ubuntu Jammy :"

#. type: Plain text
#: minios-cmd.1:188
#, no-wrap
msgid "minios-cmd -d jammy -pv standard -a amd64 -de xfce\n"
msgstr "minios-cmd -d jammy -pv standard -a amd64 -de xfce\n"

#. type: Plain text
#: minios-cmd.1:193
msgid ""
"Enable multilingual support (generates locales for English, Spanish, German, "
"French, Italian, Portuguese, Brazilian Portuguese, Russian, and Indonesian):"
msgstr ""
"Activer la prise en charge multilingue (génère les locales pour l'anglais, "
"l'espagnol, l'allemand, le français, l'italien, le portugais, le portugais "
"brésilien, le russe et l'indonésien) :"

#. type: Plain text
#: minios-cmd.1:196
#, no-wrap
msgid "minios-cmd -d trixie -a amd64 -de xfce -pv standard -ml\n"
msgstr "minios-cmd -d trixie -a amd64 -de xfce -pv standard -ml\n"

#. type: Plain text
#: minios-cmd.1:199
msgid "Create a system image with Russian boot menu language:"
msgstr "Créer une image système avec le menu de démarrage en russe :"

#. type: Plain text
#: minios-cmd.1:202
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -mln ru_RU\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -mln ru_RU\n"

#. type: Plain text
#: minios-cmd.1:205
msgid "Create a system image with livekit initramfs builder (smaller size):"
msgstr ""
"Créer une image système avec le générateur initramfs livekit (taille "
"réduite) :"

#. type: Plain text
#: minios-cmd.1:208
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de flux -pv standard -ib livekit\n"
msgstr "minios-cmd -d bookworm -a amd64 -de flux -pv standard -ib livekit\n"

#. type: SH
#: minios-cmd.1:209
#, no-wrap
msgid "GENERATING AND USING CONFIGURATION FILES"
msgstr "GÉNÉRATION ET UTILISATION DES FICHIERS DE CONFIGURATION"

#. type: Plain text
#: minios-cmd.1:211
msgid "Generate a configuration file:"
msgstr "Générer un fichier de configuration :"

#. type: Plain text
#: minios-cmd.1:214
#, no-wrap
msgid "minios-cmd --config-only --config-file myconfig.conf -d bookworm -a amd64 -de xfce -pv standard\n"
msgstr "minios-cmd --config-only --config-file myconfig.conf -d bookworm -a amd64 -de xfce -pv standard\n"

#. type: Plain text
#: minios-cmd.1:217
msgid "Use the configuration file with \\f[B]minios-live\\f[R]:\\fR"
msgstr ""
"Utiliser le fichier de configuration avec \\f[B]minios-live\\f[R] :\\fR"

#. type: Plain text
#: minios-cmd.1:220
#, no-wrap
msgid "BUILD_CONF=/path/to/myconfig.conf minios-live -\n"
msgstr "BUILD_CONF=/path/to/myconfig.conf minios-live -\n"

#. type: Plain text
#: minios-cmd.1:223
msgid "or:"
msgstr "ou :"

#. type: Plain text
#: minios-cmd.1:227
#, no-wrap
msgid ""
"export BUILD_CONF=/path/to/myconfig.conf\n"
"minios-live -\n"
msgstr ""
"export BUILD_CONF=/path/to/myconfig.conf\n"
"minios-live -\n"

#. type: Plain text
#: minios-cmd.1:231
msgid ""
"\\f[B]minios-live\\f[R](1), \\f[B]condinapt\\f[R](1), \\f[B]condinapt-"
"minios\\f[R](7)\\fR"
msgstr ""
"\\f[B]minios-live\\f[R](1), \\f[B]condinapt\\f[R](1), \\f[B]condinapt-"
"minios\\f[R](7)\\fR"
