#. type: SH
#: condinapt-minios.7:11
#, no-wrap
msgid "INTEGRATION WITH MINIOS BUILD SYSTEM"
msgstr "INTEGRAZIONE CON IL SISTEMA DI BUILD DI MINIOS"

#. type: SS
#: condinapt-minios.7:12
#, no-wrap
msgid "Usage in MiniOS Modules"
msgstr "Utilizzo nei Moduli MiniOS"

#. type: Plain text
#: condinapt-minios.7:16
msgid ""
"CondinAPT is a standard tool for package installation in MiniOS modules.  It "
"integrates into the build process through the standard module interface."
msgstr ""
"CondinAPT è uno strumento standard per l'installazione dei pacchetti nei "
"moduli MiniOS. Si integra nel processo di build tramite l'interfaccia "
"standard dei moduli."

#. type: Plain text
#: condinapt-minios.7:18
msgid "In the module installation script (\\f[B]install\\f[R]):\\fR"
msgstr "Nel script di installazione del modulo (\\f[B]install\\f[R]):\\fR"

#. type: Plain text
#: condinapt-minios.7:22 condinapt-minios.7:245
#, no-wrap
msgid ""
"#!/bin/bash\n"
"set -e\n"
msgstr ""
"#!/bin/bash\n"
"set -e\n"

#. type: Plain text
#: condinapt-minios.7:25 condinapt-minios.7:248
#, no-wrap
msgid ""
"# Load MiniOS library\n"
"\\&. /minioslib || exit 1\n"
msgstr ""
"# Carica MiniOS library\n"
"\\&. /minioslib || exit 1\n"

#. type: Plain text
#: condinapt-minios.7:31
#, no-wrap
msgid ""
"# Install packages via CondinAPT\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"
msgstr ""
"# Installa i pacchetti tramite CondinAPT\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"

#. type: SS
#: condinapt-minios.7:32
#, no-wrap
msgid "MiniOS Module Structure"
msgstr "Struttura del Modulo MiniOS"

#. type: Plain text
#: condinapt-minios.7:35
msgid ""
"Each module in \\f[B]/usr/share/minios-live/scripts/\\f[R] follows a "
"standardized structure:\\fR"
msgstr ""
"Ogni modulo in \\f[B]/usr/share/minios-live/scripts/\\f[R] segue una "
"struttura standardizzata:\\fR"

#. type: Plain text
#: condinapt-minios.7:42
#, no-wrap
msgid ""
"XX-module-name/\n"
"├── packages.list                     # Package list with conditions\n"
"├── install                           # Installation script (uses CondinAPT)\n"
"├── rootcopy-install/                 # (optional) Files to copy\n"
"└── rootcopy-postinstall/             # (optional) Files after installation\n"
msgstr ""
"XX-module-name/\n"
"├── packages.list                     # Elenco pacchetti con condizioni\n"
"├── install                           # Script di installazione (usa CondinAPT)\n"
"├── rootcopy-install/                 # (opzionale) File da copiare\n"
"└── rootcopy-postinstall/             # (opzionale) File dopo l'installazione\n"

