#. type: SH
#: condinapt-minios.7:202
#, no-wrap
msgid "REBUILDING MODULES"
msgstr "RICOSTRUZIONE DEI MODULI"

#. type: Plain text
#: condinapt-minios.7:211
msgid ""
"\\f[B]build-modules\\f[R] skips a module whose SquashFS artifact is already "
"present.  After changing a module, remove its existing artifact from the "
"selected work directory\\[cq]s \\f[B]image/\\f[R] tree and rerun "
"\\f[B]minios-live build-modules\\f[R].  The builder invalidates the "
"following non-kernel module chain once an artifact is missing.  Kernel "
"module rebuilding follows separate handling in the builder.\\fR"
msgstr ""
"\\f[B]build-modules\\f[R] salta un modulo il cui artefatto SquashFS è già "
"presente.  Dopo aver modificato un modulo, rimuovere il suo artefatto "
"esistente dall'albero \\f[B]image/\\f[R] della directory di lavoro "
"selezionata e rieseguire \\f[B]minios-live build-modules\\f[R].  Il builder "
"invalida la seguente catena di moduli non-kernel una volta che manca un "
"artefatto.  La ricostruzione dei moduli kernel segue una gestione separata "
"nel builder.\\fR"

