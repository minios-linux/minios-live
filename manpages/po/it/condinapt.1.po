#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "CONDINAPT"
msgstr "CONDINAPT"

#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "CondinAPT Package Manager"
msgstr "Gestore pacchetti CondinAPT"

#. type: Plain text
#: condinapt.1:7
msgid ""
"condinapt - conditional package installation tool for Debian-like systems"
msgstr ""
"condinapt - strumento per l'installazione condizionale di pacchetti su "
"sistemi tipo Debian"

#. type: Plain text
#: condinapt.1:9
msgid "\\f[B]condinapt\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"
msgstr "\\f[B]condinapt\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"

#. type: Plain text
#: condinapt.1:15
msgid ""
"\\f[B]CondinAPT\\f[R] is a versatile tool for automating package "
"installation in any Debian-like system (Debian, Ubuntu, and their "
"derivatives).  Its key feature is the ability to define complex conditions "
"and rules for installing each package based on arbitrary system "
"configurations.\\fR"
msgstr ""
"\\f[B]CondinAPT\\f[R] è uno strumento versatile per automatizzare "
"l'installazione dei pacchetti su qualsiasi sistema tipo Debian (Debian, "
"Ubuntu e derivati). La sua caratteristica principale è la capacità di "
"definire condizioni e regole complesse per l'installazione di ciascun "
"pacchetto in base a configurazioni di sistema arbitrarie.\\fR"

#. type: SS
#: condinapt.1:15
#, no-wrap
msgid "Areas of Application"
msgstr "Aree di applicazione"

#. type: Plain text
#: condinapt.1:18
msgid "Linux distribution build systems"
msgstr "Sistemi di build per distribuzioni Linux"

#. type: Plain text
#: condinapt.1:20
msgid "Automation of server and workstation setup"
msgstr "Automazione della configurazione di server e workstation"

#. type: Plain text
#: condinapt.1:22
msgid "Deployment of various system configurations"
msgstr "Distribuzione di diverse configurazioni di sistema"

#. type: Plain text
#: condinapt.1:24
msgid "Package management in Docker containers"
msgstr "Gestione dei pacchetti in container Docker"

#. type: Plain text
#: condinapt.1:26
msgid "CI/CD pipelines for environment setup"
msgstr "Pipeline CI/CD per la preparazione degli ambienti"

#. type: Plain text
#: condinapt.1:28
msgid "Creation of custom installation images"
msgstr "Creazione di immagini di installazione personalizzate"

#. type: SS
#: condinapt.1:28
#, no-wrap
msgid "Key Features"
msgstr "Caratteristiche principali"

#. type: Plain text
#: condinapt.1:32
msgid ""
"\\f[B]Conditional Installation:\\f[R] Install packages based on flexible "
"filters (+, -)\\fR"
msgstr ""
"\\f[B]Installazione condizionale:\\f[R] Installa i pacchetti in base a "
"filtri flessibili (+, -)\\fR"

#. type: Plain text
#: condinapt.1:35
msgid ""
"\\f[B]External Configuration:\\f[R] Complete separation of logic (package "
"list) from data (system parameters)\\fR"
msgstr ""
"\\f[B]Configurazione esterna:\\f[R] Separazione completa della logica (lista "
"pacchetti) dai dati (parametri di sistema)\\fR"

#. type: Plain text
#: condinapt.1:38
msgid ""
"\\f[B]Installation Queues:\\f[R] Divide the process into sequential stages "
"to resolve dependencies\\fR"
msgstr ""
"\\f[B]Code di installazione:\\f[R] Suddivide il processo in fasi sequenziali "
"per risolvere le dipendenze\\fR"

#. type: Plain text
#: condinapt.1:41
msgid ""
"\\f[B]Priority Queue:\\f[R] Guaranteed installation of critical packages "
"first\\fR"
msgstr ""
"\\f[B]Coda prioritaria:\\f[R] Installazione garantita dei pacchetti critici "
"come prima cosa\\fR"

#. type: Plain text
#: condinapt.1:44
msgid ""
"\\f[B]Complex Logic:\\f[R] Support for \\[lq]AND\\[rq] (&&), \\[lq]OR\\[rq] "
"(||) operators, as well as group filters (+{a|b}, -{a&b})\\fR"
msgstr ""
"\\f[B]Logica complessa:\\f[R] Supporto per operatori \\[lq]AND\\[rq] (&&), \\"
"[lq]OR\\[rq] (||), oltre a filtri di gruppo (+{a|b}, -{a&b})\\fR"

#. type: Plain text
#: condinapt.1:47
msgid ""
"\\f[B]Readability:\\f[R] Support for comments and empty lines to structure "
"lists\\fR"
msgstr ""
"\\f[B]Leggibilità:\\f[R] Supporto per commenti e righe vuote per strutturare "
"le liste\\fR"

#. type: Plain text
#: condinapt.1:50
msgid ""
"\\f[B]Backward Compatibility:\\f[R] Supports simple package lists without "
"conditions\\fR"
msgstr ""
"\\f[B]Compatibilità retroattiva:\\f[R] Supporta liste di pacchetti semplici "
"senza condizioni\\fR"

#. type: TP
#: condinapt.1:51
#, no-wrap
msgid "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:54
msgid "(Required) Path to the package list file"
msgstr "(Obbligatorio) Percorso al file della lista pacchetti"

#. type: TP
#: condinapt.1:54
#, no-wrap
msgid "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:57
msgid "(Required) Path to the main configuration file"
msgstr "(Obbligatorio) Percorso al file di configurazione principale"

#. type: TP
#: condinapt.1:57
#, no-wrap
msgid "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:60
msgid "(Optional) Path to the filter mapping file"
msgstr "(Opzionale) Percorso al file di mapping dei filtri"

#. type: TP
#: condinapt.1:60
#, no-wrap
msgid "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:65
msgid ""
"(Optional) Path to a priority filter file.  File contains regex patterns to "
"match packages.  Matched packages are moved to priority queue (preserving "
"filters)"
msgstr ""
"(Opzionale) Percorso a un file filtro di priorità. Il file contiene pattern "
"regex per identificare i pacchetti. I pacchetti corrispondenti vengono "
"spostati nella coda prioritaria (mantenendo i filtri)"

#. type: TP
#: condinapt.1:65
#, no-wrap
msgid "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"
msgstr "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"

#. type: Plain text
#: condinapt.1:69
msgid "Simulation mode.  Packages will not be installed"
msgstr "Modalità simulazione.  I pacchetti non verranno installati"

#. type: TP
#: condinapt.1:69
#, no-wrap
msgid "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"
msgstr "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"

#. type: Plain text
#: condinapt.1:74
msgid ""
"Only check if packages are already installed.  Returns exit code 1 if there "
"are uninstalled packages.  At the end, outputs a command to install missing "
"packages"
msgstr ""
"Verifica solo se i pacchetti sono già installati. Restituisce codice di "
"uscita 1 se ci sono pacchetti non installati. Al termine, mostra un comando "
"per installare i pacchetti mancanti"

#. type: TP
#: condinapt.1:74
#, no-wrap
msgid "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"
msgstr "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"

#. type: Plain text
#: condinapt.1:77
msgid "Verbose output"
msgstr "Output dettagliato"

#. type: TP
#: condinapt.1:77
#, no-wrap
msgid "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"
msgstr "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"

#. type: Plain text
#: condinapt.1:80
msgid "Very verbose output"
msgstr "Output molto dettagliato"

#. type: TP
#: condinapt.1:80
#, no-wrap
msgid "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"
msgstr "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"

#. type: Plain text
#: condinapt.1:83
msgid "Enable \\f[B]set -x\\f[R] command tracing\\fR"
msgstr "Abilita il tracciamento dei comandi \\f[B]set -x\\f[R]"

#. type: TP
#: condinapt.1:83
#, no-wrap
msgid "\\f[B]-f\\f[R], \\f[B]--force\\fR"
msgstr "\\f[B]-f\\f[R], \\f[B]--force\\fR"

#. type: Plain text
#: condinapt.1:88
msgid ""
"Force package lists update before installation.  By default, update is "
"skipped if \\f[B]/var/cache/apt/pkgcache.bin\\f[R] exists\\fR"
msgstr ""
"Forza l'aggiornamento delle liste dei pacchetti prima dell'installazione. "
"Per impostazione predefinita, l'aggiornamento viene saltato se \\f[B]/var/"
"cache/apt/pkgcache.bin\\f[R] esiste\\fR"

#. type: TP
#: condinapt.1:88
#, no-wrap
msgid "\\f[B]-h\\f[R], \\f[B]--help\\fR"
msgstr "\\f[B]-h\\f[R], \\f[B]--help\\fR"

#. type: Plain text
#: condinapt.1:91
msgid "Show help"
msgstr "Mostra l'aiuto"

#. type: SH
#: condinapt.1:91
#, no-wrap
msgid "CORE COMPONENTS"
msgstr "COMPONENTI PRINCIPALI"

#. type: Plain text
#: condinapt.1:93
msgid "CondinAPT operates with four key files:"
msgstr "CondinAPT opera con quattro file chiave:"

#. type: SS
#: condinapt.1:93
#, no-wrap
msgid "condinapt script"
msgstr "script condinapt"

#. type: Plain text
#: condinapt.1:95
msgid "The core, containing all processing logic"
msgstr "Il nucleo, che contiene tutta la logica di elaborazione"

#. type: SS
#: condinapt.1:95
#, no-wrap
msgid "Main configuration file (-c)"
msgstr "File di configurazione principale (-c)"

#. type: Plain text
#: condinapt.1:97
msgid "A file with bash variables describing the current environment"
msgstr "Un file con variabili bash che descrivono l'ambiente corrente"

#. type: Plain text
#: condinapt.1:99
msgid "Example (\\f[B]system.conf\\f[R]):\\fR"
msgstr "Esempio (\\f[B]system.conf\\f[R]):\\fR"

#. type: Plain text
#: condinapt.1:106
#, no-wrap
msgid ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"LOCALE=\\[dq]en_US\\[dq]\n"
"FEATURES=\\[dq]web,database\\[dq]\n"
msgstr ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"LOCALE=\\[dq]en_US\\[dq]\n"
"FEATURES=\\[dq]web,database\\[dq]\n"

#. type: SS
#: condinapt.1:107
#, no-wrap
msgid "Filter mapping file (-m)"
msgstr "File di mappatura filtri (-m)"

#. type: Plain text
#: condinapt.1:114
msgid ""
"Links short prefixes (used in the package list) to variable names from the "
"main configuration file.  This file is \\f[B]optional\\f[R].  If a filter is "
"not present in the filter mapping file, it will be used as a variable name "
"from the main configuration file.  If the variable is not found, CondinAPT "
"will declare it empty.\\fR"
msgstr ""
"Collega prefissi brevi (usati nell'elenco pacchetti) ai nomi delle variabili "
"del file di configurazione principale.  Questo file è "
"\\f[B]opzionale\\f[R].  Se un filtro non è presente nel file di mappatura "
"filtri, verrà usato come nome variabile dal file di configurazione "
"principale.  Se la variabile non viene trovata, CondinAPT la dichiarerà "
"vuota.\\fR"

#. type: Plain text
#: condinapt.1:116
msgid "Example (\\f[B]filters.map\\f[R]):\\fR"
msgstr "Esempio (\\f[B]filters.map\\f[R]):\\fR"

#. type: Plain text
#: condinapt.1:123
#, no-wrap
msgid ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"arch=ARCHITECTURE\n"
"feat=FEATURES\n"
msgstr ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"arch=ARCHITECTURE\n"
"feat=FEATURES\n"

#. type: SS
#: condinapt.1:124
#, no-wrap
msgid "Package list file (-l)"
msgstr "File elenco pacchetti (-l)"

#. type: Plain text
#: condinapt.1:126
msgid "The main file describing what to install and under what conditions"
msgstr "Il file principale che descrive cosa installare e in quali condizioni"

#. type: SH
#: condinapt.1:126
#, no-wrap
msgid "PACKAGE LIST SYNTAX"
msgstr "SINTASSI ELENCO PACCHETTI"

#. type: Plain text
#: condinapt.1:128
msgid "Each line in the package list file consists of two main parts:"
msgstr ""
"Ogni riga nel file elenco pacchetti è composta da due parti principali:"

#. type: IP
#: condinapt.1:128
#, no-wrap
msgid "1."
msgstr "1."

#. type: Plain text
#: condinapt.1:130
msgid "Package name with optional version and release specification"
msgstr "Nome del pacchetto con specifica opzionale di versione e rilascio"

#. type: IP
#: condinapt.1:130 condinapt.1:406
#, no-wrap
msgid "2."
msgstr "2."

#. type: Plain text
#: condinapt.1:133
msgid ""
"Condition filters - define the conditions under which the package will be "
"installed"
msgstr ""
"Filtri di condizione - definiscono le condizioni in cui il pacchetto verrà "
"installato"

#. type: SS
#: condinapt.1:133
#, no-wrap
msgid "Package Name Structure"
msgstr "Struttura del nome pacchetto"

#. type: Plain text
#: condinapt.1:135
msgid "\\f[B]Simple name:\\fR"
msgstr "\\f[B]Nome semplice:\\fR"

#. type: Plain text
#: condinapt.1:138
#, no-wrap
msgid "vim\n"
msgstr "vim\n"

#. type: Plain text
#: condinapt.1:141
msgid "\\f[B]Package version:\\fR"
msgstr "\\f[B]Versione pacchetto:\\fR"

#. type: Plain text
#: condinapt.1:145
msgid ""
"\\f[B]package=version\\f[R] - loose version requirement.  If the required "
"version is unavailable, an available version is installed\\fR"
msgstr ""
"\\f[B]package=version\\f[R] - requisito di versione flessibile.  Se la "
"versione richiesta non è disponibile, verrà installata una versione "
"disponibile\\fR"

#. type: Plain text
#: condinapt.1:148
msgid ""
"\\f[B]package==version\\f[R] - strict requirement.  If the version is not "
"found, installation aborts with an error\\fR"
msgstr ""
"\\f[B]package==version\\f[R] - requisito rigido.  Se la versione non viene "
"trovata, l'installazione viene interrotta con un errore\\fR"

#. type: Plain text
#: condinapt.1:150
msgid "\\f[B]Release specification:\\fR"
msgstr "\\f[B]Specificazione della release:\\fR"

#. type: Plain text
#: condinapt.1:152
msgid "The release is specified using the **\\[at]** symbol:"
msgstr "La release viene specificata utilizzando il simbolo **\\[at]**:"

#. type: Plain text
#: condinapt.1:156
#, no-wrap
msgid ""
"telegram\\[at]bookworm-backports\n"
"kernel-image-6.5.0\\[at]trixie-backports\n"
msgstr ""
"telegram\\[at]bookworm-backports\n"
"kernel-image-6.5.0\\[at]trixie-backports\n"

#. type: SS
#: condinapt.1:157
#, no-wrap
msgid "File Structure"
msgstr "Struttura del file"

#. type: Plain text
#: condinapt.1:161
msgid ""
"\\f[B]Package names:\\f[R] Each package or condition is written on a new "
"line\\fR"
msgstr ""
"\\f[B]Nomi dei pacchetti:\\f[R] Ogni pacchetto o condizione viene scritto su "
"una nuova riga\\fR"

#. type: Plain text
#: condinapt.1:164
msgid ""
"\\f[B]Comments:\\f[R] Lines starting with \\f[B]#\\f[R], or text after "
"\\f[B]#\\f[R] on a line, are completely ignored\\fR"
msgstr ""
"\\f[B]Commenti:\\f[R] Le righe che iniziano con \\f[B]#\\f[R], o il testo "
"dopo \\f[B]#\\f[R] su una riga, vengono completamente ignorati\\fR"

#. type: Plain text
#: condinapt.1:166
msgid "\\f[B]Empty lines:\\f[R] Ignored and serve for visual separation\\fR"
msgstr ""
"\\f[B]Righe vuote:\\f[R] Ignorate e utilizzate solo per separazione "
"visiva\\fR"

#. type: SS
#: condinapt.1:166
#, no-wrap
msgid "Filters and Conditions"
msgstr "Filtri e condizioni"

#. type: SS
#: condinapt.1:167
#, no-wrap
msgid "Single Filters"
msgstr "Filtri singoli"

#. type: Plain text
#: condinapt.1:170
msgid ""
"\\f[B]+ (Positive):\\f[R] The condition is true if the variable value "
"\\f[B]matches\\fR"
msgstr ""
"\\f[B]+ (Positivo):\\f[R] La condizione è vera se il valore della variabile "
"\\f[B]corrisponde\\fR"

#. type: Plain text
#: condinapt.1:172
msgid "Format: \\f[B]+=\\fR"
msgstr "Formato: \\f[B]+=\\fR"

#. type: Plain text
#: condinapt.1:174 condinapt.1:185 condinapt.1:254
msgid "Example:"
msgstr "Esempio:"

#. type: Plain text
#: condinapt.1:177
#, no-wrap
msgid "nginx +st=server\n"
msgstr "nginx +st=server\n"

#. type: Plain text
#: condinapt.1:181
msgid ""
"\\f[B]- (Negative):\\f[R] The condition is true if the variable value "
"\\f[B]does not match\\fR"
msgstr ""
"\\f[B]- (Negativo):\\f[R] La condizione è vera se il valore della variabile "
"\\f[B]non corrisponde\\fR"

#. type: Plain text
#: condinapt.1:183
msgid "Format: \\f[B]-=\\fR"
msgstr "Formato: \\f[B]-=\\fR"

#. type: Plain text
#: condinapt.1:188
#, no-wrap
msgid "monitoring-tools -st=desktop\n"
msgstr "monitoring-tools -st=desktop\n"

#. type: SS
#: condinapt.1:189
#, no-wrap
msgid "Group Filters"
msgstr "Filtri di gruppo"

#. type: Plain text
#: condinapt.1:192
msgid ""
"\\f[B]+{a|b} (OR for inclusion):\\f[R] True if \\f[B]at least one\\f[R] of "
"the conditions in the group is true\\fR"
msgstr ""
"\\f[B]+{a|b} (OR per inclusione):\\f[R] Vero se \\f[B]almeno una\\f[R] delle "
"condizioni nel gruppo è vera\\fR"

#. type: Plain text
#: condinapt.1:195
#, no-wrap
msgid "web-server +{st=server|st=web-server}\n"
msgstr "web-server +{st=server|st=web-server}\n"

#. type: Plain text
#: condinapt.1:199
msgid ""
"\\f[B]+{a&b} (AND for inclusion):\\f[R] True only if \\f[B]all\\f[R] "
"conditions in the group are true\\fR"
msgstr ""
"\\f[B]+{a&b} (AND per inclusione):\\f[R] Vero solo se \\f[B]tutte\\f[R] le "
"condizioni nel gruppo sono vere\\fR"

#. type: Plain text
#: condinapt.1:202
#, no-wrap
msgid "database-tools +{d=bookworm&st=server}\n"
msgstr "database-tools +{d=bookworm&st=server}\n"

#. type: Plain text
#: condinapt.1:206
msgid ""
"\\f[B]-{a|b} (OR for exclusion):\\f[R] The package is excluded if \\f[B]at "
"least one\\f[R] of the conditions is true\\fR"
msgstr ""
"\\f[B]-{a|b} (OR per esclusione):\\f[R] Il pacchetto viene escluso se "
"\\f[B]almeno una\\f[R] delle condizioni è vera\\fR"

#. type: Plain text
#: condinapt.1:209
#, no-wrap
msgid "debug-tools -{env=production|st=minimal}\n"
msgstr "debug-tools -{env=production|st=minimal}\n"

#. type: Plain text
#: condinapt.1:213
msgid ""
"\\f[B]-{a&b} (AND for exclusion):\\f[R] The package is excluded only if "
"\\f[B]all\\f[R] conditions are true\\fR"
msgstr ""
"\\f[B]-{a&b} (AND per esclusione):\\f[R] Il pacchetto viene escluso solo se "
"\\f[B]tutte\\f[R] le condizioni sono vere\\fR"

#. type: Plain text
#: condinapt.1:216
#, no-wrap
msgid "development-tools -{env=production&st=minimal}\n"
msgstr "development-tools -{env=production&st=minimal}\n"

#. type: SS
#: condinapt.1:217
#, no-wrap
msgid "Logical Operators"
msgstr "Operatori logici"

#. type: Plain text
#: condinapt.1:220
msgid ""
"\\f[B]|| (OR / Fallback):\\f[R] Try to install the left part.  If it fails, "
"try the right part\\fR"
msgstr ""
"\\f[B]|| (OR / Fallback):\\f[R] Tenta di installare la parte sinistra. Se "
"fallisce, prova la parte destra\\fR"

#. type: Plain text
#: condinapt.1:223
#, no-wrap
msgid "exfatprogs -d=bookworm || exfat-utils\n"
msgstr "exfatprogs -d=bookworm || exfat-utils\n"

#. type: Plain text
#: condinapt.1:227
msgid ""
"\\f[B]&& (AND / Conjunction):\\f[R] All parts must successfully pass filter "
"checks\\fR"
msgstr ""
"\\f[B]&& (AND / Congiunzione):\\f[R] Tutte le parti devono superare con "
"successo i controlli dei filtri\\fR"

#. type: Plain text
#: condinapt.1:230
#, no-wrap
msgid "nginx +st=web-server && php-fpm\n"
msgstr "nginx +st=web-server && php-fpm\n"

#. type: SS
#: condinapt.1:231
#, no-wrap
msgid "Special Modifiers"
msgstr "Modificatori speciali"

#. type: Plain text
#: condinapt.1:236
msgid ""
"\\f[B]! (Mandatory Package):\\f[R] If a package is marked with \\f[B]!"
"\\f[R], but cannot be found in repositories, CondinAPT will abort execution "
"with an error\\fR"
msgstr ""
"\\f[B]! (Pacchetto obbligatorio):\\f[R] Se un pacchetto è contrassegnato con "
"\\f[B]!\\f[R], ma non viene trovato nei repository, CondinAPT interrompe "
"l'esecuzione con un errore\\fR"

#. type: Plain text
#: condinapt.1:239
#, no-wrap
msgid "!essential-package\n"
msgstr "!essential-package\n"

#. type: Plain text
#: condinapt.1:243
msgid ""
"\\f[B]\\[at] (Release Specification):\\f[R] Install a package from a "
"specific Debian/Ubuntu release\\fR"
msgstr ""
"\\f[B]\\[at] (Specificazione della release):\\f[R] Installa un pacchetto da "
"una specifica release Debian/Ubuntu\\fR"

#. type: Plain text
#: condinapt.1:246
#, no-wrap
msgid "kernel-image-6.5.0 \\[at]trixie-backports\n"
msgstr "kernel-image-6.5.0 \\[at]trixie-backports\n"

#. type: SS
#: condinapt.1:247
#, no-wrap
msgid "Installation Queues"
msgstr "Code di installazione"

#. type: Plain text
#: condinapt.1:252
msgid ""
"The \\f[B]\\[em]\\f[R] separator on a separate line divides the list into "
"groups (queues).  Packages from one queue are installed together in a single "
"apt call.  Queues are executed strictly sequentially.\\fR"
msgstr ""
"Il separatore \\f[B]\\[em]\\f[R] su una riga separata divide l'elenco in "
"gruppi (code). I pacchetti di una coda vengono installati insieme in una "
"singola chiamata apt. Le code vengono eseguite in modo strettamente "
"sequenziale.\\fR"

#. type: Plain text
#: condinapt.1:266
#, no-wrap
msgid ""
"# Queue 1: Base system\n"
"systemd\n"
"network-manager\n"
"---\n"
"# Queue 2: Web server\n"
"nginx\n"
"php-fpm\n"
"---\n"
"# Queue 3: Monitoring\n"
"prometheus\n"
msgstr ""
"# Coda 1: Sistema base\n"
"systemd\n"
"network-manager\n"
"---\n"
"# Coda 2: Server web\n"
"nginx\n"
"php-fpm\n"
"---\n"
"# Coda 3: Monitoraggio\n"
"prometheus\n"

#. type: SS
#: condinapt.1:267
#, no-wrap
msgid "Priority Queue"
msgstr "Coda prioritaria"

#. type: Plain text
#: condinapt.1:273
msgid ""
"The file specified by the \\f[B]-P\\f[R] flag contains regex patterns (one "
"pattern per line, no filters).  CondinAPT scans all queues, finds packages "
"matching these patterns, and moves them (with all their filters and "
"conditions) to a special \\[lq]Priority Queue\\[rq], which is executed first."
"\\fR"
msgstr ""
"Il file specificato dall'opzione \\f[B]-P\\f[R] contiene pattern regex (uno "
"per riga, senza filtri). CondinAPT esamina tutte le code, trova i pacchetti "
"che corrispondono a questi pattern e li sposta (con tutti i loro filtri e "
"condizioni) in una speciale \\[lq]Coda Prioritaria\\[rq], che viene eseguita "
"per prima.\\fR"

#. type: Plain text
#: condinapt.1:276
msgid ""
"\\f[B]Pattern Matching:\\f[R] Uses bash regex matching (=\\[ti] operator).  "
"Patterns can be simple package names or complex regex expressions.\\fR"
msgstr ""
"\\f[B]Corrispondenza Pattern:\\f[R] Utilizza il matching regex di bash "
"(operatore =\\[ti]). I pattern possono essere semplici nomi di pacchetto o "
"espressioni regex complesse.\\fR"

#. type: Plain text
#: condinapt.1:280
msgid ""
"\\f[B]Preserving Context:\\f[R] This mechanism preserves all package "
"conditions, filters, and release specifications from the original package "
"list.\\fR"
msgstr ""
"\\f[B]Contesto preservato:\\f[R] Questo meccanismo mantiene tutte le "
"condizioni, i filtri e le specifiche di rilascio dei pacchetti dalla lista "
"originale.\\fR"

#. type: Plain text
#: condinapt.1:285
msgid ""
"\\f[B]Override:\\f[R] Matched packages are automatically removed from their "
"original queues (both regular and target queues with \\f[B]\\"
"[at]release\\f[R]) and moved to priority queues.  Target releases are "
"preserved in separate priority target queues.\\fR"
msgstr ""
"\\f[B]Override:\\f[R] I pacchetti corrispondenti vengono automaticamente "
"rimossi dalle code originali (sia regolari che di destinazione con \\f[B]\\"
"[at]release\\f[R]) e spostati nelle code prioritarie. I rilasci di "
"destinazione vengono mantenuti in code prioritarie separate.\\fR"

#. type: Plain text
#: condinapt.1:287
msgid "Example \\f[B]priority.list\\f[R]:\\fR"
msgstr "Esempio di \\f[B]priority.list\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:292
#, no-wrap
msgid ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"
msgstr ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"

#. type: SS
#: condinapt.1:294
#, no-wrap
msgid "Quick Start"
msgstr "Avvio rapido"

#. type: Plain text
#: condinapt.1:296
msgid "Create the configuration file \\f[B]config.conf\\f[R]:\\fR"
msgstr "Creare il file di configurazione \\\\f[B]config.conf\\\\f[R]:\\\\fR"

#. type: Plain text
#: condinapt.1:301
#, no-wrap
msgid ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
msgstr ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"

#. type: Plain text
#: condinapt.1:304
msgid "Create the package list \\f[B]packages.list\\f[R]:\\fR"
msgstr "Creare la lista dei pacchetti \\\\f[B]packages.list\\\\f[R]:\\\\fR"

#. type: Plain text
#: condinapt.1:309
#, no-wrap
msgid ""
"# Base packages - always installed\n"
"vim\n"
"curl\n"
msgstr ""
"# Pacchetti base - sempre installati\n"
"vim\n"
"curl\n"

#. type: Plain text
#: condinapt.1:313
#, no-wrap
msgid ""
"# Packages only for servers\n"
"nginx +SYSTEM_TYPE=server\n"
"mysql-server +SYSTEM_TYPE=server\n"
msgstr ""
"# Pacchetti solo per server\n"
"nginx +SYSTEM_TYPE=server\n"
"mysql-server +SYSTEM_TYPE=server\n"

#. type: Plain text
#: condinapt.1:316
#, no-wrap
msgid ""
"# Exclude packages for production environment\n"
"debug-tools -ENVIRONMENT=production\n"
msgstr ""
"# Escludi pacchetti per ambiente di produzione\n"
"debug-tools -ENVIRONMENT=production\n"

#. type: Plain text
#: condinapt.1:319
msgid "Run the installation:"
msgstr "Eseguire l'installazione:"

#. type: Plain text
#: condinapt.1:322
#, no-wrap
msgid "condinapt -l packages.list -c config.conf\n"
msgstr "condinapt -l packages.list -c config.conf\n"

#. type: Plain text
#: condinapt.1:325
msgid "Or test in simulation mode:"
msgstr "Oppure testare in modalità simulazione:"

#. type: Plain text
#: condinapt.1:328
#, no-wrap
msgid "condinapt -l packages.list -c config.conf -s\n"
msgstr "condinapt -l packages.list -c config.conf -s\n"

#. type: SS
#: condinapt.1:329
#, no-wrap
msgid "Multimedia Server"
msgstr "Server Multimediale"

#. type: Plain text
#: condinapt.1:331 condinapt.1:350 condinapt-minios.7:124
#: condinapt-minios.7:144 condinapt-minios.7:162 condinapt-minios.7:186
msgid "\\f[B]packages.list:\\fR"
msgstr "\\f[B]packages.list:\\fR"

#. type: Plain text
#: condinapt.1:336 condinapt-minios.7:129
#, no-wrap
msgid ""
"# Basic multimedia codecs - always\n"
"gstreamer1.0-plugins-base\n"
"gstreamer1.0-plugins-good\n"
msgstr ""
"# Codec multimediali di base - sempre\n"
"gstreamer1.0-plugins-base\n"
"gstreamer1.0-plugins-good\n"

#. type: Plain text
#: condinapt.1:340
#, no-wrap
msgid ""
"# Additional codecs - not for minimal installation\n"
"gstreamer1.0-plugins-bad -st=minimal\n"
"gstreamer1.0-plugins-ugly -st=minimal\n"
msgstr ""
"# Codec aggiuntivi - non per installazioni minime\n"
"gstreamer1.0-plugins-bad -st=minimal\n"
"gstreamer1.0-plugins-ugly -st=minimal\n"

#. type: Plain text
#: condinapt.1:347
#, no-wrap
msgid ""
"# Professional tools - only for full configuration\n"
"ffmpeg +st=media-server\n"
"vlc +st=media-server\n"
"---\n"
"# Distribution-specific packages from backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"
msgstr ""
"# Strumenti professionali - solo per configurazioni complete\n"
"ffmpeg +st=media-server\n"
"vlc +st=media-server\n"
"---\n"
"# Pacchetti specifici per distribuzione dai backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"

#. type: SS
#: condinapt.1:348
#, no-wrap
msgid "Web Server with Various Configurations"
msgstr "Server Web con Configurazioni Varie"

#. type: Plain text
#: condinapt.1:355
#, no-wrap
msgid ""
"# Basic web server components\n"
"nginx\n"
"openssl\n"
msgstr ""
"# Componenti di base per server web\n"
"nginx\n"
"openssl\n"

#. type: Plain text
#: condinapt.1:359
#, no-wrap
msgid ""
"# Database - only for full installations\n"
"mysql-server +st=full-server -{env=minimal}\n"
"postgresql +st=database-server\n"
msgstr ""
"# Database - solo per installazioni complete\n"
"mysql-server +st=full-server -{env=minimal}\n"
"postgresql +st=database-server\n"

#. type: Plain text
#: condinapt.1:363
#, no-wrap
msgid ""
"# PHP - for web servers\n"
"php-fpm +feat=php\n"
"php-mysql +{feat=php&st=full-server}\n"
msgstr ""
"# PHP - per server web\n"
"php-fpm +feat=php\n"
"php-mysql +{feat=php&st=full-server}\n"

#. type: Plain text
#: condinapt.1:366
#, no-wrap
msgid ""
"# Monitoring - not for development\n"
"prometheus-node-exporter -env=development\n"
msgstr ""
"# Monitoraggio - non per sviluppo\n"
"prometheus-node-exporter -env=development\n"

#. type: SH
#: condinapt.1:367
#, no-wrap
msgid "OPERATING MODES"
msgstr "MODALITÀ DI FUNZIONAMENTO"

#. type: SS
#: condinapt.1:368
#, no-wrap
msgid "Simulation Mode"
msgstr "Modalità simulazione"

#. type: Plain text
#: condinapt.1:371
msgid ""
"Allows you to see which packages will be installed without actually "
"installing them:"
msgstr ""
"Permette di visualizzare quali pacchetti verranno installati senza eseguire "
"realmente l'installazione:"

#. type: Plain text
#: condinapt.1:374
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -s\n"
msgstr "condinapt -l packages.list -c system.conf -s\n"

#. type: Plain text
#: condinapt.1:377
msgid "In simulation mode, the script exits with exit code 1."
msgstr "In modalità simulazione, lo script termina con codice di uscita 1."

#. type: SS
#: condinapt.1:377
#, no-wrap
msgid "Check Mode"
msgstr "Modalità verifica"

#. type: Plain text
#: condinapt.1:379
msgid ""
"Checks which packages from the list are already installed on the system:"
msgstr "Controlla quali pacchetti dell'elenco sono già installati sul sistema:"

#. type: Plain text
#: condinapt.1:382
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -C\n"
msgstr "condinapt -l packages.list -c system.conf -C\n"

#. type: Plain text
#: condinapt.1:386
msgid ""
"Shows errors for uninstalled packages and returns exit code 1 if there are "
"uninstalled packages."
msgstr ""
"Mostra errori per i pacchetti non installati e restituisce codice di uscita "
"1 se ci sono pacchetti non installati."

#. type: SS
#: condinapt.1:386
#, no-wrap
msgid "Debugging Modes"
msgstr "Modalità di debug"

#. type: Plain text
#: condinapt.1:388
msgid "\\f[B]Verbose Output (-v):\\fR"
msgstr "\\\\f[B]Output verboso (-v):\\\\fR"

#. type: Plain text
#: condinapt.1:391
msgid ""
"Shows detailed information about filter checks and displays results for each "
"package."
msgstr ""
"Mostra informazioni dettagliate sui controlli dei filtri e visualizza i "
"risultati per ogni pacchetto."

#. type: Plain text
#: condinapt.1:393
msgid "\\f[B]Very Verbose Output (-vv):\\fR"
msgstr "\\\\f[B]Output molto verboso (-vv):\\\\fR"

#. type: Plain text
#: condinapt.1:395
msgid "Maximum process detail, shows all intermediate steps."
msgstr "Dettaglio massimo del processo, mostra tutti i passaggi intermedi."

#. type: Plain text
#: condinapt.1:397
msgid "\\f[B]Command Tracing (-x):\\fR"
msgstr "\\\\f[B]Tracciamento comandi (-x):\\\\fR"

#. type: Plain text
#: condinapt.1:400
msgid ""
"Enables \\f[B]set -x\\f[R] for script debugging, shows each command being "
"executed.\\fR"
msgstr ""
"Abilita \\\\f[B]set -x\\\\f[R] per il debug dello script, mostrando ogni "
"comando eseguito.\\\\fR"

#. type: SH
#: condinapt.1:400
#, no-wrap
msgid "ERROR HANDLING"
msgstr "GESTIONE DEGLI ERRORI"

#. type: SS
#: condinapt.1:401
#, no-wrap
msgid "Mandatory Packages"
msgstr "Pacchetti obbligatori"

#. type: Plain text
#: condinapt.1:404
msgid ""
"If a package is marked as mandatory (\\f[B]!\\f[R]) but not found in "
"repositories, CondinAPT:\\fR"
msgstr ""
"Se un pacchetto è contrassegnato come obbligatorio (\\f[B]!\\f[R]) ma non "
"viene trovato nei repository, CondinAPT:\\fR"

#. type: IP
#: condinapt.1:404
#, no-wrap
msgid "\\f[R]1.\\fR"
msgstr "\\f[R]1.\\fR"

#. type: Plain text
#: condinapt.1:406
msgid "Outputs an error message"
msgstr "Mostra un messaggio di errore"

#. type: Plain text
#: condinapt.1:408
msgid "Aborts execution (unless in simulation mode)"
msgstr "Interrompe l'esecuzione (a meno che non sia in modalità simulazione)"

#. type: IP
#: condinapt.1:408
#, no-wrap
msgid "3."
msgstr "3."

#. type: Plain text
#: condinapt.1:410
msgid "Returns exit code 1"
msgstr "Restituisce il codice di uscita 1"

#. type: SS
#: condinapt.1:410
#, no-wrap
msgid "Handling Unavailable Versions"
msgstr "Gestione delle versioni non disponibili"

#. type: Plain text
#: condinapt.1:412
msgid "\\f[B]Loose Versions (=):\\fR"
msgstr "\\f[B]Versioni flessibili (=):\\fR"

#. type: Plain text
#: condinapt.1:415
msgid ""
"If the exact version is unavailable, any available version is installed with "
"a warning."
msgstr ""
"Se la versione esatta non è disponibile, viene installata qualsiasi versione "
"disponibile con un avviso."

#. type: Plain text
#: condinapt.1:417
msgid "\\f[B]Strict Versions (==):\\fR"
msgstr "\\f[B]Versioni rigide (==):\\fR"

#. type: Plain text
#: condinapt.1:420
msgid ""
"If the exact version is unavailable, the package is skipped.  If the package "
"is mandatory (\\f[B]!\\f[R]), execution aborts.\\fR"
msgstr ""
"Se la versione esatta non è disponibile, il pacchetto viene ignorato.  Se il "
"pacchetto è obbligatorio (\\f[B]!\\f[R]), l'esecuzione viene interrotta.\\fR"

#. type: SS
#: condinapt.1:420
#, no-wrap
msgid "Version Holding"
msgstr "Blocco della versione"

#. type: Plain text
#: condinapt.1:423
msgid ""
"CondinAPT automatically applies \\f[B]apt-mark hold\\f[R] when the exactly "
"requested version was installed, preventing automatic updates.\\fR"
msgstr ""
"CondinAPT applica automaticamente \\f[B]apt-mark hold\\f[R] quando viene "
"installata esattamente la versione richiesta, impedendo aggiornamenti "
"automatici.\\fR"

#. type: SH
#: condinapt.1:423 condinapt-minios.7:261
#, no-wrap
msgid "FILES"
msgstr "FILE"

#. type: TP
#: condinapt.1:424
#, no-wrap
msgid "\\f[B]/etc/condinapt/config.conf\\fR"
msgstr "\\f[B]/etc/condinapt/config.conf\\fR"

#. type: Plain text
#: condinapt.1:427
msgid "Default configuration file"
msgstr "File di configurazione predefinito"

#. type: TP
#: condinapt.1:427
#, no-wrap
msgid "\\f[B]/etc/condinapt/filters.map\\fR"
msgstr "\\f[B]/etc/condinapt/filters.map\\fR"

#. type: Plain text
#: condinapt.1:430
msgid "Default filter mapping file"
msgstr "File di mappatura dei filtri predefinito"

#. type: Plain text
#: condinapt.1:433
msgid ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
msgstr ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
