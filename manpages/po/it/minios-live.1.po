#. type: Plain text
#: minios-live.1:23
msgid ""
"\\f[B]Debian distributions:\\f[R] Buster (10), Bullseye (11), Bookworm (12), "
"Trixie (13)\\fR"
msgstr ""
"\\f[B]Distribuzioni Debian:\\f[R] Buster (10), Bullseye (11), Bookworm (12), "
"Trixie (13)\\fR"

#. type: Plain text
#: minios-live.1:25
msgid "\\f[B]Ubuntu distributions:\\f[R] Jammy (22.04), Noble (24.04)\\fR"
msgstr "\\f[B]Distribuzioni Ubuntu:\\f[R] Jammy (22.04), Noble (24.04)\\fR"

#. type: Plain text
#: minios-live.1:27
msgid "\\f[B]Desktop environments:\\fR"
msgstr "\\f[B]Ambienti desktop:\\fR"

