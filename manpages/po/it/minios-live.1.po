#, no-wrap
msgid "MINIOS-LIVE"
msgstr "MINIOS-LIVE"

#. type: TH
#: minios-live.1:3 condinapt.1:3
#, no-wrap
msgid "October 2025"
msgstr "Ottobre 2025"

#. type: TH
#: minios-live.1:3
#, no-wrap
msgid "MiniOS Live System Builder"
msgstr "Generatore di sistemi live MiniOS"

#. type: SH
#: minios-live.1:4 minios-cmd.1:4 condinapt.1:4 condinapt-minios.7:4
#, no-wrap
msgid "NAME"
msgstr "NOME"

#. type: Plain text
#: minios-live.1:7
msgid ""
"minios-live - step-by-step build tool for creating bootable MiniOS ISO images"
msgstr ""
"minios-live - strumento di creazione passo-passo per generare immagini ISO "
"avviabili di MiniOS"

#. type: SH
#: minios-live.1:7 minios-cmd.1:7 condinapt.1:7
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOSSI"

#. type: Plain text
#: minios-live.1:10
msgid ""
"\\f[B]minios-live\\f[R] [\\f[I]start_cmd\\f[R]] \\f[B]-\\f[R] "
"[\\f[I]end_cmd\\f[R]]\\fR"
msgstr ""
"\\f[B]minios-live\\f[R] [\\f[I]start_cmd\\f[R]] \\f[B]-\\f[R] "
"[\\f[I]end_cmd\\f[R]]\\fR"

#. type: SH
#: minios-live.1:10 minios-cmd.1:9 condinapt.1:9 condinapt-minios.7:6
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIZIONE"

#. type: Plain text
#: minios-live.1:17
msgid ""
"\\f[B]minios-live\\f[R] is a step-by-step build tool that builds bootable "
"MiniOS ISO images.  It uses pre-defined configurations to create a "
"customized MiniOS live system with a controlled and modular build process, "
"including the ability to add software layered on top of the base system "
"using SquashFS modules.\\fR"
msgstr ""
"\\f[B]minios-live\\f[R] è uno strumento di creazione passo-passo che genera "
"immagini ISO avviabili di MiniOS. Utilizza configurazioni predefinite per "
"creare un sistema live MiniOS personalizzato con un processo di build "
"controllato e modulare, inclusa la possibilità di aggiungere software "
"sovrapposto al sistema base tramite moduli SquashFS.\\fR"

#. type: SS
#: minios-live.1:17 minios-cmd.1:15 minios-cmd.1:63
#, no-wrap
msgid "Build Options"
msgstr "Opzioni di compilazione"

#. type: Plain text
#: minios-live.1:20
msgid ""
"Using \\f[B]minios-live\\f[R], you can build various configurations "
"including:\\fR"
msgstr ""
"Utilizzando \\f[B]minios-live\\f[R], è possibile costruire diverse "
"configurazioni tra cui:\\fR"

