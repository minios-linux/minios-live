msgstr ""
"Wählen Sie \\f[B]auto\\f[R], \\f[B]6.1\\f[R] oder \\f[B]6.12\\f[R] und "
"verwenden Sie den MiniOS-Anbieter.\\fR"

#. type: TP
#: minios-cmd.1:96
#, no-wrap
msgid "\\f[B]-kpm\\f[R], \\f[B]--kernel-payload-mode\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-kpm\\f[R], \\f[B]--kernel-payload-mode\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:99
msgid "Select \\f[B]runtime\\f[R] or \\f[B]full\\f[R].\\fR"
msgstr "Wählen Sie \\f[B]runtime\\f[R] oder \\f[B]full\\f[R].\\fR"

#. type: TP
#: minios-cmd.1:99
#, no-wrap
msgid "\\f[B]-dkms\\f[R], \\f[B]--kernel-build-dkms\\fR"
msgstr "\\f[B]-dkms\\f[R], \\f[B]--kernel-build-dkms\\fR"

#. type: Plain text
#: minios-cmd.1:102
