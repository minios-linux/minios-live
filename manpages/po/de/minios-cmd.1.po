msgstr "Erzeugt alle von \\f[B]minioslib\\f[R] deklarierten Locales.\\fR"

#. type: TP
#: minios-cmd.1:113
#, no-wrap
msgid "\\f[B]-kl\\f[R], \\f[B]--keep-locales\\fR"
msgstr "\\f[B]-kl\\f[R], \\f[B]--keep-locales\\fR"

#. type: Plain text
#: minios-cmd.1:116
