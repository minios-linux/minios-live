msgstr "Wählen Sie den MiniOS-Kernel-Anbieter."

#. type: TP
#: minios-cmd.1:92
#, no-wrap
msgid "\\f[B]-mks\\f[R], \\f[B]--minios-kernel-series\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-mks\\f[R], \\f[B]--minios-kernel-series\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:96
msgid ""
"Select \\f[B]auto\\f[R], \\f[B]6.1\\f[R], or \\f[B]6.12\\f[R] and use the "
