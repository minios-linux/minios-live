"ntfs3-dkms -kc=ntfs3\n"
"aufs-dkms -kc=aufs +kbd=true\n"
msgstr ""
"ntfs3-dkms -kc=ntfs3\n"
"aufs-dkms -kc=aufs +kbd=true\n"

#. type: Plain text
#: condinapt-minios.7:198
msgid "Choose a package during planning, not after an APT transaction failure:"
