#. type: Plain text
#: condinapt-minios.7:6
msgid "condinapt-minios - CondinAPT integration in the MiniOS build system"
msgstr "condinapt-minios - Integrasi CondinAPT dalam sistem build MiniOS"

#. type: Plain text
#: condinapt-minios.7:9
msgid ""
"This document describes the specific aspects of using \\f[B]condinapt\\f[R]"
"(1) in the MiniOS build system.\\fR"
msgstr ""
"Dokumen ini menjelaskan aspek khusus penggunaan \\f[B]condinapt\\f[R](1) "
"pada sistem build MiniOS.\\fR"

#. type: Plain text
#: condinapt-minios.7:11
msgid "For basic CondinAPT features, see \\f[B]condinapt\\f[R](1).\\fR"
msgstr "Untuk fitur dasar CondinAPT, lihat \\f[B]condinapt\\f[R](1).\\fR"

#. type: SH
#: condinapt-minios.7:11
#, no-wrap
msgid "INTEGRATION WITH MINIOS BUILD SYSTEM"
msgstr "INTEGRASI DENGAN SISTEM BUILD MINIOS"

#. type: SS
#: condinapt-minios.7:12
#, no-wrap
msgid "Usage in MiniOS Modules"
msgstr "Penggunaan pada Modul MiniOS"

#. type: Plain text
#: condinapt-minios.7:16
msgid ""
"CondinAPT is a standard tool for package installation in MiniOS modules.  It "
"integrates into the build process through the standard module interface."
msgstr ""
"CondinAPT adalah alat standar untuk instalasi paket pada modul MiniOS.  Alat "
"ini terintegrasi ke dalam proses build melalui antarmuka modul standar."

#. type: Plain text
#: condinapt-minios.7:18
msgid "In the module installation script (\\f[B]install\\f[R]):\\fR"
msgstr "Dalam skrip instalasi modul (\\f[B]install\\f[R]):\\fR"

#. type: Plain text
#: condinapt-minios.7:22 condinapt-minios.7:245
#, no-wrap
msgid ""
"#!/bin/bash\n"
"set -e\n"
msgstr ""
"#!/bin/bash\n"
"set -e\n"

#. type: Plain text
#: condinapt-minios.7:25 condinapt-minios.7:248
#, no-wrap
msgid ""
"# Load MiniOS library\n"
"\\&. /minioslib || exit 1\n"
msgstr ""
"# Muat pustaka MiniOS\n"
"\\&. /minioslib || exit 1\n"

#. type: Plain text
#: condinapt-minios.7:31
#, no-wrap
msgid ""
"# Install packages via CondinAPT\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"
msgstr ""
"# Instal paket melalui CondinAPT\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"

#. type: SS
#: condinapt-minios.7:32
#, no-wrap
msgid "MiniOS Module Structure"
msgstr "Struktur Modul MiniOS"

#. type: Plain text
#: condinapt-minios.7:35
msgid ""
"Each module in \\f[B]/usr/share/minios-live/scripts/\\f[R] follows a "
"standardized structure:\\fR"
msgstr ""
"Setiap modul di \\f[B]/usr/share/minios-live/scripts/\\f[R] mengikuti "
"struktur yang terstandarisasi:\\fR"

#. type: Plain text
#: condinapt-minios.7:42
#, no-wrap
msgid ""
"XX-module-name/\n"
"├── packages.list                     # Package list with conditions\n"
"├── install                           # Installation script (uses CondinAPT)\n"
"├── rootcopy-install/                 # (optional) Files to copy\n"
"└── rootcopy-postinstall/             # (optional) Files after installation\n"
msgstr ""
"XX-module-name/\n"
"├── packages.list                     # Daftar paket dengan kondisi\n"
"├── install                           # Skrip instalasi (menggunakan CondinAPT)\n"
"├── rootcopy-install/                 # (opsional) Berkas untuk disalin\n"
"└── rootcopy-postinstall/             # (opsional) Berkas setelah instalasi\n"

