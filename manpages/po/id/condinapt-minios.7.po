msgid "MiniOS CondinAPT Integration"
msgstr "Integrasi CondinAPT MiniOS"

#. type: Plain text
#: condinapt-minios.7:6
msgid "condinapt-minios - use CondinAPT in MiniOS build modules"
msgstr "condinapt-minios - gunakan CondinAPT dalam MiniOS modul build"

#. type: Plain text
#: condinapt-minios.7:11
msgid ""
"MiniOS modules use \\f[B]condinapt\\f[R](1) to select and install APT "
"packages from the active build configuration.  This page documents the "
"MiniOS staging paths, module layout, and standard filter map.\\fR"
msgstr ""
"Modul MiniOS menggunakan \\f[B]condinapt\\fR(1) untuk memilih dan menginstal "
"paket APT dari konfigurasi build yang aktif. Halaman ini mendokumentasikan "
"jalur staging MiniOS, tata letak modul, dan peta filter standar.\\fR"

#. type: SH
#: condinapt-minios.7:11
#, no-wrap
msgid "MODULE INTEGRATION"
msgstr "INTEGRASI MODUL"

#. type: Plain text
#: condinapt-minios.7:14
msgid ""
"The builder discovers modules through the selected environment directory:"
msgstr "Builder menemukan modul melalui direktori lingkungan yang dipilih:"

#. type: Plain text
#: condinapt-minios.7:17
#, no-wrap
msgid "linux-live/environments/E<lt>desktopE<gt>/\n"
msgstr "linux-live/environments/E<lt>desktopE<gt>/\n"

#. type: Plain text
#: condinapt-minios.7:20
msgid "Entries there are normally links to reusable module sources under:"
msgstr ""
"Entri di sana biasanya berupa tautan ke sumber modul yang dapat digunakan "
"ulang di bawah:"

#. type: Plain text
#: condinapt-minios.7:23
#, no-wrap
msgid "linux-live/scripts/E<lt>NN-module-nameE<gt>/\n"
msgstr "linux-live/scripts/E<lt>NN-module-nameE<gt>/\n"

#. type: Plain text
#: condinapt-minios.7:32
msgid ""
"During the install stage, the builder copies the module\\[cq]s "
"\\f[B]install\\f[R] script to \\f[B]/install\\f[R] in the chroot.  It also "
"stages \\f[B]condinapt\\f[R], \\f[B]condinapt.map\\f[R], "
"\\f[B]packages.list\\f[R], and the generated build configuration at the "
"chroot root.  Do not rely on \\f[B]$CWD\\f[R] or an installed \\f[B]/usr/"
"share/minios-live\\f[R] path from inside a module script.\\fR"
msgstr ""
"Selama tahap instalasi, builder menyalin skrip \\f[B]install\\fR modul ke "
"\\f[B]/install\\fR di dalam chroot. Selain itu, juga menempatkan "
"\\f[B]condinapt\\fR, \\f[B]condinapt.map\\fR, \\f[B]packages.list\\fR, dan "
"konfigurasi build yang dihasilkan di root chroot. Jangan mengandalkan \\f[B]"
"$CWD\\fR atau path \\f[B]/usr/share/minios-live\\fR yang terinstal dari "
"dalam skrip modul.\\fR"

#. type: Plain text
#: condinapt-minios.7:34
msgid "A minimal \\f[B]install\\f[R] script is:\\fR"
msgstr "Skrip \\f[B]install\\fR minimal adalah:\\fR"

#. type: Plain text
#: condinapt-minios.7:40
#, no-wrap
msgid ""
"#!/bin/bash\n"
"set -e\n"
"set -o pipefail\n"
"set -u\n"
msgstr ""
"#!/bin/bash\n"
"set -e\n"
"set -o pipefail\n"
"set -u\n"

#. type: Plain text
#: condinapt-minios.7:43
#, no-wrap
msgid ""
"\\&. /minioslib || exit 1\n"
"\\&. /minios_build.conf || exit 1\n"
msgstr ""
"\\&. /minioslib || exit 1\n"
"\\&. /minios_build.conf || exit 1\n"

#. type: Plain text
#: condinapt-minios.7:49
#, no-wrap
msgid ""
"SCRIPT_DIR=\\[dq]$(dirname \\[dq]$(readlink -f \\[dq]$0\\[dq])\\[dq])\\[dq]\n"
"/condinapt \\[rs]\n"
"    -l \\[dq]${SCRIPT_DIR}/packages.list\\[dq] \\[rs]\n"
"    -c \\[dq]${SCRIPT_DIR}/minios_build.conf\\[dq] \\[rs]\n"
"    -m \\[dq]${SCRIPT_DIR}/condinapt.map\\[dq]\n"
msgstr ""
"SCRIPT_DIR=\\[dq]$(dirname \\[dq]$(readlink -f \\[dq]$0\\[dq])\\[dq])\\[dq]\n"
"/condinapt \\[rs]\n"
"    -l \\[dq]${SCRIPT_DIR}/packages.list\\[dq] \\[rs]\n"
"    -c \\[dq]${SCRIPT_DIR}/minios_build.conf\\[dq] \\[rs]\n"
"    -m \\[dq]${SCRIPT_DIR}/condinapt.map\\[dq]\n"

#. type: Plain text
#: condinapt-minios.7:52
msgid "The standard module may contain:"
msgstr "Modul standar dapat berisi:"

#. type: Plain text
#: condinapt-minios.7:64
#, no-wrap
msgid ""
"NN-module-name/\n"
"|-- packages.list\n"
"|-- install\n"
"|-- skip_conditions.conf       # optional\n"
"|-- rootcopy-install/          # optional\n"
"|-- build                      # optional\n"
"|-- patches/                   # optional, used by build\n"
"|-- is_dkms_build              # optional DKMS marker\n"
"|-- rootcopy-postinstall/      # optional\n"
"\\[ga]-- postinstall                # optional\n"
msgstr ""
"NN-module-name/\n"
"|-- packages.list\n"
"|-- install\n"
"|-- skip_conditions.conf       # opsional\n"
"|-- rootcopy-install/          # opsional\n"
"|-- build                      # opsional\n"
"|-- patches/                   # opsional, digunakan oleh build\n"
"|-- is_dkms_build              # penanda DKMS opsional\n"
"|-- rootcopy-postinstall/      # opsional\n"
"\\[ga]-- postinstall                # opsional\n"

#. type: Plain text
#: condinapt-minios.7:69
msgid ""
"See \\f[B]linux-live/scripts/10-example/README.md\\f[R] for the complete "
"module lifecycle, ownership manifests, naming, and environment-link "
"instructions.\\fR"
msgstr ""
"Lihat \\f[B]linux-live/scripts/10-example/README.md\\fR untuk siklus hidup "
"modul lengkap, manifest kepemilikan, penamaan, dan instruksi tautan "
"lingkungan.\\fR"

