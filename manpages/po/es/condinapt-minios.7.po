#, no-wrap
msgid "\\f[B]DISTRIBUTION_PROFILE\\fR"
msgstr "\\f[B]DISTRIBUTION_PROFILE\\fR"

#. type: Plain text
#: condinapt-minios.7:117
msgid ""
"Distribution behavior profile (debian, ubuntu) - automatically determined "
"based on DISTRIBUTION"
msgstr ""
"Perfil de comportamiento de la distribución (debian, ubuntu) - se determina "
"automáticamente según DISTRIBUTION"

#. type: TP
#: condinapt-minios.7:117
#, no-wrap
msgid "\\f[B]INIT_SYSTEM\\fR"
msgstr "\\f[B]INIT_SYSTEM\\fR"

#. type: Plain text
#: condinapt-minios.7:121
