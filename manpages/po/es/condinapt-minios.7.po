"Init system profile (systemd, sysvinit) - automatically determined based on "
"DISTRIBUTION"
msgstr ""
"Perfil del sistema de inicio (systemd, sysvinit) - se determina "
"automáticamente según DISTRIBUTION"

#. type: SS
#: condinapt-minios.7:122
#, no-wrap
msgid "Multimedia Module"
msgstr "Módulo de multimedia"

#. type: Plain text
#: condinapt-minios.7:134
#, no-wrap
msgid ""
"# Additional codecs - not for minimal variant\n"
"gstreamer1.0-plugins-bad -pv=minimum\n"
"gstreamer1.0-plugins-ugly -pv=minimum\n"
"gstreamer1.0-libav -pv=minimum\n"
msgstr ""
"# Códecs adicionales - no para la variante mínima\n"
"gstreamer1.0-plugins-bad -pv=minimum\n"
"gstreamer1.0-plugins-ugly -pv=minimum\n"
"gstreamer1.0-libav -pv=minimum\n"

#. type: Plain text
#: condinapt-minios.7:141
#, no-wrap
msgid ""
"# Professional tools - only for toolbox and ultra\n"
"audacity +{pv=toolbox|pv=ultra}\n"
"kdenlive +{pv=toolbox|pv=ultra} +{de=xfce|de=lxqt}\n"
"---\n"
"# Distribution-specific packages from backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"
msgstr ""
"# Herramientas profesionales - solo para toolbox y ultra\n"
"audacity +{pv=toolbox|pv=ultra}\n"
"kdenlive +{pv=toolbox|pv=ultra} +{de=xfce|de=lxqt}\n"
"---\n"
"# Paquetes específicos de la distribución desde backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"

#. type: SS
#: condinapt-minios.7:142
#, no-wrap
msgid "Driver Module"
msgstr "Módulo de controladores"

#. type: Plain text
#: condinapt-minios.7:149
#, no-wrap
msgid ""
"# Basic drivers\n"
"mesa-utils\n"
"xserver-xorg-video-all\n"
msgstr ""
"# Controladores básicos\n"
"mesa-utils\n"
"xserver-xorg-video-all\n"

#. type: Plain text
#: condinapt-minios.7:152
#, no-wrap
msgid ""
"# NVIDIA drivers - only for non-free distributions\n"
"nvidia-driver +d=bookworm -{pv=minimum&de=core}\n"
msgstr ""
"# Controladores NVIDIA - solo para distribuciones no libres\n"
"nvidia-driver +d=bookworm -{pv=minimum&de=core}\n"

#. type: Plain text
#: condinapt-minios.7:156
#, no-wrap
msgid ""
"# AMD drivers - for modern distributions\n"
"firmware-amd-graphics +{d=trixie|d=noble}\n"
"mesa-vulkan-drivers +{d=trixie|d=noble}\n"
msgstr ""
"# Controladores AMD - para distribuciones modernas\n"
"firmware-amd-graphics +{d=trixie|d=noble}\n"
"mesa-vulkan-drivers +{d=trixie|d=noble}\n"

#. type: Plain text
#: condinapt-minios.7:159
#, no-wrap
msgid ""
"# Old drivers - for old systems\n"
"xserver-xorg-video-radeon +d=bookworm\n"
msgstr ""
"# Controladores antiguos - para sistemas antiguos\n"
"xserver-xorg-video-radeon +d=bookworm\n"

#. type: SS
#: condinapt-minios.7:160
#, no-wrap
msgid "Localization Module"
msgstr "Módulo de localización"

#. type: Plain text
#: condinapt-minios.7:166
#, no-wrap
msgid ""
"# Basic locales - always\n"
"locales\n"
msgstr ""
"# Locales básicos - siempre\n"
"locales\n"

#. type: Plain text
#: condinapt-minios.7:171
#, no-wrap
msgid ""
"# Russian localization\n"
"language-pack-ru +lo=ru_RU\n"
"fonts-liberation +lo=ru_RU\n"
"firefox-esr-l10n-ru +lo=ru_RU +{de=xfce|de=lxqt}\n"
msgstr ""
"# Localización al ruso\n"
"language-pack-ru +lo=ru_RU\n"
"fonts-liberation +lo=ru_RU\n"
"firefox-esr-l10n-ru +lo=ru_RU +{de=xfce|de=lxqt}\n"

#. type: Plain text
#: condinapt-minios.7:175
#, no-wrap
msgid ""
"# Multilingual support\n"
"task-russian +ml=true +lo=ru_RU\n"
"hunspell-ru +ml=true +lo=ru_RU\n"
msgstr ""
"# Soporte multilingüe\n"
"task-russian +ml=true +lo=ru_RU\n"
"hunspell-ru +ml=true +lo=ru_RU\n"

#. type: Plain text
#: condinapt-minios.7:178
#, no-wrap
msgid ""
"# Keeping locales\n"
"vlc-l10n +kl=true +{pv=toolbox|pv=ultra}\n"
msgstr ""
"# Conservando los locales\n"
"vlc-l10n +kl=true +{pv=toolbox|pv=ultra}\n"

#. type: Plain text
#: condinapt-minios.7:183
#, no-wrap
msgid ""
"# Regional settings for different locales\n"
"language-pack-pt +lo=pt_BR\n"
"language-pack-de +lo=de_DE\n"
"language-pack-fr +lo=fr_FR\n"
msgstr ""
"# Configuración regional para diferentes locales\n"
"language-pack-pt +lo=pt_BR\n"
"language-pack-de +lo=de_DE\n"
"language-pack-fr +lo=fr_FR\n"

#. type: SS
#: condinapt-minios.7:184
#, no-wrap
msgid "Advanced Filter Usage"
msgstr "Uso avanzado de filtros"

#. type: Plain text
#: condinapt-minios.7:191
#, no-wrap
msgid ""
"# DKMS modules with kernel and distribution conditions\n"
"ntfs3-dkms -kc=ntfs3\n"
"zfs-dkms +{pv=toolbox|pv=ultra} +da=amd64 +kbd=true -kf=none\n"
msgstr ""
"# Módulos DKMS con condiciones de kernel y distribución\n"
"ntfs3-dkms -kc=ntfs3\n"
"zfs-dkms +{pv=toolbox|pv=ultra} +da=amd64 +kbd=true -kf=none\n"

#. type: Plain text
#: condinapt-minios.7:195
#, no-wrap
msgid ""
"# Drivers for old systems\n"
"broadcom-sta-dkms -d=jammy -da=i386\n"
"aufs-dkms +dp=debian +d=buster -kc=aufs\n"
msgstr ""
"# Controladores para sistemas antiguos\n"
"broadcom-sta-dkms -d=jammy -da=i386\n"
"aufs-dkms +dp=debian +d=buster -kc=aufs\n"

#. type: Plain text
#: condinapt-minios.7:199
#, no-wrap
msgid ""
"# Exclusion when the selected kernel already provides the driver\n"
"realtek-rtl8821cu-dkms -kc=rtw88_8821cu\n"
"firmware-b43-installer -d=bionic\n"
msgstr ""
"# Exclusión cuando el kernel seleccionado ya proporciona el controlador\n"
"realtek-rtl8821cu-dkms -kc=rtw88_8821cu\n"
"firmware-b43-installer -d=bionic\n"

#. type: Plain text
#: condinapt-minios.7:202
#, no-wrap
msgid ""
"# Complex alternatives with filters\n"
"exfatprogs -pv=minimum || exfat-utils -pv=minimum && exfat-fuse -pv=minimum\n"
msgstr ""
"# Alternativas complejas con filtros\n"
"exfatprogs -pv=minimum || exfat-utils -pv=minimum && exfat-fuse -pv=minimum\n"

#. type: Plain text
#: condinapt-minios.7:208
#, no-wrap
msgid ""
"# Localization with exclusions and conditions\n"
"vlc-l10n -lo=en_US +{pv=toolbox|pv=ultra}\n"
"language-pack-gnome-ru-base +lo=ru_RU +dp=ubuntu\n"
"language-pack-gnome-ru-base +ml=true +dp=ubuntu\n"
"language-pack-gnome-ru-base +kl=true +dp=ubuntu\n"
msgstr ""
"# Localización con exclusiones y condiciones\n"
"vlc-l10n -lo=en_US +{pv=toolbox|pv=ultra}\n"
"language-pack-gnome-ru-base +lo=ru_RU +dp=ubuntu\n"
"language-pack-gnome-ru-base +ml=true +dp=ubuntu\n"
"language-pack-gnome-ru-base +kl=true +dp=ubuntu\n"

#. type: SS
#: condinapt-minios.7:209
#, no-wrap
msgid "Optimization for MiniOS"
msgstr "Optimización para MiniOS"

#. type: Plain text
#: condinapt-minios.7:211
msgid "Grouping by functionality:"
msgstr "Agrupación por funcionalidad:"

#. type: Plain text
#: condinapt-minios.7:216
#, no-wrap
msgid ""
"#=== Core System ===\n"
"systemd +pv=standard +pv=toolbox +pv=ultra\n"
"dbus\n"
msgstr ""
"#=== Sistema principal ===\n"
"systemd +pv=standard +pv=toolbox +pv=ultra\n"
"dbus\n"

#. type: Plain text
#: condinapt-minios.7:221
#, no-wrap
msgid ""
"#=== Desktop Environment ===\n"
"xfce4-panel +de=xfce\n"
"lxqt-panel +de=lxqt\n"
"fluxbox +de=flux\n"
msgstr ""
"#=== Entorno de escritorio ===\n"
"xfce4-panel +de=xfce\n"
"lxqt-panel +de=lxqt\n"
"fluxbox +de=flux\n"

#. type: Plain text
#: condinapt-minios.7:226
#, no-wrap
msgid ""
"#=== Applications by Variant ===\n"
"firefox-esr +{pv=standard|pv=toolbox|pv=ultra}\n"
"thunderbird +{pv=toolbox|pv=ultra}\n"
"libreoffice +pv=ultra\n"
msgstr ""
"#=== Aplicaciones por variante ===\n"
"firefox-esr +{pv=standard|pv=toolbox|pv=ultra}\n"
"thunderbird +{pv=toolbox|pv=ultra}\n"
"libreoffice +pv=ultra\n"

#. type: SH
#: condinapt-minios.7:227
#, no-wrap
msgid "INTEGRATION WITH BUILD PROCESS"
msgstr "INTEGRACIÓN CON EL PROCESO DE CONSTRUCCIÓN"

#. type: SS
#: condinapt-minios.7:228
#, no-wrap
msgid "Module Environment Variables"
msgstr "Variables de entorno del módulo"

#. type: Plain text
#: condinapt-minios.7:230
msgid ""
"Within the MiniOS module context, the following variables are available:"
msgstr ""
"Dentro del contexto del módulo MiniOS, están disponibles las siguientes "
"variables:"

#. type: TP
#: condinapt-minios.7:230
#, no-wrap
msgid "\\f[B]$CWD\\fR"
msgstr "\\f[B]$CWD\\fR"

#. type: Plain text
#: condinapt-minios.7:233
msgid "Current module directory"
msgstr "Directorio actual del módulo"

#. type: TP
#: condinapt-minios.7:233
#, no-wrap
msgid "\\f[B]$LIVEKITNAME\\fR"
msgstr "\\f[B]$LIVEKITNAME\\fR"

#. type: Plain text
#: condinapt-minios.7:236
msgid "System name (usually \\[lq]minios\\[rq])"
msgstr "Nombre del sistema (usualmente \\[lq]minios\\[rq])"

#. type: TP
#: condinapt-minios.7:236
#, no-wrap
msgid "\\f[B]$MODULE\\fR"
msgstr "\\f[B]$MODULE\\fR"

#. type: Plain text
#: condinapt-minios.7:239
msgid "Current module name"
msgstr "Nombre actual del módulo"

#. type: SS
#: condinapt-minios.7:239
#, no-wrap
msgid "Using minioslib"
msgstr "Uso de minioslib"

#. type: Plain text
#: condinapt-minios.7:241
msgid "Example installation script with conditional execution:"
msgstr "Ejemplo de script de instalación con ejecución condicional:"

#. type: Plain text
#: condinapt-minios.7:254
#, no-wrap
msgid ""
"# Check module conditions\n"
"if [ \\[dq]$PACKAGE_VARIANT\\[dq] = \\[dq]minimum\\[dq] ] && [ \\[dq]$DESKTOP_ENVIRONMENT\\[dq] = \\[dq]core\\[dq] ]; then\n"
"    echo \\[dq]Skipping module for minimal core build\\[dq]\n"
"    exit 0\n"
"fi\n"
msgstr ""
"# Comprobar condiciones del módulo\n"
"if [ \\[dq]$PACKAGE_VARIANT\\[dq] = \\[dq]minimum\\[dq] ] && [ \\[dq]$DESKTOP_ENVIRONMENT\\[dq] = \\[dq]core\\[dq] ]; then\n"
"    echo \\[dq]Omitiendo el módulo para la compilación mínima con core\\[dq]\n"
"    exit 0\n"
"fi\n"

#. type: Plain text
#: condinapt-minios.7:260
#, no-wrap
msgid ""
"# Install packages\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"
msgstr ""
"# Instalar paquetes\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"

#. type: TP
#: condinapt-minios.7:262
#, no-wrap
msgid "\\f[B]/etc/minios-live/build.conf\\fR"
msgstr "\\f[B]/etc/minios-live/build.conf\\fR"

#. type: Plain text
#: condinapt-minios.7:265
msgid "Main MiniOS build configuration file"
msgstr "Archivo principal de configuración de compilación de MiniOS"

#. type: TP
#: condinapt-minios.7:265
#, no-wrap
msgid "\\f[B]/usr/share/minios-live/condinapt.map\\fR"
msgstr "\\f[B]/usr/share/minios-live/condinapt.map\\fR"

#. type: Plain text
#: condinapt-minios.7:268
msgid "Filter mapping for MiniOS build system"
msgstr "Mapeo de filtros para el sistema de compilación de MiniOS"

#. type: TP
#: condinapt-minios.7:268
#, no-wrap
msgid "\\f[B]/usr/share/minios-live/scripts/XX-module-name/packages.list\\fR"
msgstr "\\f[B]/usr/share/minios-live/scripts/XX-module-name/packages.list\\fR"

#. type: Plain text
#: condinapt-minios.7:271
msgid "Package list for each module"
msgstr "Lista de paquetes para cada módulo"

#. type: TP
#: condinapt-minios.7:271
#, no-wrap
msgid "\\f[B]/usr/share/minios-live/scripts/XX-module-name/install\\fR"
msgstr "\\f[B]/usr/share/minios-live/scripts/XX-module-name/install\\fR"

#. type: Plain text
#: condinapt-minios.7:274
msgid "Module installation script"
msgstr "Script de instalación del módulo"

#. type: Plain text
#: condinapt-minios.7:277
msgid ""
"\\f[B]condinapt\\f[R](1), \\f[B]minios-live\\f[R](1), \\f[B]minios-cmd\\f[R]"
"(1)\\fR"
msgstr ""
"\\f[B]condinapt\\f[R](1), \\f[B]minios-live\\f[R](1), \\f[B]minios-cmd\\f[R]"
"(1)\\fR"
