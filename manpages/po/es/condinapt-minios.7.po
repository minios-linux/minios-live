#. type: SH
#: condinapt-minios.7:202
#, no-wrap
msgid "REBUILDING MODULES"
msgstr "RECONSTRUCCIÓN DE MÓDULOS"

#. type: Plain text
#: condinapt-minios.7:211
msgid ""
"\\f[B]build-modules\\f[R] skips a module whose SquashFS artifact is already "
"present.  After changing a module, remove its existing artifact from the "
"selected work directory\\[cq]s \\f[B]image/\\f[R] tree and rerun "
"\\f[B]minios-live build-modules\\f[R].  The builder invalidates the "
"following non-kernel module chain once an artifact is missing.  Kernel "
"module rebuilding follows separate handling in the builder.\\fR"
msgstr ""
"\\f[B]build-modules\\f[R] omite un módulo cuyo artefacto SquashFS ya está "
"presente.  Después de modificar un módulo, elimine su artefacto existente "
"del árbol \\f[B]image/\\f[R] del directorio de trabajo seleccionado y vuelva "
"a ejecutar \\f[B]minios-live build-modules\\f[R].  El generador invalida la "
"siguiente cadena de módulos no relacionados con el kernel una vez que falta "
"un artefacto.  La reconstrucción de módulos de kernel sigue un manejo "
"separado en el generador.\\fR"

