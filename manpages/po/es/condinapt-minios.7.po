msgstr "INTEGRACIÓN CON EL SISTEMA DE CONSTRUCCIÓN DE MINIOS"

#. type: SS
#: condinapt-minios.7:12
#, no-wrap
msgid "Usage in MiniOS Modules"
msgstr "Uso en módulos de MiniOS"

#. type: Plain text
#: condinapt-minios.7:16
msgid ""
"CondinAPT is a standard tool for package installation in MiniOS modules.  It "
"integrates into the build process through the standard module interface."
msgstr ""
"CondinAPT es una herramienta estándar para la instalación de paquetes en los "
"módulos de MiniOS. Se integra en el proceso de construcción a través de la "
"interfaz estándar de módulos."

#. type: Plain text
#: condinapt-minios.7:18
msgid "In the module installation script (\\f[B]install\\f[R]):\\fR"
msgstr "En el script de instalación del módulo (\\f[B]install\\f[R]):\\fR"

#. type: Plain text
#: condinapt-minios.7:22 condinapt-minios.7:245
#, no-wrap
msgid ""
"#!/bin/bash\n"
"set -e\n"
msgstr ""
"#!/bin/bash\n"
"set -e\n"

#. type: Plain text
#: condinapt-minios.7:25 condinapt-minios.7:248
#, no-wrap
msgid ""
"# Load MiniOS library\n"
"\\&. /minioslib || exit 1\n"
msgstr ""
"# Cargar la biblioteca de MiniOS\n"
"\\&. /minioslib || exit 1\n"

#. type: Plain text
#: condinapt-minios.7:31
#, no-wrap
msgid ""
"# Install packages via CondinAPT\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"
msgstr ""
"# Instalar paquetes mediante CondinAPT\n"
"/usr/share/minios-live/condinapt \\[rs]\n"
"    -l \\[dq]$CWD/packages.list\\[dq] \\[rs]\n"
"    -c /etc/minios-live/build.conf \\[rs]\n"
"    -m /usr/share/minios-live/condinapt.map\n"

#. type: SS
#: condinapt-minios.7:32
#, no-wrap
msgid "MiniOS Module Structure"
msgstr "Estructura del módulo de MiniOS"

#. type: Plain text
#: condinapt-minios.7:35
msgid ""
"Each module in \\f[B]/usr/share/minios-live/scripts/\\f[R] follows a "
"standardized structure:\\fR"
msgstr ""
"Cada módulo en \\f[B]/usr/share/minios-live/scripts/\\f[R] sigue una "
"estructura estandarizada:\\fR"

#. type: Plain text
#: condinapt-minios.7:42
#, no-wrap
msgid ""
"XX-module-name/\n"
"├── packages.list                     # Package list with conditions\n"
"├── install                           # Installation script (uses CondinAPT)\n"
"├── rootcopy-install/                 # (optional) Files to copy\n"
"└── rootcopy-postinstall/             # (optional) Files after installation\n"
msgstr ""
"XX-module-name/\n"
"├── packages.list                     # Lista de paquetes con condiciones\n"
"├── install                           # Script de instalación (utiliza CondinAPT)\n"
"├── rootcopy-install/                 # (opcional) Archivos para copiar\n"
"└── rootcopy-postinstall/             # (opcional) Archivos después de la instalación\n"

