#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "CONDINAPT"
msgstr "CONDINAPT"

#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "CondinAPT Package Manager"
msgstr "Gestor de paquetes CondinAPT"

#. type: Plain text
#: condinapt.1:7
msgid ""
"condinapt - conditional package installation tool for Debian-like systems"
msgstr ""
"condinapt - herramienta de instalación condicional de paquetes para sistemas "
"basados en Debian"

#. type: Plain text
#: condinapt.1:9
msgid "\\f[B]condinapt\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"
msgstr "\\f[B]condinapt\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"

#. type: Plain text
#: condinapt.1:15
msgid ""
"\\f[B]CondinAPT\\f[R] is a versatile tool for automating package "
"installation in any Debian-like system (Debian, Ubuntu, and their "
"derivatives).  Its key feature is the ability to define complex conditions "
"and rules for installing each package based on arbitrary system "
"configurations.\\fR"
msgstr ""
"\\f[B]CondinAPT\\f[R] es una herramienta versátil para automatizar la "
"instalación de paquetes en cualquier sistema basado en Debian (Debian, "
"Ubuntu y sus derivados). Su característica principal es la capacidad de "
"definir condiciones y reglas complejas para instalar cada paquete según "
"configuraciones arbitrarias del sistema.\\fR"

#. type: SS
#: condinapt.1:15
#, no-wrap
msgid "Areas of Application"
msgstr "Áreas de aplicación"

#. type: Plain text
#: condinapt.1:18
msgid "Linux distribution build systems"
msgstr "Sistemas de construcción de distribuciones Linux"

#. type: Plain text
#: condinapt.1:20
msgid "Automation of server and workstation setup"
msgstr ""
"Automatización de la configuración de servidores y estaciones de trabajo"

#. type: Plain text
#: condinapt.1:22
msgid "Deployment of various system configurations"
msgstr "Despliegue de diversas configuraciones del sistema"

#. type: Plain text
#: condinapt.1:24
msgid "Package management in Docker containers"
msgstr "Gestión de paquetes en contenedores Docker"

#. type: Plain text
#: condinapt.1:26
msgid "CI/CD pipelines for environment setup"
msgstr "Pipelines CI/CD para la preparación de entornos"

#. type: Plain text
#: condinapt.1:28
msgid "Creation of custom installation images"
msgstr "Creación de imágenes de instalación personalizadas"

#. type: SS
#: condinapt.1:28
#, no-wrap
msgid "Key Features"
msgstr "Características principales"

#. type: Plain text
#: condinapt.1:32
msgid ""
"\\f[B]Conditional Installation:\\f[R] Install packages based on flexible "
"filters (+, -)\\fR"
msgstr ""
"\\f[B]Instalación condicional:\\f[R] Instala paquetes según filtros "
"flexibles (+, -)\\fR"

#. type: Plain text
#: condinapt.1:35
msgid ""
"\\f[B]External Configuration:\\f[R] Complete separation of logic (package "
"list) from data (system parameters)\\fR"
msgstr ""
"\\f[B]Configuración externa:\\f[R] Separación completa de la lógica (lista "
"de paquetes) y los datos (parámetros del sistema)\\fR"

#. type: Plain text
#: condinapt.1:38
msgid ""
"\\f[B]Installation Queues:\\f[R] Divide the process into sequential stages "
"to resolve dependencies\\fR"
msgstr ""
"\\f[B]Colas de instalación:\\f[R] Divide el proceso en etapas secuenciales "
"para resolver dependencias\\fR"

#. type: Plain text
#: condinapt.1:41
msgid ""
"\\f[B]Priority Queue:\\f[R] Guaranteed installation of critical packages "
"first\\fR"
msgstr ""
"\\f[B]Cola de prioridad:\\f[R] Instalación garantizada de paquetes críticos "
"en primer lugar\\fR"

#. type: Plain text
#: condinapt.1:44
msgid ""
"\\f[B]Complex Logic:\\f[R] Support for \\[lq]AND\\[rq] (&&), \\[lq]OR\\[rq] "
"(||) operators, as well as group filters (+{a|b}, -{a&b})\\fR"
msgstr ""
"\\f[B]Lógica compleja:\\f[R] Soporte para operadores \\[lq]AND\\[rq] (&&), \\"
"[lq]OR\\[rq] (||), así como filtros de grupo (+{a|b}, -{a&b})\\fR"

#. type: Plain text
#: condinapt.1:47
msgid ""
"\\f[B]Readability:\\f[R] Support for comments and empty lines to structure "
"lists\\fR"
msgstr ""
"\\f[B]Legibilidad:\\f[R] Permite comentarios y líneas vacías para "
"estructurar las listas\\fR"

#. type: Plain text
#: condinapt.1:50
msgid ""
"\\f[B]Backward Compatibility:\\f[R] Supports simple package lists without "
"conditions\\fR"
msgstr ""
"\\f[B]Compatibilidad con versiones anteriores:\\f[R] Permite listas simples "
"de paquetes sin condiciones\\fR"

#. type: TP
#: condinapt.1:51
#, no-wrap
msgid "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:54
msgid "(Required) Path to the package list file"
msgstr "(Obligatorio) Ruta al archivo de la lista de paquetes"

#. type: TP
#: condinapt.1:54
#, no-wrap
msgid "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:57
msgid "(Required) Path to the main configuration file"
msgstr "(Obligatorio) Ruta al archivo principal de configuración"

#. type: TP
#: condinapt.1:57
#, no-wrap
msgid "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:60
msgid "(Optional) Path to the filter mapping file"
msgstr "(Opcional) Ruta al archivo de mapeo de filtros"

#. type: TP
#: condinapt.1:60
#, no-wrap
msgid "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:65
msgid ""
"(Optional) Path to a priority filter file.  File contains regex patterns to "
"match packages.  Matched packages are moved to priority queue (preserving "
"filters)"
msgstr ""
"(Opcional) Ruta a un archivo de filtro de prioridad. El archivo contiene "
"patrones regex para coincidir con paquetes. Los paquetes coincidentes se "
"mueven a la cola de prioridad (manteniendo los filtros)"

#. type: TP
#: condinapt.1:65
#, no-wrap
msgid "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"
msgstr "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"

#. type: Plain text
#: condinapt.1:69
msgid "Simulation mode.  Packages will not be installed"
msgstr "Modo simulación.  No se instalarán paquetes"

#. type: TP
#: condinapt.1:69
#, no-wrap
msgid "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"
msgstr "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"

#. type: Plain text
#: condinapt.1:74
msgid ""
"Only check if packages are already installed.  Returns exit code 1 if there "
"are uninstalled packages.  At the end, outputs a command to install missing "
"packages"
msgstr ""
"Solo verifica si los paquetes ya están instalados. Devuelve el código de "
"salida 1 si hay paquetes sin instalar. Al final, muestra un comando para "
"instalar los paquetes que faltan"

#. type: TP
#: condinapt.1:74
#, no-wrap
msgid "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"
msgstr "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"

#. type: Plain text
#: condinapt.1:77
msgid "Verbose output"
msgstr "Salida detallada"

#. type: TP
#: condinapt.1:77
#, no-wrap
msgid "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"
msgstr "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"

#. type: Plain text
#: condinapt.1:80
msgid "Very verbose output"
msgstr "Salida muy detallada"

#. type: TP
#: condinapt.1:80
#, no-wrap
msgid "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"
msgstr "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"

#. type: Plain text
#: condinapt.1:83
msgid "Enable \\f[B]set -x\\f[R] command tracing\\fR"
msgstr "Habilita el rastreo de comandos \\f[B]set -x\\f[R]\\fR"

#. type: TP
#: condinapt.1:83
#, no-wrap
msgid "\\f[B]-f\\f[R], \\f[B]--force\\fR"
msgstr "\\f[B]-f\\f[R], \\f[B]--force\\fR"

#. type: Plain text
#: condinapt.1:88
msgid ""
"Force package lists update before installation.  By default, update is "
"skipped if \\f[B]/var/cache/apt/pkgcache.bin\\f[R] exists\\fR"
msgstr ""
"Forzar la actualización de las listas de paquetes antes de la instalación. "
"Por defecto, la actualización se omite si \\f[B]/var/cache/apt/"
"pkgcache.bin\\f[R] existe\\fR"

#. type: TP
#: condinapt.1:88
#, no-wrap
msgid "\\f[B]-h\\f[R], \\f[B]--help\\fR"
msgstr "\\f[B]-h\\f[R], \\f[B]--help\\fR"

#. type: Plain text
#: condinapt.1:91
msgid "Show help"
msgstr "Mostrar ayuda"

#. type: SH
#: condinapt.1:91
#, no-wrap
msgid "CORE COMPONENTS"
msgstr "COMPONENTES PRINCIPALES"

#. type: Plain text
#: condinapt.1:93
msgid "CondinAPT operates with four key files:"
msgstr "CondinAPT opera con cuatro archivos clave:"

#. type: SS
#: condinapt.1:93
#, no-wrap
msgid "condinapt script"
msgstr "script condinapt"

#. type: Plain text
#: condinapt.1:95
msgid "The core, containing all processing logic"
msgstr "El núcleo, contiene toda la lógica de procesamiento"

#. type: SS
#: condinapt.1:95
#, no-wrap
msgid "Main configuration file (-c)"
msgstr "Archivo principal de configuración (-c)"

#. type: Plain text
#: condinapt.1:97
msgid "A file with bash variables describing the current environment"
msgstr "Un archivo con variables de bash que describen el entorno actual"

#. type: Plain text
#: condinapt.1:99
msgid "Example (\\f[B]system.conf\\f[R]):\\fR"
msgstr "Ejemplo (\\f[B]system.conf\\f[R]):\\fR"

#. type: Plain text
#: condinapt.1:106
#, no-wrap
msgid ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"LOCALE=\\[dq]en_US\\[dq]\n"
"FEATURES=\\[dq]web,database\\[dq]\n"
msgstr ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"LOCALE=\\[dq]en_US\\[dq]\n"
"FEATURES=\\[dq]web,database\\[dq]\n"

#. type: SS
#: condinapt.1:107
#, no-wrap
msgid "Filter mapping file (-m)"
msgstr "Archivo de mapeo de filtros (-m)"

#. type: Plain text
#: condinapt.1:114
msgid ""
"Links short prefixes (used in the package list) to variable names from the "
"main configuration file.  This file is \\f[B]optional\\f[R].  If a filter is "
"not present in the filter mapping file, it will be used as a variable name "
"from the main configuration file.  If the variable is not found, CondinAPT "
"will declare it empty.\\fR"
msgstr ""
"Vincula prefijos cortos (usados en la lista de paquetes) con nombres de "
"variables del archivo principal de configuración.  Este archivo es "
"\\f[B]opcional\\f[R].  Si un filtro no está presente en el archivo de mapeo "
"de filtros, se usará como nombre de variable del archivo principal de "
"configuración.  Si la variable no se encuentra, CondinAPT la declarará vacía."
"\\fR"

#. type: Plain text
#: condinapt.1:116
msgid "Example (\\f[B]filters.map\\f[R]):\\fR"
msgstr "Ejemplo (\\f[B]filters.map\\f[R]):\\fR"

#. type: Plain text
#: condinapt.1:123
#, no-wrap
msgid ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"arch=ARCHITECTURE\n"
"feat=FEATURES\n"
msgstr ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"arch=ARCHITECTURE\n"
"feat=FEATURES\n"

#. type: SS
#: condinapt.1:124
#, no-wrap
msgid "Package list file (-l)"
msgstr "Archivo de lista de paquetes (-l)"

#. type: Plain text
#: condinapt.1:126
msgid "The main file describing what to install and under what conditions"
msgstr "El archivo principal que describe qué instalar y bajo qué condiciones"

#. type: SH
#: condinapt.1:126
#, no-wrap
msgid "PACKAGE LIST SYNTAX"
msgstr "SINTAXIS DE LA LISTA DE PAQUETES"

#. type: Plain text
#: condinapt.1:128
msgid "Each line in the package list file consists of two main parts:"
msgstr ""
"Cada línea en el archivo de lista de paquetes consta de dos partes "
"principales:"

#. type: IP
#: condinapt.1:128
#, no-wrap
msgid "1."
msgstr "1."

#. type: Plain text
#: condinapt.1:130
msgid "Package name with optional version and release specification"
msgstr ""
"Nombre del paquete con versión y especificación de lanzamiento opcionales"

#. type: IP
#: condinapt.1:130 condinapt.1:406
#, no-wrap
msgid "2."
msgstr "2."

#. type: Plain text
#: condinapt.1:133
msgid ""
"Condition filters - define the conditions under which the package will be "
"installed"
msgstr ""
"Filtros de condición: definen bajo qué condiciones se instalará el paquete"

#. type: SS
#: condinapt.1:133
#, no-wrap
msgid "Package Name Structure"
msgstr "Estructura del nombre del paquete"

#. type: Plain text
#: condinapt.1:135
msgid "\\f[B]Simple name:\\fR"
msgstr "\\f[B]Nombre simple:\\fR"

#. type: Plain text
#: condinapt.1:138
#, no-wrap
msgid "vim\n"
msgstr "vim\n"

#. type: Plain text
#: condinapt.1:141
msgid "\\f[B]Package version:\\fR"
msgstr "\\f[B]Versión del paquete:\\fR"

#. type: Plain text
#: condinapt.1:145
msgid ""
"\\f[B]package=version\\f[R] - loose version requirement.  If the required "
"version is unavailable, an available version is installed\\fR"
msgstr ""
"\\f[B]package=version\\f[R] - requisito de versión flexible.  Si la versión "
"requerida no está disponible, se instalará una versión disponible\\fR"

#. type: Plain text
#: condinapt.1:148
msgid ""
"\\f[B]package==version\\f[R] - strict requirement.  If the version is not "
"found, installation aborts with an error\\fR"
msgstr ""
"\\f[B]package==version\\f[R] - requisito estricto.  Si no se encuentra la "
"versión, la instalación aborta con un error\\fR"

#. type: Plain text
#: condinapt.1:150
msgid "\\f[B]Release specification:\\fR"
msgstr "\\f[B]Especificación de versión:\\fR"

#. type: Plain text
#: condinapt.1:152
msgid "The release is specified using the **\\[at]** symbol:"
msgstr "La versión se especifica utilizando el símbolo **\\[at]**:"

#. type: Plain text
#: condinapt.1:156
#, no-wrap
msgid ""
"telegram\\[at]bookworm-backports\n"
"kernel-image-6.5.0\\[at]trixie-backports\n"
msgstr ""
"telegram\\[at]bookworm-backports\n"
"kernel-image-6.5.0\\[at]trixie-backports\n"

#. type: SS
#: condinapt.1:157
#, no-wrap
msgid "File Structure"
msgstr "Estructura de archivos"

#. type: Plain text
#: condinapt.1:161
msgid ""
"\\f[B]Package names:\\f[R] Each package or condition is written on a new "
"line\\fR"
msgstr ""
"\\f[B]Nombres de paquetes:\\f[R] Cada paquete o condición se escribe en una "
"nueva línea\\fR"

#. type: Plain text
#: condinapt.1:164
msgid ""
"\\f[B]Comments:\\f[R] Lines starting with \\f[B]#\\f[R], or text after "
"\\f[B]#\\f[R] on a line, are completely ignored\\fR"
msgstr ""
"\\f[B]Comentarios:\\f[R] Las líneas que comienzan con \\f[B]#\\f[R], o el "
"texto después de \\f[B]#\\f[R] en una línea, se ignoran completamente\\fR"

#. type: Plain text
#: condinapt.1:166
msgid "\\f[B]Empty lines:\\f[R] Ignored and serve for visual separation\\fR"
msgstr ""
"\\f[B]Líneas vacías:\\f[R] Se ignoran y sirven para la separación visual\\fR"

#. type: SS
#: condinapt.1:166
#, no-wrap
msgid "Filters and Conditions"
msgstr "Filtros y condiciones"

#. type: SS
#: condinapt.1:167
#, no-wrap
msgid "Single Filters"
msgstr "Filtros individuales"

#. type: Plain text
#: condinapt.1:170
msgid ""
"\\f[B]+ (Positive):\\f[R] The condition is true if the variable value "
"\\f[B]matches\\fR"
msgstr ""
"\\f[B]+ (Positivo):\\f[R] La condición se cumple si el valor de la variable "
"\\f[B]coincide\\fR"

#. type: Plain text
#: condinapt.1:172
msgid "Format: \\f[B]+=\\fR"
msgstr "Formato: \\f[B]+=\\fR"

#. type: Plain text
#: condinapt.1:174 condinapt.1:185 condinapt.1:254
msgid "Example:"
msgstr "Ejemplo:"

#. type: Plain text
#: condinapt.1:177
#, no-wrap
msgid "nginx +st=server\n"
msgstr "nginx +st=server\n"

#. type: Plain text
#: condinapt.1:181
msgid ""
"\\f[B]- (Negative):\\f[R] The condition is true if the variable value "
"\\f[B]does not match\\fR"
msgstr ""
"\\f[B]- (Negativo):\\f[R] La condición se cumple si el valor de la variable "
"\\f[B]no coincide\\fR"

#. type: Plain text
#: condinapt.1:183
msgid "Format: \\f[B]-=\\fR"
msgstr "Formato: \\f[B]-=\\fR"

#. type: Plain text
#: condinapt.1:188
#, no-wrap
msgid "monitoring-tools -st=desktop\n"
msgstr "monitoring-tools -st=desktop\n"

#. type: SS
#: condinapt.1:189
#, no-wrap
msgid "Group Filters"
msgstr "Filtros de grupo"

#. type: Plain text
#: condinapt.1:192
msgid ""
"\\f[B]+{a|b} (OR for inclusion):\\f[R] True if \\f[B]at least one\\f[R] of "
"the conditions in the group is true\\fR"
msgstr ""
"\\f[B]+{a|b} (OR para inclusión):\\f[R] Verdadero si \\f[B]al menos "
"una\\f[R] de las condiciones del grupo se cumple\\fR"

#. type: Plain text
#: condinapt.1:195
#, no-wrap
msgid "web-server +{st=server|st=web-server}\n"
msgstr "web-server +{st=server|st=web-server}\n"

#. type: Plain text
#: condinapt.1:199
msgid ""
"\\f[B]+{a&b} (AND for inclusion):\\f[R] True only if \\f[B]all\\f[R] "
"conditions in the group are true\\fR"
msgstr ""
"\\f[B]+{a&b} (AND para inclusión):\\f[R] Verdadero solo si \\f[B]todas\\f[R] "
"las condiciones del grupo se cumplen\\fR"

#. type: Plain text
#: condinapt.1:202
#, no-wrap
msgid "database-tools +{d=bookworm&st=server}\n"
msgstr "database-tools +{d=bookworm&st=server}\n"

#. type: Plain text
#: condinapt.1:206
msgid ""
"\\f[B]-{a|b} (OR for exclusion):\\f[R] The package is excluded if \\f[B]at "
"least one\\f[R] of the conditions is true\\fR"
msgstr ""
"\\f[B]-{a|b} (OR para exclusión):\\f[R] El paquete se excluye si \\f[B]al "
"menos una\\f[R] de las condiciones se cumple\\fR"

#. type: Plain text
#: condinapt.1:209
#, no-wrap
msgid "debug-tools -{env=production|st=minimal}\n"
msgstr "debug-tools -{env=production|st=minimal}\n"

#. type: Plain text
#: condinapt.1:213
msgid ""
"\\f[B]-{a&b} (AND for exclusion):\\f[R] The package is excluded only if "
"\\f[B]all\\f[R] conditions are true\\fR"
msgstr ""
"\\f[B]-{a&b} (AND para exclusión):\\f[R] El paquete se excluye solo si "
"\\f[B]todas\\f[R] las condiciones se cumplen\\fR"

#. type: Plain text
#: condinapt.1:216
#, no-wrap
msgid "development-tools -{env=production&st=minimal}\n"
msgstr "development-tools -{env=production&st=minimal}\n"

#. type: SS
#: condinapt.1:217
#, no-wrap
msgid "Logical Operators"
msgstr "Operadores lógicos"

#. type: Plain text
#: condinapt.1:220
msgid ""
"\\f[B]|| (OR / Fallback):\\f[R] Try to install the left part.  If it fails, "
"try the right part\\fR"
msgstr ""
"\\f[B]|| (OR / Alternativa):\\f[R] Intenta instalar la parte izquierda. Si "
"falla, se intenta la parte derecha\\fR"

#. type: Plain text
#: condinapt.1:223
#, no-wrap
msgid "exfatprogs -d=bookworm || exfat-utils\n"
msgstr "exfatprogs -d=bookworm || exfat-utils\n"

#. type: Plain text
#: condinapt.1:227
msgid ""
"\\f[B]&& (AND / Conjunction):\\f[R] All parts must successfully pass filter "
"checks\\fR"
msgstr ""
"\\f[B]&& (AND / Conjunción):\\f[R] Todas las partes deben superar "
"exitosamente las comprobaciones de filtros\\fR"

#. type: Plain text
#: condinapt.1:230
#, no-wrap
msgid "nginx +st=web-server && php-fpm\n"
msgstr "nginx +st=web-server && php-fpm\n"

#. type: SS
#: condinapt.1:231
#, no-wrap
msgid "Special Modifiers"
msgstr "Modificadores especiales"

#. type: Plain text
#: condinapt.1:236
msgid ""
"\\f[B]! (Mandatory Package):\\f[R] If a package is marked with \\f[B]!"
"\\f[R], but cannot be found in repositories, CondinAPT will abort execution "
"with an error\\fR"
msgstr ""
"\\f[B]! (Paquete obligatorio):\\f[R] Si un paquete está marcado con \\f[B]!"
"\\f[R], pero no se encuentra en los repositorios, CondinAPT abortará la "
"ejecución con un error\\fR"

#. type: Plain text
#: condinapt.1:239
#, no-wrap
msgid "!essential-package\n"
msgstr "!essential-package\n"

#. type: Plain text
#: condinapt.1:243
msgid ""
"\\f[B]\\[at] (Release Specification):\\f[R] Install a package from a "
"specific Debian/Ubuntu release\\fR"
msgstr ""
"\\f[B]\\[at] (Especificación de versión):\\f[R] Instala un paquete desde una "
"versión específica de Debian/Ubuntu\\fR"

#. type: Plain text
#: condinapt.1:246
#, no-wrap
msgid "kernel-image-6.5.0 \\[at]trixie-backports\n"
msgstr "kernel-image-6.5.0 \\[at]trixie-backports\n"

#. type: SS
#: condinapt.1:247
#, no-wrap
msgid "Installation Queues"
msgstr "Colas de instalación"

#. type: Plain text
#: condinapt.1:252
msgid ""
"The \\f[B]\\[em]\\f[R] separator on a separate line divides the list into "
"groups (queues).  Packages from one queue are installed together in a single "
"apt call.  Queues are executed strictly sequentially.\\fR"
msgstr ""
"El separador \\f[B]\\[em]\\f[R] en una línea separada divide la lista en "
"grupos (colas). Los paquetes de una cola se instalan juntos en una sola "
"llamada a apt. Las colas se ejecutan estrictamente de forma secuencial.\\fR"

#. type: Plain text
#: condinapt.1:266
#, no-wrap
msgid ""
"# Queue 1: Base system\n"
"systemd\n"
"network-manager\n"
"---\n"
"# Queue 2: Web server\n"
"nginx\n"
"php-fpm\n"
"---\n"
"# Queue 3: Monitoring\n"
"prometheus\n"
msgstr ""
"# Cola 1: Sistema base\n"
"systemd\n"
"network-manager\n"
"---\n"
"# Cola 2: Servidor web\n"
"nginx\n"
"php-fpm\n"
"---\n"
"# Cola 3: Monitorización\n"
"prometheus\n"

#. type: SS
#: condinapt.1:267
#, no-wrap
msgid "Priority Queue"
msgstr "Cola prioritaria"

#. type: Plain text
#: condinapt.1:273
msgid ""
"The file specified by the \\f[B]-P\\f[R] flag contains regex patterns (one "
"pattern per line, no filters).  CondinAPT scans all queues, finds packages "
"matching these patterns, and moves them (with all their filters and "
"conditions) to a special \\[lq]Priority Queue\\[rq], which is executed first."
"\\fR"
msgstr ""
"El archivo especificado por la opción \\f[B]-P\\f[R] contiene patrones regex "
"(un patrón por línea, sin filtros). CondinAPT escanea todas las colas, "
"encuentra los paquetes que coinciden con estos patrones y los mueve (junto "
"con todos sus filtros y condiciones) a una \\[lq]Cola de Prioridad\\[rq] "
"especial, que se ejecuta primero.\\fR"

#. type: Plain text
#: condinapt.1:276
msgid ""
"\\f[B]Pattern Matching:\\f[R] Uses bash regex matching (=\\[ti] operator).  "
"Patterns can be simple package names or complex regex expressions.\\fR"
msgstr ""
"\\f[B]Coincidencia de patrones:\\f[R] Utiliza coincidencia regex de bash "
"(operador =\\[ti]). Los patrones pueden ser nombres de paquetes simples o "
"expresiones regex complejas.\\fR"

#. type: Plain text
#: condinapt.1:280
msgid ""
"\\f[B]Preserving Context:\\f[R] This mechanism preserves all package "
"conditions, filters, and release specifications from the original package "
"list.\\fR"
msgstr ""
"\\f[B]Preservación de contexto:\\f[R] Este mecanismo conserva todas las "
"condiciones, filtros y especificaciones de versión de los paquetes de la "
"lista original.\\fR"

#. type: Plain text
#: condinapt.1:285
msgid ""
"\\f[B]Override:\\f[R] Matched packages are automatically removed from their "
"original queues (both regular and target queues with \\f[B]\\"
"[at]release\\f[R]) and moved to priority queues.  Target releases are "
"preserved in separate priority target queues.\\fR"
msgstr ""
"\\f[B]Sobrescritura:\\f[R] Los paquetes coincidentes se eliminan "
"automáticamente de sus colas originales (tanto colas regulares como de "
"destino con \\f[B]\\[at]release\\f[R]) y se mueven a las colas de prioridad. "
"Las versiones de destino se conservan en colas de prioridad separadas para "
"versiones objetivo.\\fR"

#. type: Plain text
#: condinapt.1:287
msgid "Example \\f[B]priority.list\\f[R]:\\fR"
msgstr "Ejemplo de \\f[B]priority.list\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:292
#, no-wrap
msgid ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"
msgstr ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"

#. type: SS
#: condinapt.1:294
#, no-wrap
msgid "Quick Start"
msgstr "Inicio rápido"

#. type: Plain text
#: condinapt.1:296
msgid "Create the configuration file \\f[B]config.conf\\f[R]:\\fR"
msgstr "Cree el archivo de configuración \\f[B]config.conf\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:301
#, no-wrap
msgid ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
msgstr ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"

#. type: Plain text
#: condinapt.1:304
msgid "Create the package list \\f[B]packages.list\\f[R]:\\fR"
msgstr "Cree la lista de paquetes \\f[B]packages.list\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:309
#, no-wrap
msgid ""
"# Base packages - always installed\n"
"vim\n"
"curl\n"
msgstr ""
"# Paquetes base - siempre instalados\n"
"vim\n"
"curl\n"

#. type: Plain text
#: condinapt.1:313
#, no-wrap
msgid ""
"# Packages only for servers\n"
"nginx +SYSTEM_TYPE=server\n"
"mysql-server +SYSTEM_TYPE=server\n"
msgstr ""
"# Paquetes solo para servidores\n"
"nginx +SYSTEM_TYPE=server\n"
"mysql-server +SYSTEM_TYPE=server\n"

#. type: Plain text
#: condinapt.1:316
#, no-wrap
msgid ""
"# Exclude packages for production environment\n"
"debug-tools -ENVIRONMENT=production\n"
msgstr ""
"# Excluir paquetes para entorno de producción\n"
"debug-tools -ENVIRONMENT=production\n"

#. type: Plain text
#: condinapt.1:319
msgid "Run the installation:"
msgstr "Ejecute la instalación:"

#. type: Plain text
#: condinapt.1:322
#, no-wrap
msgid "condinapt -l packages.list -c config.conf\n"
msgstr "condinapt -l packages.list -c config.conf\n"

#. type: Plain text
#: condinapt.1:325
msgid "Or test in simulation mode:"
msgstr "O pruebe en modo simulación:"

#. type: Plain text
#: condinapt.1:328
#, no-wrap
msgid "condinapt -l packages.list -c config.conf -s\n"
msgstr "condinapt -l packages.list -c config.conf -s\n"

#. type: SS
#: condinapt.1:329
#, no-wrap
msgid "Multimedia Server"
msgstr "Servidor multimedia"

#. type: Plain text
#: condinapt.1:331 condinapt.1:350 condinapt-minios.7:124
#: condinapt-minios.7:144 condinapt-minios.7:162 condinapt-minios.7:186
msgid "\\f[B]packages.list:\\fR"
msgstr "\\f[B]packages.list:\\fR"

#. type: Plain text
#: condinapt.1:336 condinapt-minios.7:129
#, no-wrap
msgid ""
"# Basic multimedia codecs - always\n"
"gstreamer1.0-plugins-base\n"
"gstreamer1.0-plugins-good\n"
msgstr ""
"# Códecs multimedia básicos - siempre\n"
"gstreamer1.0-plugins-base\n"
"gstreamer1.0-plugins-good\n"

#. type: Plain text
#: condinapt.1:340
#, no-wrap
msgid ""
"# Additional codecs - not for minimal installation\n"
"gstreamer1.0-plugins-bad -st=minimal\n"
"gstreamer1.0-plugins-ugly -st=minimal\n"
msgstr ""
"# Códecs adicionales - no para instalaciones mínimas\n"
"gstreamer1.0-plugins-bad -st=minimal\n"
"gstreamer1.0-plugins-ugly -st=minimal\n"

#. type: Plain text
#: condinapt.1:347
#, no-wrap
msgid ""
"# Professional tools - only for full configuration\n"
"ffmpeg +st=media-server\n"
"vlc +st=media-server\n"
"---\n"
"# Distribution-specific packages from backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"
msgstr ""
"# Herramientas profesionales - solo para configuración completa\n"
"ffmpeg +st=media-server\n"
"vlc +st=media-server\n"
"---\n"
"# Paquetes específicos de la distribución desde backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"

#. type: SS
#: condinapt.1:348
#, no-wrap
msgid "Web Server with Various Configurations"
msgstr "Servidor web con varias configuraciones"

#. type: Plain text
#: condinapt.1:355
#, no-wrap
msgid ""
"# Basic web server components\n"
"nginx\n"
"openssl\n"
msgstr ""
"# Componentes básicos de servidor web\n"
"nginx\n"
"openssl\n"

#. type: Plain text
#: condinapt.1:359
#, no-wrap
msgid ""
"# Database - only for full installations\n"
"mysql-server +st=full-server -{env=minimal}\n"
"postgresql +st=database-server\n"
msgstr ""
"# Base de datos - solo para instalaciones completas\n"
"mysql-server +st=full-server -{env=minimal}\n"
"postgresql +st=database-server\n"

#. type: Plain text
#: condinapt.1:363
#, no-wrap
msgid ""
"# PHP - for web servers\n"
"php-fpm +feat=php\n"
"php-mysql +{feat=php&st=full-server}\n"
msgstr ""
"# PHP - para servidores web\n"
"php-fpm +feat=php\n"
"php-mysql +{feat=php&st=full-server}\n"

#. type: Plain text
#: condinapt.1:366
#, no-wrap
msgid ""
"# Monitoring - not for development\n"
"prometheus-node-exporter -env=development\n"
msgstr ""
"# Monitorización - no para desarrollo\n"
"prometheus-node-exporter -env=development\n"

#. type: SH
#: condinapt.1:367
#, no-wrap
msgid "OPERATING MODES"
msgstr "MODOS DE OPERACIÓN"

#. type: SS
#: condinapt.1:368
#, no-wrap
msgid "Simulation Mode"
msgstr "Modo simulación"

#. type: Plain text
#: condinapt.1:371
msgid ""
"Allows you to see which packages will be installed without actually "
"installing them:"
msgstr "Permite ver qué paquetes se instalarán sin instalarlos realmente:"

#. type: Plain text
#: condinapt.1:374
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -s\n"
msgstr "condinapt -l packages.list -c system.conf -s\n"

#. type: Plain text
#: condinapt.1:377
msgid "In simulation mode, the script exits with exit code 1."
msgstr "En modo simulación, el script termina con código de salida 1."

#. type: SS
#: condinapt.1:377
#, no-wrap
msgid "Check Mode"
msgstr "Modo comprobación"

#. type: Plain text
#: condinapt.1:379
msgid ""
"Checks which packages from the list are already installed on the system:"
msgstr "Verifica qué paquetes de la lista ya están instalados en el sistema:"

#. type: Plain text
#: condinapt.1:382
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -C\n"
msgstr "condinapt -l packages.list -c system.conf -C\n"

#. type: Plain text
#: condinapt.1:386
msgid ""
"Shows errors for uninstalled packages and returns exit code 1 if there are "
"uninstalled packages."
msgstr ""
"Muestra errores para los paquetes no instalados y devuelve código de salida "
"1 si hay paquetes sin instalar."

#. type: SS
#: condinapt.1:386
#, no-wrap
msgid "Debugging Modes"
msgstr "Modos de depuración"

#. type: Plain text
#: condinapt.1:388
msgid "\\f[B]Verbose Output (-v):\\fR"
msgstr "\\f[B]Salida detallada (-v):\\fR"

#. type: Plain text
#: condinapt.1:391
msgid ""
"Shows detailed information about filter checks and displays results for each "
"package."
msgstr ""
"Muestra información detallada sobre las comprobaciones de filtros y presenta "
"resultados para cada paquete."

#. type: Plain text
#: condinapt.1:393
msgid "\\f[B]Very Verbose Output (-vv):\\fR"
msgstr "\\f[B]Salida muy detallada (-vv):\\fR"

#. type: Plain text
#: condinapt.1:395
msgid "Maximum process detail, shows all intermediate steps."
msgstr "Detalle máximo del proceso, muestra todos los pasos intermedios."

#. type: Plain text
#: condinapt.1:397
msgid "\\f[B]Command Tracing (-x):\\fR"
msgstr "\\f[B]Trazado de comandos (-x):\\fR"

#. type: Plain text
#: condinapt.1:400
msgid ""
"Enables \\f[B]set -x\\f[R] for script debugging, shows each command being "
"executed.\\fR"
msgstr ""
"Activa \\f[B]set -x\\f[R] para depuración del script, mostrando cada comando "
"que se ejecuta.\\fR"

#. type: SH
#: condinapt.1:400
#, no-wrap
msgid "ERROR HANDLING"
msgstr "GESTIÓN DE ERRORES"

#. type: SS
#: condinapt.1:401
#, no-wrap
msgid "Mandatory Packages"
msgstr "Paquetes obligatorios"

#. type: Plain text
#: condinapt.1:404
msgid ""
"If a package is marked as mandatory (\\f[B]!\\f[R]) but not found in "
"repositories, CondinAPT:\\fR"
msgstr ""
"Si un paquete está marcado como obligatorio (\\f[B]!\\f[R]) pero no se "
"encuentra en los repositorios, CondinAPT:\\fR"

#. type: IP
#: condinapt.1:404
#, no-wrap
msgid "\\f[R]1.\\fR"
msgstr "\\f[R]1.\\fR"

#. type: Plain text
#: condinapt.1:406
msgid "Outputs an error message"
msgstr "Muestra un mensaje de error"

#. type: Plain text
#: condinapt.1:408
msgid "Aborts execution (unless in simulation mode)"
msgstr "Aborta la ejecución (a menos que esté en modo simulación)"

#. type: IP
#: condinapt.1:408
#, no-wrap
msgid "3."
msgstr "3."

#. type: Plain text
#: condinapt.1:410
msgid "Returns exit code 1"
msgstr "Devuelve el código de salida 1"

#. type: SS
#: condinapt.1:410
#, no-wrap
msgid "Handling Unavailable Versions"
msgstr "Gestión de versiones no disponibles"

#. type: Plain text
#: condinapt.1:412
msgid "\\f[B]Loose Versions (=):\\fR"
msgstr "\\f[B]Versiones flexibles (=):\\fR"

#. type: Plain text
#: condinapt.1:415
msgid ""
"If the exact version is unavailable, any available version is installed with "
"a warning."
msgstr ""
"Si la versión exacta no está disponible, se instala cualquier versión "
"disponible y se muestra una advertencia."

#. type: Plain text
#: condinapt.1:417
msgid "\\f[B]Strict Versions (==):\\fR"
msgstr "\\f[B]Versiones estrictas (==):\\fR"

#. type: Plain text
#: condinapt.1:420
msgid ""
"If the exact version is unavailable, the package is skipped.  If the package "
"is mandatory (\\f[B]!\\f[R]), execution aborts.\\fR"
msgstr ""
"Si la versión exacta no está disponible, el paquete se omite. Si el paquete "
"es obligatorio (\\f[B]!\\f[R]), la ejecución se aborta.\\fR"

#. type: SS
#: condinapt.1:420
#, no-wrap
msgid "Version Holding"
msgstr "Retención de versiones"

#. type: Plain text
#: condinapt.1:423
msgid ""
"CondinAPT automatically applies \\f[B]apt-mark hold\\f[R] when the exactly "
"requested version was installed, preventing automatic updates.\\fR"
msgstr ""
"CondinAPT aplica automáticamente \\f[B]apt-mark hold\\f[R] cuando se instala "
"exactamente la versión solicitada, evitando actualizaciones automáticas.\\fR"

#. type: SH
#: condinapt.1:423 condinapt-minios.7:261
#, no-wrap
msgid "FILES"
msgstr "ARCHIVOS"

#. type: TP
#: condinapt.1:424
#, no-wrap
msgid "\\f[B]/etc/condinapt/config.conf\\fR"
msgstr "\\f[B]/etc/condinapt/config.conf\\fR"

#. type: Plain text
#: condinapt.1:427
msgid "Default configuration file"
msgstr "Archivo de configuración predeterminado"

#. type: TP
#: condinapt.1:427
#, no-wrap
msgid "\\f[B]/etc/condinapt/filters.map\\fR"
msgstr "\\f[B]/etc/condinapt/filters.map\\fR"

#. type: Plain text
#: condinapt.1:430
msgid "Default filter mapping file"
msgstr "Archivo de mapeo de filtros predeterminado"

#. type: Plain text
#: condinapt.1:433
msgid ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
msgstr ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
