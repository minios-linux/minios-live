#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "CONDINAPT"
msgstr "CONDINAPT"

#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "Conditional APT Package Installer"
msgstr "Instalador condicional de paquetes APT"

#. type: Plain text
#: condinapt.1:7
msgid ""
"condinapt - plan and install APT packages from a conditional package list"
msgstr ""
"condinapt - planifica e instala paquetes APT a partir de una lista "
"condicional de paquetes"

#. type: Plain text
#: condinapt.1:10
msgid ""
"\\f[B]condinapt\\f[R] \\f[B]-l\\f[R] \\f[I]PACKAGE-LIST\\f[R] \\f[B]-c\\f[R] "
"\\f[I]CONFIG\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"
msgstr ""
"\\f[B]condinapt\\f[R] \\f[B]-l\\f[R] \\f[I]PACKAGE-LIST\\f[R] \\f[B]-c\\f[R] "
"\\f[I]CONFIG\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"

#. type: Plain text
#: condinapt.1:17
msgid ""
"\\f[B]condinapt\\f[R] reads a Bash configuration and a package list, "
"evaluates package filters, checks package availability, groups selected "
"packages into APT transactions, and installs them.  It supports exact or "
"fallback versions, target releases, alternatives, conjunctions, mandatory "
"alternatives, queue separators, and a priority list.\\fR"
msgstr ""
"\\f[B]condinapt\\f[R] lee una configuración Bash y una lista de paquetes, "
"evalúa los filtros de paquetes, comprueba la disponibilidad, agrupa los "
"paquetes seleccionados en transacciones APT y los instala.  Soporta "
"versiones exactas o de respaldo, lanzamientos objetivo, alternativas, "
"conjunciones, alternativas obligatorias, separadores de cola y una lista de "
"prioridades.\\fR"

#. type: Plain text
#: condinapt.1:21
msgid ""
"The configuration file is sourced as Bash and must be trusted.  Package "
"installation and any APT list refresh normally require suitable privileges."
msgstr ""
"El archivo de configuración se interpreta como Bash y debe ser confiable.  "
"La instalación de paquetes y cualquier actualización de la lista de APT "
"normalmente requieren privilegios adecuados."

#. type: TP
#: condinapt.1:22
#, no-wrap
msgid "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:25
msgid "Required package list."
msgstr "Lista de paquetes obligatoria."

#. type: TP
#: condinapt.1:25
#, no-wrap
msgid "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:28
msgid "Required Bash configuration file containing filter variables."
msgstr ""
"Archivo de configuración Bash obligatorio que contiene las variables de "
"filtro."

#. type: TP
#: condinapt.1:28
#, no-wrap
msgid "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:32
msgid ""
"Optional prefix-to-variable mapping.  Without it, filter prefixes are "
"interpreted directly as variable names."
msgstr ""
"Asignación opcional de prefijos a variables.  Sin ella, los prefijos de "
"filtro se interpretan directamente como nombres de variables."

#. type: TP
#: condinapt.1:32
#, no-wrap
msgid "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:38
msgid ""
"Optional file containing one Bash regular expression per line.  Expressions "
"match the first package token on each package-list line.  Matching lines are "
"moved to priority queues with their filters and target releases preserved."
msgstr ""
"Archivo opcional que contiene una expresión regular de Bash por línea.  Las "
"expresiones coinciden con el primer token de paquete en cada línea de la "
"lista de paquetes.  Las líneas coincidentes se mueven a colas de prioridad, "
"conservando sus filtros y lanzamientos objetivo."

#. type: TP
#: condinapt.1:38
#, no-wrap
msgid "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"
msgstr "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"

#. type: Plain text
#: condinapt.1:48
msgid ""
"Evaluate filters and report relevant package names that are not installed.  "
"Return 1 and print a suggested \\f[B]apt install\\f[R] command when packages "
"are missing.  This mode checks package names only; it does not validate "
"requested versions or target releases.  An alternative expression is "
"satisfied when one branch is installed; if none is installed, every failed "
"branch may be reported and suggested.\\fR"
msgstr ""
"Evalúa los filtros e informa los nombres de paquetes relevantes que no están "
"instalados.  Devuelve 1 e imprime un comando sugerido \\f[B]apt "
"install\\f[R] cuando faltan paquetes.  Este modo solo comprueba nombres de "
"paquetes; no valida versiones solicitadas ni lanzamientos objetivo.  Una "
"expresión alternativa se considera satisfecha cuando una rama está "
"instalada; si ninguna lo está, cada rama fallida puede ser informada y "
"sugerida.\\fR"

#. type: TP
#: condinapt.1:48
#, no-wrap
msgid "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"
msgstr "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"

#. type: Plain text
#: condinapt.1:54
msgid ""
"Plan the installation without installing packages.  Simulation always exits "
"with status 1.  It may still run \\f[B]apt-get update\\f[R] when the package "
"cache is absent or \\f[B]--force\\f[R] is used.\\fR"
msgstr ""
"Planifica la instalación sin instalar paquetes.  La simulación siempre "
"termina con estado 1.  Aun así, puede ejecutar \\f[B]apt-get update\\f[R] "
"cuando la caché de paquetes no existe o se usa \\f[B]--force\\f[R].\\fR"

#. type: TP
#: condinapt.1:54
#, no-wrap
msgid "\\f[B]-f\\f[R], \\f[B]--force\\fR"
msgstr "\\f[B]-f\\f[R], \\f[B]--force\\fR"

#. type: Plain text
#: condinapt.1:59
msgid ""
"Run \\f[B]apt-get update\\f[R] before normal installation or simulation even "
"when \\f[B]/var/cache/apt/pkgcache.bin\\f[R] exists.  It has no effect in "
"check-only mode.\\fR"
msgstr ""
"Ejecuta \\f[B]apt-get update\\f[R] antes de la instalación normal o la "
"simulación incluso cuando existe \\f[B]/var/cache/apt/pkgcache.bin\\f[R].  "
"No tiene efecto en el modo solo comprobación.\\fR"

#. type: TP
#: condinapt.1:59
#, no-wrap
msgid "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"
msgstr "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"

#. type: Plain text
#: condinapt.1:62
msgid "Show filter decisions and direct APT output."
msgstr "Muestra las decisiones de filtro y la salida directa de APT."

#. type: TP
#: condinapt.1:62
#, no-wrap
msgid "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"
msgstr "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"

#. type: Plain text
#: condinapt.1:65
msgid "Show additional planning and priority-queue details."
msgstr ""
"Muestra detalles adicionales de la planificación y de las colas de prioridad."

#. type: TP
#: condinapt.1:65
#, no-wrap
msgid "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"
msgstr "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"

#. type: Plain text
#: condinapt.1:68
msgid "Enable Bash command tracing."
msgstr "Activa el rastreo de comandos Bash."

#. type: TP
#: condinapt.1:68
#, no-wrap
msgid "\\f[B]-h\\f[R], \\f[B]--help\\fR"
msgstr "\\f[B]-h\\f[R], \\f[B]--help\\fR"

#. type: Plain text
#: condinapt.1:71
msgid "Display help and exit."
msgstr "Muestra la ayuda y sale."

#. type: SH
#: condinapt.1:71
#, no-wrap
msgid "INPUT FILES"
msgstr "ARCHIVOS DE ENTRADA"

#. type: SS
#: condinapt.1:72
#, no-wrap
msgid "Configuration"
msgstr "Configuración"

#. type: Plain text
#: condinapt.1:76
msgid ""
"The required configuration is a Bash file.  Scalar values compare by exact "
"string equality.  Indexed Bash arrays match when any element equals the "
"requested value."
msgstr ""
"La configuración requerida es un archivo Bash.  Los valores escalares se "
"comparan por igualdad exacta de cadena.  Los arreglos indexados de Bash "
"coinciden cuando cualquier elemento es igual al valor solicitado."

#. type: Plain text
#: condinapt.1:82
#, no-wrap
msgid ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"FEATURES=(web database)\n"
msgstr ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"FEATURES=(web database)\n"

#. type: SS
#: condinapt.1:83
#, no-wrap
msgid "Filter Mapping"
msgstr "Mapeo de filtros"

#. type: Plain text
#: condinapt.1:86
msgid ""
"An optional mapping assigns short package-list prefixes to configuration "
"variables:"
msgstr ""
"Una asignación opcional asocia prefijos cortos de la lista de paquetes a "
"variables de configuración:"

#. type: Plain text
#: condinapt.1:92
#, no-wrap
msgid ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"feat=FEATURES\n"
msgstr ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"feat=FEATURES\n"

#. type: Plain text
#: condinapt.1:97
msgid ""
"An unmapped prefix is used as the variable name.  Missing variables have an "
"empty value.  Variable names must be valid Bash identifiers."
msgstr ""
"Un prefijo no asignado se utiliza como nombre de variable.  Las variables "
"ausentes tienen valor vacío.  Los nombres de variables deben ser "
"identificadores Bash válidos."

#. type: SS
#: condinapt.1:97
#, no-wrap
msgid "Package List"
msgstr "Lista de paquetes"

#. type: Plain text
#: condinapt.1:100
msgid ""
"Each non-empty, non-comment line contains a package expression.  Text after "
"\\f[B]#\\f[R] is ignored.\\fR"
msgstr ""
"Cada línea no vacía y que no sea un comentario contiene una expresión de "
"paquete.  El texto después de \\f[B]#\\f[R] se ignora.\\fR"

#. type: Plain text
#: condinapt.1:105
#, no-wrap
msgid ""
"vim\n"
"nginx +st=server\n"
"debug-tools -env=production\n"
msgstr ""
"vim\n"
"nginx +st=server\n"
"debug-tools -env=production\n"

#. type: SS
#: condinapt.1:106
#, no-wrap
msgid "Priority List"
msgstr "Lista de prioridades"

#. type: Plain text
#: condinapt.1:110
msgid ""
"Each non-empty, non-comment line is a Bash \\f[B]=\\[ti]\\f[R] regular "
"expression matched against the first package token in a package expression:"
"\\fR"
msgstr ""
"Cada línea no vacía y que no sea un comentario es una expresión regular Bash "
"\\f[B]=\\[ti]\\f[R] que se compara con el primer token de paquete en una "
"expresión de paquete:\\fR"

#. type: Plain text
#: condinapt.1:115
#, no-wrap
msgid ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"
msgstr ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"

#. type: SH
#: condinapt.1:116
#, no-wrap
msgid "PACKAGE SYNTAX"
msgstr "SINTAXIS DE PAQUETES"

#. type: SS
#: condinapt.1:117
#, no-wrap
msgid "Versions"
msgstr "Versiones"

#. type: TP
#: condinapt.1:118
#, no-wrap
msgid "\\f[B]package=version\\fR"
msgstr "\\f[B]package=version\\fR"

#. type: Plain text
#: condinapt.1:123
msgid ""
"Request an exact version.  If it is unavailable but another candidate "
"exists, install the candidate and emit a warning."
msgstr ""
"Solicita una versión exacta.  Si no está disponible pero existe otro "
"candidato, se instala el candidato y se emite una advertencia."

#. type: TP
#: condinapt.1:123
#, no-wrap
msgid "\\f[B]package==version\\fR"
msgstr "\\f[B]package==version\\fR"

#. type: Plain text
#: condinapt.1:127
msgid ""
"Require an exact version during planning.  If it is unavailable, this "
"expression cannot be selected."
msgstr ""
"Requiere una versión exacta durante la planificación.  Si no está "
"disponible, esta expresión no puede ser seleccionada."

#. type: Plain text
#: condinapt.1:130
msgid ""
"When an exact requested version is selected and installed, "
"\\f[B]condinapt\\f[R] applies \\f[B]apt-mark hold\\f[R] to that package.\\fR"
msgstr ""
"Cuando se selecciona e instala una versión exacta solicitada, "
"\\f[B]condinapt\\f[R] aplica \\f[B]apt-mark hold\\f[R] a ese paquete.\\fR"

#. type: SS
#: condinapt.1:130
#, no-wrap
msgid "Target Releases"
msgstr "Lanzamientos objetivo"

#. type: Plain text
#: condinapt.1:133
msgid ""
"Append \\f[B]\\[at]release\\f[R] to install through \\f[B]apt-get -t "
"release\\f[R]:\\fR"
msgstr ""
"Añade \\f[B]\\[at]release\\f[R] para instalar mediante \\f[B]apt-get -t "
"release\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:136
#, no-wrap
msgid "linux-image-amd64 \\[at]bookworm-backports\n"
msgstr "linux-image-amd64 \\[at]bookworm-backports\n"

#. type: Plain text
#: condinapt.1:141
msgid ""
"Entries for the same release are pooled into one release-specific queue.  "
"The \\f[B]\\[em]\\f[R] separator does not split target-release queues.\\fR"
msgstr ""
"Las entradas para el mismo lanzamiento se agrupan en una sola cola "
"específica de ese lanzamiento.  El separador \\f[B]\\[em]\\f[R] no divide "
"las colas de lanzamientos objetivo.\\fR"

#. type: SS
#: condinapt.1:141
#, no-wrap
msgid "Filters"
msgstr "Filtros"

#. type: TP
#: condinapt.1:142
#, no-wrap
msgid "\\f[B]+prefix=value\\fR"
msgstr "\\f[B]+prefijo=valor\\fR"

#. type: Plain text
#: condinapt.1:146
msgid ""
"Include the package when the mapped scalar equals \\f[I]value\\f[R] or an "
"array contains it.\\fR"
msgstr ""
"Incluye el paquete cuando el escalar mapeado es igual a \\f[I]valor\\f[R] o "
"si una matriz lo contiene.\\fR"

#. type: TP
#: condinapt.1:146
#, no-wrap
msgid "\\f[B]-prefix=value\\fR"
msgstr "\\f[B]-prefijo=valor\\fR"

#. type: Plain text
#: condinapt.1:150
msgid ""
"Exclude the package when the mapped scalar equals \\f[I]value\\f[R] or an "
"array contains it.\\fR"
msgstr ""
"Excluye el paquete cuando el escalar mapeado es igual a \\f[I]valor\\f[R] o "
"si una matriz lo contiene.\\fR"

#. type: Plain text
#: condinapt.1:154
msgid ""
"Repeated positive filters with the same prefix are alternatives.  Positive "
"filters with different prefixes must each have at least one match:"
msgstr ""
"Los filtros positivos repetidos con el mismo prefijo son alternativas. Los "
"filtros positivos con diferentes prefijos requieren al menos una "
"coincidencia cada uno:"

#. type: Plain text
#: condinapt.1:157
#, no-wrap
msgid "editor +d=bookworm +d=trixie +st=desktop\n"
msgstr "editor +d=bookworm +d=trixie +st=desktop\n"

#. type: Plain text
#: condinapt.1:161
msgid ""
"The example selects Debian Bookworm or Trixie and also requires "
"\\f[B]SYSTEM_TYPE=desktop\\f[R].\\fR"
msgstr ""
"El ejemplo selecciona Debian Bookworm o Trixie y también requiere "
"\\f[B]SYSTEM_TYPE=desktop\\f[R].\\fR"

#. type: Plain text
#: condinapt.1:163
msgid "Group filters make the relationship explicit:"
msgstr "Los filtros de grupo hacen explícita la relación:"

#. type: TP
#: condinapt.1:163
#, no-wrap
msgid "\\f[B]+{a|b}\\fR"
msgstr "\\f[B]+{a|b}\\fR"

#. type: Plain text
#: condinapt.1:166
msgid "Include when at least one condition matches."
msgstr "Incluir cuando al menos una condición coincida."

#. type: TP
#: condinapt.1:166
#, no-wrap
msgid "\\f[B]+{a&b}\\fR"
msgstr "\\f[B]+{a&b}\\fR"

#. type: Plain text
#: condinapt.1:169
msgid "Include only when every condition matches."
msgstr "Incluir solo cuando todas las condiciones coincidan."

#. type: TP
#: condinapt.1:169
#, no-wrap
msgid "\\f[B]-{a|b}\\fR"
msgstr "\\f[B]-{a|b}\\fR"

#. type: Plain text
#: condinapt.1:172
msgid "Exclude when at least one condition matches."
msgstr "Excluir cuando al menos una condición coincida."

#. type: TP
#: condinapt.1:172
#, no-wrap
msgid "\\f[B]-{a&b}\\fR"
msgstr "\\f[B]-{a&b}\\fR"

#. type: Plain text
#: condinapt.1:175
msgid "Exclude only when every condition matches."
msgstr "Excluir solo cuando todas las condiciones coincidan."

#. type: Plain text
#: condinapt.1:177
msgid "Examples:"
msgstr "Ejemplos:"

#. type: Plain text
#: condinapt.1:182
#, no-wrap
msgid ""
"web-server +{st=server|st=web-server}\n"
"database-tools +{d=bookworm&st=server}\n"
"debug-tools -{env=production|st=minimal}\n"
msgstr ""
"web-server +{st=server|st=web-server}\n"
"database-tools +{d=bookworm&st=server}\n"
"debug-tools -{env=production|st=minimal}\n"

#. type: SS
#: condinapt.1:183
#, no-wrap
msgid "Alternatives And Conjunctions"
msgstr "Alternativas y Conjunciones"

#. type: TP
#: condinapt.1:184
#, no-wrap
msgid "\\f[B]left || right\\fR"
msgstr "\\f[B]izquierda || derecha\\fR"

#. type: Plain text
#: condinapt.1:190
msgid ""
"During planning, select the first alternative whose filters pass and whose "
"required packages are installed or available from APT.  It is not a runtime "
"fallback: if the later \\f[B]apt-get install\\f[R] transaction fails, "
"another alternative is not tried.\\fR"
msgstr ""
"Durante la planificación, se selecciona la primera alternativa cuyos filtros "
"se cumplan y cuyos paquetes requeridos estén instalados o disponibles desde "
"APT. No es una conmutación en tiempo de ejecución: si la transacción "
"posterior de \\f[B]apt-get install\\f[R] falla, no se prueba otra "
"alternativa.\\fR"

#. type: TP
#: condinapt.1:190
#, no-wrap
msgid "\\f[B]left && right\\fR"
msgstr "\\f[B]izquierda && derecha\\fR"

#. type: Plain text
#: condinapt.1:194
msgid ""
"Require every expression in the alternative to pass filtering and "
"availability checks before adding them to the same installation plan."
msgstr ""
"Se requiere que cada expresión de la alternativa pase los filtros y las "
"comprobaciones de disponibilidad antes de añadirlas al mismo plan de "
"instalación."

#. type: Plain text
#: condinapt.1:196
msgid "\\f[B]&&\\f[R] binds within each \\f[B]||\\f[R] alternative:\\fR"
msgstr ""
"\\f[B]&&\\f[R] tiene prioridad dentro de cada alternativa \\f[B]||\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:199 condinapt-minios.7:201
#, no-wrap
msgid "exfatprogs || exfat-utils && exfat-fuse\n"
msgstr "exfatprogs || exfat-utils && exfat-fuse\n"

#. type: SS
#: condinapt.1:200
#, no-wrap
msgid "Mandatory Alternatives"
msgstr "Alternativas obligatorias"

#. type: Plain text
#: condinapt.1:202
msgid ""
"A leading \\f[B]!\\f[R] marks the entire package expression as mandatory:\\fR"
msgstr ""
"Un \\f[B]!\\f[R] al inicio marca toda la expresión del paquete como "
"obligatoria:\\fR"

#. type: Plain text
#: condinapt.1:206
#, no-wrap
msgid ""
"!essential-package\n"
"!preferred-package || fallback-package\n"
msgstr ""
"!essential-package\n"
"!preferred-package || fallback-package\n"

#. type: Plain text
#: condinapt.1:213
msgid ""
"If no alternative can be selected because required packages are unavailable, "
"normal execution aborts.  A valid later alternative satisfies the mandatory "
"expression.  Filter-only exclusions do not trigger a mandatory-package "
"abort, and simulation reports the failure without aborting early."
msgstr ""
"Si no se puede seleccionar ninguna alternativa porque los paquetes "
"requeridos no están disponibles, la ejecución normal se aborta. Una "
"alternativa válida posterior satisface la expresión obligatoria. Las "
"exclusiones solo por filtro no provocan un aborto de paquete obligatorio, y "
"la simulación informa del fallo sin abortar anticipadamente."

#. type: SH
#: condinapt.1:213
#, no-wrap
msgid "QUEUES"
msgstr "COLAS"

#. type: Plain text
#: condinapt.1:218
msgid ""
"A line containing only \\f[B]\\[em]\\f[R] closes the current normal-"
"repository queue.  Packages in one queue are installed in a single APT "
"transaction, and normal queues run sequentially.\\fR"
msgstr ""
"Una línea que contiene solo \\f[B]\\[em]\\f[R] cierra la cola de repositorio "
"normal actual. Los paquetes en una cola se instalan en una sola transacción "
"de APT, y las colas normales se ejecutan secuencialmente.\\fR"

#. type: Plain text
#: condinapt.1:221
msgid ""
"Target-release entries are pooled separately by release.  Processing order "
"is:"
msgstr ""
"Las entradas de target-release se agrupan por separado por versión. El orden "
"de procesamiento es:"

#. type: IP
#: condinapt.1:221
#, no-wrap
msgid "1."
msgstr "1."

#. type: Plain text
#: condinapt.1:223
msgid "Priority normal-repository queue"
msgstr "Cola de repositorio normal prioritaria"

#. type: IP
#: condinapt.1:223
#, no-wrap
msgid "2."
msgstr "2."

#. type: Plain text
#: condinapt.1:225
msgid "Priority target-release queues"
msgstr "Colas de target-release prioritarias"

#. type: IP
#: condinapt.1:225
#, no-wrap
msgid "3."
msgstr "3."

#. type: Plain text
#: condinapt.1:227
msgid "Normal queues"
msgstr "Colas normales"

#. type: IP
#: condinapt.1:227
#, no-wrap
msgid "4."
msgstr "4."

#. type: Plain text
#: condinapt.1:229
msgid "Remaining target-release queues"
msgstr "Colas de target-release restantes"

#. type: Plain text
#: condinapt.1:236
msgid ""
"The priority list removes matching expressions from their original queues "
"and preserves their complete filters, conditions, versions, and target "
"release.  Only the first package token is used for priority matching, so a "
"pattern that matches only a later \\f[B]||\\f[R] branch does not prioritize "
"the expression.\\fR"
msgstr ""
"La lista de prioridades elimina las expresiones coincidentes de sus colas "
"originales y conserva sus filtros, condiciones, versiones y versión de "
"destino completos. Solo se utiliza el primer token de paquete para la "
"coincidencia de prioridad, por lo que un patrón que solo coincida con una "
"rama posterior de \\f[B]||\\f[R] no prioriza la expresión.\\fR"

#. type: SH
#: condinapt.1:236
#, no-wrap
msgid "OPERATING MODES"
msgstr "MODOS DE OPERACIÓN"

#. type: SS
#: condinapt.1:237
#, no-wrap
msgid "Simulation"
msgstr "Simulación"

#. type: Plain text
#: condinapt.1:241
msgid ""
"Simulation performs planning but no package installation.  It can update APT "
"list state and always exits 1, so its exit status is not a success indicator."
msgstr ""
"La simulación realiza la planificación pero no instala paquetes. Puede "
"actualizar el estado de las listas de APT y siempre termina con código 1, "
"por lo que su estado de salida no indica éxito."

#. type: Plain text
#: condinapt.1:244
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -m filters.map -s -v\n"
msgstr "condinapt -l packages.list -c system.conf -m filters.map -s -v\n"

#. type: SS
#: condinapt.1:245
#, no-wrap
msgid "Check Only"
msgstr "Solo comprobación"

#. type: Plain text
#: condinapt.1:253
msgid ""
"Check-only evaluates filters and checks package names against the installed "
"package database.  It skips \\f[B]apt-get update\\f[R] and ignores version "
"and target-release requirements.  An alternative is satisfied when any "
"branch is installed.  If none is installed, the report and suggested command "
"may contain every failed branch rather than one availability-selected "
"alternative.\\fR"
msgstr ""
"La opción Solo comprobación evalúa los filtros y verifica los nombres de los "
"paquetes contra la base de datos de paquetes instalados. Omite \\\\f[B]apt-"
"get update\\\\f[R] e ignora los requisitos de versión y de publicación de "
"destino. Una alternativa se considera satisfecha cuando cualquier rama está "
"instalada. Si ninguna está instalada, el informe y el comando sugerido "
"pueden contener todas las ramas fallidas en lugar de una alternativa "
"seleccionada por disponibilidad.\\\\fR"

#. type: Plain text
#: condinapt.1:256
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -m filters.map -C\n"
msgstr "condinapt -l packages.list -c system.conf -m filters.map -C\n"

#. type: SH
#: condinapt.1:257
#, no-wrap
msgid "EXIT STATUS"
msgstr "ESTADO DE SALIDA"

#. type: TP
#: condinapt.1:258
#, no-wrap
msgid "\\f[B]0\\fR"
msgstr "\\\\f[B]0\\\\fR"

#. type: Plain text
#: condinapt.1:262
msgid ""
"Installation completed, help was displayed, or check-only found no missing "
"packages."
msgstr ""
"La instalación se completó, se mostró la ayuda o el modo solo comprobación "
"no encontró paquetes ausentes."

#. type: TP
#: condinapt.1:262
#, no-wrap
msgid "\\f[B]1\\fR"
msgstr "\\\\f[B]1\\\\fR"

#. type: Plain text
#: condinapt.1:266
msgid ""
"Invalid input, missing files, package or APT failure, missing packages in "
"check-only mode, or completion of simulation mode."
msgstr ""
"Entrada no válida, archivos ausentes, fallo de paquete o de APT, paquetes "
"ausentes en modo solo comprobación, o finalización del modo simulación."

#. type: Plain text
#: condinapt.1:272
msgid ""
"\\f[B]condinapt\\f[R] has no implicit configuration, mapping, or package-"
"list paths.  The package list and configuration must be supplied "
"explicitly.  The mapping and priority list are optional but are used only "
"when their paths are supplied.\\fR"
msgstr ""
"\\\\f[B]condinapt\\\\f[R] no tiene rutas implícitas para configuración, "
"mapeo ni lista de paquetes. La lista de paquetes y la configuración deben "
"proporcionarse explícitamente. El mapeo y la lista de prioridades son "
"opcionales, pero solo se usan si se indican sus rutas.\\\\fR"

#. type: Plain text
#: condinapt.1:274
msgid "Install a filtered list:"
msgstr "Instalar una lista filtrada:"

#. type: Plain text
#: condinapt.1:277
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -m filters.map\n"
msgstr "condinapt -l packages.list -c system.conf -m filters.map\n"

#. type: Plain text
#: condinapt.1:280
msgid "Force an APT list refresh and install priority packages first:"
msgstr ""
"Forzar una actualización de las listas de APT e instalar primero los "
"paquetes prioritarios:"

#. type: Plain text
#: condinapt.1:284
#, no-wrap
msgid ""
"condinapt -l packages.list -c system.conf -m filters.map \\[rs]\n"
"  -P priority.list -f\n"
msgstr ""
"condinapt -l packages.list -c system.conf -m filters.map \\\\[rs]\n"
"  -P priority.list -f\n"

#. type: Plain text
#: condinapt.1:288
msgid ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
msgstr ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
