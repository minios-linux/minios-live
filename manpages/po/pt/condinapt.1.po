#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "CONDINAPT"
msgstr "CONDINAPT"

#. type: TH
#: condinapt.1:3
#, no-wrap
msgid "CondinAPT Package Manager"
msgstr "Gerenciador de Pacotes CondinAPT"

#. type: Plain text
#: condinapt.1:7
msgid ""
"condinapt - conditional package installation tool for Debian-like systems"
msgstr ""
"condinapt - ferramenta de instalação condicional de pacotes para sistemas "
"baseados em Debian"

#. type: Plain text
#: condinapt.1:9
msgid "\\f[B]condinapt\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"
msgstr "\\f[B]condinapt\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"

#. type: Plain text
#: condinapt.1:15
msgid ""
"\\f[B]CondinAPT\\f[R] is a versatile tool for automating package "
"installation in any Debian-like system (Debian, Ubuntu, and their "
"derivatives).  Its key feature is the ability to define complex conditions "
"and rules for installing each package based on arbitrary system "
"configurations.\\fR"
msgstr ""
"\\f[B]CondinAPT\\f[R] é uma ferramenta versátil para automatizar a "
"instalação de pacotes em qualquer sistema baseado em Debian (Debian, Ubuntu "
"e seus derivados). Sua principal característica é a capacidade de definir "
"condições e regras complexas para instalar cada pacote com base em "
"configurações arbitrárias do sistema.\\fR"

#. type: SS
#: condinapt.1:15
#, no-wrap
msgid "Areas of Application"
msgstr "Áreas de Aplicação"

#. type: Plain text
#: condinapt.1:18
msgid "Linux distribution build systems"
msgstr "Sistemas de construção de distribuições Linux"

#. type: Plain text
#: condinapt.1:20
msgid "Automation of server and workstation setup"
msgstr "Automação da configuração de servidores e estações de trabalho"

#. type: Plain text
#: condinapt.1:22
msgid "Deployment of various system configurations"
msgstr "Implantação de várias configurações de sistema"

#. type: Plain text
#: condinapt.1:24
msgid "Package management in Docker containers"
msgstr "Gerenciamento de pacotes em contêineres Docker"

#. type: Plain text
#: condinapt.1:26
msgid "CI/CD pipelines for environment setup"
msgstr "Pipelines de CI/CD para preparação de ambiente"

#. type: Plain text
#: condinapt.1:28
msgid "Creation of custom installation images"
msgstr "Criação de imagens de instalação personalizadas"

#. type: SS
#: condinapt.1:28
#, no-wrap
msgid "Key Features"
msgstr "Principais Funcionalidades"

#. type: Plain text
#: condinapt.1:32
msgid ""
"\\f[B]Conditional Installation:\\f[R] Install packages based on flexible "
"filters (+, -)\\fR"
msgstr ""
"\\f[B]Instalação Condicional:\\f[R] Instala pacotes com base em filtros "
"flexíveis (+, -)\\fR"

#. type: Plain text
#: condinapt.1:35
msgid ""
"\\f[B]External Configuration:\\f[R] Complete separation of logic (package "
"list) from data (system parameters)\\fR"
msgstr ""
"\\f[B]Configuração Externa:\\f[R] Separação completa da lógica (lista de "
"pacotes) dos dados (parâmetros do sistema)\\fR"

#. type: Plain text
#: condinapt.1:38
msgid ""
"\\f[B]Installation Queues:\\f[R] Divide the process into sequential stages "
"to resolve dependencies\\fR"
msgstr ""
"\\f[B]Filas de Instalação:\\f[R] Divide o processo em etapas sequenciais "
"para resolver dependências\\fR"

#. type: Plain text
#: condinapt.1:41
msgid ""
"\\f[B]Priority Queue:\\f[R] Guaranteed installation of critical packages "
"first\\fR"
msgstr ""
"\\f[B]Fila de Prioridade:\\f[R] Instalação garantida dos pacotes críticos "
"primeiro\\fR"

#. type: Plain text
#: condinapt.1:44
msgid ""
"\\f[B]Complex Logic:\\f[R] Support for \\[lq]AND\\[rq] (&&), \\[lq]OR\\[rq] "
"(||) operators, as well as group filters (+{a|b}, -{a&b})\\fR"
msgstr ""
"\\f[B]Lógica Complexa:\\f[R] Suporte aos operadores \\[lq]AND\\[rq] (&&), \\"
"[lq]OR\\[rq] (||), além de filtros em grupo (+{a|b}, -{a&b})\\fR"

#. type: Plain text
#: condinapt.1:47
msgid ""
"\\f[B]Readability:\\f[R] Support for comments and empty lines to structure "
"lists\\fR"
msgstr ""
"\\f[B]Legibilidade:\\f[R] Suporte a comentários e linhas em branco para "
"estruturar listas\\fR"

#. type: Plain text
#: condinapt.1:50
msgid ""
"\\f[B]Backward Compatibility:\\f[R] Supports simple package lists without "
"conditions\\fR"
msgstr ""
"\\f[B]Compatibilidade Retroativa:\\f[R] Suporta listas simples de pacotes "
"sem condições\\fR"

#. type: TP
#: condinapt.1:51
#, no-wrap
msgid "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-l\\f[R], \\f[B]--package-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:54
msgid "(Required) Path to the package list file"
msgstr "(Obrigatório) Caminho para o arquivo de lista de pacotes"

#. type: TP
#: condinapt.1:54
#, no-wrap
msgid "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-c\\f[R], \\f[B]--config\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:57
msgid "(Required) Path to the main configuration file"
msgstr "(Obrigatório) Caminho para o arquivo principal de configuração"

#. type: TP
#: condinapt.1:57
#, no-wrap
msgid "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-m\\f[R], \\f[B]--filter-mapping\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:60
msgid "(Optional) Path to the filter mapping file"
msgstr "(Opcional) Caminho para o arquivo de mapeamento de filtros"

#. type: TP
#: condinapt.1:60
#, no-wrap
msgid "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"
msgstr "\\f[B]-P\\f[R], \\f[B]--priority-list\\f[R] \\f[I]PATH\\fR"

#. type: Plain text
#: condinapt.1:65
msgid ""
"(Optional) Path to a priority filter file.  File contains regex patterns to "
"match packages.  Matched packages are moved to priority queue (preserving "
"filters)"
msgstr ""
"(Opcional) Caminho para um arquivo de filtro de prioridade. O arquivo contém "
"padrões regex para corresponder pacotes. Pacotes correspondentes são movidos "
"para a fila de prioridade (preservando os filtros)"

#. type: TP
#: condinapt.1:65
#, no-wrap
msgid "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"
msgstr "\\f[B]-s\\f[R], \\f[B]--simulation\\fR"

#. type: Plain text
#: condinapt.1:69
msgid "Simulation mode.  Packages will not be installed"
msgstr "Modo de simulação.  Os pacotes não serão instalados"

#. type: TP
#: condinapt.1:69
#, no-wrap
msgid "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"
msgstr "\\f[B]-C\\f[R], \\f[B]--check-only\\fR"

#. type: Plain text
#: condinapt.1:74
msgid ""
"Only check if packages are already installed.  Returns exit code 1 if there "
"are uninstalled packages.  At the end, outputs a command to install missing "
"packages"
msgstr ""
"Apenas verifica se os pacotes já estão instalados. Retorna o código de saída "
"1 se houver pacotes não instalados. Ao final, exibe um comando para instalar "
"os pacotes ausentes"

#. type: TP
#: condinapt.1:74
#, no-wrap
msgid "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"
msgstr "\\f[B]-v\\f[R], \\f[B]--verbose\\fR"

#. type: Plain text
#: condinapt.1:77
msgid "Verbose output"
msgstr "Saída detalhada"

#. type: TP
#: condinapt.1:77
#, no-wrap
msgid "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"
msgstr "\\f[B]-vv\\f[R], \\f[B]--very-verbose\\fR"

#. type: Plain text
#: condinapt.1:80
msgid "Very verbose output"
msgstr "Saída muito detalhada"

#. type: TP
#: condinapt.1:80
#, no-wrap
msgid "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"
msgstr "\\f[B]-x\\f[R], \\f[B]--xtrace\\fR"

#. type: Plain text
#: condinapt.1:83
msgid "Enable \\f[B]set -x\\f[R] command tracing\\fR"
msgstr "Ativa o rastreamento de comandos \\f[B]set -x\\f[R]"

#. type: TP
#: condinapt.1:83
#, no-wrap
msgid "\\f[B]-f\\f[R], \\f[B]--force\\fR"
msgstr "\\f[B]-f\\f[R], \\f[B]--force\\fR"

#. type: Plain text
#: condinapt.1:88
msgid ""
"Force package lists update before installation.  By default, update is "
"skipped if \\f[B]/var/cache/apt/pkgcache.bin\\f[R] exists\\fR"
msgstr ""
"Força a atualização das listas de pacotes antes da instalação. Por padrão, a "
"atualização é ignorada se \\f[B]/var/cache/apt/pkgcache.bin\\f[R] existir\\fR"

#. type: TP
#: condinapt.1:88
#, no-wrap
msgid "\\f[B]-h\\f[R], \\f[B]--help\\fR"
msgstr "\\f[B]-h\\f[R], \\f[B]--help\\fR"

#. type: Plain text
#: condinapt.1:91
msgid "Show help"
msgstr "Exibe a ajuda"

#. type: SH
#: condinapt.1:91
#, no-wrap
msgid "CORE COMPONENTS"
msgstr "COMPONENTES PRINCIPAIS"

#. type: Plain text
#: condinapt.1:93
msgid "CondinAPT operates with four key files:"
msgstr "O CondinAPT opera com quatro arquivos principais:"

#. type: SS
#: condinapt.1:93
#, no-wrap
msgid "condinapt script"
msgstr "script condinapt"

#. type: Plain text
#: condinapt.1:95
msgid "The core, containing all processing logic"
msgstr "O núcleo, contendo toda a lógica de processamento"

#. type: SS
#: condinapt.1:95
#, no-wrap
msgid "Main configuration file (-c)"
msgstr "Arquivo de configuração principal (-c)"

#. type: Plain text
#: condinapt.1:97
msgid "A file with bash variables describing the current environment"
msgstr "Um arquivo com variáveis bash que descrevem o ambiente atual"

#. type: Plain text
#: condinapt.1:99
msgid "Example (\\f[B]system.conf\\f[R]):\\fR"
msgstr "Exemplo (\\f[B]system.conf\\f[R]):\\fR"

#. type: Plain text
#: condinapt.1:106
#, no-wrap
msgid ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"LOCALE=\\[dq]en_US\\[dq]\n"
"FEATURES=\\[dq]web,database\\[dq]\n"
msgstr ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
"LOCALE=\\[dq]en_US\\[dq]\n"
"FEATURES=\\[dq]web,database\\[dq]\n"

#. type: SS
#: condinapt.1:107
#, no-wrap
msgid "Filter mapping file (-m)"
msgstr "Arquivo de mapeamento de filtros (-m)"

#. type: Plain text
#: condinapt.1:114
msgid ""
"Links short prefixes (used in the package list) to variable names from the "
"main configuration file.  This file is \\f[B]optional\\f[R].  If a filter is "
"not present in the filter mapping file, it will be used as a variable name "
"from the main configuration file.  If the variable is not found, CondinAPT "
"will declare it empty.\\fR"
msgstr ""
"Relaciona prefixos curtos (usados na lista de pacotes) a nomes de variáveis "
"do arquivo de configuração principal.  Este arquivo é \\f[B]opcional\\f[R].  "
"Se um filtro não estiver presente no arquivo de mapeamento de filtros, ele "
"será usado como nome de variável do arquivo de configuração principal.  Se a "
"variável não for encontrada, o CondinAPT irá declará-la vazia.\\fR"

#. type: Plain text
#: condinapt.1:116
msgid "Example (\\f[B]filters.map\\f[R]):\\fR"
msgstr "Exemplo (\\f[B]filters.map\\f[R]):\\fR"

#. type: Plain text
#: condinapt.1:123
#, no-wrap
msgid ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"arch=ARCHITECTURE\n"
"feat=FEATURES\n"
msgstr ""
"d=DISTRIBUTION\n"
"st=SYSTEM_TYPE\n"
"env=ENVIRONMENT\n"
"arch=ARCHITECTURE\n"
"feat=FEATURES\n"

#. type: SS
#: condinapt.1:124
#, no-wrap
msgid "Package list file (-l)"
msgstr "Arquivo de lista de pacotes (-l)"

#. type: Plain text
#: condinapt.1:126
msgid "The main file describing what to install and under what conditions"
msgstr "O arquivo principal que descreve o que instalar e sob quais condições"

#. type: SH
#: condinapt.1:126
#, no-wrap
msgid "PACKAGE LIST SYNTAX"
msgstr "SINTAXE DA LISTA DE PACOTES"

#. type: Plain text
#: condinapt.1:128
msgid "Each line in the package list file consists of two main parts:"
msgstr ""
"Cada linha no arquivo de lista de pacotes consiste em duas partes principais:"

#. type: IP
#: condinapt.1:128
#, no-wrap
msgid "1."
msgstr "1."

#. type: Plain text
#: condinapt.1:130
msgid "Package name with optional version and release specification"
msgstr "Nome do pacote com especificação opcional de versão e release"

#. type: IP
#: condinapt.1:130 condinapt.1:406
#, no-wrap
msgid "2."
msgstr "2."

#. type: Plain text
#: condinapt.1:133
msgid ""
"Condition filters - define the conditions under which the package will be "
"installed"
msgstr ""
"Filtros de condição - definem as condições sob as quais o pacote será "
"instalado"

#. type: SS
#: condinapt.1:133
#, no-wrap
msgid "Package Name Structure"
msgstr "Estrutura do Nome do Pacote"

#. type: Plain text
#: condinapt.1:135
msgid "\\f[B]Simple name:\\fR"
msgstr "\\f[B]Nome simples:\\fR"

#. type: Plain text
#: condinapt.1:138
#, no-wrap
msgid "vim\n"
msgstr "vim\n"

#. type: Plain text
#: condinapt.1:141
msgid "\\f[B]Package version:\\fR"
msgstr "\\f[B]Versão do pacote:\\fR"

#. type: Plain text
#: condinapt.1:145
msgid ""
"\\f[B]package=version\\f[R] - loose version requirement.  If the required "
"version is unavailable, an available version is installed\\fR"
msgstr ""
"\\f[B]package=version\\f[R] - requisito de versão flexível.  Se a versão "
"requerida não estiver disponível, será instalada uma versão disponível\\fR"

#. type: Plain text
#: condinapt.1:148
msgid ""
"\\f[B]package==version\\f[R] - strict requirement.  If the version is not "
"found, installation aborts with an error\\fR"
msgstr ""
"\\f[B]package==version\\f[R] - requisito estrito.  Se a versão não for "
"encontrada, a instalação é abortada com erro\\fR"

#. type: Plain text
#: condinapt.1:150
msgid "\\f[B]Release specification:\\fR"
msgstr "\\f[B]Especificação de release:\\fR"

#. type: Plain text
#: condinapt.1:152
msgid "The release is specified using the **\\[at]** symbol:"
msgstr "A release é especificada utilizando o símbolo **\\[at]**:"

#. type: Plain text
#: condinapt.1:156
#, no-wrap
msgid ""
"telegram\\[at]bookworm-backports\n"
"kernel-image-6.5.0\\[at]trixie-backports\n"
msgstr ""
"telegram\\[at]bookworm-backports\n"
"kernel-image-6.5.0\\[at]trixie-backports\n"

#. type: SS
#: condinapt.1:157
#, no-wrap
msgid "File Structure"
msgstr "Estrutura de Arquivo"

#. type: Plain text
#: condinapt.1:161
msgid ""
"\\f[B]Package names:\\f[R] Each package or condition is written on a new "
"line\\fR"
msgstr ""
"\\f[B]Nomes de pacotes:\\f[R] Cada pacote ou condição deve ser escrito em "
"uma nova linha\\fR"

#. type: Plain text
#: condinapt.1:164
msgid ""
"\\f[B]Comments:\\f[R] Lines starting with \\f[B]#\\f[R], or text after "
"\\f[B]#\\f[R] on a line, are completely ignored\\fR"
msgstr ""
"\\f[B]Comentários:\\f[R] Linhas iniciadas com \\f[B]#\\f[R], ou texto após "
"\\f[B]#\\f[R] em uma linha, são totalmente ignorados\\fR"

#. type: Plain text
#: condinapt.1:166
msgid "\\f[B]Empty lines:\\f[R] Ignored and serve for visual separation\\fR"
msgstr ""
"\\f[B]Linhas em branco:\\f[R] Ignoradas e servem para separação visual\\fR"

#. type: SS
#: condinapt.1:166
#, no-wrap
msgid "Filters and Conditions"
msgstr "Filtros e Condições"

#. type: SS
#: condinapt.1:167
#, no-wrap
msgid "Single Filters"
msgstr "Filtros Simples"

#. type: Plain text
#: condinapt.1:170
msgid ""
"\\f[B]+ (Positive):\\f[R] The condition is true if the variable value "
"\\f[B]matches\\fR"
msgstr ""
"\\f[B]+ (Positivo):\\f[R] A condição é verdadeira se o valor da variável "
"\\f[B]corresponder\\fR"

#. type: Plain text
#: condinapt.1:172
msgid "Format: \\f[B]+=\\fR"
msgstr "Formato: \\f[B]+=\\fR"

#. type: Plain text
#: condinapt.1:174 condinapt.1:185 condinapt.1:254
msgid "Example:"
msgstr "Exemplo:"

#. type: Plain text
#: condinapt.1:177
#, no-wrap
msgid "nginx +st=server\n"
msgstr "nginx +st=server\n"

#. type: Plain text
#: condinapt.1:181
msgid ""
"\\f[B]- (Negative):\\f[R] The condition is true if the variable value "
"\\f[B]does not match\\fR"
msgstr ""
"\\f[B]- (Negativo):\\f[R] A condição é verdadeira se o valor da variável "
"\\f[B]não corresponder\\fR"

#. type: Plain text
#: condinapt.1:183
msgid "Format: \\f[B]-=\\fR"
msgstr "Formato: \\f[B]-=\\fR"

#. type: Plain text
#: condinapt.1:188
#, no-wrap
msgid "monitoring-tools -st=desktop\n"
msgstr "monitoring-tools -st=desktop\n"

#. type: SS
#: condinapt.1:189
#, no-wrap
msgid "Group Filters"
msgstr "Filtros de Grupo"

#. type: Plain text
#: condinapt.1:192
msgid ""
"\\f[B]+{a|b} (OR for inclusion):\\f[R] True if \\f[B]at least one\\f[R] of "
"the conditions in the group is true\\fR"
msgstr ""
"\\f[B]+{a|b} (OU para inclusão):\\f[R] Verdadeiro se \\f[B]ao menos "
"uma\\f[R] das condições do grupo for verdadeira\\fR"

#. type: Plain text
#: condinapt.1:195
#, no-wrap
msgid "web-server +{st=server|st=web-server}\n"
msgstr "web-server +{st=server|st=web-server}\n"

#. type: Plain text
#: condinapt.1:199
msgid ""
"\\f[B]+{a&b} (AND for inclusion):\\f[R] True only if \\f[B]all\\f[R] "
"conditions in the group are true\\fR"
msgstr ""
"\\f[B]+{a&b} (E para inclusão):\\f[R] Verdadeiro somente se "
"\\f[B]todas\\f[R] as condições do grupo forem verdadeiras\\fR"

#. type: Plain text
#: condinapt.1:202
#, no-wrap
msgid "database-tools +{d=bookworm&st=server}\n"
msgstr "database-tools +{d=bookworm&st=server}\n"

#. type: Plain text
#: condinapt.1:206
msgid ""
"\\f[B]-{a|b} (OR for exclusion):\\f[R] The package is excluded if \\f[B]at "
"least one\\f[R] of the conditions is true\\fR"
msgstr ""
"\\f[B]-{a|b} (OU para exclusão):\\f[R] O pacote é excluído se \\f[B]ao menos "
"uma\\f[R] das condições for verdadeira\\fR"

#. type: Plain text
#: condinapt.1:209
#, no-wrap
msgid "debug-tools -{env=production|st=minimal}\n"
msgstr "debug-tools -{env=production|st=minimal}\n"

#. type: Plain text
#: condinapt.1:213
msgid ""
"\\f[B]-{a&b} (AND for exclusion):\\f[R] The package is excluded only if "
"\\f[B]all\\f[R] conditions are true\\fR"
msgstr ""
"\\f[B]-{a&b} (E para exclusão):\\f[R] O pacote é excluído somente se "
"\\f[B]todas\\f[R] as condições forem verdadeiras\\fR"

#. type: Plain text
#: condinapt.1:216
#, no-wrap
msgid "development-tools -{env=production&st=minimal}\n"
msgstr "development-tools -{env=production&st=minimal}\n"

#. type: SS
#: condinapt.1:217
#, no-wrap
msgid "Logical Operators"
msgstr "Operadores Lógicos"

#. type: Plain text
#: condinapt.1:220
msgid ""
"\\f[B]|| (OR / Fallback):\\f[R] Try to install the left part.  If it fails, "
"try the right part\\fR"
msgstr ""
"\\f[B]|| (OU / Alternativa):\\f[R] Tenta instalar a parte à esquerda. Se "
"falhar, tenta a parte à direita\\fR"

#. type: Plain text
#: condinapt.1:223
#, no-wrap
msgid "exfatprogs -d=bookworm || exfat-utils\n"
msgstr "exfatprogs -d=bookworm || exfat-utils\n"

#. type: Plain text
#: condinapt.1:227
msgid ""
"\\f[B]&& (AND / Conjunction):\\f[R] All parts must successfully pass filter "
"checks\\fR"
msgstr ""
"\\f[B]&& (E / Conjunção):\\f[R] Todas as partes devem passar com sucesso "
"pelas verificações de filtro\\fR"

#. type: Plain text
#: condinapt.1:230
#, no-wrap
msgid "nginx +st=web-server && php-fpm\n"
msgstr "nginx +st=web-server && php-fpm\n"

#. type: SS
#: condinapt.1:231
#, no-wrap
msgid "Special Modifiers"
msgstr "Modificadores Especiais"

#. type: Plain text
#: condinapt.1:236
msgid ""
"\\f[B]! (Mandatory Package):\\f[R] If a package is marked with \\f[B]!"
"\\f[R], but cannot be found in repositories, CondinAPT will abort execution "
"with an error\\fR"
msgstr ""
"\\f[B]! (Pacote obrigatório):\\f[R] Se um pacote estiver marcado com \\f[B]!"
"\\f[R], mas não for encontrado nos repositórios, o CondinAPT irá abortar a "
"execução com um erro\\fR"

#. type: Plain text
#: condinapt.1:239
#, no-wrap
msgid "!essential-package\n"
msgstr "!essential-package\n"

#. type: Plain text
#: condinapt.1:243
msgid ""
"\\f[B]\\[at] (Release Specification):\\f[R] Install a package from a "
"specific Debian/Ubuntu release\\fR"
msgstr ""
"\\f[B]\\[at] (Especificação de release):\\f[R] Instala um pacote de uma "
"release específica do Debian/Ubuntu\\fR"

#. type: Plain text
#: condinapt.1:246
#, no-wrap
msgid "kernel-image-6.5.0 \\[at]trixie-backports\n"
msgstr "kernel-image-6.5.0 \\[at]trixie-backports\n"

#. type: SS
#: condinapt.1:247
#, no-wrap
msgid "Installation Queues"
msgstr "Filas de Instalação"

#. type: Plain text
#: condinapt.1:252
msgid ""
"The \\f[B]\\[em]\\f[R] separator on a separate line divides the list into "
"groups (queues).  Packages from one queue are installed together in a single "
"apt call.  Queues are executed strictly sequentially.\\fR"
msgstr ""
"O separador \\f[B]\\[em]\\f[R] em uma linha separada divide a lista em "
"grupos (filas). Os pacotes de uma fila são instalados juntos em uma única "
"chamada do apt. As filas são executadas estritamente em sequência.\\fR"

#. type: Plain text
#: condinapt.1:266
#, no-wrap
msgid ""
"# Queue 1: Base system\n"
"systemd\n"
"network-manager\n"
"---\n"
"# Queue 2: Web server\n"
"nginx\n"
"php-fpm\n"
"---\n"
"# Queue 3: Monitoring\n"
"prometheus\n"
msgstr ""
"# Fila 1: Sistema base\n"
"systemd\n"
"network-manager\n"
"---\n"
"# Fila 2: Servidor web\n"
"nginx\n"
"php-fpm\n"
"---\n"
"# Fila 3: Monitoramento\n"
"prometheus\n"

#. type: SS
#: condinapt.1:267
#, no-wrap
msgid "Priority Queue"
msgstr "Fila de Prioridade"

#. type: Plain text
#: condinapt.1:273
msgid ""
"The file specified by the \\f[B]-P\\f[R] flag contains regex patterns (one "
"pattern per line, no filters).  CondinAPT scans all queues, finds packages "
"matching these patterns, and moves them (with all their filters and "
"conditions) to a special \\[lq]Priority Queue\\[rq], which is executed first."
"\\fR"
msgstr ""
"O arquivo especificado pela opção \\f[B]-P\\f[R] contém padrões regex (um "
"padrão por linha, sem filtros). CondinAPT analisa todas as filas, encontra "
"pacotes que correspondem a esses padrões e os move (com todos os seus "
"filtros e condições) para uma \\[lq]Fila de Prioridade\\[rq] especial, que é "
"executada primeiro.\\fR"

#. type: Plain text
#: condinapt.1:276
msgid ""
"\\f[B]Pattern Matching:\\f[R] Uses bash regex matching (=\\[ti] operator).  "
"Patterns can be simple package names or complex regex expressions.\\fR"
msgstr ""
"\\f[B]Correspondência de Padrões:\\f[R] Utiliza correspondência regex do "
"bash (operador =\\[ti]). Os padrões podem ser nomes simples de pacotes ou "
"expressões regex complexas.\\fR"

#. type: Plain text
#: condinapt.1:280
msgid ""
"\\f[B]Preserving Context:\\f[R] This mechanism preserves all package "
"conditions, filters, and release specifications from the original package "
"list.\\fR"
msgstr ""
"\\f[B]Preservação de Contexto:\\f[R] Este mecanismo preserva todas as "
"condições dos pacotes, filtros e especificações de release da lista original "
"de pacotes.\\fR"

#. type: Plain text
#: condinapt.1:285
msgid ""
"\\f[B]Override:\\f[R] Matched packages are automatically removed from their "
"original queues (both regular and target queues with \\f[B]\\"
"[at]release\\f[R]) and moved to priority queues.  Target releases are "
"preserved in separate priority target queues.\\fR"
msgstr ""
"\\f[B]Sobrescrever:\\f[R] Pacotes correspondentes são removidos "
"automaticamente de suas filas originais (tanto filas regulares quanto filas "
"de destino com \\f[B]\\[at]release\\f[R]) e movidos para filas de "
"prioridade. Releases de destino são preservados em filas de prioridade "
"separadas para destino.\\fR"

#. type: Plain text
#: condinapt.1:287
msgid "Example \\f[B]priority.list\\f[R]:\\fR"
msgstr "Exemplo de \\f[B]priority.list\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:292
#, no-wrap
msgid ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"
msgstr ""
"\\[ha]linux-.*\n"
"\\[ha]firmware-.*\n"
"\\[ha]dkms$\n"

#. type: SS
#: condinapt.1:294
#, no-wrap
msgid "Quick Start"
msgstr "Início Rápido"

#. type: Plain text
#: condinapt.1:296
msgid "Create the configuration file \\f[B]config.conf\\f[R]:\\fR"
msgstr "Crie o arquivo de configuração \\f[B]config.conf\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:301
#, no-wrap
msgid ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"
msgstr ""
"DISTRIBUTION=\\[dq]bookworm\\[dq]\n"
"SYSTEM_TYPE=\\[dq]server\\[dq]\n"
"ENVIRONMENT=\\[dq]production\\[dq]\n"

#. type: Plain text
#: condinapt.1:304
msgid "Create the package list \\f[B]packages.list\\f[R]:\\fR"
msgstr "Crie a lista de pacotes \\f[B]packages.list\\f[R]:\\fR"

#. type: Plain text
#: condinapt.1:309
#, no-wrap
msgid ""
"# Base packages - always installed\n"
"vim\n"
"curl\n"
msgstr ""
"# Pacotes base - sempre instalados\n"
"vim\n"
"curl\n"

#. type: Plain text
#: condinapt.1:313
#, no-wrap
msgid ""
"# Packages only for servers\n"
"nginx +SYSTEM_TYPE=server\n"
"mysql-server +SYSTEM_TYPE=server\n"
msgstr ""
"# Pacotes apenas para servidores\n"
"nginx +SYSTEM_TYPE=server\n"
"mysql-server +SYSTEM_TYPE=server\n"

#. type: Plain text
#: condinapt.1:316
#, no-wrap
msgid ""
"# Exclude packages for production environment\n"
"debug-tools -ENVIRONMENT=production\n"
msgstr ""
"# Excluir pacotes para ambiente de produção\n"
"debug-tools -ENVIRONMENT=production\n"

#. type: Plain text
#: condinapt.1:319
msgid "Run the installation:"
msgstr "Execute a instalação:"

#. type: Plain text
#: condinapt.1:322
#, no-wrap
msgid "condinapt -l packages.list -c config.conf\n"
msgstr "condinapt -l packages.list -c config.conf\n"

#. type: Plain text
#: condinapt.1:325
msgid "Or test in simulation mode:"
msgstr "Ou teste em modo de simulação:"

#. type: Plain text
#: condinapt.1:328
#, no-wrap
msgid "condinapt -l packages.list -c config.conf -s\n"
msgstr "condinapt -l packages.list -c config.conf -s\n"

#. type: SS
#: condinapt.1:329
#, no-wrap
msgid "Multimedia Server"
msgstr "Servidor Multimídia"

#. type: Plain text
#: condinapt.1:331 condinapt.1:350 condinapt-minios.7:124
#: condinapt-minios.7:144 condinapt-minios.7:162 condinapt-minios.7:186
msgid "\\f[B]packages.list:\\fR"
msgstr "\\f[B]packages.list:\\fR"

#. type: Plain text
#: condinapt.1:336 condinapt-minios.7:129
#, no-wrap
msgid ""
"# Basic multimedia codecs - always\n"
"gstreamer1.0-plugins-base\n"
"gstreamer1.0-plugins-good\n"
msgstr ""
"# Codecs multimídia básicos - sempre\n"
"gstreamer1.0-plugins-base\n"
"gstreamer1.0-plugins-good\n"

#. type: Plain text
#: condinapt.1:340
#, no-wrap
msgid ""
"# Additional codecs - not for minimal installation\n"
"gstreamer1.0-plugins-bad -st=minimal\n"
"gstreamer1.0-plugins-ugly -st=minimal\n"
msgstr ""
"# Codecs adicionais - não para instalação mínima\n"
"gstreamer1.0-plugins-bad -st=minimal\n"
"gstreamer1.0-plugins-ugly -st=minimal\n"

#. type: Plain text
#: condinapt.1:347
#, no-wrap
msgid ""
"# Professional tools - only for full configuration\n"
"ffmpeg +st=media-server\n"
"vlc +st=media-server\n"
"---\n"
"# Distribution-specific packages from backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"
msgstr ""
"# Ferramentas profissionais - apenas para configuração completa\n"
"ffmpeg +st=media-server\n"
"vlc +st=media-server\n"
"---\n"
"# Pacotes específicos da distribuição dos backports\n"
"ffmpeg \\[at]bookworm-backports +d=bookworm\n"

#. type: SS
#: condinapt.1:348
#, no-wrap
msgid "Web Server with Various Configurations"
msgstr "Servidor Web com Várias Configurações"

#. type: Plain text
#: condinapt.1:355
#, no-wrap
msgid ""
"# Basic web server components\n"
"nginx\n"
"openssl\n"
msgstr ""
"# Componentes básicos de servidor web\n"
"nginx\n"
"openssl\n"

#. type: Plain text
#: condinapt.1:359
#, no-wrap
msgid ""
"# Database - only for full installations\n"
"mysql-server +st=full-server -{env=minimal}\n"
"postgresql +st=database-server\n"
msgstr ""
"# Banco de dados - apenas para instalações completas\n"
"mysql-server +st=full-server -{env=minimal}\n"
"postgresql +st=database-server\n"

#. type: Plain text
#: condinapt.1:363
#, no-wrap
msgid ""
"# PHP - for web servers\n"
"php-fpm +feat=php\n"
"php-mysql +{feat=php&st=full-server}\n"
msgstr ""
"# PHP - para servidores web\n"
"php-fpm +feat=php\n"
"php-mysql +{feat=php&st=full-server}\n"

#. type: Plain text
#: condinapt.1:366
#, no-wrap
msgid ""
"# Monitoring - not for development\n"
"prometheus-node-exporter -env=development\n"
msgstr ""
"# Monitoramento - não para desenvolvimento\n"
"prometheus-node-exporter -env=development\n"

#. type: SH
#: condinapt.1:367
#, no-wrap
msgid "OPERATING MODES"
msgstr "MODOS DE OPERAÇÃO"

#. type: SS
#: condinapt.1:368
#, no-wrap
msgid "Simulation Mode"
msgstr "Modo de Simulação"

#. type: Plain text
#: condinapt.1:371
msgid ""
"Allows you to see which packages will be installed without actually "
"installing them:"
msgstr ""
"Permite visualizar quais pacotes serão instalados sem realmente instalá-los:"

#. type: Plain text
#: condinapt.1:374
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -s\n"
msgstr "condinapt -l packages.list -c system.conf -s\n"

#. type: Plain text
#: condinapt.1:377
msgid "In simulation mode, the script exits with exit code 1."
msgstr "No modo de simulação, o script termina com código de saída 1."

#. type: SS
#: condinapt.1:377
#, no-wrap
msgid "Check Mode"
msgstr "Modo de Verificação"

#. type: Plain text
#: condinapt.1:379
msgid ""
"Checks which packages from the list are already installed on the system:"
msgstr "Verifica quais pacotes da lista já estão instalados no sistema:"

#. type: Plain text
#: condinapt.1:382
#, no-wrap
msgid "condinapt -l packages.list -c system.conf -C\n"
msgstr "condinapt -l packages.list -c system.conf -C\n"

#. type: Plain text
#: condinapt.1:386
msgid ""
"Shows errors for uninstalled packages and returns exit code 1 if there are "
"uninstalled packages."
msgstr ""
"Exibe erros para pacotes não instalados e retorna código de saída 1 se "
"houver pacotes não instalados."

#. type: SS
#: condinapt.1:386
#, no-wrap
msgid "Debugging Modes"
msgstr "Modos de Depuração"

#. type: Plain text
#: condinapt.1:388
msgid "\\f[B]Verbose Output (-v):\\fR"
msgstr "\\f[B]Saída Verbosa (-v):\\fR"

#. type: Plain text
#: condinapt.1:391
msgid ""
"Shows detailed information about filter checks and displays results for each "
"package."
msgstr ""
"Exibe informações detalhadas sobre as verificações de filtros e mostra "
"resultados para cada pacote."

#. type: Plain text
#: condinapt.1:393
msgid "\\f[B]Very Verbose Output (-vv):\\fR"
msgstr "\\f[B]Saída Muito Verbosa (-vv):\\fR"

#. type: Plain text
#: condinapt.1:395
msgid "Maximum process detail, shows all intermediate steps."
msgstr ""
"Detalhamento máximo do processo, mostra todas as etapas intermediárias."

#. type: Plain text
#: condinapt.1:397
msgid "\\f[B]Command Tracing (-x):\\fR"
msgstr "\\f[B]Rastreamento de Comandos (-x):\\fR"

#. type: Plain text
#: condinapt.1:400
msgid ""
"Enables \\f[B]set -x\\f[R] for script debugging, shows each command being "
"executed.\\fR"
msgstr ""
"Ativa \\f[B]set -x\\f[R] para depuração do script, mostrando cada comando "
"executado.\\fR"

#. type: SH
#: condinapt.1:400
#, no-wrap
msgid "ERROR HANDLING"
msgstr "TRATAMENTO DE ERROS"

#. type: SS
#: condinapt.1:401
#, no-wrap
msgid "Mandatory Packages"
msgstr "Pacotes Obrigatórios"

#. type: Plain text
#: condinapt.1:404
msgid ""
"If a package is marked as mandatory (\\f[B]!\\f[R]) but not found in "
"repositories, CondinAPT:\\fR"
msgstr ""
"Se um pacote estiver marcado como obrigatório (\\f[B]!\\f[R]) mas não for "
"encontrado nos repositórios, o CondinAPT:\\fR"

#. type: IP
#: condinapt.1:404
#, no-wrap
msgid "\\f[R]1.\\fR"
msgstr "\\f[R]1.\\fR"

#. type: Plain text
#: condinapt.1:406
msgid "Outputs an error message"
msgstr "Exibe uma mensagem de erro"

#. type: Plain text
#: condinapt.1:408
msgid "Aborts execution (unless in simulation mode)"
msgstr "Interrompe a execução (a menos que esteja em modo de simulação)"

#. type: IP
#: condinapt.1:408
#, no-wrap
msgid "3."
msgstr "3."

#. type: Plain text
#: condinapt.1:410
msgid "Returns exit code 1"
msgstr "Retorna o código de saída 1"

#. type: SS
#: condinapt.1:410
#, no-wrap
msgid "Handling Unavailable Versions"
msgstr "Tratamento de Versões Indisponíveis"

#. type: Plain text
#: condinapt.1:412
msgid "\\f[B]Loose Versions (=):\\fR"
msgstr "\\f[B]Versões Flexíveis (=):\\fR"

#. type: Plain text
#: condinapt.1:415
msgid ""
"If the exact version is unavailable, any available version is installed with "
"a warning."
msgstr ""
"Se a versão exata não estiver disponível, qualquer versão disponível será "
"instalada com um aviso."

#. type: Plain text
#: condinapt.1:417
msgid "\\f[B]Strict Versions (==):\\fR"
msgstr "\\f[B]Versões Estritas (==):\\fR"

#. type: Plain text
#: condinapt.1:420
msgid ""
"If the exact version is unavailable, the package is skipped.  If the package "
"is mandatory (\\f[B]!\\f[R]), execution aborts.\\fR"
msgstr ""
"Se a versão exata não estiver disponível, o pacote é ignorado.  Se o pacote "
"for obrigatório (\\f[B]!\\f[R]), a execução é interrompida.\\fR"

#. type: SS
#: condinapt.1:420
#, no-wrap
msgid "Version Holding"
msgstr "Retenção de Versão"

#. type: Plain text
#: condinapt.1:423
msgid ""
"CondinAPT automatically applies \\f[B]apt-mark hold\\f[R] when the exactly "
"requested version was installed, preventing automatic updates.\\fR"
msgstr ""
"O CondinAPT aplica automaticamente \\f[B]apt-mark hold\\f[R] quando a versão "
"solicitada exatamente foi instalada, prevenindo atualizações automáticas.\\fR"

#. type: SH
#: condinapt.1:423 condinapt-minios.7:261
#, no-wrap
msgid "FILES"
msgstr "ARQUIVOS"

#. type: TP
#: condinapt.1:424
#, no-wrap
msgid "\\f[B]/etc/condinapt/config.conf\\fR"
msgstr "\\f[B]/etc/condinapt/config.conf\\fR"

#. type: Plain text
#: condinapt.1:427
msgid "Default configuration file"
msgstr "Arquivo de configuração padrão"

#. type: TP
#: condinapt.1:427
#, no-wrap
msgid "\\f[B]/etc/condinapt/filters.map\\fR"
msgstr "\\f[B]/etc/condinapt/filters.map\\fR"

#. type: Plain text
#: condinapt.1:430
msgid "Default filter mapping file"
msgstr "Arquivo padrão de mapeamento de filtros"

#. type: Plain text
#: condinapt.1:433
msgid ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
msgstr ""
"\\f[B]apt\\f[R](8), \\f[B]apt-get\\f[R](8), \\f[B]apt-cache\\f[R](8), "
"\\f[B]condinapt-minios\\f[R](7)\\fR"
