#. type: TH
#: minios-cmd.1:3
#, no-wrap
msgid "MiniOS Command-Line Builder"
msgstr "Construtor de Linha de Comando do MiniOS"

#. type: Plain text
#: minios-cmd.1:7
msgid ""
"minios-cmd - command-line utility for configuring and building customized "
"MiniOS system images"
msgstr ""
"minios-cmd - utilitário de linha de comando para configurar e construir "
"imagens de sistema MiniOS personalizadas"

#. type: Plain text
#: minios-cmd.1:9
msgid "\\f[B]minios-cmd\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"
msgstr "\\f[B]minios-cmd\\f[R] [\\f[I]OPTIONS\\f[R]]\\fR"

#. type: Plain text
#: minios-cmd.1:15
msgid ""
"\\f[B]minios-cmd\\f[R] is a command-line utility designed to simplify the "
"process of configuring and building customized MiniOS system images.  Acting "
"as a frontend for \\f[B]minios-live\\f[R](1), it manages the configuration "
"and invokes \\f[B]minios-live\\f[R] to execute the actual build steps.\\fR"
msgstr ""
"\\f[B]minios-cmd\\f[R] é um utilitário de linha de comando projetado para "
"simplificar o processo de configuração e construção de imagens de sistema "
"MiniOS personalizadas. Atuando como frontend para \\f[B]minios-live\\f[R]"
"(1), gerencia a configuração e invoca o \\f[B]minios-live\\f[R] para "
"executar as etapas reais de compilação.\\fR"

#. type: Plain text
#: minios-cmd.1:18
msgid ""
"With \\f[B]minios-cmd\\f[R], you can customize various aspects of your "
"MiniOS image, including:\\fR"
msgstr ""
"Com o \\f[B]minios-cmd\\f[R], você pode personalizar vários aspectos da sua "
"imagem MiniOS, incluindo:\\fR"

#. type: Plain text
#: minios-cmd.1:22
msgid ""
"\\f[B]Distribution:\\f[R] Choose from Debian releases (\\f[B]buster\\f[R], "
"\\f[B]bullseye\\f[R], \\f[B]bookworm\\f[R], \\f[B]trixie\\f[R]) and Ubuntu "
"releases (\\f[B]jammy\\f[R], \\f[B]noble\\f[R])\\fR"
msgstr ""
"\\f[B]Distribuição:\\f[R] Escolha entre versões do Debian "
"(\\f[B]buster\\f[R], \\f[B]bullseye\\f[R], \\f[B]bookworm\\f[R], "
"\\f[B]trixie\\f[R]) e versões do Ubuntu (\\f[B]jammy\\f[R], "
"\\f[B]noble\\f[R])\\fR"

#. type: Plain text
#: minios-cmd.1:25
msgid ""
"\\f[B]Architecture:\\f[R] Specify the target architecture "
"(\\f[B]amd64\\f[R], \\f[B]i386\\f[R] for older distributions)\\fR"
msgstr ""
"\\f[B]Arquitetura:\\f[R] Especifique a arquitetura de destino "
"(\\f[B]amd64\\f[R], \\f[B]i386\\f[R] para distribuições antigas)\\fR"

#. type: Plain text
#: minios-cmd.1:27
msgid "\\f[B]Desktop Environment:\\fR"
msgstr "\\f[B]Ambiente de Desktop:\\fR"

#. type: Plain text
#: minios-cmd.1:31
msgid ""
"\\f[B]Debian:\\f[R] \\f[B]xfce\\f[R] (standard), \\f[B]flux\\f[R] (minimum), "
"\\f[B]lxqt\\f[R] (bookworm/trixie only)\\fR"
msgstr ""
"\\f[B]Debian:\\f[R] \\f[B]xfce\\f[R] (padrão), \\f[B]flux\\f[R] (mínimo), "
"\\f[B]lxqt\\f[R] (apenas bookworm/trixie)\\fR"

#. type: Plain text
#: minios-cmd.1:33
msgid "\\f[B]Ubuntu:\\f[R] \\f[B]xfce\\f[R] only\\fR"
msgstr "\\f[B]Ubuntu:\\f[R] apenas \\f[B]xfce\\f[R]\\fR"

#. type: Plain text
#: minios-cmd.1:36
msgid "\\f[B]Package Variant:\\fR"
msgstr "\\f[B]Variante de Pacote:\\fR"

#. type: Plain text
#: minios-cmd.1:40
msgid ""
"\\f[B]All Debian:\\f[R] \\f[B]standard\\f[R] (xfce), \\f[B]minimum\\f[R] "
"(flux)\\fR"
msgstr ""
"\\f[B]Todos Debian:\\f[R] \\f[B]standard\\f[R] (xfce), \\f[B]minimum\\f[R] "
"(flux)\\fR"

#. type: Plain text
#: minios-cmd.1:42
msgid "\\f[B]Bookworm/Trixie only:\\f[R] \\f[B]toolbox\\f[R], \\f[B]ultra\\fR"
msgstr ""
"\\f[B]Somente Bookworm/Trixie:\\f[R] \\f[B]toolbox\\f[R], \\f[B]ultra\\fR"

#. type: Plain text
#: minios-cmd.1:44
msgid "\\f[B]Ubuntu:\\f[R] \\f[B]standard\\f[R] only\\fR"
msgstr "\\f[B]Ubuntu:\\f[R] apenas \\f[B]standard\\f[R]\\fR"

#. type: Plain text
#: minios-cmd.1:48
msgid ""
"\\f[B]Compression Type:\\f[R] Specify the image compression method "
"(\\f[B]zstd\\f[R])\\fR"
msgstr ""
"\\f[B]Tipo de Compressão:\\f[R] Especifique o método de compressão da imagem "
"(\\f[B]zstd\\f[R])\\fR"

#. type: Plain text
#: minios-cmd.1:51
msgid ""
"\\f[B]Kernel:\\f[R] Select a distribution or AUFS-enabled MiniOS kernel and "
"compile optional DKMS modules\\fR"
msgstr ""
"\\f[B]Kernel:\\f[R] Selecione uma distribuição ou kernel compatível com AUFS-"
"habilitado MiniOS e compile módulos DKMS opcionais\\fR"

#. type: Plain text
#: minios-cmd.1:54
msgid ""
"\\f[B]Locale and Timezone:\\f[R] Set the system locale and timezone with "
"multilingual support\\fR"
msgstr ""
"\\f[B]Localidade e Fuso Horário:\\f[R] Defina a localidade e o fuso horário "
"do sistema com suporte multilíngue\\fR"

#. type: SH
#: minios-cmd.1:54 condinapt.1:50
#, no-wrap
msgid "OPTIONS"
msgstr "OPÇÕES"

#. type: SS
#: minios-cmd.1:55
#, no-wrap
msgid "Configuration Options"
msgstr "Opções de configuração"

#. type: TP
#: minios-cmd.1:56
#, no-wrap
msgid "\\f[B]--config-file\\f[R] \\f[I]FILE\\fR"
msgstr "\\f[B]--config-file\\f[R] \\f[I]FILE\\fR"

#. type: Plain text
#: minios-cmd.1:60
msgid "Specify the configuration file path.  All other options are ignored."
msgstr ""
"Especifique o caminho do arquivo de configuração. Todas as outras opções "
"serão ignoradas."

#. type: TP
#: minios-cmd.1:60
#, no-wrap
msgid "\\f[B]--config-only\\fR"
msgstr "\\f[B]--config-only\\fR"

#. type: Plain text
#: minios-cmd.1:63
msgid ""
"Generate the configuration file only and do not start the build process."
msgstr ""
"Gera apenas o arquivo de configuração e não inicia o processo de compilação."

#. type: TP
#: minios-cmd.1:64
#, no-wrap
msgid "\\f[B]-b\\f[R], \\f[B]--build-dir\\f[R] \\f[I]DIR\\fR"
msgstr "\\f[B]-b\\f[R], \\f[B]--build-dir\\f[R] \\f[I]DIR\\fR"

#. type: Plain text
#: minios-cmd.1:67
msgid "Specify the build directory."
msgstr "Especifique o diretório de compilação."

#. type: SS
#: minios-cmd.1:67
#, no-wrap
msgid "System Options"
msgstr "Opções do sistema"

#. type: Plain text
#: minios-cmd.1:70
msgid ""
"These options \\f[B]must be provided\\f[R] unless a configuration file is "
"used:\\fR"
msgstr ""
"Essas opções \\f[B]devem ser fornecidas\\f[R] a menos que um arquivo de "
"configuração seja utilizado:\\fR"

#. type: TP
#: minios-cmd.1:70
#, no-wrap
msgid "\\f[B]-d\\f[R], \\f[B]--distribution\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-d\\f[R], \\f[B]--distribution\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:74
msgid "Specify the distribution name (e.g., `bookworm').  \\f[B]REQUIRED\\fR"
msgstr ""
"Especifique o nome da distribuição (ex.: `bookworm').  \\f[B]OBRIGATÓRIO\\fR"

#. type: TP
#: minios-cmd.1:74
#, no-wrap
msgid "\\f[B]-a\\f[R], \\f[B]--architecture\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-a\\f[R], \\f[B]--architecture\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:78
msgid "Specify the architecture (e.g., `amd64').  \\f[B]REQUIRED\\fR"
msgstr "Especifique a arquitetura (ex.: `amd64').  \\f[B]OBRIGATÓRIO\\fR"

#. type: TP
#: minios-cmd.1:78
#, no-wrap
msgid "\\f[B]-de\\f[R], \\f[B]--desktop-environment\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-de\\f[R], \\f[B]--desktop-environment\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:82
msgid "Specify the desktop environment (e.g., `xfce').  \\f[B]REQUIRED\\fR"
msgstr ""
"Especifique o ambiente de área de trabalho (ex.: `xfce').  "
"\\f[B]OBRIGATÓRIO\\fR"

#. type: TP
#: minios-cmd.1:82
#, no-wrap
msgid "\\f[B]-pv\\f[R], \\f[B]--package-variant\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-pv\\f[R], \\f[B]--package-variant\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:86
msgid "Specify the package variant (e.g., `standard').  \\f[B]REQUIRED\\fR"
msgstr ""
"Especifique a variante de pacote (ex.: `standard').  \\f[B]OBRIGATÓRIO\\fR"

#. type: TP
#: minios-cmd.1:86
#, no-wrap
msgid "\\f[B]-c\\f[R], \\f[B]--compression-type\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-c\\f[R], \\f[B]--compression-type\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:89
msgid "Specify the compression type (e.g., `zstd')."
msgstr "Especifique o tipo de compactação (ex.: `zstd')."

#. type: SS
#: minios-cmd.1:89
#, no-wrap
msgid "Kernel Options"
msgstr "Opções do Kernel"

#. type: TP
#: minios-cmd.1:90
#, no-wrap
msgid "\\f[B]-kp\\f[R], \\f[B]--kernel-provider\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-kp\\f[R], \\f[B]--kernel-provider\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:93
msgid "Select the kernel provider (`distribution' or `minios')."
msgstr "Selecione o provedor do kernel ('distribution' ou 'minios')."

#. type: TP
#: minios-cmd.1:93
#, no-wrap
msgid "\\f[B]-kf\\f[R], \\f[B]--kernel-flavour\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-kf\\f[R], \\f[B]--kernel-flavour\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:96
msgid "Specify the kernel flavour (e.g., `none')."
msgstr "Especifique o flavor do kernel (ex.: `none')."

#. type: TP
#: minios-cmd.1:96
#, no-wrap
msgid "\\f[B]-mk\\f[R], \\f[B]--minios-kernel\\fR"
msgstr "\\f[B]-mk\\f[R], \\f[B]--minios-kernel\\fR"

#. type: Plain text
#: minios-cmd.1:99
msgid "Install the AUFS-enabled MiniOS kernel."
msgstr "Instale o kernel AUFS-habilitado MiniOS."

#. type: TP
#: minios-cmd.1:99
#, no-wrap
msgid "\\f[B]-mks\\f[R], \\f[B]--minios-kernel-series\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-mks\\f[R], \\f[B]--minios-kernel-series\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:103
msgid ""
"Select the MiniOS kernel series (`auto', `6.1', or `6.12') and use the "
"MiniOS provider."
msgstr ""
"Selecione a série do kernel MiniOS ('auto', '6.1' ou '6.12') e utilize o "
"provedor MiniOS."

#. type: TP
#: minios-cmd.1:103
#, no-wrap
msgid "\\f[B]-kpm\\f[R], \\f[B]--kernel-payload-mode\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-kpm\\f[R], \\f[B]--kernel-payload-mode\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:106
msgid "Select the kernel payload mode (`runtime' or `full')."
msgstr "Selecione o modo de payload do kernel ('runtime' ou 'full')."

#. type: TP
#: minios-cmd.1:106
#, no-wrap
msgid "\\f[B]-dkms\\f[R], \\f[B]--kernel-build-dkms\\fR"
msgstr "\\f[B]-dkms\\f[R], \\f[B]--kernel-build-dkms\\fR"

#. type: Plain text
#: minios-cmd.1:109
msgid "Enable compilation of additional drivers during kernel installation."
msgstr ""
"Habilita a compilação de drivers adicionais durante a instalação do kernel."

#. type: SS
#: minios-cmd.1:109
#, no-wrap
msgid "Locale and Timezone Options"
msgstr "Opções de Localização e Fuso Horário"

#. type: TP
#: minios-cmd.1:110
#, no-wrap
msgid "\\f[B]-l\\f[R], \\f[B]--locale\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-l\\f[R], \\f[B]--locale\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:113
msgid "Specify the system locale (e.g., `en_US')."
msgstr "Especifique o locale do sistema (ex.: `en_US')."

#. type: TP
#: minios-cmd.1:113
#, no-wrap
msgid "\\f[B]-ml\\f[R], \\f[B]--multilingual\\fR"
msgstr "\\f[B]-ml\\f[R], \\f[B]--multilingual\\fR"

#. type: Plain text
#: minios-cmd.1:116
msgid "Enable multilingual support."
msgstr "Habilita o suporte multilíngue."

#. type: TP
#: minios-cmd.1:116
#, no-wrap
msgid "\\f[B]-kl\\f[R], \\f[B]--keep-locales\\fR"
msgstr "\\f[B]-kl\\f[R], \\f[B]--keep-locales\\fR"

#. type: Plain text
#: minios-cmd.1:119
msgid "Keep all available locales."
msgstr "Mantém todos os locales disponíveis."

#. type: TP
#: minios-cmd.1:119
#, no-wrap
msgid "\\f[B]-tz\\f[R], \\f[B]--timezone\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-tz\\f[R], \\f[B]--timezone\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:122
msgid "Specify the timezone (e.g., `Etc/UTC')."
msgstr "Especifique o fuso horário (ex.: `Etc/UTC')."

#. type: SS
#: minios-cmd.1:122
#, no-wrap
msgid "Boot Loader Options"
msgstr "Opções do carregador de boot"

#. type: TP
#: minios-cmd.1:123
#, no-wrap
msgid "\\f[B]-ib\\f[R], \\f[B]--initramfs-builder\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-ib\\f[R], \\f[B]--initramfs-builder\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:126
msgid "Specify the initramfs builder (`livekit' or `dracut')."
msgstr "Especifique o construtor do initramfs ('livekit' ou 'dracut')."

#. type: SS
#: minios-cmd.1:126
#, no-wrap
msgid "Boot Menu Options"
msgstr "Opções do Menu de Inicialização"

#. type: TP
#: minios-cmd.1:127
#, no-wrap
msgid "\\f[B]-mln\\f[R], \\f[B]--menu-language\\f[R] \\f[I]NAME\\fR"
msgstr "\\f[B]-mln\\f[R], \\f[B]--menu-language\\f[R] \\f[I]NAME\\fR"

#. type: Plain text
#: minios-cmd.1:131
msgid ""
"Specify the boot menu language (`multilang' for language selection or "
"specific language code like `ru_RU')."
msgstr ""
"Especifique o idioma do menu de inicialização (`multilang' para seleção de "
"idioma ou código de idioma específico como `ru_RU')."

#. type: SH
#: minios-cmd.1:131
#, no-wrap
msgid "DEFAULT SETTINGS"
msgstr "CONFIGURAÇÕES PADRÃO"

#. type: SS
#: minios-cmd.1:132
#, no-wrap
msgid "Kernel Settings"
msgstr "Configurações do Kernel"

#. type: Plain text
#: minios-cmd.1:134
msgid "\\f[B]KERNEL_FLAVOUR\\f[R]: \\[lq]none\\[rq]\\fR"
msgstr "\\f[B]KERNEL_FLAVOUR\\f[R]: \\[lq]none\\[rq]\\fR"

#. type: Plain text
#: minios-cmd.1:137
msgid ""
"\\f[B]KERNEL_PROVIDER\\f[R]: \\[lq]distribution\\[rq] (automatically \\"
"[lq]minios\\[rq] for Trixie/Excalibur i386)\\fR"
msgstr ""
"\\f[B]KERNEL_PROVIDER\\f[R]: \\[lq]distribution\\[rq] (automaticamente \\"
"[lq]minios\\[rq] para Trixie/Excalibur i386)\\fR"

#. type: Plain text
#: minios-cmd.1:139
msgid "\\f[B]MINIOS_KERNEL_SERIES\\f[R]: \\[lq]auto\\[rq]\\fR"
msgstr "\\f[B]MINIOS_KERNEL_SERIES\\f[R]: \\[lq]auto\\[rq]\\fR"

#. type: Plain text
#: minios-cmd.1:141
msgid "\\f[B]KERNEL_PAYLOAD_MODE\\f[R]: \\[lq]runtime\\[rq]\\fR"
msgstr "\\f[B]KERNEL_PAYLOAD_MODE\\f[R]: \\[lq]runtime\\[rq]\\fR"

#. type: SS
#: minios-cmd.1:141
#, no-wrap
msgid "Locale & Timezone Settings"
msgstr "Configurações de Localização e Fuso Horário"

#. type: Plain text
#: minios-cmd.1:144
msgid ""
"\\f[B]LOCALE\\f[R]: \\[lq]en_US\\[rq] \\f[B]LIVE_TIMEZONE\\f[R]: \\[lq]Etc/"
"UTC\\[rq]\\fR"
msgstr ""
"\\f[B]LOCALE\\f[R]: \\[lq]en_US\\[rq] \\f[B]LIVE_TIMEZONE\\f[R]: \\[lq]Etc/"
"UTC\\[rq]\\fR"

#. type: SS
#: minios-cmd.1:144
#, no-wrap
msgid "Boot Loader Settings"
msgstr "Configurações do carregador de boot"

#. type: Plain text
#: minios-cmd.1:146
msgid "\\f[B]INITRAMFS_BUILDER\\f[R]: \\[lq]dracut\\[rq]\\fR"
msgstr "\\f[B]INITRAMFS_BUILDER\\f[R]: \\[lq]dracut\\[rq]\\fR"

#. type: SS
#: minios-cmd.1:146
#, no-wrap
msgid "Boot Menu Settings"
msgstr "Configurações do Menu de Inicialização"

#. type: Plain text
#: minios-cmd.1:148
msgid "\\f[B]MENU_LANG\\f[R]: \\[lq]multilang\\[rq]\\fR"
msgstr "\\f[B]MENU_LANG\\f[R]: \\[lq]multilang\\[rq]\\fR"

#. type: SH
#: minios-cmd.1:148
#, no-wrap
msgid "INTERACTION WITH MINIOS-LIVE"
msgstr "INTERAÇÃO COM O MINIOS-LIVE"

#. type: Plain text
#: minios-cmd.1:153
msgid ""
"\\f[B]minios-cmd\\f[R] prepares the build environment and generates a "
"\\f[B]build.conf\\f[R] configuration file based on the options provided.  It "
"then calls \\f[B]minios-live\\f[R] with the relevant environment variables, "
"delegating the build execution to \\f[B]minios-live\\f[R].\\fR"
msgstr ""
"\\f[B]minios-cmd\\f[R] prepara o ambiente de construção e gera um arquivo de "
"configuração \\f[B]build.conf\\f[R] com base nas opções fornecidas. Em "
"seguida, chama o \\f[B]minios-live\\f[R] com as variáveis de ambiente "
"relevantes, delegando a execução da construção ao \\f[B]minios-live\\f[R]."
"\\fR"

#. type: Plain text
#: minios-cmd.1:155
msgid "Create a MiniOS Standard system image with default settings:"
msgstr ""
"Cria uma imagem de sistema MiniOS Standard com as configurações padrão:"

#. type: Plain text
#: minios-cmd.1:158
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -c zstd -mk -dkms -kl\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -c zstd -mk -dkms -kl\n"

#. type: Plain text
#: minios-cmd.1:161
msgid "Create a MiniOS Toolbox system image with default settings:"
msgstr "Cria uma imagem de sistema MiniOS Toolbox com as configurações padrão:"

#. type: Plain text
#: minios-cmd.1:164
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -c zstd -mk -dkms -kl\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -c zstd -mk -dkms -kl\n"

#. type: Plain text
#: minios-cmd.1:167
msgid "Create a system image with Russian locale:"
msgstr "Crie uma imagem de sistema com localidade russa:"

#. type: Plain text
#: minios-cmd.1:170
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -l ru_RU\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv toolbox -l ru_RU\n"

#. type: Plain text
#: minios-cmd.1:173
msgid "Create a system image with LXQt desktop environment:"
msgstr "Crie uma imagem de sistema com o ambiente de desktop LXQt:"

#. type: Plain text
#: minios-cmd.1:176
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de lxqt -pv standard\n"
msgstr "minios-cmd -d bookworm -a amd64 -de lxqt -pv standard\n"

#. type: Plain text
#: minios-cmd.1:179
msgid "Create a system image for 32-bit architecture:"
msgstr "Crie uma imagem de sistema para arquitetura 32 bits:"

#. type: Plain text
#: minios-cmd.1:182
#, no-wrap
msgid "minios-cmd -d buster -a i386 -de xfce -pv standard\n"
msgstr "minios-cmd -d buster -a i386 -de xfce -pv standard\n"

#. type: Plain text
#: minios-cmd.1:185
msgid "Create a system image with Ubuntu Jammy:"
msgstr "Crie uma imagem de sistema com Ubuntu Jammy:"

#. type: Plain text
#: minios-cmd.1:188
#, no-wrap
msgid "minios-cmd -d jammy -pv standard -a amd64 -de xfce\n"
msgstr "minios-cmd -d jammy -pv standard -a amd64 -de xfce\n"

#. type: Plain text
#: minios-cmd.1:193
msgid ""
"Enable multilingual support (generates locales for English, Spanish, German, "
"French, Italian, Portuguese, Brazilian Portuguese, Russian, and Indonesian):"
msgstr ""
"Habilite o suporte multilíngue (gera localidades para inglês, espanhol, "
"alemão, francês, italiano, português, português do Brasil, russo e "
"indonésio):"

#. type: Plain text
#: minios-cmd.1:196
#, no-wrap
msgid "minios-cmd -d trixie -a amd64 -de xfce -pv standard -ml\n"
msgstr "minios-cmd -d trixie -a amd64 -de xfce -pv standard -ml\n"

#. type: Plain text
#: minios-cmd.1:199
msgid "Create a system image with Russian boot menu language:"
msgstr "Crie uma imagem de sistema com idioma russo no menu de inicialização:"

#. type: Plain text
#: minios-cmd.1:202
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -mln ru_RU\n"
msgstr "minios-cmd -d bookworm -a amd64 -de xfce -pv standard -mln ru_RU\n"

#. type: Plain text
#: minios-cmd.1:205
msgid "Create a system image with livekit initramfs builder (smaller size):"
msgstr ""
"Crie uma imagem do sistema com o construtor de initramfs livekit (tamanho "
"reduzido):"

#. type: Plain text
#: minios-cmd.1:208
#, no-wrap
msgid "minios-cmd -d bookworm -a amd64 -de flux -pv standard -ib livekit\n"
msgstr "minios-cmd -d bookworm -a amd64 -de flux -pv standard -ib livekit\n"

#. type: SH
#: minios-cmd.1:209
#, no-wrap
msgid "GENERATING AND USING CONFIGURATION FILES"
msgstr "GERAÇÃO E USO DE ARQUIVOS DE CONFIGURAÇÃO"

#. type: Plain text
#: minios-cmd.1:211
msgid "Generate a configuration file:"
msgstr "Gerar um arquivo de configuração:"

#. type: Plain text
#: minios-cmd.1:214
#, no-wrap
msgid "minios-cmd --config-only --config-file myconfig.conf -d bookworm -a amd64 -de xfce -pv standard\n"
msgstr "minios-cmd --config-only --config-file myconfig.conf -d bookworm -a amd64 -de xfce -pv standard\n"

#. type: Plain text
#: minios-cmd.1:217
msgid "Use the configuration file with \\f[B]minios-live\\f[R]:\\fR"
msgstr "Utilize o arquivo de configuração com \\f[B]minios-live\\f[R]:\\fR"

#. type: Plain text
#: minios-cmd.1:220
#, no-wrap
msgid "BUILD_CONF=/path/to/myconfig.conf minios-live -\n"
msgstr "BUILD_CONF=/path/to/myconfig.conf minios-live -\n"

#. type: Plain text
#: minios-cmd.1:223
msgid "or:"
msgstr "ou:"

#. type: Plain text
#: minios-cmd.1:227
#, no-wrap
msgid ""
"export BUILD_CONF=/path/to/myconfig.conf\n"
"minios-live -\n"
msgstr ""
"export BUILD_CONF=/path/to/myconfig.conf\n"
"minios-live -\n"

#. type: Plain text
#: minios-cmd.1:231
msgid ""
"\\f[B]minios-live\\f[R](1), \\f[B]condinapt\\f[R](1), \\f[B]condinapt-"
"minios\\f[R](7)\\fR"
msgstr ""
"\\f[B]minios-live\\f[R](1), \\f[B]condinapt\\f[R](1), \\f[B]condinapt-"
"minios\\f[R](7)\\fR"
