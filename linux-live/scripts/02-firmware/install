#!/bin/bash

set -e          # exit on error
set -o pipefail # exit on pipeline error
set -u          # treat unset variable as error

. /minioslib
. /minios_build.conf

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

echo "firmware-ipw2x00 firmware-ipw2x00/license/accepted boolean true" | debconf-set-selections
echo "b43-fwcutter b43-fwcutter/install-unconditional boolean true" | debconf-set-selections

if ! /condinapt -l "${SCRIPT_DIR}/packages.list" -c "${SCRIPT_DIR}/minios_build.conf" -m "${SCRIPT_DIR}/condinapt.map"; then
    error "Failed to install packages."
    exit 1
fi

# Avoid storing individually compressed firmware inside the compressed MiniOS
# module. Keep dpkg ownership metadata synchronized with the normalized paths.
normalize_package_compressed_files /lib/firmware zst
normalize_package_compressed_files /lib/firmware xz
