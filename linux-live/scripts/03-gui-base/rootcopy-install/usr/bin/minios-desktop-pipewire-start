#!/bin/sh
set -eu
for daemon in pipewire pipewire-pulse wireplumber; do
    command -v "$daemon" >/dev/null 2>&1 || exit 0
done
uid=$(id -u)
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$uid}
[ -d "$runtime_dir" ] && [ -w "$runtime_dir" ] || exit 0
export XDG_RUNTIME_DIR="$runtime_dir"
# A systemd user session owns socket activation and daemon restarts.
if [ -d /run/systemd/system ] && systemctl --user show-environment >/dev/null 2>&1; then
    exit 0
fi
if [ ! -S "$runtime_dir/pipewire-0" ] && ! pgrep -u "$uid" -x pipewire >/dev/null 2>&1; then
    pipewire >"$runtime_dir/pipewire.log" 2>&1 &
fi
attempt=0
while [ ! -S "$runtime_dir/pipewire-0" ] && [ "$attempt" -lt 30 ]; do
    sleep 0.1
    attempt=$((attempt + 1))
done
[ -S "$runtime_dir/pipewire-0" ] || exit 0
# Repair a partially started session without creating duplicate companion daemons.
if ! pgrep -u "$uid" -x pipewire-pulse >/dev/null 2>&1; then
    pipewire-pulse >"$runtime_dir/pipewire-pulse.log" 2>&1 &
fi
if ! pgrep -u "$uid" -x wireplumber >/dev/null 2>&1; then
    wireplumber >"$runtime_dir/wireplumber.log" 2>&1 &
fi
