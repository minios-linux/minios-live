LXQtPanel #BackgroundWidget {
    background: rgba(31, 33, 36, 230);
    color: #eeeeee;
}
LXQtPanel QToolButton {
    color: #eeeeee;
    background: transparent;
    border: none;
    padding: 4px;
}
LXQtPanel QToolButton:hover, LXQtPanel QToolButton:checked {
    background: #4a90d9;
    color: #ffffff;
}
