#!/bin/bash
set -euo pipefail

. /minioslib
console_colors
. /minios_build.conf

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
minios_desktop_install_packages "$SCRIPT_DIR"
minios_desktop_remove_optional lxqt-admin lxqt-about
minios_desktop_defaults lxqt /usr/bin/qterminal pcmanfm-qt.desktop featherpad.desktop
minios_desktop_openbox_defaults lxqt qterminal pcmanfm-qt lxqt-runner lxqt-leave

test -x /usr/bin/startlxqt
update-alternatives --install /usr/bin/x-session-manager x-session-manager /usr/bin/minios-lxqt-session 90
update-alternatives --set x-session-manager /usr/bin/minios-lxqt-session

mkdir -p /etc/skel/.config/lxqt /etc/skel/.config/pcmanfm-qt/lxqt /etc/skel/.config/qterminal.org
cat >/etc/skel/.config/lxqt/lxqt.conf <<EOF
[General]
theme=MiniOS
icon_theme=$MINIOS_ICON_THEME
single_click_activate=false
palette_override=true

[Qt]
font="Inter,9,-1,5,50,0,0,0,0,0"
style=Fusion

[Palette]
window_color=$([ "$PACKAGE_VARIANT" = ultra ] && echo '#303235' || echo '#eeeeee')
window_text_color=$([ "$PACKAGE_VARIANT" = ultra ] && echo '#eeeeee' || echo '#2e3436')
base_color=$([ "$PACKAGE_VARIANT" = ultra ] && echo '#1f2124' || echo '#ffffff')
text_color=$([ "$PACKAGE_VARIANT" = ultra ] && echo '#eeeeee' || echo '#2e3436')
button_color=$([ "$PACKAGE_VARIANT" = ultra ] && echo '#303235' || echo '#eeeeee')
button_text_color=$([ "$PACKAGE_VARIANT" = ultra ] && echo '#eeeeee' || echo '#2e3436')
highlight_color=#4a90d9
highlighted_text_color=#ffffff
link_color=#4a90d9
EOF
cat >/etc/skel/.config/lxqt/session.conf <<'EOF'
[General]
window_manager=openbox

[Mouse]
cursor_theme=Breeze_Light
cursor_size=24
EOF
cat >/etc/skel/.config/pcmanfm-qt/lxqt/settings.conf <<EOF
[Behavior]
SingleClick=false
RecentFilesNumber=0

[Desktop]
Wallpaper=$MINIOS_WALLPAPER
WallpaperMode=zoom
PerScreenWallpaper=false
Font="Inter,9,-1,5,50,0,0,0,0,0"
DesktopIconSize=48
DesktopShortcuts=Home, Trash

[System]
Terminal=qterminal
Archiver=$([ "$PACKAGE_VARIANT" = minimum ] && echo xarchiver || echo lxqt-archiver)
SuCommand=lxqt-sudo %s
FallbackIconThemeName=$MINIOS_ICON_THEME

[Volume]
AutoRun=false
MountOnStartup=true
MountRemovable=true
EOF
cat >/etc/skel/.config/qterminal.org/qterminal.ini <<'EOF'
[General]
fontFamily=JetBrains Mono
fontSize=10
colorScheme=Linux
MenuVisible=false
HistoryLimited=true
HistoryLimitedTo=10000
TerminalTransparency=0
EOF
# lxqt-session requires lxqt-themes, but its distribution wallpapers are not used.
if [ -d /usr/share/lxqt/wallpapers ]; then
    rm -rf /usr/share/lxqt/wallpapers
fi
chmod +x /usr/bin/minios-lxqt-session /usr/bin/minios-desktop-pipewire-start \
    /etc/skel/.xsession /etc/skel/.xinitrc
