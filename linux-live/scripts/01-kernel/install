#!/bin/bash

set -e
set -o pipefail
set -u

. /minioslib

TMP_PKGLIST="$(mktemp /tmp/kernel-package.list.XXXXXX)"
trap 'rm -f "${TMP_PKGLIST}"' EXIT

[ "${INSTALL_KERNEL}" = true ] || exit 0

run_with_spinner "Updating package lists" apt-get update --allow-releaseinfo-change
run_with_spinner "Installing kernel build prerequisites" \
    apt-get install -y --no-install-recommends ca-certificates gnupg gpgv xz-utils zstd kmod
[ ! -e /etc/kernel/postinst.d/initramfs-tools ] || chmod -x /etc/kernel/postinst.d/initramfs-tools
[ ! -e /etc/kernel/postrm.d/initramfs-tools ] || chmod -x /etc/kernel/postrm.d/initramfs-tools

if [ "${KERNEL_PROVIDER}" = minios ]; then
    printf '%s\n' "${KERNEL_METAPACKAGE}" >"${TMP_PKGLIST}"
    /condinapt -l "${TMP_PKGLIST}" -c /minios_build.conf -m /condinapt.map

    mapfile -t KERNEL_IMAGES < <(find /boot -maxdepth 1 -type f -name 'vmlinuz-*' -print | sort -V)
    [ "${#KERNEL_IMAGES[@]}" -eq 1 ] || {
        error "MiniOS kernel provider must install exactly one kernel image"
        exit 1
    }
    KERNEL_RELEASE="${KERNEL_IMAGES[0]##*/vmlinuz-}"
    KERNEL_CONFIG="/boot/config-${KERNEL_RELEASE}"
    [ -f "${KERNEL_CONFIG}" ] || {
        error "MiniOS kernel has no matching config: ${KERNEL_CONFIG}"
        exit 1
    }
    grep -Eq '^CONFIG_AUFS_FS=[ym]$' "${KERNEL_CONFIG}" || {
        error "MiniOS kernel ${KERNEL_RELEASE} does not provide AUFS support"
        exit 1
    }
    depmod "${KERNEL_RELEASE}"
    sed -i '/^KERNEL=/d;/^KERNEL_VERSION=/d;/^KERNEL_BUILD_ARCH=/d' /minios_build.conf
    {
        printf 'KERNEL="%s"\n' "${KERNEL_RELEASE}"
        printf 'KERNEL_VERSION="%s"\n' "${KERNEL_RELEASE}"
        printf 'KERNEL_BUILD_ARCH="%s"\n' "${KERNEL_APT_ARCH}"
    } >>/minios_build.conf
    exit 0
fi

[ -x /kernel-acquire ] || {
    error "Isolated kernel acquisition helper is unavailable"
    exit 1
}

/kernel-acquire
