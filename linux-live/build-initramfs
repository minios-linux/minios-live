#!/bin/bash

: ${BUILD_SCRIPTS:="linux-live"}

export PATH=.:./tools:../tools:/usr/sbin:/usr/bin:/sbin:/bin:/

. /minioslib || exit 1
. /minios_build.conf || exit 1
KERNEL="${KERNEL:-$(file /boot/vmlinuz-* | grep -oP 'version \K[^\s]+')}"

console_colors

# Determine which initramfs builder to use
INITRAMFS_BUILDER="${INITRAMFS_BUILDER:-dracut}"
INITRAMFS_CRYPT="${INITRAMFS_CRYPT:-false}"
CRYPT_ARGS=()
[ "$INITRAMFS_CRYPT" = "true" ] && CRYPT_ARGS=(--crypt)

case "$INITRAMFS_BUILDER" in
dracut)
    # Build initramfs using dracut
    if [ "${VERBOSITY_LEVEL}" -ge 2 ]; then
        echo -e "   ${YELLOW}KERNEL=${KERNEL}${ENDCOLOR}"
        echo -e "   ${YELLOW}INITRAMFS_BUILDER=dracut${ENDCOLOR}"
    fi

    cd /$BUILD_SCRIPTS/initramfs/dracut-mos
    chmod 755 ./mkdracut

    # Build initramfs with mkdracut
    if [ "${PACKAGE_VARIANT}" = "minimum" ]; then
        run_with_spinner "Building dracut initramfs image" ./mkdracut -k "$KERNEL" "${CRYPT_ARGS[@]}"
    else
        run_with_spinner "Building dracut initramfs image" ./mkdracut -k "$KERNEL" -n -c "${CRYPT_ARGS[@]}"
    fi

    # Check if initramfs was created successfully
    if [ ! -f /boot/initrfs.img ]; then
        echo "E: Failed to create initramfs" >&2
        exit 1
    fi
    ;;

livekit | *)
    # Build initramfs using livekit (default)
    if [ "${VERBOSITY_LEVEL}" -ge 2 ]; then
        echo -e "   ${YELLOW}KERNEL=${KERNEL}${ENDCOLOR}"
        echo -e "   ${YELLOW}INITRAMFS_BUILDER=livekit${ENDCOLOR}"
    fi

    cd /$BUILD_SCRIPTS/initramfs/livekit-mos
    chmod 755 ./mkinitrfs

    TMPFILE=$(mktemp)
    if [ "${PACKAGE_VARIANT}" = "minimum" ]; then
        run_with_spinner "Building initramfs image" ./mkinitrfs -k "$KERNEL" -dm "${CRYPT_ARGS[@]}" >"$TMPFILE"
    else
        run_with_spinner "Building initramfs image" ./mkinitrfs -k "$KERNEL" -n -c -dm "${CRYPT_ARGS[@]}" >"$TMPFILE"
    fi

    INITRAMFS=$(tail -n 1 "$TMPFILE" | xargs)
    rm "$TMPFILE"

    if [ -n "$INITRAMFS" ]; then
        mv "$INITRAMFS" /boot/initrfs.img
    fi
    ;;
esac
