# =================================================================
# timing and debug variables
# =================================================================

TIMING_ENABLED=""
TIMING_LAST_TIME=""
TIMING_LAST_FUNCTION=""

# =================================================================
# debug and output functions
# =================================================================

debug_start() {
   if grep -q debug /proc/cmdline; then
      DEBUG_IS_ENABLED=1
      set -x
   else
      DEBUG_IS_ENABLED=
   fi

   # Initialize timing if timing parameter is present
   if grep -q timing /proc/cmdline; then
      TIMING_ENABLED=1
      if [ -r /proc/uptime ]; then
         TIMING_LAST_TIME=$(awk '{print $1}' /proc/uptime)
      fi
   else
      TIMING_ENABLED=
   fi

   # Start timing with a marker
   debug_log "init_start" "MiniOS initialization begins"
}

debug_log() {
   local FUNC_NAME

   # Extract function name from debug message
   FUNC_NAME=$(echo "$1" | awk '{print $1}')

   # Handle timing
   if [ -r /proc/uptime ]; then
      local CURRENT_TIME ELAPSED_TIME MESSAGE
      CURRENT_TIME=$(awk '{print $1}' /proc/uptime)

      # Initialize timing on first call if not already set
      if [ -z "$TIMING_LAST_TIME" ]; then
         TIMING_LAST_TIME="$CURRENT_TIME"
      fi

      if [ -n "$TIMING_LAST_FUNCTION" ] && [ "$TIMING_LAST_FUNCTION" != "$FUNC_NAME" ]; then
         ELAPSED_TIME=$(awk "BEGIN {printf \"%.2f\", $CURRENT_TIME - $TIMING_LAST_TIME}")
         MESSAGE="$TIMING_LAST_FUNCTION -> $FUNC_NAME: +${ELAPSED_TIME}s"

         if [ "$TIMING_ENABLED" ]; then
            log "- timing: $MESSAGE"
            echo "  $MESSAGE" >&2
         fi
      elif [ -z "$TIMING_LAST_FUNCTION" ]; then
         MESSAGE="$FUNC_NAME: started"
         if [ "$TIMING_ENABLED" ]; then
            log "- timing: $MESSAGE"
            echo "  $MESSAGE" >&2
         fi
      fi

      TIMING_LAST_TIME="$CURRENT_TIME"
      TIMING_LAST_FUNCTION="$FUNC_NAME"
   fi

   # Standard debug logging
   if [ "$DEBUG_IS_ENABLED" ]; then
      echo "- debug: $*" >&2
   fi
   log "- debug: $*"
}

# header
# Print header with TITLE, URL and SLOGAN
# -t TITLE
# -u URL
# -s SLOGAN
#
header() {
   local TITLE="" URL="" SLOGAN=""

   OPTIND=1
   while getopts ":t:u:s:" OPT; do
      case "$OPT" in
      t) TITLE="$OPTARG" ;;
      u) URL="$OPTARG" ;;
      s) SLOGAN="$OPTARG" ;;
      *)
         echo "Usage: header -t title [-u url] [-s slogan]" >&2
         return 1
         ;;
      esac
   done

   local FORMATTED_TITLE FORMATTED_URL FORMATTED_SLOGAN
   [ -n "$TITLE" ] && FORMATTED_TITLE="[1;37m${TITLE}[0;0m"
   [ -n "$URL" ] && FORMATTED_URL="[1;94m${URL}[0;0m"
   [ -n "$SLOGAN" ] && FORMATTED_SLOGAN="[1;37m${SLOGAN}[0;0m"

   local SEP="" TEXT=""
   [ -n "$FORMATTED_TITLE" ] && {
      TEXT="${TEXT}${SEP}${FORMATTED_TITLE}"
      SEP=" - "
   }
   [ -n "$FORMATTED_URL" ] && {
      TEXT="${TEXT}${SEP}${FORMATTED_URL}"
      SEP=" - "
   }
   [ -n "$FORMATTED_SLOGAN" ] && { TEXT="${TEXT}${SEP}${FORMATTED_SLOGAN}"; }

   [ -n "$TEXT" ] && echo "  $TEXT"
}

# echo green star
#
echo_green_star() {
   echo -ne "[0;32m""* ""[0;39m"
}

# echo red star
#
echo_red_star() {
   echo -ne "[0;31m""* ""[0;39m"
}

# echo yellow star
#
echo_yellow_star() {
   echo -ne "[0;33m""* ""[0;39m"
}

# echo white star
#
echo_white_star() {
   echo -ne "[1;37m""* ""[0;39m"
}

# log - store given text in /var/log/livedbg
#
log() {
   echo "$@" 2>/dev/null >>/var/log/livedbg
}

# Only resources recorded here were created for the LUKS persistence container.
close_owned_crypt() {
   local MAPPER STATUS=0 STATE="${1:-/run/initramfs/minios-crypt}"
   [ -d "$STATE" ] || return 0
   [ -f "$STATE/mapper" ] && MAPPER=$(cat "$STATE/mapper")
   if [ -n "$MAPPER" ] && [ -b "/dev/mapper/$MAPPER" ] && ! cryptsetup close "$MAPPER" 2>/dev/null; then
      STATUS=1
   fi
   [ "$STATUS" -ne 0 ] || rm -rf "$STATE"
   return "$STATUS"
}

luks_layer_available() {
   local MARKER
   command -v cryptsetup >/dev/null 2>&1 || return 1
   for MARKER in ${MINIOS_CRYPT_MARKERS:-/etc/minios-initramfs-crypt /run/initramfs/etc/minios-initramfs-crypt}; do
      [ -f "$MARKER" ] || continue
      grep -qx 'luks-layer-v1' "$MARKER" 2>/dev/null && return 0
   done
   return 1
}

luks_mapper_ready() {
   [ -b "/dev/mapper/$1" ]
}

echolog() {
   echo "$@"
   log "$@"
}

# show information about the debug shell
#
show_debug_banner() {
   echo
   echo "====="
   echo ": Debugging started. Here is the root shell for you."
   echo ": Type your desired commands or hit Ctrl+D to continue booting."
   echo
}

# debug_shell
# executed when debug boot parameter is present
#
debug_shell() {
   if [ "$DEBUG_IS_ENABLED" ]; then
      show_debug_banner
      setsid sh -c 'exec sh < /dev/tty1 >/dev/tty1 2>&1'
      echo
   fi
}

fatal() {
   echolog
   header "Fatal error occured - $1"
   echolog "Something went wrong and we can't continue. This should never happen."
   echolog "Please reboot your computer with Ctrl+Alt+Delete ..."
   echolog
   while :; do
      setsid sh -c 'exec sh < /dev/tty1 >/dev/tty1 2>&1'
      sleep 1
   done
}

# get value of commandline parameter $1
# $1 = parameter to search for
#
cmdline_value() {
   cat /proc/cmdline | egrep -o "(^|[[:space:]])$1=[^[:space:]]+" | tr -d " " | cut -d "=" -f 2- | tail -n 1
}

boot_console_mirror_start() {
   local CMDLINE LOG_DIR TTY0 TTYS0
   CMDLINE="${MINIOS_BOOT_CMDLINE:-$(cat /proc/cmdline 2>/dev/null)}"
   TTY0="${MINIOS_CONSOLE_TTY0:-/dev/tty0}"
   TTYS0="${MINIOS_CONSOLE_TTYS0:-/dev/ttyS0}"
   BOOT_CONSOLE_LOG="${MINIOS_INITRD_LOG:-/var/log/initrd.log}"

   command -v tee >/dev/null 2>&1 || return 0
   LOG_DIR=${BOOT_CONSOLE_LOG%/*}
   [ "$LOG_DIR" != "$BOOT_CONSOLE_LOG" ] || LOG_DIR=.
   mkdir -p "$LOG_DIR" 2>/dev/null || return 0

   BOOT_CONSOLE_MIRROR_FIFO="${MINIOS_CONSOLE_FIFO:-/dev/.minios-console-log}"
   rm -f "$BOOT_CONSOLE_MIRROR_FIFO"
   mkfifo "$BOOT_CONSOLE_MIRROR_FIFO" || return 0

   exec 7>&1 8>&2
   case " $CMDLINE " in
   *" console=tty0 "*" console=ttyS0,"*)
      if [ -c "$TTY0" ] && [ -c "$TTYS0" ]; then
         tee "$BOOT_CONSOLE_LOG" "$TTY0" "$TTYS0" \
            <"$BOOT_CONSOLE_MIRROR_FIFO" >/dev/null 7>&- 8>&- &
      else
         tee "$BOOT_CONSOLE_LOG" <"$BOOT_CONSOLE_MIRROR_FIFO" >&7 2>&8 7>&- 8>&- &
      fi
      ;;
   *)
      tee "$BOOT_CONSOLE_LOG" <"$BOOT_CONSOLE_MIRROR_FIFO" >&7 2>&8 7>&- 8>&- &
      ;;
   esac
   BOOT_CONSOLE_MIRROR_PID=$!
   exec >"$BOOT_CONSOLE_MIRROR_FIFO" 2>&1
}

boot_console_mirror_stop() {
   local TARGET_ROOT="${1:-}"
   [ -n "$BOOT_CONSOLE_MIRROR_PID" ] || return 0

   exec 1>&7 2>&8
   exec 7>&- 8>&-
   wait "$BOOT_CONSOLE_MIRROR_PID"
   rm -f "$BOOT_CONSOLE_MIRROR_FIFO"
   if [ -n "$TARGET_ROOT" ] && [ -f "$BOOT_CONSOLE_LOG" ]; then
      mkdir -p "$TARGET_ROOT/run/initramfs/var/log" 2>/dev/null &&
         cp -a "$BOOT_CONSOLE_LOG" "$TARGET_ROOT/run/initramfs/var/log/initrd.log" 2>/dev/null || true
   fi
   BOOT_CONSOLE_MIRROR_PID=
   BOOT_CONSOLE_MIRROR_FIFO=
}

# get value of config parameter $2
# $1 = config file name
# $2 = parameter to search for
#
config_value() {
   cat $1 | egrep -o "(^|[[:space:]])$2=[^[:space:]]+" | tr -d " " | cut -d "=" -f 2- | tail -n 1 | sed 's/"//g'
}

#! test if the script is started by root user. If not, exit
#
allow_only_root() {
   if [ "0$UID" -ne 0 ]; then
      echo "Only root can run $(basename $0)"
      exit 1
   fi
}

#! Create bundle
# call mksquashfs with apropriate arguments
# $1 = directory which will be compressed to squashfs bundle
# $2 = output file
# $3..$9 = optional arguments like -keep-as-directory or -b 123456789
#
create_bundle() {
   debug_log "create_module" "$*"
   rm -f "$2" # overwrite, never append to existing file
   mksquashfs "$1" "$2" -comp xz -b 1024K -Xbcj x86 -always-use-fragments $3 $4 $5 $6 $7 $8 $9 >/dev/null
}

# Move entire initramfs tree to tmpfs mount.
# It's a bit tricky but is necessary to enable pivot_root
# even for initramfs boot image
#
transfer_initramfs() {
   if [ ! -r /lib/initramfs_escaped ]; then
      #echo "switch root from initramfs to ramfs"
      SWITCH=/m # one letter directory
      mkdir -p $SWITCH
      mount -t tmpfs -o size="100%" tmpfs $SWITCH
      cp -a /??* $SWITCH 2>/dev/null # only copy two-and-more-letter directories
      cd $SWITCH
      echo "This file indicates that we successfully escaped initramfs" >$SWITCH/lib/initramfs_escaped
      exec switch_root -c /dev/console . $0
   fi
}

# Dracut-adapted transfer_initramfs
#
transfer_initramfs_dracut() {
   if [ ! -r /lib/initramfs_escaped ]; then
      SWITCH=/m
      mkdir -p $SWITCH
      mount -t tmpfs -o size="100%" tmpfs $SWITCH

      # Copy all content from root, excluding special filesystems
      for item in /*; do
         case "$item" in
         /dev | /proc | /sys | /run | /m) continue ;; # Skip special filesystems and SWITCH dir
         *) cp -a "$item" $SWITCH/ 2>/dev/null ;;
         esac
      done

      # Create mount points for special filesystems
      mkdir -p $SWITCH/dev $SWITCH/proc $SWITCH/sys $SWITCH/run

      # Move special filesystems to new location
      cd $SWITCH
      mount --move /dev $SWITCH/dev 2>/dev/null || mount --bind /dev $SWITCH/dev
      mount --move /proc $SWITCH/proc 2>/dev/null || mount --bind /proc $SWITCH/proc
      mount --move /sys $SWITCH/sys 2>/dev/null || mount --bind /sys $SWITCH/sys
      mount --move /run $SWITCH/run 2>/dev/null || mount --bind /run $SWITCH/run

      echo "This file indicates that we successfully escaped initramfs" >$SWITCH/lib/initramfs_escaped

      # Suppress stderr before switch_root to hide udev mknod "File exists" errors
      exec 2>/dev/null

      # Use dracut's switch_root
      exec switch_root . $0
   fi

   # Restore stderr after transfer (udev has settled by now)
   if [ -r /lib/initramfs_escaped ]; then
      exec 2>&1
   fi
}

# mount virtual filesystems like proc etc
#
init_proc_sysfs() {
   debug_log "init_proc_sysfs" "$*"
   mkdir -p /proc /sys /etc $MEMORY
   mount -n -t proc proc /proc
   echo "0" >/proc/sys/kernel/printk
   mount -n -t sysfs sysfs /sys
   mount -n -o remount,rw rootfs /
   ln -sf /proc/mounts /etc/mtab
}

# modprobe all modules found in initial ramdisk
# $1 = -e for match, -v for negative match
# $2 = regex pattern
#
modprobe_everything() {
   debug_log "modprobe_everything" "$*"

   echo_white_star >&2
   echo "Probing for hardware" >&2

   find /lib/modules/ | fgrep .ko | egrep $1 $2 | sed -r "s:^.*/|[.]ko\$::g" | xargs -n 1 modprobe 2>/dev/null
   refresh_devs
}

refresh_devs() {
   debug_log "refresh_devs" "$*"
   if [ -r /proc/sys/kernel/hotplug ]; then
      echo /sbin/mdev >/proc/sys/kernel/hotplug
   fi
   mdev -s
}

# make sure some devices are there
#
init_devs() {
   debug_log "init_devs" "$*"
   modprobe zram 2>/dev/null
   modprobe loop 2>/dev/null
   modprobe squashfs 2>/dev/null
   modprobe fuse 2>/dev/null
   modprobe ext4 2>/dev/null
   refresh_devs
}

# Activate zram (auto-compression of RAM)
# Compressed RAM consumes 1/2 or even 1/4 of original size
#
init_zram() {
   if grep -q nozram /proc/cmdline; then
      return
   fi
   debug_log "init_zram" "$*"
   echo_white_star
   echo "Setting dynamic RAM compression using ZRAM if available"
   ZRAMCOMP=$(cmdline_value zramcomp)
   ZRAMSIZE=$(cmdline_value zramsize)
   TOTAL_MEM_KB=$(awk '/MemTotal/ {print $2}' /proc/meminfo)

   if [ -z "$ZRAMSIZE" ]; then
      if [ "$TOTAL_MEM_KB" -ge 4194304 ]; then
         ZRAMSIZE=2048
      elif [ "$TOTAL_MEM_KB" -ge 1048576 ]; then
         ZRAMSIZE=$((TOTAL_MEM_KB / 1024 / 2))
      else
         ZRAMSIZE=512
      fi
   fi

   ZRAMSIZE=$((ZRAMSIZE * 1024 * 1024))
   if [ -r /sys/block/zram0/comp_algorithm ]; then
      case "$ZRAMCOMP" in
      lzo | lzo-rle | lz4 | lz4hc | zstd)
         echo $ZRAMCOMP >/sys/block/zram0/comp_algorithm
         ;;
      esac
   fi
   if [ -r /sys/block/zram0/disksize ]; then
      echo $ZRAMSIZE >/sys/block/zram0/disksize
      mkswap /dev/zram0 >/dev/null
      swapon /dev/zram0
      echo 100 >/proc/sys/vm/swappiness
   fi
}

secure_boot_enabled() {
   local EFIVARS VAR VALUE
   EFIVARS="${MINIOS_EFIVARS_DIR:-/sys/firmware/efi/efivars}"
   VAR="$EFIVARS/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"

   if [ -z "${MINIOS_EFIVARS_DIR:-}" ] && [ ! -r "$VAR" ] && [ -d /sys/firmware/efi ]; then
      mkdir -p "$EFIVARS" 2>/dev/null || true
      modprobe efivarfs 2>/dev/null || true
      mount -t efivarfs efivarfs "$EFIVARS" 2>/dev/null || true
   fi
   [ -r "$VAR" ] || return 1
   VALUE=$(dd if="$VAR" bs=1 skip=4 count=1 2>/dev/null | od -An -tu1 2>/dev/null | tr -d ' \n')
   [ "$VALUE" = 1 ]
}

aufs_is_supported() {
   cat /proc/filesystems | grep aufs >/dev/null 2>&1
}

aufs_ng_is_loaded() {
   [ -d "${MINIOS_SYS_MODULE:-/sys/module}/aufs_ng" ]
}

aufs_is_usable() {
   aufs_is_supported || return 1
   if secure_boot_enabled && aufs_ng_is_loaded; then
      return 1
   fi
   return 0
}

load_aufs_module() {
   secure_boot_enabled && return 1
   modprobe aufs 2>/dev/null || modprobe aufs-ng 2>/dev/null
}

mount_aufs_union() {
   if aufs_ng_is_loaded; then
      mount -t aufs -o "xino=/.xino,br:$1=rw" aufs "$2"
   else
      mount -t aufs -o xino="/.xino",trunc_xino,br="$1" aufs "$2"
   fi
}

# OverlayFS build layers encode deletions as character devices 0:0. Remove any
# visible markers through the runtime union so its native whiteout is created.
normalize_module_whiteouts() {
   local ROOT="$1" PATHNAME DEVICE STATUS=0
   local LIST="/tmp/minios-whiteouts.$$"

   [ "$(get_union_fs)" = aufs ] || return 0

   find "$ROOT" -xdev -type c -print >"$LIST" 2>/dev/null || {
      rm -f "$LIST"
      return 1
   }
   while IFS= read -r PATHNAME; do
      # AUFS can enumerate an OverlayFS whiteout that shadows a lower symlink,
      # but stat resolves the conflicting union path and fails. Since find has
      # already identified it as a character device, remove that marker too.
      DEVICE=$(stat -c '%t:%T' "$PATHNAME" 2>/dev/null) || {
         rm -f -- "$PATHNAME" || STATUS=1
         continue
      }
      [ "$DEVICE" = 0:0 ] || continue
      rm -f -- "$PATHNAME" || {
         STATUS=1
         break
      }
   done <"$LIST"
   rm -f "$LIST"
   return "$STATUS"
}

publish_union_branch_inventory() {
   local CHANGES="$1" BUNDLES="$2"
   local INVENTORY="${3:-/minios-aufs-branches}"
   local TEMP="${INVENTORY}.tmp.$$" RAW="/tmp/minios-aufs-active-branches.$$"
   local KEYED="/tmp/minios-aufs-keyed.$$" SORTED="/tmp/minios-aufs-sorted.$$"
   local PATHS="/tmp/minios-aufs-paths.$$" ORDERED="/tmp/minios-aufs-ordered.$$" BUNDLE

   if [ "$(get_union_fs)" != aufs ]; then
      rm -f "$INVENTORY"
      return 0
   fi

   [ -f "$RAW" ] || return 1
   sed -r 's,(.*/(.*)),\2:\1,' <"$RAW" >"$KEYED" &&
      sort -n <"$KEYED" >"$SORTED" &&
      cut -d : -f 2- <"$SORTED" >"$PATHS" &&
      tac <"$PATHS" >"$ORDERED" || {
         rm -f "$RAW" "$KEYED" "$SORTED" "$PATHS" "$ORDERED"
         return 1
      }
   (
      umask 077
      {
         printf '%s=rw\n' "$CHANGES"
         while IFS= read -r BUNDLE; do
            printf '%s=rr+wh\n' "$BUNDLE"
         done <"$ORDERED"
      } >"$TEMP" && chmod 0644 "$TEMP"
   ) || {
      rm -f "$TEMP" "$RAW" "$KEYED" "$SORTED" "$PATHS" "$ORDERED"
      return 1
   }
   rm -f "$RAW" "$KEYED" "$SORTED" "$PATHS" "$ORDERED"
   mv -f "$TEMP" "$INVENTORY"
}

install_aufs_runtime_inventory() {
   local ROOT="$1" SOURCE="${2:-/minios-aufs-branches}"
   local TARGET="$ROOT/run/initramfs/minios-aufs-branches"
   local LOCK="$ROOT/run/initramfs/minios-aufs-branches.lock"

   [ -f "$SOURCE" ] || return 0
   mkdir -p "$ROOT/run/initramfs" || return 1
   cp -a "$SOURCE" "$TARGET" || return 1
   chmod 0644 "$TARGET" || return 1
   : >"$LOCK" || return 1
   chmod 0644 "$LOCK"
}

# Detect which union filesystem to use
# Can be overridden with union= kernel parameter
#
get_union_fs() {
   local UNION_PARAM=$(cmdline_value union)

   if [ -n "$UNION_PARAM" ]; then
      case "$UNION_PARAM" in
      aufs)
         if aufs_is_usable >/dev/null; then
            echo "aufs"
            return
         else
            echo "overlayfs"
            return
         fi
         ;;
      overlayfs)
         echo "overlayfs"
         return
         ;;
      *)
         echo "Warning: invalid union parameter '$UNION_PARAM'" >&2
         ;;
      esac
   fi

   if aufs_is_usable >/dev/null; then
      echo "aufs"
   else
      echo "overlayfs"
   fi
}

# Get currently running kernel version
#
get_running_kernel() {
   local CMDLINE=$(cat /proc/cmdline)
   local VERSION

   VERSION=$(echo "$CMDLINE" | grep -o 'vmlinuz-[^ ]*' | sed 's|vmlinuz-||' | head -n1)

   # Fallback to uname -r if cmdline parsing failed
   if [ -z "$VERSION" ]; then
      VERSION=$(uname -r)
   fi

   echo "$VERSION"
}

# Load union filesystem kernel modules
# $1 = optional union parameter override
#
init_union_modules() {
   debug_log "init_union_modules" "$*"
   local UNION_PARAM=$(cmdline_value union)

    if [ "$UNION_PARAM" = "aufs" ]; then
       if secure_boot_enabled; then
          echo "Secure Boot disables the unsigned aufs-ng module; using OverlayFS." >&2
       fi
       load_aufs_module || true
       if ! aufs_is_usable >/dev/null; then
          modprobe overlay 2>/dev/null
       fi
   elif [ "$UNION_PARAM" = "overlayfs" ]; then
      modprobe overlay 2>/dev/null
    else
       load_aufs_module || true
       if ! aufs_is_usable >/dev/null; then
          modprobe overlay 2>/dev/null
      fi
   fi
   refresh_devs
}

# Setup empty aufs union, or create overlayfs union
# $1 = changes directory (ramfs or persistent changes)
# $2 = union directory where to mount the union
# $3 = bundles directory
#
init_union() {
   debug_log "init_union" "$*"
   mkdir -p "$1"
   mkdir -p "$2"

   local UNION_TYPE=$(get_union_fs)
   local UNION_PARAM=$(cmdline_value union)

    if [ "$UNION_TYPE" = "aufs" ]; then
       echo_white_star
       echo "Setting up empty union using aufs"
       [ -n "$UNION_PARAM" ] && [ "$UNION_PARAM" = "aufs" ] && echo "(forced by union=$UNION_PARAM parameter)"
      mount_aufs_union "$1" "$2"
   else
      echo_white_star
      echo "Setting up union using overlayfs"
      [ -n "$UNION_PARAM" ] && [ "$UNION_PARAM" = "overlayfs" ] && echo "(forced by union=$UNION_PARAM parameter)"
      mkdir -p "$1/changes"
      mkdir -p "$1/workdir"
      mount -t overlay overlay -o lowerdir=$(find "$3" -mindepth 1 -maxdepth 1 | sortmod | tac | tr '\n' ':' | sed -r 's/:$//'),upperdir=$1/changes,workdir=$1/workdir $2
   fi
}

# Return device mounted for given directory
# $1 = directory
#
mounted_device() {
   debug_log "mounted_device" "$*"

   local MNT TARGET
   MNT="$1"
   while [ "$MNT" != "/" -a "$MNT" != "." -a "$MNT" != "" ]; do
      TARGET="$(grep -F " $MNT " /proc/mounts | cut -d " " -f 1)"
      if [ "$TARGET" != "" ]; then
         echo "$TARGET"
         return
      fi
      MNT="$(dirname "$MNT")"
   done
}

# Return mounted dir for given directory
# $1 = directory
#
mounted_dir() {
   debug_log "mounted_dir" "$*"

   local MNT
   MNT="$1"
   while [ "$MNT" != "/" -a "$MNT" != "." -a "$MNT" != "" ]; do
      if mountpoint -q "$MNT" 2>/dev/null; then
         echo "$MNT"
         return
      fi
      MNT="$(dirname "$MNT")"
   done
}

# Initialize blkid cache by manually probing all devices
#
init_blkid_cache() {
   local DEV
   cat /proc/partitions | tr -s " " | cut -d " " -f 5 | while read DEV; do
      blkid /dev/$DEV >/dev/null 2>/dev/null
   done
}

# Get device tag.
# $1 = device
# $2 = tag name, such as TYPE, LABEL, UUID, etc
#
device_tag() {
   blkid -s $2 "$1" | sed -r "s/^[^=]+=//" | tr -d '"'
}

ntfs3_is_supported() {
   local FILESYSTEMS="${MINIOS_PROC_FILESYSTEMS:-/proc/filesystems}"

   grep -q '^[[:space:]]*ntfs3$' "$FILESYSTEMS" 2>/dev/null && return 0
   modprobe ntfs3 2>/dev/null || return 1
   grep -q '^[[:space:]]*ntfs3$' "$FILESYSTEMS" 2>/dev/null
}

# Make sure to mount FAT12/16/32 using vfat
# in order to support long filenames
# $1 = device
# $2 = prefix to add, like -t
#
device_bestfs() {
   debug_log "device_bestfs" "$*"
   local FS

   FS="$(device_tag "$1" TYPE | tr [A-Z] [a-z])"
   if [ "$FS" = "msdos" -o "$FS" = "fat" -o "$FS" = "vfat" ]; then
      FS="vfat"
   elif [ "$FS" = "ntfs" ]; then
      if ntfs3_is_supported; then
         FS="ntfs3"
      else
         FS="ntfs-3g"
      fi
   fi

   if [ "$2" != "" ]; then
      echo -n "$2"
   fi

   echo "$FS"
}

# Filesystem mount options
# $1 = filesystem
# $2 = access mode (rw by default)
#
fs_options() {
   debug_log "fs_options" "$*"
   local ACCESS="${2:-rw}"

   if [ "$1" != "ntfs-3g" ]; then
      echo -n "-t $1 "
   fi

   echo -n "-o $ACCESS"

   if [ "$1" = "vfat" ]; then
      echo ",umask=000,check=s,shortname=mixed,iocharset=utf8"
   elif [ "$1" = "ntfs-3g" ] || [ "$1" = "ntfs3" ] || [ "$1" = "exfat" ]; then
      echo ",umask=000"
   fi
}

# Mount command for given filesystem
# $1.. = filesystem
#
mount_command() {
   debug_log "mount_command" "$*"

   if [ "$1" = "ntfs-3g" ]; then
      echo "@mount.ntfs-3g"
   else
      echo "mount"
   fi
}

# Switch the selected data filesystem to writable mode after read-only probing.
# If an in-place remount is unsupported (for example by a FUSE helper), retry a
# clean writable mount and restore the read-only mount if that fails.
# $1 = device
# $2 = mount point
# $3 = filesystem
#
data_mount_make_writable() {
   debug_log "data_mount_make_writable" "$*"
   local DRIVE="$1" TARGET="$2" FS="$3" MOUNT OPTIONS

   mount -o remount,rw "$TARGET" 2>/dev/null && return 0

   MOUNT="$(mount_command "$FS")"
   umount "$TARGET" 2>/dev/null || return 1
   OPTIONS="$(fs_options "$FS" rw)"
   $MOUNT "$DRIVE" "$TARGET" $OPTIONS 2>/dev/null && return 0

   OPTIONS="$(fs_options "$FS" ro)"
   $MOUNT "$DRIVE" "$TARGET" $OPTIONS 2>/dev/null || return 1
   return 1
}

# echo first network device known at the moment of calling, eg. eth0
#
network_device() {
   debug_log "network_device" "$*"
   cat /proc/net/dev | grep : | grep -v lo: | grep -v ip6tnl | cut -d : -f 1 | tr -d " " | head -n 1
}

# Modprobe network kernel modules until a working driver is found.
# These drivers are (or used to be) probed in Slackware's initrd.
# The function returns the first device found, yet it doesn't have
# to be a working one, eg. if the computer has two network interfaces
# and ethernet cable is plugged only to one of them.
#
init_network_dev() {
   debug_log "init_network_dev" "$*"
   local MODULE ETH

   for MODULE in 3c59x acenic e1000 e1000e e100 epic100 hp100 ne2k-pci \
      pcnet32 8139too 8139cp tulip via-rhine r8169 atl1e yellowfin tg3 \
      dl2k ns83820 atl1 b44 bnx2 skge sky2 tulip forcedeth sb1000 sis900 \
      vmxnet3 virtio_net; do
      modprobe $MODULE 2>/dev/null
      ETH="$(network_device)"
      if [ "$ETH" != "" ]; then
         echo $ETH
         return 0
      fi
      rmmod $MODULE 2>/dev/null
   done

   # If we are here, none of the above specified modules worked.
   # As a last chance, try to modprobe everything else
   modprobe_everything -e /drivers/net/
   echo $(network_device)
}

# Initialize network IP address
# either static from ip=bootparameter, or from DHCP
#
init_network_ip() {
   debug_log "init_network_ip" "$*"
   local IP ETH SCRIPT CLIENT SERVER GW MASK

   SCRIPT=/tmp/dhcpscript
   ETH=$(init_network_dev)
   IP=$(cmdline_value ip)

   echo "* Setting up network" >&2

   if [ "$IP" != "" ]; then
      # set IP address as given by boot parameter
      echo "$IP" | while IFS=":" read CLIENT SERVER GW MASK; do
         ifconfig $ETH "$CLIENT" netmask "$MASK"
         route add default gw "$GW"
         echo nameserver "$GW" >>/etc/resolv.conf
         echo nameserver "$SERVER" >>/etc/resolv.conf
      done
   else
      # if client ip is unknown, try to get a DHCP lease
      ifconfig $ETH up
      echo -e '#!/bin/sh\nif [ "$1" != "bound" ]; then exit; fi\nifconfig $interface $ip netmask $subnet\nroute add default gw $router\necho nameserver $dns >>/etc/resolv.conf' >$SCRIPT
      chmod a+x $SCRIPT
      udhcpc -i $ETH -n -s $SCRIPT -q >/dev/null
   fi
}

# Mount data from http using httpfs
# $1 = from URL
# $2 = target
#
mount_data_http() {
   debug_log "mount_data_http" "$*"
   local CACHE

   echo_white_star >&2
   echo "Load data from $1" >&2

   CACHE=$(cmdline_value cache | sed -r "s/[^0-9]//g" | sed -r "s/^0+//g")
   if [ "$CACHE" != "" ]; then
      CACHE="-C /tmp/httpfs.cache -S "$(($CACHE * 1024 * 1024))
   fi

   init_network_ip

   if [ "$(network_device)" != "" ]; then
      echo "* Mounting remote file..." >&2
      mkdir -p "$2"
      #umount "$2" >/dev/null 2>/dev/null
      @mount.httpfs2 -r 9999 -t 5 $CACHE -c /dev/null "$1" "$2" -o ro >/dev/null 2>/dev/null
      mount -o loop "$2"/* "$2" # self mount
      echo "$2/$LIVEKITNAME"
   fi
}

# stdin = files to get
# $1 = server
# $2 = destination directory
#
tftp_mget() {
   while read FNAME; do
      echo "* $FNAME ..." >&2
      tftp -b 1486 -g -r "$FNAME" -l "$2/$FNAME" "$1"
   done
}

# Download data from tftp
# $1 = target (store downloaded files there)
#
download_data_pxe() {
   debug_log "download_data_pxe" "$*"
   local IP CMD CLIENT SERVER GW MASK PORT PROTOCOL JOBS

   mkdir -p "$1/$LIVEKITNAME"
   IP="$(cmdline_value ip)"

   echo "$IP" | while IFS=":" read CLIENT SERVER GW MASK PORT; do
      echo_white_star >&2
      echo "Contacting PXE server $SERVER" >&2

      if [ "$PORT" = "" ]; then PORT="7529"; fi

      init_network_ip

      echo "* Downloading PXE file list" >&2

      PROTOCOL=http
      wget -q -O "$1/PXEFILELIST" "http://$SERVER:$PORT/PXEFILELIST?$(uname -r):$(uname -m)"
      if [ $? -ne 0 ]; then
         echo "Error downloading from http://$SERVER:$PORT, trying TFTP" >&2
         PROTOCOL=tftp
         echo PXEFILELIST | tftp_mget "$SERVER" "$1"
      fi

      echo "* Downloading files from the list" >&2

      if [ "$PROTOCOL" = "http" ]; then
         cat "$1/PXEFILELIST" | while read FILE; do
            wget -O "$1/$LIVEKITNAME/$(basename $FILE)" "http://$SERVER:$PORT/$FILE"
         done
      else
         JOBS=3
         for i in $(seq 1 $JOBS); do
            awk "NR % $JOBS == $i-1" "$1/PXEFILELIST" | tftp_mget "$SERVER" "$1/$LIVEKITNAME" &
         done
         wait
      fi
   done

   echo "$1/$LIVEKITNAME"
}

# Interactively ask the user to select a disk partition.
# $1 = action and folder path, e.g. for from: askdisk:where/is/my/system
# $2 = mode: from or perchdir
#
ask_disk() {
   debug_log "ask_disk" "$*"
   local WHERE MODE COMMAND PARTITION SIZE TYPE LABEL ASKPID DIR DRIVE

   WHERE="$1"
   MODE="$2"
   COMMAND="askdisk"

   if echo "$WHERE" | grep -q "^$COMMAND"; then
      (while true; do
         # Among other things, filter out swap, since the user may have a hard disk with a swap partition on the actual hardware.
         blkid -o full -s TYPE -s LABEL /dev/sd* /dev/hd* /dev/vd* /dev/xvd* /dev/nvme* /dev/mmcblk* /dev/sr* /dev/mapper/* /dev/dm-* /dev/nbd* /dev/md* /dev/rbd* 2>/dev/null | grep -E -v "TYPE=\"swap\"" | while read -r LINE; do
            PARTITION=$(echo "$LINE" | awk '{print $1}' | awk -F':' '{print $1}')
            SIZE=$(fdisk -l "$PARTITION" 2>/dev/null | head -n 1 | awk '/Disk \// {print $3, $4}' | tr -d ",")
            TYPE=$(echo $LINE | awk -F'TYPE="' '{print $2}' | awk -F'"' '{print $1}')
            LABEL=$(echo $LINE | awk -F'LABEL="' '{print $2}' | awk -F'"' '{print $1}')
            echo "$PARTITION: SIZE=\"$SIZE\" TYPE=\"$TYPE\" LABEL=\"$LABEL\" "
         done >/tmp/0.txt
         mv -f /tmp/0.txt /tmp/askdisk.txt
         sleep 1
      done) &
      ASKPID=$!
      sleep 1 # give blkid some chance to finish
      if echo "$WHERE" | grep -q "^$COMMAND:"; then
         DIR="$(echo "$WHERE" | cut -d ':' -f 2- | tr ':' '/')"
      else
         if [ "$MODE" = "from" ]; then
            DIR="$LIVEKITNAME"
         elif [ "$MODE" = "perchdir" ]; then
            DIR=""
         fi
      fi
      DRIVE="$(ncurses-menu -t "Look for /$DIR directory on:" -f /tmp/askdisk.txt -s 2>&1 >/dev/tty1 </dev/tty1)"
      DRIVE="$(echo "$DRIVE" | cut -d : -f 1)"
      if echo "$WHERE" | grep -q "^$COMMAND:"; then
         WHERE="$DRIVE/$(echo "$WHERE" | cut -d ':' -f 2- | tr ':' '/')"
      else
         WHERE="$DRIVE/$DIR"
      fi
      kill $ASKPID
   fi
   echo $WHERE
}

# Find LIVEKIT data by mounting all devices
# If found, keep mounted, else unmount
# $1 = data directory target (mount here)
# $2 = data directory which contains compressed bundles
#
find_data_try() {
   debug_log "find_data_try" "$*"
   local DRIVE FS FROM OPTIONS MOUNT

   mkdir -p "$1"

   blkid /dev/sd* /dev/hd* /dev/vd* /dev/xvd* /dev/nvme* /dev/mmcblk* /dev/sr* /dev/mapper/* /dev/dm-* /dev/nbd* /dev/md* /dev/rbd* 2>/dev/null | sort | cut -d: -f 1 | while read DRIVE; do
      FROM="$2"

      # supported syntax is even like from=/dev/sr0/livekitname. It is not so much
      # optiomal to put the following block of code here inside the while loop,
      # but there is no harm so lets modify DRIVE and FROM to make it work
      if echo "$FROM" | grep -q '^/dev/'; then
         if echo "$FROM" | grep -q '^/dev/disk/by-label/'; then
            LABEL=$(echo "$FROM" | awk -F"/" '{print $5}')
            DRIVE=$(blkid -t LABEL="$LABEL" -o device -c /dev/null 2>/dev/null)
            FROM="$(echo "$FROM" | cut -d '/' -f 6-)"
         else
            DRIVE="$(echo "$FROM" | cut -d '/' -f 1-3)"
            FROM="$(echo "$FROM" | cut -d '/' -f 4-)"
         fi
      fi
      if [ "$FROM" = "" ]; then
         FROM="$LIVEKITNAME"
      fi

      FS="$(device_bestfs "$DRIVE")"
      OPTIONS="$(fs_options "$FS" ro)"
      MOUNT="$(mount_command "$FS")"

      $MOUNT "$DRIVE" "$1" $OPTIONS 2>/dev/null

      # if the FROM parameter is actual file, mount it again as loop (eg. iso)
      if [ -f "$1/$FROM" ]; then
         mkdir -p "$1/../iso"
         mount -o loop,ro "$1/$FROM" "$1/../iso" 2>/dev/null
         FROM="../iso/$LIVEKITNAME"
      fi

      # search for bundles in the mounted directory
      if [ "$(find "$1/$FROM" -maxdepth 1 -name "*.$BEXT" 2>/dev/null)" != "" ]; then
         # we found at least one bundle/module here
         data_mount_make_writable "$DRIVE" "$1" "$FS" || true
         echo "$FROM" >/var/log/from.log
         echo "$1/$FROM" | tr -s "/" | sed -r "s:/[^/]+/[.][.]/:/:g"
         return
      fi

      # search for bundles in modules directory
      if [ "$(find "$1/$FROM/modules" -maxdepth 1 -name "*.$BEXT" 2>/dev/null)" != "" ]; then
         # we found at least one bundle/module here
         data_mount_make_writable "$DRIVE" "$1" "$FS" || true
         echo "$1/$FROM" | tr -s "/" | sed -r "s:/[^/]+/[.][.]/:/:g"
         echo "$FROM" >/var/log/from.log
         return
      fi

      # unmount twice, since there could be mounted ISO as loop too. If not, it doesn't hurt
      umount "$1" 2>/dev/null
      umount "$1" 2>/dev/null
   done
}

# Retry finding LIVEKIT data several times,
# until timeouted or until data is found
# $1 = timeout
# $2 = data directory target (mount here)
#
find_data() {
   debug_log "find_data" "$*"
   local DATA FROM TIMEOUT

   FROM="$(cmdline_value from)"

   # boot parameter specified as from=http://server.com/file.iso
   if [ "$(echo $FROM | grep 'http://')" != "" ]; then
      mount_data_http "$FROM" "$2"
      return
   fi

   # if we got IP address as boot parameter, it means we booted over PXE
   if [ "$(cmdline_value ip)" != "" ]; then
      download_data_pxe "$2"
      return
   fi

   # If user wants to get asked, ask and periodically update list of devices
   # boot parameter specified as from=askdisk or from=askdisk/directory/where/system/is/installed
   FROM=$(ask_disk "$FROM" from)

   # default to livekitname autodetected on all disks
   if [ "$FROM" = "" ]; then FROM="$LIVEKITNAME"; fi

   echo_white_star >&2
   echo -n "Looking for MiniOS data in /$FROM .." | tr -s "/" >&2 >/dev/tty1
   for TIMEOUT in $(seq 1 $1); do
      echo -n "." >&2 >/dev/tty1
      refresh_devs
      DATA="$(find_data_try "$2" "$FROM")"
      if [ "$DATA" != "" ]; then
         echo "" >&2 >/dev/tty1
         # Use df to get device for DATA path, fallback to mounted_device for mount point
         DEVICE="$(df -P "$DATA" 2>/dev/null | tail -n 1 | awk '{print $1}')"
         [ -z "$DEVICE" ] && DEVICE="$(mounted_device "$2")"
         echo "* Found on $DEVICE" >&2 >/dev/tty1
         echo "$DATA"
         return
      fi
      sleep 1
   done
   echo "" >&2 >/dev/tty1
}

# Check if data is found and exists
# $1 = data directory
#
check_data_found() {
   if [ "$1" = "" -o ! -d "$1" ]; then
      fatal "Could not locate MiniOS data"
   fi
}

# Get a human readable format of time elapsed since given datetime
# $1 = date time
#
date_diff_since_now() {
   local NOW TIMESTAMP SEC MINS HOURS DAYS

   NOW=$(date '+%s')
   TIMESTAMP=$(date --date "$1" '+%s')
   SEC=$(($NOW - $TIMESTAMP))
   MINS=$(($SEC / 60))
   HOURS=$(($SEC / 3600))
   DAYS=$(($SEC / 86400))

   if [ "$DAYS" -gt 0 ]; then
      echo "$DAYS days" | sed -r "s/^1 days/1 day/"
   elif [ "$HOURS" -gt 0 ]; then
      echo "$HOURS hours" | sed -r "s/^1 hours/1 hour/"
   elif [ "$MINS" -gt 0 ]; then
      echo "$MINS minutes" | sed -r "s/^1 minutes/1 minute/"
   else
      echo "$SEC seconds" | sed -r "s/^1 seconds/1 second/"
   fi
}

# Check if the directory is writable. If the directory is writable, 0 is returned, otherwise 1 is returned.
# $1 = The directory to check for write access.
# $2 = The device on which the directory resides.
# $3 = An optional parameter that specifies the persistent changes directory.
#      If not provided, it will be retrieved from the command line.
#
check_write_access() {
   debug_log "check_write_access" "$*"
   local CHANDIR DRIVE PERCHDIR T1

   CHANDIR="$1"
   if echo "$2" | grep -q ":"; then
      PERCHDIR=$(echo "$2" | cut -d':' -f2)
   else
      PERCHDIR="$2"
   fi
   T1="$CHANDIR/.empty"

   # Supported syntax is even like perchdir=/dev/sda1/changes
   # In this case, perchdir is mounted over $CHANDIR and is set to ask
   if echo "$PERCHDIR" | grep -q '^/dev/'; then
      case "$PERCHDIR" in
      /dev/disk/by-label/*)
         LABEL=$(echo "$PERCHDIR" | awk -F"/" '{print $5}')
         DRIVE=$(blkid -t LABEL="$LABEL" -o device -c /dev/null 2>/dev/null)
         ;;
      /dev/mapper/*)
         DRIVE="$(echo "$PERCHDIR" | cut -d '/' -f 1-4)"
         ;;
      /dev/*)
         DRIVE="$(echo "$PERCHDIR" | cut -d '/' -f 1-3)"
         ;;
      esac

      # If the partition is unavailable for writing, there is no point in
      # checking whether the folder can be written to
      if [ ! -w "$DRIVE" ]; then
         return 1
      fi

      FS="$(device_bestfs "$DRIVE")"
      OPTIONS="$(fs_options $FS)"
      MOUNT="$(mount_command $FS)"

      refresh_devs
      $MOUNT "$DRIVE" "$CHANDIR" $OPTIONS 2>/dev/null || return 1
      if [ $? -eq 0 ]; then
         # check if changes directory exists and is writable
         touch "$T1" 2>/dev/null && rm -f "$T1" 2>/dev/null

         # if not, return 1, otherwise return 0
         if [ $? -ne 0 ]; then
            umount "$CHANDIR"
            return 1
         else
            umount "$CHANDIR"
            return 0
         fi
      fi
   else
      # check if changes directory exists and is writable
      touch "$T1" 2>/dev/null && rm -f "$T1" 2>/dev/null

      # if not, return 1, otherwise return 0
      if [ $? -ne 0 ]; then
         return 1
      else
         return 0
      fi
   fi
}

# Attempt to mount a device to a specific directory.
# $1 = The device to be mounted.
# $2 = The directory where the device will be mounted.
# $3 = Persistent changes directory within the mounted device.
#
mount_perch_drive() {
   debug_log "mount_perch_drive" "$*"
   local TIMEOUT DRIVE FS OPTIONS MOUNT CHANDIR PERCHDIR LABEL

   DRIVE="$1"
   CHANDIR="$2"
   PERCHDIR="$3"

   case "$PERCHDIR" in
   /dev/disk/by-label/*)
      LABEL=$(echo "$PERCHDIR" | awk -F"/" '{print $5}')
      DRIVE=$(blkid -t LABEL="$LABEL" -o device -c /dev/null 2>/dev/null)
      PERCHDIR="$(echo "$PERCHDIR" | cut -d '/' -f 6-)"
      ;;
   /dev/mapper/*)
      DRIVE="$(echo "$PERCHDIR" | cut -d '/' -f 1-4)"
      LABEL=$(blkid -o value -s LABEL "$DRIVE" -c /dev/null 2>/dev/null)
      PERCHDIR="$(echo "$PERCHDIR" | cut -d '/' -f 5-)"
      ;;
   /dev/*)
      DRIVE="$(echo "$PERCHDIR" | cut -d '/' -f 1-3)"
      LABEL=$(blkid -o value -s LABEL "$DRIVE" -c /dev/null 2>/dev/null)
      PERCHDIR="$(echo "$PERCHDIR" | cut -d '/' -f 4-)"
      ;;
   label:*)
      LABEL=$(echo "$PERCHDIR" | awk -F":" '{print $2}' | awk -F"/" '{print $1}')
      DRIVE=$(blkid -t LABEL="$LABEL" -o device -c /dev/null 2>/dev/null)
      PERCHDIR="$(echo "$PERCHDIR" | cut -d '/' -f 2-)"
      ;;
   esac

   FS="$(device_bestfs "$DRIVE")"
   OPTIONS="$(fs_options $FS)"
   MOUNT="$(mount_command $FS)"

   echo -n "* Waiting for persistent changes on $DRIVE .." >&2
   for TIMEOUT in $(seq 1 20); do
      echo -n "." >&2
      refresh_devs
      if $MOUNT "$DRIVE" "$CHANDIR" $OPTIONS 2>/dev/null; then
         # Save the writable partition root path for later use (e.g., loading modules)
         echo "$CHANDIR" >/run/perch_root
         if [ -n "$PERCHDIR" ] && [ "$PERCHDIR" != "/" ]; then
            mkdir -p "$CHANDIR/$PERCHDIR"
            if $MOUNT --bind "$CHANDIR/$PERCHDIR" "$CHANDIR"; then
               echo -e "\n" >&2
               break
            fi
         else
            echo -e "\n" >&2
            break
         fi
      fi
      sleep 1
   done
   echo "$PERCHDIR"
}

# Interactively choose storage, optional encryption and DynBlk compression for
# a new persistence session. The result is printed as three shell words:
# backend, encryption and compression.
select_new_session_mode() {
   debug_log "select_new_session_mode" "$*"
   local OPTIONS SELECTED MODE ENCRYPTION ENCRYPT_OPTIONS COMPRESSION COMP_OPTIONS CODEC MENU_TTY
   MENU_TTY="${MINIOS_MENU_TTY:-/dev/tty1}"
   OPTIONS="/tmp/minios-session-modes.$$"
   : >"$OPTIONS" || return 1

   printf '%s\n' 'Native' >>"$OPTIONS"
   dynblk_available && printf '%s\n' 'DynBlk' >>"$OPTIONS"
   vmdk_available && printf '%s\n' 'VMDK' >>"$OPTIONS"
   command -v @mount.dynfilefs >/dev/null 2>&1 && printf '%s\n' 'DynFileFS' >>"$OPTIONS"
   if command -v truncate >/dev/null 2>&1 && command -v mke2fs >/dev/null 2>&1; then
      printf '%s\n' 'Raw' >>"$OPTIONS"
   fi
   case "$(device_bestfs "$1")" in
   ext2 | ext3 | ext4 | btrfs | xfs | f2fs | reiserfs)
      printf '%s\n' 'SquashFS' >>"$OPTIONS"
      ;;
   esac

   SELECTED=$(ncurses-menu -t 'Select storage:' -f "$OPTIONS" 2>&1 >"$MENU_TTY" <"$MENU_TTY")
   rm -f "$OPTIONS"
   case "$SELECTED" in
   Native) MODE=native ;;
   DynFileFS) MODE=dynfilefs ;;
   DynBlk) MODE=dynblk ;;
   VMDK) MODE=vmdk ;;
   Raw) MODE=raw ;;
   SquashFS) MODE=squashfs ;;
   *) return 1 ;;
   esac

   ENCRYPTION=none
   case "$MODE" in
   raw | dynfilefs | dynblk | vmdk)
      ENCRYPT_OPTIONS="/tmp/minios-session-encryption.$$"
      printf '%s\n' 'None' >"$ENCRYPT_OPTIONS" || return 1
      if luks_layer_available && { [ "$MODE" = dynblk ] || [ "$MODE" = vmdk ] || command -v losetup >/dev/null 2>&1; }; then
         printf '%s\n' 'LUKS2' >>"$ENCRYPT_OPTIONS"
      fi
      SELECTED=$(ncurses-menu -t 'Encryption:' -f "$ENCRYPT_OPTIONS" 2>&1 >"$MENU_TTY" <"$MENU_TTY")
      rm -f "$ENCRYPT_OPTIONS"
      case "$SELECTED" in
      None) ENCRYPTION=none ;;
      LUKS2) ENCRYPTION=luks ;;
      *) return 1 ;;
      esac
      ;;
   esac

   COMPRESSION=none
   if [ "$MODE" = dynblk ] && [ "$ENCRYPTION" = none ]; then
      COMP_OPTIONS="/tmp/minios-session-compression.$$"
      printf '%s\n' 'None' >"$COMP_OPTIONS" || return 1
      for CODEC in lz4 lz4hc lzo lzo-rle zstd deflate; do
         dynblk_codec_available "$CODEC" && printf '%s\n' "$CODEC" >>"$COMP_OPTIONS"
      done
      SELECTED=$(ncurses-menu -t 'Compression:' -f "$COMP_OPTIONS" 2>&1 >"$MENU_TTY" <"$MENU_TTY")
      rm -f "$COMP_OPTIONS"
      case "$SELECTED" in
      None) COMPRESSION=none ;;
      lz4 | lz4hc | lzo | lzo-rle | zstd | deflate) COMPRESSION="$SELECTED" ;;
      *) return 1 ;;
      esac
   fi
   printf '%s %s %s\n' "$MODE" "$ENCRYPTION" "$COMPRESSION"
}

# Restore persistent changes from previous session.
# Store persistent changes to a directory and keep the directory in a session file,
# so we know which session was active last time so we can resume it next time
# $1 = partition on which changes will be stored
# $2 = changes directory
# $3 = persistent changes directory within changes directory
# $4 = action to perform (e.g., resume, new, setup, ask)
# $5 = session mode
# $6 = automatic resume (true = create a new session when resume has nothing usable)
# $7 = requested encryption for a newly created session
# $8 = requested compression for a newly created DynBlk session
#
restore_perch_session() {
   debug_log "restore_perch_session" "$*"
   local DRIVE CHANDIR PERCHDIR REQUESTED_SESSION ACTION LASTSESSION LASTMODE LASTENCRYPTION LASTVERSION LASTEDITION LASTSIZE NEW DIR USAGE LASTMOD DAYS PERCHMODE PERCHENCRYPT PERCHCOMP SESSIONS SELECTED VERSION EDITION SYSTEM_VERSION SYSTEM_EDITION UNION SYSTEM_UNION LASTUNION NEW_SESSION AUTO_RESUME COMPAT_TITLE COMPAT_SYSTEM COMPAT_SESSION SESSION_SELECTION

   DRIVE="$1"
   CHANDIR="$2"
   PERCHDIR="$3"
   REQUESTED_SESSION="$3"
   ACTION="$4"
   PERCHMODE="$5"
   AUTO_RESUME="${6:-false}"
   PERCHENCRYPT="${7:-none}"
   : "${PERCHENCRYPT:=none}"
   PERCHCOMP="${8:-none}"
   : "${PERCHCOMP:=none}"
   NEW_SESSION="false"

   # Get current system's MiniOS version and edition
   if [ -f /etc/minios-release ]; then
      SYSTEM_VERSION=$(config_value "/etc/minios-release" VERSION)
      SYSTEM_EDITION=$(config_value "/etc/minios-release" EDITION)
   fi
   # Set the main VERSION/EDITION variables to the system's version by default
   VERSION="$SYSTEM_VERSION"
   EDITION="$SYSTEM_EDITION"

   # Get current system's union filesystem
   SYSTEM_UNION=$(get_union_fs)

   # Supported syntax allows perchdir=/dev/sda1/changes
   # In this case, perchdir is mounted on $CHANDIR and action is prompted
   if echo "$PERCHDIR" | grep -q '^/dev/'; then
      PERCHDIR=$(mount_perch_drive "$DRIVE" "$CHANDIR" "$PERCHDIR" 2>/dev/null)
      if [ "$PERCHDIR" = "resume" ] || [ "$PERCHDIR" = "new" ] || [ "$PERCHDIR" = "setup" ] || [ "$PERCHDIR" = "ask" ]; then
         ACTION="$PERCHDIR"
      fi
   fi

   SESSIONS=$(session_metadata_select "$CHANDIR") || {
      echo "Cannot read persistence session metadata" >&2
      return 1
   }
   if [ -f "$SESSIONS" ]; then
      LASTSESSION=$(sed -n 's/^default=//p' "$SESSIONS")
      if [ -n "$LASTSESSION" ] && ! echo "$LASTSESSION" | grep -q '^[0-9][0-9]*$'; then
         echo "Invalid persistence session ID: $LASTSESSION" >&2
         return 1
      fi
      LASTMODE=$(sed -n "s/^session_mode\[$LASTSESSION\]=//p" "$SESSIONS")
      LASTENCRYPTION=$(sed -n "s/^session_encryption\[$LASTSESSION\]=//p" "$SESSIONS")
      : "${LASTENCRYPTION:=none}"
      LASTVERSION=$(sed -n "s/^session_version\[$LASTSESSION\]=//p" "$SESSIONS")
      LASTEDITION=$(sed -n "s/^session_edition\[$LASTSESSION\]=//p" "$SESSIONS")
      LASTUNION=$(sed -n "s/^session_union\[$LASTSESSION\]=//p" "$SESSIONS")
      LASTSIZE=$(sed -n "s/^session_size\[$LASTSESSION\]=//p" "$SESSIONS")
   fi

   # A numeric perchdir selects that session directly instead of following default.
   if echo "$REQUESTED_SESSION" | grep -q '^[0-9][0-9]*$' && [ -d "$CHANDIR/$REQUESTED_SESSION" ]; then
      LASTSESSION="$REQUESTED_SESSION"
      LASTMODE=$(sed -n "s/^session_mode\[$LASTSESSION\]=//p" "$SESSIONS" 2>/dev/null)
      LASTENCRYPTION=$(sed -n "s/^session_encryption\[$LASTSESSION\]=//p" "$SESSIONS" 2>/dev/null)
      : "${LASTENCRYPTION:=none}"
      LASTVERSION=$(sed -n "s/^session_version\[$LASTSESSION\]=//p" "$SESSIONS" 2>/dev/null)
      LASTEDITION=$(sed -n "s/^session_edition\[$LASTSESSION\]=//p" "$SESSIONS" 2>/dev/null)
      LASTUNION=$(sed -n "s/^session_union\[$LASTSESSION\]=//p" "$SESSIONS" 2>/dev/null)
      LASTSIZE=$(sed -n "s/^session_size\[$LASTSESSION\]=//p" "$SESSIONS" 2>/dev/null)
   fi

   if [ "$ACTION" = "ask" ] && [ -z "$LASTSESSION" ]; then
      ACTION="setup"
   fi

   if [ "$ACTION" = "setup" ]; then
      SESSION_SELECTION=$(select_new_session_mode "$DRIVE") || {
         echo "No persistence session type was selected" >&2
         return 1
      }
      set -- $SESSION_SELECTION
      PERCHMODE="$1"
      PERCHENCRYPT="${2:-none}"
      PERCHCOMP="${3:-none}"
      ACTION="new"
   fi

   if [ "$ACTION" != "new" ] && [ -z "$LASTSESSION" ]; then
      if [ "$ACTION" = "resume" ] && [ "$AUTO_RESUME" = "true" ]; then
         ACTION="new"
      else
         echo "No resumable persistence session was found" >&2
         return 1
      fi
   fi

   if [ "$ACTION" = "new" ]; then
      :
   elif [ -n "$LASTSESSION" ]; then
      # If action is "ask", prompt the user to select a session
      if [ "$ACTION" = "ask" ]; then
         local SESSION_CONFIRMED="false"
         while [ "$SESSION_CONFIRMED" = "false" ]; do
            ls -1 $CHANDIR | grep -E "^[0-9]+" | while read DIR; do
               local S_MODE S_ENCRYPTION S_LABEL S_VERSION S_EDITION S_UNION INFO_PARTS SESSION_INFO
               S_MODE=$(sed -n "s/^session_mode\[$DIR\]=//p" "$SESSIONS")
               S_ENCRYPTION=$(sed -n "s/^session_encryption\[$DIR\]=//p" "$SESSIONS")
               : "${S_ENCRYPTION:=none}"
               S_VERSION=$(sed -n "s/^session_version\[$DIR\]=//p" "$SESSIONS")
                S_EDITION=$(sed -n "s/^session_edition\[$DIR\]=//p" "$SESSIONS")
                S_UNION=$(sed -n "s/^session_union\[$DIR\]=//p" "$SESSIONS")

               INFO_PARTS=""
               [ -n "$S_VERSION" ] && INFO_PARTS="$S_VERSION"
               if [ -n "$S_EDITION" ]; then
                  [ -n "$INFO_PARTS" ] && INFO_PARTS="$INFO_PARTS, "
                  INFO_PARTS="$INFO_PARTS$S_EDITION"
               fi
               if [ -n "$S_UNION" ]; then
                  [ -n "$INFO_PARTS" ] && INFO_PARTS="$INFO_PARTS, "
                  INFO_PARTS="$INFO_PARTS$S_UNION"
               fi

               case "$S_MODE:$S_ENCRYPTION" in
               native:none) S_LABEL=Native ;;
               raw:none) S_LABEL=Raw ;;
               raw:luks) S_LABEL=Raw+LUKS ;;
               dynfilefs:none) S_LABEL=DynFileFS ;;
               dynfilefs:luks) S_LABEL=DynFileFS+LUKS ;;
               dynblk:none) S_LABEL=DynBlk ;;
               dynblk:luks) S_LABEL=DynBlk+LUKS ;;
               vmdk:none) S_LABEL=VMDK ;;
               vmdk:luks) S_LABEL=VMDK+LUKS ;;
               squashfs:none) S_LABEL=SquashFS ;;
               *) S_LABEL=Unsupported ;;
               esac
               [ -n "$INFO_PARTS" ] && SESSION_INFO=" $INFO_PARTS"

               USAGE=$(du -s -h "$CHANDIR/$DIR" 2>/dev/null | sed -r "s/[[:space:]].*//")
               LASTMOD=$(date -r "$CHANDIR/$DIR" "+%Y-%m-%d %H:%M:%S")
               DAYS=$(date_diff_since_now "$LASTMOD")

               echo "$LASTMOD #$DIR [$S_LABEL]$SESSION_INFO - $USAGE - $DAYS ago" | sed -r "s/(.)\$/ \1B/"

            done | sort -r | cut -d " " -f 3- >/tmp/sessions.txt

            SELECTED=$(ncurses-menu -t 'Select session:' -o '+ New session' -f /tmp/sessions.txt 2>&1 >/dev/tty1 </dev/tty1)

            if [ -z "$SELECTED" ]; then
               continue
            fi

            if echo "$SELECTED" | grep -q "New session"; then
               ACTION="setup"
               SESSION_CONFIRMED="true"
            else
               PERCHDIR=$(echo "$SELECTED" | sed -r 's/.*#//' | sed -r 's/[^0-9].*//')
               local SELECTED_ENCRYPTION SELECTED_VERSION SELECTED_EDITION SELECTED_UNION SELECTED_SIZE
                PERCHMODE=$(sed -n "s/^session_mode\[$PERCHDIR\]=//p" "$SESSIONS")
                SELECTED_ENCRYPTION=$(sed -n "s/^session_encryption\[$PERCHDIR\]=//p" "$SESSIONS")
                PERCHENCRYPT="${SELECTED_ENCRYPTION:-none}"
                SELECTED_VERSION=$(sed -n "s/^session_version\[$PERCHDIR\]=//p" "$SESSIONS")
                SELECTED_EDITION=$(sed -n "s/^session_edition\[$PERCHDIR\]=//p" "$SESSIONS")
                SELECTED_UNION=$(sed -n "s/^session_union\[$PERCHDIR\]=//p" "$SESSIONS")
                SELECTED_SIZE=$(sed -n "s/^session_size\[$PERCHDIR\]=//p" "$SESSIONS")

               local WARNING_TITLE=""
               if [ "$SYSTEM_VERSION" != "$SELECTED_VERSION" ] && [ "$SYSTEM_EDITION" != "$SELECTED_EDITION" ]; then
                  WARNING_TITLE="Warning: Incompatible Session\n"
                  WARNING_TITLE="${WARNING_TITLE}Reason: OS Version and Edition Mismatch\n"
                  WARNING_TITLE="${WARNING_TITLE}System: $SYSTEM_VERSION/$SYSTEM_EDITION | Session: $SELECTED_VERSION/$SELECTED_EDITION"
               elif [ "$SYSTEM_VERSION" != "$SELECTED_VERSION" ]; then
                  WARNING_TITLE="Warning: Incompatible Session\n"
                  WARNING_TITLE="${WARNING_TITLE}Reason: OS Version Mismatch\n"
                  WARNING_TITLE="${WARNING_TITLE}System: $SYSTEM_VERSION | Session: $SELECTED_VERSION"
               elif [ "$SYSTEM_EDITION" != "$SELECTED_EDITION" ]; then
                  WARNING_TITLE="Warning: Incompatible Session\n"
                  WARNING_TITLE="${WARNING_TITLE}Reason: OS Edition Mismatch\n"
                  WARNING_TITLE="${WARNING_TITLE}System: $SYSTEM_EDITION | Session: $SELECTED_EDITION"
               elif [ -n "$SELECTED_UNION" ] && [ "$SYSTEM_UNION" != "$SELECTED_UNION" ]; then
                  WARNING_TITLE="Warning: Incompatible Session\n"
                  WARNING_TITLE="${WARNING_TITLE}Reason: Union Filesystem Mismatch\n"
                  WARNING_TITLE="${WARNING_TITLE}System: $SYSTEM_UNION | Session: $SELECTED_UNION"
               fi

               if [ -n "$WARNING_TITLE" ]; then
                  WARNING_TITLE="${WARNING_TITLE}\nUsing this session may cause system instability.\nProceed anyway?"

                  WARNING_CHOICE=$(ncurses-menu \
                     -t "${WARNING_TITLE}" \
                     -o "Yes, proceed at my own risk" \
                     -o "No, return to session list" \
                     2>&1 >/dev/tty1 </dev/tty1)

                  if echo "$WARNING_CHOICE" | grep -q "Yes"; then
                     VERSION="$SELECTED_VERSION"
                     EDITION="$SELECTED_EDITION"
                     UNION="$SELECTED_UNION"
                     # Restore session size if available and not overridden by command line (dynfilefs only)
                     if [ "$PERCHSIZE" = "0" ] && [ "$PERCHMODE" = "dynfilefs" ] && [ -n "$SELECTED_SIZE" ] && [ "$SELECTED_SIZE" != "empty" ]; then
                        PERCHSIZE="$SELECTED_SIZE"
                     fi
                     SESSION_CONFIRMED="true"
                  fi
               else
                  VERSION="$SELECTED_VERSION"
                  EDITION="$SELECTED_EDITION"
                  UNION="$SELECTED_UNION"
                  # Restore session size if available and not overridden by command line (dynfilefs only)
                  if [ "$PERCHSIZE" = "0" ] && [ "$PERCHMODE" = "dynfilefs" ] && [ -n "$SELECTED_SIZE" ] && [ "$SELECTED_SIZE" != "empty" ]; then
                     PERCHSIZE="$SELECTED_SIZE"
                  fi
                  SESSION_CONFIRMED="true"
               fi
            fi
         done
      # Check for mode change
      elif [ -n "$PERCHMODE" ] && [ "$PERCHMODE" != "$LASTMODE" ]; then
         if [ "$ACTION" = "resume" ] && [ "$AUTO_RESUME" = "true" ]; then
            boot_warning_notify warning mode \
               "Session #$LASTSESSION: persistence mode changed." \
               "($LASTMODE -> $PERCHMODE) Creating a new session."
            ACTION="new"
         else
            echo_yellow_star >&2
            echo "Session #$LASTSESSION: Persistence mode changed." >&2 >/dev/tty1
            echo "($LASTMODE -> $PERCHMODE) Refusing automatic replacement." >&2 >/dev/tty1
            return 1
         fi
      # Check for union filesystem mismatch first
      elif [ "$ACTION" = "resume" ] && [ -n "$LASTUNION" ] && [ "$SYSTEM_UNION" != "$LASTUNION" ]; then
         if [ "$AUTO_RESUME" = "true" ]; then
            boot_warning_notify warning persistence \
               "Session #$LASTSESSION: union filesystem mismatch detected." \
               "System: $SYSTEM_UNION, session: $LASTUNION. Creating a new session."
            ACTION="new"
         else
            echo_yellow_star >&2
            echo "Session #$LASTSESSION: Union FS mismatch detected." >&2 >/dev/tty1
            echo "* System: $SYSTEM_UNION, Session: $LASTUNION" >&2 >/dev/tty1
            echo "* Refusing automatic replacement." >&2 >/dev/tty1
            return 1
         fi
      # Check for version/edition mismatch
      elif [ "$ACTION" = "resume" ] && [ -n "$LASTVERSION" ] && { [ "$SYSTEM_VERSION" != "$LASTVERSION" ] || [ "$SYSTEM_EDITION" != "$LASTEDITION" ]; }; then
         if [ "$SYSTEM_VERSION" != "$LASTVERSION" ] && [ "$SYSTEM_EDITION" != "$LASTEDITION" ]; then
            COMPAT_TITLE="Session #$LASTSESSION: OS version and edition mismatch."
            COMPAT_SYSTEM="System: $SYSTEM_VERSION/$SYSTEM_EDITION."
            COMPAT_SESSION="Session: $LASTVERSION/$LASTEDITION."
         elif [ "$SYSTEM_VERSION" != "$LASTVERSION" ]; then
            COMPAT_TITLE="Session #$LASTSESSION: OS version mismatch detected."
            COMPAT_SYSTEM="System: $SYSTEM_VERSION."
            COMPAT_SESSION="Session: $LASTVERSION."
         else
            COMPAT_TITLE="Session #$LASTSESSION: OS edition mismatch detected."
            COMPAT_SYSTEM="System: $SYSTEM_EDITION."
            COMPAT_SESSION="Session: $LASTEDITION."
         fi
         if [ "$AUTO_RESUME" = "true" ]; then
            boot_warning_notify warning persistence \
               "$COMPAT_TITLE" "$COMPAT_SYSTEM" "$COMPAT_SESSION" \
               "Creating a new session."
            ACTION="new"
         else
            echo_yellow_star >&2
            echo "$COMPAT_TITLE" >&2 >/dev/tty1
            echo "* $COMPAT_SYSTEM" >&2 >/dev/tty1
            echo "* $COMPAT_SESSION" >&2 >/dev/tty1
            echo "* Refusing automatic replacement." >&2 >/dev/tty1
            return 1
         fi
      elif [ "$ACTION" = "resume" ]; then
         PERCHDIR="$LASTSESSION"
         PERCHMODE="$LASTMODE"
         PERCHENCRYPT="$LASTENCRYPTION"
         VERSION="$LASTVERSION"
         EDITION="$LASTEDITION"
         UNION="$LASTUNION"
         # Restore session size if available and not overridden by command line (dynfilefs only)
         if [ "$PERCHSIZE" = "0" ] && [ "$PERCHMODE" = "dynfilefs" ] && [ -n "$LASTSIZE" ] && [ "$LASTSIZE" != "empty" ]; then
            PERCHSIZE="$LASTSIZE"
         fi
      else
         echo "Unsupported persistence action: $ACTION" >&2
         return 1
      fi
   fi

   if [ "$ACTION" = "setup" ]; then
      SESSION_SELECTION=$(select_new_session_mode "$DRIVE") || {
         echo "No persistence session type was selected" >&2
         return 1
      }
      set -- $SESSION_SELECTION
      PERCHMODE="$1"
      PERCHENCRYPT="${2:-none}"
      PERCHCOMP="${3:-none}"
      ACTION="new"
   fi

   if [ "$ACTION" = "new" ]; then
      : "${PERCHMODE:=native}"
      case "$PERCHENCRYPT" in
      none | luks) ;;
      *)
         echo "Unsupported persistence encryption: $PERCHENCRYPT" >&2
         return 1
         ;;
      esac
      if [ "$PERCHMODE" = luks ]; then
         echo "Unsupported persistence mode: luks" >&2
         return 1
      fi
      if [ "$PERCHENCRYPT" = luks ]; then
         case "$PERCHMODE" in
         raw | dynfilefs | dynblk | vmdk) ;;
         *)
            echo "LUKS encryption is not supported with $PERCHMODE persistence" >&2
            return 1
            ;;
         esac
      fi
      # Consider only strictly-numeric session directories, ordered numerically
      # (not lexically, so 10 sorts after 9). Allocate strictly above the current
      # maximum and create the directory exclusively so an existing session is
      # never reused for a new candidate.
      NEW=$(ls -1 "$CHANDIR" 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -n 1)
      : "${NEW:=0}"
      NEW=$(($NEW + 1))
      mkdir "$CHANDIR/$NEW" || return 1
      PERCHDIR="$NEW"
      VERSION="$SYSTEM_VERSION"
      EDITION="$SYSTEM_EDITION"
      UNION="$SYSTEM_UNION"
      NEW_SESSION="true"
   elif [ ! -d "$CHANDIR/$PERCHDIR" ]; then
      echo "Persistence session #$PERCHDIR is missing" >&2
      return 1
   fi

   : "${PERCHMODE:=native}"
   if [ "$NEW_SESSION" != true ]; then
      case "$PERCHMODE:$PERCHENCRYPT" in
      native:none | raw:none | raw:luks | dynfilefs:none | dynfilefs:luks | dynblk:none | dynblk:luks | vmdk:none | vmdk:luks | squashfs:none) ;;
      *)
         echo "Session #$PERCHDIR has unsupported persistence metadata" >&2
         return 1
         ;;
      esac
   fi
   echo "$PERCHDIR" "$PERCHMODE" "$NEW_SESSION" "$PERCHENCRYPT" "$PERCHCOMP"
}

# Manage persistence partition
# $1 = partition on which changes will be stored
# $2 = changes directory
#
manage_perch_partition() {
   debug_log "manage_perch_partition" "$*"
   local PERCHPART RESIZEMEPART PERCHDEVICE DEVICE DRIVE PERCHDIR LABELS PART ALTPART FREE_SPACE_MB VTOY_PERST_DEV VTOY_PARENT VENTOYDIR MAPPER_NAME MAPPER_DEVICE DM_NAME DM_BLOCK

   DRIVE="$1"
   PERCHDIR="$2"

   # Determine the primary device and check for Ventoy environment
   VENTOYDIR="${MINIOS_VENTOY_DIR:-/ventoy}"
   VENTOYDRIVE=$(awk '/linear/ {print $4; exit}' "$VENTOYDIR/ventoy_dm_table" 2>/dev/null)
   if [ ! "$VENTOYDRIVE" ]; then
      DEVICE="/dev/$(lsblk -no pkname "$DRIVE" 2>/dev/null | head -n 1)"
   else
      DEVICE="/dev/$(lsblk -no pkname "$VENTOYDRIVE" 2>/dev/null | head -n 1)"
   fi

   for LABEL in persistence resizeme; do
      PART=$(blkid -t LABEL="$LABEL" -o device -c /dev/null 2>/dev/null)
      if [ "$PART" ]; then
         PERCHDEVICE="/dev/$(lsblk -no pkname "$PART" 2>/dev/null | head -n 1)"
         if [ "$PERCHDEVICE" != "$DEVICE" ]; then
            continue
         fi
         # Handle existing partitions
         if [ "$LABEL" = "resizeme" ]; then
            echo "* Found resizeme partition, resizing..." >&2
            if ! parted --fix -a optimal -s "$DEVICE" resizepart $(lsblk -no partn "$PART" 2>/dev/null) 100% >/dev/null 2>&1; then
               echo "$PERCHDIR"
               return
            fi
            partprobe "$DEVICE" >/dev/null 2>&1 || sleep 1
            if ! mke2fs -t ext4 -F -L persistence "$PART" >/dev/null 2>&1; then
               echo "$PERCHDIR"
               return
            fi
         fi
         PERCHPART="$PART"
         break
      fi
   done

   if [ ! "$PERCHPART" ]; then
      # Check for Ventoy-specific persistence
      if [ "$VENTOYDRIVE" ]; then
         # Ventoy persistence plugin: Ventoy mounts the backend .dat file
         # (configured in /ventoy/ventoy.json) as a loop device with label "persistence".
         # This device has no parent disk (pkname is empty).
         for VTOY_PERST_DEV in $(blkid -t LABEL="persistence" -o device -c /dev/null 2>/dev/null); do
            if [ -b "$VTOY_PERST_DEV" ]; then
               VTOY_PARENT=$(lsblk -no pkname "$VTOY_PERST_DEV" 2>/dev/null | head -n 1)
               if [ -z "$VTOY_PARENT" ]; then
                  debug_log "manage_perch_partition" "Found Ventoy persistence plugin device: $VTOY_PERST_DEV"
                  PERCHPART="$VTOY_PERST_DEV"
                  break
               fi
            fi
         done
         # Fallback: directory-based persistence on Ventoy partition
         if [ ! "$PERCHPART" ]; then
            # In Ventoy version 1.1.01 and higher, a device link to /dev/mapper is used
            # instead of the VENTOY_LINUX_REMOUNT variable in the configuration file.
            MAPPER_NAME="$(lsblk -no name "$VENTOYDRIVE" 2>/dev/null | head -n 1)"
            MAPPER_DEVICE="/dev/mapper/$MAPPER_NAME"
            if [ ! -e "$MAPPER_DEVICE" ] && [ -n "$MAPPER_NAME" ]; then
               for DM_NAME in "${MINIOS_SYS_CLASS_BLOCK:-/sys/class/block}"/dm-*/dm/name; do
                  [ -f "$DM_NAME" ] || continue
                  [ "$(cat "$DM_NAME" 2>/dev/null)" = "$MAPPER_NAME" ] || continue
                  DM_BLOCK="$(basename "$(dirname "$(dirname "$DM_NAME")")")"
                  MAPPER_DEVICE="${MINIOS_DEV_ROOT:-/dev}/$DM_BLOCK"
                  break
               done
            fi
            if [ -e "$MAPPER_DEVICE" ]; then
               PERCHPART="$MAPPER_DEVICE/minios/changes"
            # If there is no device link in /dev/mapper, then an older version of Ventoy is used.
            else
               PERCHPART="$VENTOYDRIVE/minios/changes"
            fi
         fi
      fi
   fi

   if [ ! "$PERCHPART" ]; then
      echo "$PERCHDIR"
      return
   fi

   echo "$PERCHPART"
}

persistence_requested() {
   local TOKEN
   for TOKEN in $(cat "$MINIOS_CMDLINE_FILE" 2>/dev/null); do
      case "$TOKEN" in
      perch | perchdir=* | perchmode=* | perchencrypt=* | perchsize=* | perchreserve=* | perchcomp=*) return 0 ;;
      esac
   done
   return 1
}

dynblk_available() {
   secure_boot_enabled && return 1
   command -v dynblk >/dev/null 2>&1
}

vmdk_available() {
   dynblk_available && dynblk limits --format vmdk >/dev/null 2>&1
}

dynblk_codec_registered() {
   local CODEC="$1" PROC_CRYPTO="${MINIOS_PROC_CRYPTO:-/proc/crypto}"
   [ -r "$PROC_CRYPTO" ] || return 1
   awk -v wanted="$CODEC" '
      $1 == "name" && $2 == ":" { name = $3 }
      $1 == "type" && $2 == ":" && name == wanted && $3 == "compression" { found = 1 }
      END { exit found ? 0 : 1 }
   ' "$PROC_CRYPTO"
}

dynblk_codec_available() {
   local CODEC="$1"
   case "$CODEC" in
   none) return 0 ;;
   lz4 | lz4hc | lzo | lzo-rle | zstd | deflate | 842) ;;
   *) return 1 ;;
   esac
   dynblk_codec_registered "$CODEC" && return 0
   modprobe -q "crypto-$CODEC" 2>/dev/null || modprobe -q "$CODEC" 2>/dev/null || return 1
   dynblk_codec_registered "$CODEC"
}

block_session_available() {
   case "$1" in
   dynblk) dynblk_available ;;
   vmdk) vmdk_available ;;
   *) return 0 ;;
   esac
}

dynblk_device_valid() {
   local DEVICE="$1" INDEX
   case "$DEVICE" in
   /dev/dynblk*) ;;
   *) return 1 ;;
   esac
   INDEX=${DEVICE#/dev/dynblk}
   case "$INDEX" in
   '' | *[!0-9]*) return 1 ;;
   esac
   [ "$INDEX" -le 255 ]
}

dynblk_device_ready() {
   dynblk_device_valid "$1" && [ -b "$1" ]
}

# Free space in whole MB on the filesystem that holds $1.
perch_free_mb() {
   local BLOCKS
   BLOCKS=$(df -P "$1" 2>/dev/null | tail -n 1 | awk '{print $4}')
   case "$BLOCKS" in
   '' | *[!0-9]*)
      echo 0
      return
      ;;
   esac
   echo $((BLOCKS / 1024))
}

# Free space kept in reserve (MB) so persistence never consumes the last bytes
# of the device. A full device is what freezes writes and leaves a container
# that cannot be unmounted cleanly. Override with the perchreserve= parameter.
perch_reserve_mb() {
   local RESERVE
   RESERVE="$(cmdline_value perchreserve)"
   case "$RESERVE" in
   '' | *[!0-9]*) RESERVE=256 ;;
   esac
   [ "$RESERVE" -gt 4096 ] && RESERVE=4096
   echo "$RESERVE"
}

# Warn early when the persistence device is already low on free space. This is
# the preventive counterpart to a mid-session out-of-space hang: it lets the
# user free space before writes start failing. Returns non-zero when low.
perch_space_warn() {
   local DIR="$1" FREE RESERVE
   FREE=$(perch_free_mb "$DIR")
   RESERVE=$(perch_reserve_mb)
   if [ "$FREE" -le "$RESERVE" ]; then
      boot_warning_notify warning space \
         "Warning: only ${FREE}MB free on the persistence device (reserve ${RESERVE}MB)." \
         "Free up space, delete old sessions, or reduce session data to avoid a full-disk hang."
      return 1
   fi
   return 0
}

# --- Boot warning capture and persistence runtime state (tmpfs only) ----------
# These publish to a tmpfs area preserved across switch_root so the desktop
# guard can surface any warning the user may have missed on the console (U1),
# and record whether persistence activation succeeded. Nothing is written to the
# persistent (monitored) filesystem.

# Locations overridable for tests.
: "${MINIOS_PERSISTENCE_RUNDIR:=/run/initramfs/minios-persistence}"
: "${MINIOS_SESSION_STATE_FILE:=/minios-session-state}"
: "${MINIOS_BOOT_ID_FILE:=/proc/sys/kernel/random/boot_id}"
: "${MINIOS_PROC_MOUNTS:=/proc/mounts}"
: "${MINIOS_PROC_MOUNTINFO:=/proc/self/mountinfo}"
: "${MINIOS_PROC_MEMINFO:=/proc/meminfo}"
: "${MINIOS_UNSQUASHFS:=/bin/unsquashfs}"
: "${MINIOS_PERSISTENCE_TTY:=/dev/tty1}"
: "${MINIOS_PERSISTENCE_TTY_OUTPUT:=$MINIOS_PERSISTENCE_TTY}"
: "${MINIOS_CMDLINE_FILE:=/proc/cmdline}"
: "${MINIOS_SYS_CLASS_BLOCK:=/sys/class/block}"
: "${MINIOS_DEV_ROOT:=/dev}"
: "${MINIOS_SYS_FS_AUFS:=/sys/fs/aufs}"
: "${MINIOS_LIVEKIT_STATE_STAGE:=/minios-persistence}"

# Append one structured boot-warning record. Console output is left to the
# caller (or boot_warning_notify) so existing messages are unchanged.
# $1 severity (warning|error)  $2 category (persistence|mode|space|fsck|other)
# $3.. message
boot_warning_log() {
   local SEVERITY="$1" CATEGORY="$2" MSG BOOTID TS
   shift 2
   MSG="$*"
   mkdir -p "$MINIOS_PERSISTENCE_RUNDIR" 2>/dev/null || return 0
   BOOTID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null) || BOOTID="unknown"
   TS=$(cut -d' ' -f1 /proc/uptime 2>/dev/null) || TS="0"
   printf '%s\t%s\t%s\t%s\t%s\n' "$BOOTID" "$TS" "$SEVERITY" "$CATEGORY" "$MSG" \
      >>"$MINIOS_PERSISTENCE_RUNDIR/boot-warnings" 2>/dev/null || true
}

# Console warning (keeping the existing visual style) plus a structured record.
# $1 severity (warning|error)  $2 category  $3.. message
boot_warning_notify() {
   local SEVERITY="$1" CATEGORY="$2" LINE MSG=""
   shift 2
   case "$SEVERITY" in
   error) echo_red_star >&2 ;;
   *) echo_yellow_star >&2 ;;
   esac
   for LINE in "$@"; do
      echo "$LINE" >&2
      if [ -z "$MSG" ]; then
         MSG="$LINE"
      else
         MSG="$MSG $LINE"
      fi
   done
   [ -z "$MSG" ] || boot_warning_log "$SEVERITY" "$CATEGORY" "$MSG"
}

# Return source, filesystem type, and mount options for the deepest mount that
# contains a path. Fixed MiniOS paths do not contain mount-table escapes.
perch_mount_record() {
   awk -v path="$1" '
      {
         mountpoint = $2
         if (mountpoint == "/" || path == mountpoint ||
             index(path, mountpoint "/") == 1) {
            if (length(mountpoint) > best) {
               best = length(mountpoint)
               source = $1
               filesystem = $3
               options = $4
            }
         }
      }
      END {
         if (best > 0) print source "\t" filesystem "\t" options
      }
   ' "$MINIOS_PROC_MOUNTS" 2>/dev/null
}

# A persistence store must resolve to a supported disk filesystem. Follow loop
# backing files so toram and another volatile loop-backed store cannot be
# reported as durable merely because the inner filesystem is ext4.
perch_block_is_durable() {
   local DEVICE="$1" DEPTH="${2:-0}" RESOLVED NAME RO BACKING SLAVE SLAVE_PATH FOUND=0
   [ "$DEPTH" -lt 8 ] || return 1
   RESOLVED=$(readlink -f "$DEVICE" 2>/dev/null) || RESOLVED="$DEVICE"
   NAME=$(basename "$RESOLVED")
   case "$NAME" in
   zram* | ram* | nbd*) return 1 ;;
   loop*)
      BACKING=$(losetup "$RESOLVED" 2>/dev/null | sed -n 's/.*(\(.*\)).*/\1/p')
      [ -n "$BACKING" ] || return 1
      perch_store_is_durable "$BACKING" $((DEPTH + 1))
      return
      ;;
   esac
   [ -d "$MINIOS_SYS_CLASS_BLOCK/$NAME" ] || return 1
   RO=$(cat "$MINIOS_SYS_CLASS_BLOCK/$NAME/ro" 2>/dev/null) || return 1
   [ "$RO" = "0" ] || return 1
   if [ -d "$MINIOS_SYS_CLASS_BLOCK/$NAME/slaves" ]; then
      for SLAVE_PATH in "$MINIOS_SYS_CLASS_BLOCK/$NAME/slaves"/*; do
         [ -e "$SLAVE_PATH" ] || continue
         FOUND=1
         SLAVE=$(basename "$SLAVE_PATH")
         perch_block_is_durable "$MINIOS_DEV_ROOT/$SLAVE" $((DEPTH + 1)) || return 1
      done
   fi
   [ "$FOUND" = "1" ] && return 0
   case "$NAME" in
   sd[a-z]* | vd[a-z]* | xvd[a-z]* | nvme[0-9]*n[0-9]* | mmcblk[0-9]*) return 0 ;;
   *) return 1 ;;
   esac
}

perch_store_is_durable() {
   local PATH_TO_CHECK="$1" DEPTH="${2:-0}" RECORD SOURCE FILESYSTEM
   [ "$DEPTH" -lt 8 ] || return 1
   RECORD=$(perch_mount_record "$PATH_TO_CHECK")
   [ -n "$RECORD" ] || return 1
   SOURCE=$(printf '%s\n' "$RECORD" | cut -f1)
   FILESYSTEM=$(printf '%s\n' "$RECORD" | cut -f2)
   case "$FILESYSTEM" in
   ext2 | ext3 | ext4 | btrfs | xfs | f2fs | reiserfs | vfat | fat | msdos | exfat | ntfs | ntfs3 | ntfs-3g | fuseblk) ;;
   *) return 1 ;;
   esac
   case "$SOURCE" in
   "$MINIOS_DEV_ROOT"/*) perch_block_is_durable "$SOURCE" "$DEPTH" ;;
   *) return 1 ;;
   esac
}

perch_store_is_writable() {
   local RECORD OPTIONS
   RECORD=$(perch_mount_record "$1")
   [ -n "$RECORD" ] || return 1
   OPTIONS=$(printf '%s\n' "$RECORD" | cut -f3)
   case ",$OPTIONS," in
   *,rw,*) return 0 ;;
   *) return 1 ;;
   esac
}

# Return the st_dev-compatible device number and inode for a fixed MiniOS path
# without depending on a stat applet in the small LiveKit BusyBox payload.
perch_store_identity() {
   local STORE="$1" DEVICE INODE
   DEVICE=$(awk -v path="$STORE" '
      {
         mountpoint = $5
         if (mountpoint == "/" || path == mountpoint ||
             index(path, mountpoint "/") == 1) {
            if (length(mountpoint) > best) {
               split($3, parts, ":")
               major = parts[1] + 0
               minor = parts[2] + 0
               best = length(mountpoint)
            }
         }
      }
      END {
         if (best > 0)
            printf "%.0f\n", major * 256 + (minor % 256) + int(minor / 256) * 1048576
      }
   ' "$MINIOS_PROC_MOUNTINFO" 2>/dev/null) || return 1
   INODE=$(LC_ALL=C ls -di "$STORE" 2>/dev/null | awk 'NR == 1 { print $1 }') || return 1
   case "$DEVICE" in '' | *[!0-9]*) return 1 ;; esac
   case "$INODE" in '' | *[!0-9]*) return 1 ;; esac
   printf '%s %s\n' "$DEVICE" "$INODE"
}

# Publish the boot-time persistence result for runtime consumers. A successful
# record is bound to this boot and to the actual durable numbered-session store.
# $1 level  $2 mode  $3 session  $4 session store  $5 active generation
# $6 dynblk device  $7 encryption  $8 crypt mapper  $9 owned loop device
perch_state_publish() {
   local LEVEL="$1" MODE="$2" SESSION="$3" STORE="$4" GENERATION="$5"
   local DYNBLK_DEVICE="${6:-none}"
   local ENCRYPTION="${7:-none}" CRYPT_MAPPER="${8:-none}" LOOP_DEVICE="${9:-none}"
   local TMP BOOTID DURABLE=0 WRITABLE=0 DEVICE=0 INODE=0 IDENTITY LOOP_INDEX
   BOOTID=$(cat "$MINIOS_BOOT_ID_FILE" 2>/dev/null) || BOOTID="unknown"
   case "$BOOTID" in
   '' | *[!0-9A-Fa-f-]*) BOOTID="unknown" ;;
   esac
   case "$SESSION" in
   '' | *[!0-9]*) SESSION="unknown" ;;
   esac
   case "$MODE" in
   native | dynfilefs | dynblk | vmdk | raw | squashfs) ;;
   *) MODE="unknown" ;;
   esac
   { [ "$MODE" = dynblk ] || [ "$MODE" = vmdk ]; } || DYNBLK_DEVICE="none"
   case "$ENCRYPTION" in none | luks) ;; *) ENCRYPTION="unknown" ;; esac
   if [ "$ENCRYPTION" != luks ]; then
      CRYPT_MAPPER="none"
      LOOP_DEVICE="none"
   else
      case "$CRYPT_MAPPER" in
      '' | none | *[!A-Za-z0-9_.+-]*) CRYPT_MAPPER="none" ;;
      esac
      case "$LOOP_DEVICE" in
      none) ;;
      /dev/loop*)
         LOOP_INDEX=${LOOP_DEVICE#/dev/loop}
         case "$LOOP_INDEX" in '' | *[!0-9]*) LOOP_DEVICE="none" ;; esac
         ;;
      *) LOOP_DEVICE="none" ;;
      esac
   fi
   case "$LEVEL" in
   ok)
      if ! echo "$SESSION" | grep -q '^[0-9][0-9]*$' ||
         { [ "$GENERATION" != "current" ] &&
           { [ "$GENERATION" != "old" ] || [ "$MODE" != "squashfs" ]; }; } ||
         [ "$BOOTID" = "unknown" ] || [ -z "$BOOTID" ] ||
         { { [ "$MODE" = dynblk ] || [ "$MODE" = vmdk ]; } &&
           ! dynblk_device_ready "$DYNBLK_DEVICE"; }; then
         LEVEL="failed"
         GENERATION="none"
         DYNBLK_DEVICE="none"
      else
         IDENTITY=$(perch_store_identity "$STORE") || LEVEL="failed"
         DEVICE=${IDENTITY%% *}
         INODE=${IDENTITY#* }
         perch_store_is_writable "$STORE" && WRITABLE=1
         perch_store_is_durable "$STORE" && DURABLE=1
         if [ "$LEVEL" != "ok" ] || [ "$WRITABLE" != "1" ]; then
            LEVEL="failed"
            DEVICE=0
            INODE=0
            GENERATION="none"
            DYNBLK_DEVICE="none"
         fi
      fi
      ;;
   *)
      LEVEL="failed"
      GENERATION="none"
      DYNBLK_DEVICE="none"
      ;;
   esac
   mkdir -p "$MINIOS_PERSISTENCE_RUNDIR" 2>/dev/null || return 1
   TMP="$MINIOS_PERSISTENCE_RUNDIR/boot-state.tmp.$$"
   if (
      umask 077
      {
         echo "boot_id=$BOOTID"
         echo "boot_level=$LEVEL"
         echo "mode=$MODE"
         echo "session=$SESSION"
         echo "durable=$DURABLE"
         echo "writable=$WRITABLE"
         echo "sessions_device=$DEVICE"
         echo "sessions_inode=$INODE"
         echo "active_generation=${GENERATION:-none}"
         echo "dynblk_device=$DYNBLK_DEVICE"
         echo "encryption=$ENCRYPTION"
         echo "crypt_mapper=$CRYPT_MAPPER"
         echo "loop_device=$LOOP_DEVICE"
      } >"$TMP" 2>/dev/null && chmod 600 "$TMP" 2>/dev/null &&
         mv -f "$TMP" "$MINIOS_PERSISTENCE_RUNDIR/boot-state" 2>/dev/null
   ); then
      [ "$LEVEL" = "ok" ]
      return
   fi
   rm -f "$TMP" "$MINIOS_PERSISTENCE_RUNDIR/boot-state" 2>/dev/null
   return 1
}

# Defer a successful marker until the union mount has actually consumed the
# activated changes root. Failure markers remain immediate.
perch_state_prepare() {
   MINIOS_PENDING_PERSISTENCE_MODE="$1"
   MINIOS_PENDING_PERSISTENCE_SESSION="$2"
   MINIOS_PENDING_PERSISTENCE_STORE="$3"
   MINIOS_PENDING_PERSISTENCE_GENERATION="$4"
   MINIOS_PENDING_PERSISTENCE_CHANGES="$5"
   MINIOS_PENDING_PERSISTENCE_CONF="${6:-}"
   MINIOS_PENDING_PERSISTENCE_DYNBLK_DEVICE="${7:-none}"
   MINIOS_PENDING_PERSISTENCE_ENCRYPTION="${8:-none}"
   MINIOS_PENDING_PERSISTENCE_CRYPT_MAPPER="${9:-none}"
   MINIOS_PENDING_PERSISTENCE_LOOP_DEVICE="${10:-none}"
}

perch_state_clear_pending() {
   MINIOS_PENDING_PERSISTENCE_MODE=""
   MINIOS_PENDING_PERSISTENCE_SESSION=""
   MINIOS_PENDING_PERSISTENCE_STORE=""
   MINIOS_PENDING_PERSISTENCE_GENERATION=""
   MINIOS_PENDING_PERSISTENCE_CHANGES=""
   MINIOS_PENDING_PERSISTENCE_CONF=""
   MINIOS_PENDING_PERSISTENCE_DYNBLK_DEVICE=""
   MINIOS_PENDING_PERSISTENCE_ENCRYPTION=""
   MINIOS_PENDING_PERSISTENCE_CRYPT_MAPPER=""
   MINIOS_PENDING_PERSISTENCE_LOOP_DEVICE=""
}

perch_union_is_active() {
   local RECORD FILESYSTEM OPTIONS EXPECTED SI BRANCH BRANCH_PATH EXPECTED_ID BRANCH_ID PROBE
   RECORD=$(perch_mount_record "$1")
   [ -n "$RECORD" ] || {
      echo "Cannot identify the active root union at $1" >&2
      return 1
   }
   FILESYSTEM=$(printf '%s\n' "$RECORD" | cut -f2)
   OPTIONS=$(printf '%s\n' "$RECORD" | cut -f3)
   case "$FILESYSTEM" in
   overlay | overlayfs)
      EXPECTED="upperdir=$2/changes"
      case ",$OPTIONS," in
      *,"$EXPECTED",*) return 0 ;;
      *) return 1 ;;
      esac
      ;;
   aufs)
      if aufs_ng_is_loaded; then
         PROBE=".minios-persistence-probe.$$"
         : >"$1/$PROBE" || return 1
         if [ ! -f "$2/$PROBE" ]; then
            rm -f "$1/$PROBE" "$2/$PROBE" 2>/dev/null
            return 1
         fi
         rm -f "$1/$PROBE" || return 1
         [ ! -e "$2/$PROBE" ]
         return
      fi
      SI=$(printf '%s\n' "$OPTIONS" | tr ',' '\n' | sed -n 's/^si=//p')
      [ -n "$SI" ] || {
         echo "Cannot identify the active AUFS instance" >&2
         return 1
      }
      BRANCH="$MINIOS_SYS_FS_AUFS/si_$SI/br0"
      [ -r "$BRANCH" ] || {
         echo "Cannot read the active AUFS writable branch: $BRANCH" >&2
         return 1
      }
      BRANCH_PATH=$(sed 's/=rw.*$//' "$BRANCH")
      [ "$BRANCH_PATH" = "$2" ] && return 0
      EXPECTED_ID=$(perch_store_identity "$2") || {
         echo "Cannot identify expected AUFS persistence branch: $2" >&2
         return 1
      }
      BRANCH_ID=$(perch_store_identity "$BRANCH_PATH") || {
         echo "Cannot identify active AUFS persistence branch: $BRANCH_PATH" >&2
         return 1
      }
      if [ "$BRANCH_ID" != "$EXPECTED_ID" ]; then
         echo "AUFS writable branch does not match persistence: $BRANCH_PATH" >&2
         return 1
      fi
      return 0
      ;;
   *) return 1 ;;
   esac
}

perch_state_commit() {
   local UNION_ROOT="$1"
   [ -n "$MINIOS_PENDING_PERSISTENCE_SESSION" ] || return 0
   if ! perch_union_is_active "$UNION_ROOT" "$MINIOS_PENDING_PERSISTENCE_CHANGES"; then
      boot_warning_notify error persistence "Persistence changes were not committed into the root union."
      perch_state_publish failed "$MINIOS_PENDING_PERSISTENCE_MODE" \
         "$MINIOS_PENDING_PERSISTENCE_SESSION"
      perch_state_clear_pending
      return 1
   fi
   if ! perch_state_publish ok "$MINIOS_PENDING_PERSISTENCE_MODE" \
      "$MINIOS_PENDING_PERSISTENCE_SESSION" \
       "$MINIOS_PENDING_PERSISTENCE_STORE" \
       "$MINIOS_PENDING_PERSISTENCE_GENERATION" \
       "$MINIOS_PENDING_PERSISTENCE_DYNBLK_DEVICE" \
       "$MINIOS_PENDING_PERSISTENCE_ENCRYPTION" \
       "$MINIOS_PENDING_PERSISTENCE_CRYPT_MAPPER" \
       "$MINIOS_PENDING_PERSISTENCE_LOOP_DEVICE"; then
      boot_warning_notify error persistence "Persistence was active but its runtime authority could not be published."
      perch_state_publish failed "$MINIOS_PENDING_PERSISTENCE_MODE" \
         "$MINIOS_PENDING_PERSISTENCE_SESSION"
      perch_state_clear_pending
      return 1
   fi
   if [ "$MINIOS_PENDING_PERSISTENCE_MODE" = "squashfs" ] &&
      ! session_conf_commit "$MINIOS_PENDING_PERSISTENCE_CONF" \
         "$MINIOS_PENDING_PERSISTENCE_SESSION" squashfs \
         "$MINIOS_SQUASHFS_VERSION" "$MINIOS_SQUASHFS_EDITION" \
         "$MINIOS_SQUASHFS_SYSTEM_UNION" "$MINIOS_SQUASHFS_SIZE"; then
      boot_warning_notify error persistence "SquashFS session metadata could not be committed after union activation."
      perch_state_publish failed "$MINIOS_PENDING_PERSISTENCE_MODE" \
         "$MINIOS_PENDING_PERSISTENCE_SESSION"
      perch_state_clear_pending
      return 1
   fi
   perch_state_clear_pending
   return 0
}

perch_state_abort() {
   local MESSAGE="$1"
   boot_warning_notify error persistence "$MESSAGE"
   [ -n "$MINIOS_PENDING_PERSISTENCE_SESSION" ] || return 0
   perch_state_publish failed "$MINIOS_PENDING_PERSISTENCE_MODE" \
      "$MINIOS_PENDING_PERSISTENCE_SESSION" || true
   perch_state_clear_pending
}

# Carry the current-boot record into the final root. The old initramfs itself
# later lives at /run/initramfs, so leaving the record under its original /run
# would place it one level too deep for runtime consumers.
perch_state_preserve() {
   local NEW_ROOT="$1" DESTINATION="$1/run/initramfs/minios-persistence"
   [ -d "$MINIOS_PERSISTENCE_RUNDIR" ] || return 0
   mkdir -p "$DESTINATION" || return 1
   chmod 700 "$DESTINATION" || return 1
   cp -a "$MINIOS_PERSISTENCE_RUNDIR"/. "$DESTINATION"/ || return 1
   if [ -f "$DESTINATION/boot-state" ]; then
      chmod 600 "$DESTINATION/boot-state" || return 1
   fi
}

perch_state_stage_livekit() {
   local DESTINATION="$MINIOS_LIVEKIT_STATE_STAGE"
   [ -d "$MINIOS_PERSISTENCE_RUNDIR" ] || return 0
   rm -rf "$DESTINATION" || return 1
   mkdir -p "$DESTINATION" || return 1
   chmod 700 "$DESTINATION" || return 1
   cp -a "$MINIOS_PERSISTENCE_RUNDIR"/. "$DESTINATION"/ || return 1
   [ ! -f "$DESTINATION/boot-state" ] || chmod 600 "$DESTINATION/boot-state"
}

# Pop any stacked mounts left on the persistence target by a failed attempt so a
# failed activation cannot masquerade as a writable RAM directory. Loop devices
# set up with "mount -o loop" auto-detach on umount.
perch_activation_unwind() {
   local TARGET="$1" I
   for I in 1 2 3 4; do
      grep -qF " $TARGET " /proc/mounts 2>/dev/null || break
      umount "$TARGET" 2>/dev/null || break
   done
   ! grep -qF " $TARGET " "$MINIOS_PROC_MOUNTS" 2>/dev/null
}

perch_state_fail_now() {
   local MODE="$1" SESSION="$2"
   shift 2
   perch_state_clear_pending
   boot_warning_notify error persistence "$*"
   perch_state_publish failed "$MODE" "$SESSION" || true
}

# Install a complete metadata replacement atomically in the same directory.
session_conf_replace() {
   local CONF="$1" TMP="$2"

   sync
   mv -f "$TMP" "$CONF" || return 1
   sync
}

# Convert JSON metadata to the conf representation used by the shell reader.
session_json_migrate() {
   local JSON="$1" CONF="$2" TMP="${2}.tmp.$$"

   command -v jq >/dev/null 2>&1 || return 1
   jq -e '
      (.sessions | type == "object") and
      ([.sessions | to_entries[] |
         (.key | test("^[0-9]+$")) and
         (.value | type == "object") and
         ([.value | to_entries[] |
            (.key | test("^[a-z][a-z0-9_]*$")) and
            ((.value | type) == "string" or
             (.value | type) == "number" or
             (.value | type) == "boolean" or
             (.value | type) == "null") and
            ((.value | tostring | test("[\u0000\r\n]")) | not)
         ] | all)
      ] | all) and
      (.default == null or (.default | type == "string" and test("^[0-9]+$"))) and
      (.running == null or (.running | type == "string" and test("^[0-9]+$")))
   ' "$JSON" >/dev/null 2>&1 || return 1
   jq -r '
      (select(.default != null) | "default=\(.default)"),
      (select(.running != null) | "running=\(.running)"),
      (.sessions | to_entries[] |
       .key as $id | .value | to_entries[] |
       select(.key | test("^[a-z][a-z0-9_]*$")) |
       select(.value != null and .value != "") |
       "session_\(.key)[\($id)]=\(.value)")
   ' "$JSON" >"$TMP" || {
      rm -f "$TMP"
      return 1
   }
   session_conf_replace "$CONF" "$TMP" || {
      rm -f "$TMP"
      return 1
   }
}

# Regenerate session.json from the current session.conf when jq is available.
# session.json is the expected format when tooling has jq; this keeps it current
# after every boot-time conf commit. Failure is best-effort: conf is always
# written first and is already consistent.
session_conf_to_json() {
   local CONF="$1" JSON="$2" TMP
   command -v jq >/dev/null 2>&1 || return 0
   [ -f "$CONF" ] || return 1
   TMP="${JSON}.tmp.$$"
   # Parse the conf key=value stream with a jq Rn filter. jq handles all string
   # escaping, so special characters in field values are safe.
   jq -Rn '
      [inputs | select(length > 0)] |
      reduce .[] as $line (
         {"default": null, "sessions": {}};
         if ($line | test("^default=")) then
            .default = ($line | ltrimstr("default="))
         elif ($line | test("^running=")) then
            .running = ($line | ltrimstr("running="))
         elif ($line | test("^session_[a-z][a-z0-9_]*\\[[0-9]+\\]=")) then
            ($line | capture("^session_(?<field>[a-z][a-z0-9_]*)\\[(?<id>[0-9]+)\\]=(?<val>.*)")) as $m |
            .sessions[$m.id][$m.field] = $m.val
         else . end
      )
   ' "$CONF" >"$TMP" 2>/dev/null || { rm -f "$TMP"; return 1; }
   session_conf_replace "$JSON" "$TMP" || { rm -f "$TMP"; return 1; }
}

# Select the source solely from initrd capability and synchronize the conf copy
# used by the existing shell commit path.
session_metadata_select() {
   local DIR="$1" CONF="$1/session.conf" JSON="$1/session.json"

   if command -v jq >/dev/null 2>&1; then
      if [ ! -f "$JSON" ] && [ -f "$CONF" ]; then
         session_conf_to_json "$CONF" "$JSON" || return 1
      fi
      if [ -f "$JSON" ]; then
         session_json_migrate "$JSON" "$CONF" || return 1
         echo "$CONF"
         return 0
      fi
   fi

   [ ! -f "$JSON" ] || [ -f "$CONF" ] || return 1
   echo "$CONF"
}

# Publish a session only after its persistence mount is active.
session_conf_commit() {
   local CONF="$1" SESSION="$2" MODE="$3" VERSION="$4" EDITION="$5" UNION="$6" SIZE="$7" ENCRYPTION="${8:-none}"
   local INPUT TMP JSON

   INPUT="$CONF"
   [ -f "$INPUT" ] || INPUT=/dev/null
   TMP="${CONF}.tmp.$$"
   awk -v id="$SESSION" -v size="$SIZE" '
      /^default=/ || /^running=/ { next }
       index($0, "session_mode[" id "]=") == 1 { next }
       index($0, "session_encryption[" id "]=") == 1 { next }
      index($0, "session_version[" id "]=") == 1 { next }
      index($0, "session_edition[" id "]=") == 1 { next }
      index($0, "session_union[" id "]=") == 1 { next }
      index($0, "session_size[" id "]=") == 1 && size != "" && size != "0" { next }
      index($0, "session_state[" id "]=") == 1 { next }
      { print }
   ' "$INPUT" >"$TMP" || return 1

   {
      echo "default=$SESSION"
      echo "running=$SESSION"
       echo "session_mode[$SESSION]=$MODE"
       [ "$ENCRYPTION" != luks ] || echo "session_encryption[$SESSION]=luks"
      [ -z "$VERSION" ] || echo "session_version[$SESSION]=$VERSION"
      [ -z "$EDITION" ] || echo "session_edition[$SESSION]=$EDITION"
      [ -z "$UNION" ] || echo "session_union[$SESSION]=$UNION"
      [ -z "$SIZE" ] || [ "$SIZE" = "0" ] || echo "session_size[$SESSION]=$SIZE"
      echo "session_state[$SESSION]=dirty"
   } >>"$TMP" || return 1

   JSON="$(dirname "$CONF")/session.json"
   rm -f "$JSON" || { rm -f "$TMP"; return 1; }
   sync
   session_conf_replace "$CONF" "$TMP" || {
      rm -f "$TMP"
      return 1
   }

   # Keep JSON current when jq is available. Without jq, remove a stale JSON
   # copy; a later jq-capable initrd will regenerate it from current conf.
   if command -v jq >/dev/null 2>&1; then
      session_conf_to_json "$CONF" "$JSON" || rm -f "$JSON"
   fi

   # The shutdown-state marker only lets a clean shutdown mark the session clean.
   # session.conf is already committed above, so a failure here must not fail
   # activation; record it and continue.
   if ! {
       echo "CONF=$CONF"
      echo "SESSION=$SESSION"
   } >"$MINIOS_SESSION_STATE_FILE" 2>/dev/null; then
      boot_warning_notify warning other "Could not record session shutdown-state marker; session may stay marked dirty."
   fi
   sync
   return 0
}

# Mark a session clean only after its persistence mounts have disappeared.
session_conf_mark_clean() {
   local STATE CONF SESSION INPUT TMP JSON

   STATE="${1:-}"
   if [ -z "$STATE" ]; then
      for STATE in "$MINIOS_SESSION_STATE_FILE" /run/initramfs/minios-session-state; do
         [ -f "$STATE" ] && break
      done
   fi
   [ -f "$STATE" ] || return 0
    CONF=$(sed -n 's/^CONF=//p' "$STATE")
    SESSION=$(sed -n 's/^SESSION=//p' "$STATE")
    if [ ! -f "$CONF" ] && [ -f "/run/initramfs$CONF" ]; then
       CONF="/run/initramfs$CONF"
    fi
   [ -n "$CONF" ] && [ -n "$SESSION" ] && [ -f "$CONF" ] || return 1
   grep -q '/memory/changes ' /proc/mounts 2>/dev/null && return 1

   INPUT="$CONF"
   TMP="${CONF}.tmp.$$"
   awk -v id="$SESSION" '
      /^running=/ { next }
      index($0, "session_state[" id "]=") == 1 { next }
      { print }
   ' "$INPUT" >"$TMP" || return 1
   echo "session_state[$SESSION]=clean" >>"$TMP" || return 1
   JSON="$(dirname "$CONF")/session.json"
   rm -f "$JSON" || { rm -f "$TMP"; return 1; }
   sync
   session_conf_replace "$CONF" "$TMP" || {
      rm -f "$TMP"
      return 1
   }
   if command -v jq >/dev/null 2>&1; then
      session_conf_to_json "$CONF" "$JSON" || rm -f "$JSON"
   fi
   rm -f "$STATE"
   sync
}

squashfs_metadata_value() {
   local CONF="$1" SESSION="$2" FIELD="$3"
   awk -v prefix="session_${FIELD}[${SESSION}]=" '
      index($0, prefix) == 1 {
         count++
         value = substr($0, length(prefix) + 1)
      }
      END {
         if (count != 1) exit 1
         print value
      }
   ' "$CONF"
}

squashfs_decimal() {
   case "$1" in
   0 | [1-9] | [1-9][0-9]*) return 0 ;;
   *) return 1 ;;
   esac
}

squashfs_upper_unwind() {
   local CHANGES="$1" STATUS=0 IMAGE
   IMAGE="$(dirname "$CHANGES")/.minios-upper-$MINIOS_SQUASHFS_SESSION.ext4"
   perch_activation_unwind "$CHANGES" || STATUS=1
   [ "$STATUS" != "0" ] || rm -f "$IMAGE" || STATUS=1
   return "$STATUS"
}

squashfs_metadata_create() {
   local CHANDIR="$1" SESSION="$2" UNION="$3"
   local CONF CONF_TMP INPUT

   CONF="$CHANDIR/session.conf"
   CONF_TMP="${CONF}.tmp.$$"
   INPUT="$CONF"
   [ -f "$INPUT" ] || INPUT=/dev/null
   awk -v id="$SESSION" '
      index($0, "session_mode[" id "]=") == 1 { next }
      index($0, "session_policy[" id "]=") == 1 { next }
      index($0, "session_saved[" id "]=") == 1 { next }
      index($0, "session_digest[" id "]=") == 1 { next }
      index($0, "session_compressed[" id "]=") == 1 { next }
      index($0, "session_uncompressed[" id "]=") == 1 { next }
      index($0, "session_entries[" id "]=") == 1 { next }
      index($0, "session_footprint[" id "]=") == 1 { next }
      index($0, "session_generation[" id "]=") == 1 { next }
      index($0, "session_union[" id "]=") == 1 { next }
      { print }
   ' "$INPUT" >"$CONF_TMP" || return 1
   {
      echo "session_mode[$SESSION]=squashfs"
      echo "session_policy[$SESSION]=shutdown"
      echo "session_generation[$SESSION]=0"
      echo "session_union[$SESSION]=$UNION"
   } >>"$CONF_TMP" || return 1
   rm -f "$CHANDIR/session.json"
   session_conf_replace "$CONF" "$CONF_TMP" || {
      rm -f "$CONF_TMP"
      return 1
   }
   sync
}

squashfs_generation_restore() {
   local CHANGES="$1" ARTIFACT DIGEST COMPRESSED UNCOMPRESSED ENTRIES UNION GENERATION
   local IMAGE IMAGE_BYTES INODES REQUIRED AVAILABLE ROOT SIZE ACTUAL PLAN
   ARTIFACT="$MINIOS_SQUASHFS_SESSION_DIR/changes.sb"
   GENERATION=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" "$MINIOS_SQUASHFS_SESSION" generation) || return 1
   squashfs_decimal "$GENERATION" || return 1
   UNION=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" "$MINIOS_SQUASHFS_SESSION" union) || return 1
   [ "$UNION" = "$(get_union_fs)" ] || return 1
   if [ "$GENERATION" = 0 ]; then
      [ ! -e "$ARTIFACT" ] && [ ! -L "$ARTIFACT" ] || return 1
      if awk -v id="$MINIOS_SQUASHFS_SESSION" '
         index($0, "session_digest[" id "]=") == 1 ||
         index($0, "session_compressed[" id "]=") == 1 ||
         index($0, "session_uncompressed[" id "]=") == 1 ||
         index($0, "session_entries[" id "]=") == 1 ||
         index($0, "session_footprint[" id "]=") == 1 { found=1 }
         END { exit !found }
      ' "$MINIOS_SQUASHFS_CONF"; then
         return 1
      fi
      IMAGE_BYTES=67108864
      INODES=8192
   else
      [ -f "$ARTIFACT" ] && [ ! -L "$ARTIFACT" ] || return 1
   fi
   IMAGE="$(dirname "$CHANGES")/.minios-upper-$MINIOS_SQUASHFS_SESSION.ext4"
   if [ "$GENERATION" = 0 ]; then
      truncate -s "$IMAGE_BYTES" "$IMAGE" || return 1
      mke2fs -q -t ext4 -F -m 0 -N "$INODES" -O '^has_journal' \
         "$IMAGE" || return 1
      mount -o loop,rw,noatime,nodiratime,errors=remount-ro \
         "$IMAGE" "$CHANGES" || return 1
      rmdir "$CHANGES/lost+found" 2>/dev/null || return 1
      if [ "$UNION" = overlayfs ]; then
         mkdir "$CHANGES/changes" "$CHANGES/workdir" || return 1
      fi
      SQUASHFS_ACTIVE_GENERATION=current
      return 0
   fi
   DIGEST=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" "$MINIOS_SQUASHFS_SESSION" digest) || return 1
   COMPRESSED=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" "$MINIOS_SQUASHFS_SESSION" compressed) || return 1
   UNCOMPRESSED=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" "$MINIOS_SQUASHFS_SESSION" uncompressed) || return 1
   ENTRIES=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" "$MINIOS_SQUASHFS_SESSION" entries) || return 1
   squashfs_decimal "$COMPRESSED" && squashfs_decimal "$UNCOMPRESSED" &&
      squashfs_decimal "$ENTRIES" && [ "$COMPRESSED" != "0" ] || return 1
   echo "$DIGEST" | grep -q '^[0-9a-f][0-9a-f]*$' && [ "${#DIGEST}" -eq 64 ] || return 1
   PLAN=$(awk -v bytes="$UNCOMPRESSED" -v entries="$ENTRIES" '
      BEGIN {
         image = bytes * 2 + entries * 8192 + 67108864
         if (image < 67108864 || image > 9007199254740991) exit 1
         printf "%.0f %.0f %.0f\n", image, entries * 2 + 8192,
            bytes + entries * 8192 + 134217728
      }
   ') || return 1
   set -- $PLAN
   IMAGE_BYTES=$1
   INODES=$2
   REQUIRED=$3
   AVAILABLE=$(awk '$1 == "MemAvailable:" || $1 == "SwapFree:" { total += $2 }
                    END { printf "%.0f\n", total * 1024 }' "$MINIOS_PROC_MEMINFO") || return 1
   [ "$AVAILABLE" -ge "$REQUIRED" ] 2>/dev/null || return 1
   SIZE=$(wc -c <"$ARTIFACT" 2>/dev/null | tr -d ' ') || return 1
   [ "$SIZE" = "$COMPRESSED" ] || return 1
   [ "$(LC_ALL=C sha256sum "$ARTIFACT" 2>/dev/null | awk 'NR == 1 { print $1 }')" = "$DIGEST" ] || return 1
   truncate -s "$IMAGE_BYTES" "$IMAGE" || return 1
   mke2fs -q -t ext4 -F -m 0 -N "$INODES" -O '^has_journal' \
      "$IMAGE" || return 1
   mount -o loop,rw,noatime,nodiratime,errors=remount-ro \
      "$IMAGE" "$CHANGES" || return 1
   rmdir "$CHANGES/lost+found" 2>/dev/null || return 1
   ROOT="$CHANGES"
   if [ "$UNION" = "overlayfs" ]; then
      mkdir "$CHANGES/changes" "$CHANGES/workdir" || return 1
      ROOT="$CHANGES/changes"
   fi
   exec 9<"$ARTIFACT" || return 1
   if ! LC_ALL=C "$MINIOS_UNSQUASHFS" -quiet -no-progress -strict-errors -xattrs \
         -processors 1 -data-queue 1 -frag-queue 1 -dest "$ROOT" /proc/self/fd/9; then
      exec 9<&-
      return 1
   fi
   ACTUAL=$(LC_ALL=C sha256sum /proc/self/fd/9 2>/dev/null | awk 'NR == 1 { print $1 }')
   exec 9<&-
   [ "$ACTUAL" = "$DIGEST" ] || return 1
   SQUASHFS_ACTIVE_GENERATION="current"
}

# Activate persistent changes
# $1 = data directory
# $2 = target changes directory
#
persistent_changes() {
   debug_log "persistent_changes" "$*"
   local DATA CHANGES DRIVE CHANDIR PERCHDIR PERCHSIZE PERCHSIZE_SPECIFIED PERCHCOMP PERCHFILE FS_TYPE PERCHFILE_EXISTS SPECIFIED AVAILABLE_SPACE MAX_SIZE MOUNT_OPTS PERCHMODE PERCHENCRYPT ACTION PERCHSESSION CURRENT_SIZE CURRENT_USAGE NEW_SESSION AUTO_RESUME DYNBLK_DEVICE CRYPT_MAPPER LOOP_DEVICE LUKS_PASSWORD LUKS_SECRET LUKS_CONFIRM LUKS_TRACE_WAS_ENABLED LUKS_TTY_OPEN

   DATA="$1"
   CHANGES="$2"
   DYNBLK_DEVICE="none"
   CRYPT_MAPPER="none"
   LOOP_DEVICE="none"
   LUKS_TTY_OPEN=false
   perch_state_clear_pending
   MINIOS_SQUASHFS_SESSION=""
   rm -f "$MINIOS_PERSISTENCE_RUNDIR/boot-state" 2>/dev/null
   PERCHDIR="$(cmdline_value perchdir)"
   AUTO_RESUME="false"
   [ "$PERCHDIR" = "resume" ] && AUTO_RESUME="true"
   PERCHMODE="$(cmdline_value perchmode)"
   PERCHENCRYPT="$(cmdline_value perchencrypt)"
   : "${PERCHENCRYPT:=none}"
   if ! block_session_available "$PERCHMODE"; then
      if secure_boot_enabled && { [ "$PERCHMODE" = dynblk ] || [ "$PERCHMODE" = vmdk ]; }; then
         boot_warning_notify warning mode \
            "$PERCHMODE persistence is unavailable while Secure Boot is enabled; using the standard persistence mode."
      else
         boot_warning_notify warning mode \
            "DynBlk is unavailable in this initramfs; using the standard persistence mode."
      fi
      PERCHMODE="native"
   fi
   PERCHSIZE="$(cmdline_value perchsize)"
   PERCHSIZE_SPECIFIED="false"
   [ -z "$PERCHSIZE" ] || PERCHSIZE_SPECIFIED="true"
   : "${PERCHSIZE:=0}"
   PERCHCOMP="$(cmdline_value perchcomp)"
   : "${PERCHCOMP:=none}"

   # Parse size with units (MB, GB, TB) and convert to MB
   parse_size() {
      local SIZE="$1"
      local NUMBER UNIT

      # Remove any whitespace
      SIZE=$(echo "$SIZE" | tr -d ' ')

      # Extract number and unit
      NUMBER=$(echo "$SIZE" | sed 's/[A-Za-z]*$//')
      UNIT=$(echo "$SIZE" | sed 's/^[0-9]*//' | tr '[:lower:]' '[:upper:]')

      # Validate number
      if ! echo "$NUMBER" | grep -q '^[0-9]\+$'; then
         echo "0"
         return
      fi

      # Convert to MB based on unit
      case "$UNIT" in
      "" | "M" | "MB")
         echo "$NUMBER"
         ;;
      "G" | "GB")
         echo $((NUMBER * 1000))
         ;;
      "T" | "TB")
         echo $((NUMBER * 1000000))
         ;;
      *)
         echo "0"
         ;;
      esac
   }

   # Parse PERCHSIZE if it contains units
   if [ "$PERCHSIZE" != "0" ] && echo "$PERCHSIZE" | grep -q '[A-Za-z]'; then
      PERCHSIZE=$(parse_size "$PERCHSIZE")
   fi
   CHANDIR="$DATA/$(basename "$CHANGES")"
   DRIVE="$(df -P "$DATA" | tail -n 1 | awk '{print $1}')"

   handle_perch_file() {
      if [ -z "$PERCHFILE_EXISTS" ]; then
         echo "* Creating new persistent changes for session #$PERCHDIR"
         debug_log "truncate -s ${PERCHSIZE}M $1"
         truncate -s "${PERCHSIZE}M" "$1" || {
            boot_warning_notify error persistence "Session #$PERCHDIR: cannot allocate container ($PERCHMODE)."
            return 1
         }
         echo "- creating filesystem"
         mke2fs -t ext4 -F "$1" >/dev/null 2>&1 || {
            boot_warning_notify error persistence "Session #$PERCHDIR: cannot create filesystem ($PERCHMODE)."
            return 1
         }
      else
         echo "* Resuming persistent changes for session #$PERCHDIR"

         # Check filesystem before any resize operations. Statuses 0 and 1 may
         # continue; 2 and above reject writable activation and preserve the
         # container for recovery.
         if command -v e2fsck >/dev/null; then
            echo "- checking filesystem for errors"
            e2fsck -p "$1" >/dev/null 2>&1
            [ "$?" -le 1 ] || {
               boot_warning_notify error fsck "Session #$PERCHDIR: filesystem check failed; keeping it read-only for recovery."
               return 1
            }
         fi

         echo "- grow if needed"
         case "$PERCHMODE" in
         "raw")
            CURRENT_SIZE=$(du -m "$1" | awk '{print $1}')
            if [ "$PERCHSIZE" -gt "$CURRENT_SIZE" ]; then
               echo "- expanding raw image from ${CURRENT_SIZE}MB to ${PERCHSIZE}MB"
               truncate -s "${PERCHSIZE}M" "$1" || {
                  boot_warning_notify error persistence "Session #$PERCHDIR: cannot expand raw image."
                  return 1
               }
            fi
            echo "- resizing filesystem to match image"
            # A failed resize means the filesystem stays at its previous size;
            # the container is still valid and we continue to mount it.
            if ! resize2fs -f "$1" >/dev/null 2>&1; then
               boot_warning_notify warning persistence "Session #$PERCHDIR: could not resize filesystem to full container size; mounting at previous size."
            fi
            ;;
         "dynfilefs")
            echo "- resizing filesystem to match container"
            if ! resize2fs -f "$1" >/dev/null 2>&1; then
               boot_warning_notify warning persistence "Session #$PERCHDIR: could not resize filesystem to full container size; mounting at previous size."
            fi
            ;;
         esac
      fi
      echo "- mounting persistent changes"
      # errors=remount-ro turns a full backing device into a read-only inner
      # filesystem instead of corruption when writes start failing.
      mount -o loop,errors=remount-ro "$1" "$CHANGES" || {
         boot_warning_notify error persistence "Session #$PERCHDIR: cannot mount persistent changes."
         return 1
      }
   }

   calculate_perch_size() {
      local MEM_TOTAL_KB DYN_LIMIT RAM_LIMIT INDEX_DISK_LIMIT AUTO_LIMIT STORED_SIZE

      AVAILABLE_SPACE=$(df -P "$CHANDIR" | tail -n 1 | awk '{print $4}')
      AVAILABLE_SPACE=$((AVAILABLE_SPACE / 1024))

      if [ "$PERCHMODE" = "raw" ] && [ -e "$CHANDIR/$PERCHFILE" ]; then
         CURRENT_USAGE=$(du -m "$CHANDIR/$PERCHFILE" | awk '{print $1}')
         AVAILABLE_SPACE=$((AVAILABLE_SPACE + CURRENT_USAGE))
      fi

      # Keep a safety reserve free so creating or growing persistence does not
      # consume the last bytes of the device (see perch_reserve_mb).
      MAX_SIZE=$((AVAILABLE_SPACE - $(perch_reserve_mb)))
      [ "$MAX_SIZE" -lt 0 ] && MAX_SIZE=0

      case "$PERCHMODE" in
      dynfilefs)
         # Format 400 stores one 8-byte offset for every 4 KiB logical block.
         # With -p 4000 every segment therefore maps about 8 MiB of index into
         # RAM and stores the same index on disk. Limit indexes to about 1/8 of
         # physical RAM, then apply the tested i686 address-space ceiling.
         DYN_LIMIT=2000000
         MEM_TOTAL_KB=$(awk '/^MemTotal:/ { print $2; exit }' "$MINIOS_PROC_MEMINFO" 2>/dev/null)
         case "$MEM_TOTAL_KB" in
         '' | *[!0-9]*) ;;
         *)
            RAM_LIMIT=$((MEM_TOTAL_KB / 65536 * 4000))
            [ "$RAM_LIMIT" -lt "$DYN_LIMIT" ] && DYN_LIMIT=$RAM_LIMIT
            ;;
         esac

         # A new storage also has to fit its eagerly-created indexes on the
         # persistence filesystem. Use 8 MiB per 4000 MiB segment as a safe
         # upper estimate. Existing containers have already paid this cost.
         if [ ! -e "$CHANDIR/$PERCHFILE" ]; then
            INDEX_DISK_LIMIT=$((MAX_SIZE / 8 * 4000))
            [ "$INDEX_DISK_LIMIT" -lt "$DYN_LIMIT" ] && DYN_LIMIT=$INDEX_DISK_LIMIT
         fi
         [ "$DYN_LIMIT" -lt 0 ] && DYN_LIMIT=0

         # Refuse an existing session whose stored geometry cannot be opened
         # within the current machine's RAM/address-space limit. Passing a
         # smaller -s does not shrink DynFileFS metadata.
         if [ -e "$CHANDIR/$PERCHFILE" ]; then
            STORED_SIZE=$(sed -n "s/^session_size\[$PERCHDIR\]=//p" \
               "$CHANDIR/session.conf" 2>/dev/null)
            case "$STORED_SIZE" in
            [1-9] | [1-9][0-9]*)
               if [ "$STORED_SIZE" -gt "$DYN_LIMIT" ]; then
                  echo "- DynFileFS session size ${STORED_SIZE}MB exceeds the safe limit ${DYN_LIMIT}MB for available RAM"
                  return 1
               fi
               ;;
            esac
         fi

         if [ "$PERCHSIZE" = "0" ] && [ ! -e "$CHANDIR/$PERCHFILE" ]; then
            PERCHSIZE="auto"
         fi
         if [ "$PERCHSIZE" = "auto" ]; then
            # Automatic dynamic persistence defaults to 16 GiB, but never
            # advertises more capacity than the backing store can ultimately
            # hold after the reserve. DynFileFS also needs ~0.2% for indexes.
            AUTO_LIMIT=$((MAX_SIZE * 500 / 501))
            [ "$DYN_LIMIT" -lt "$AUTO_LIMIT" ] && AUTO_LIMIT=$DYN_LIMIT
            [ "$AUTO_LIMIT" -gt 16384 ] && AUTO_LIMIT=16384
            PERCHSIZE=$AUTO_LIMIT
         elif [ "$PERCHSIZE" -gt "$DYN_LIMIT" ]; then
            echo "- persistent changes size ${PERCHSIZE}MB exceeds DynFileFS safe limit"
            echo "- using maximum safe size ${DYN_LIMIT}MB"
            PERCHSIZE=$DYN_LIMIT
         fi
         ;;
      dynblk | vmdk)
         # Match DynFileFS automatic sizing: use up to 16 GiB only when the
         # backing store has that much space after the reserve. Explicit thin
         # capacities remain a user choice and are not capped by current free
         # space. DynBlk reports its geometry limit and owns its bounded metadata cache.
         DYN_LIMIT=$(dynblk limits --format "$PERCHMODE" 2>/dev/null |
            sed -n 's/^max_capacity_mib: //p')
         case "$DYN_LIMIT" in
         '' | *[!0-9]*) DYN_LIMIT=524288 ;; # Older CLI compatibility only.
         esac
         [ "$DYN_LIMIT" -gt 0 ] || DYN_LIMIT=524288
         if [ "$PERCHSIZE" = "0" ] && [ ! -e "$CHANDIR/$PERCHFILE" ]; then
            PERCHSIZE=$MAX_SIZE
            [ "$PERCHSIZE" -gt 16384 ] && PERCHSIZE=16384
         fi
         if [ "$PERCHSIZE" -gt "$DYN_LIMIT" ]; then
            echo "- persistent changes size ${PERCHSIZE}MB exceeds DynBlk limit, using ${DYN_LIMIT}MB"
            PERCHSIZE=$DYN_LIMIT
         fi
         ;;
      *)
         if [ "$PERCHSIZE" = "0" ] && [ ! -e "$CHANDIR/$PERCHFILE" ]; then
            PERCHSIZE=4000
         fi
         [ "$MAX_SIZE" -gt 1000000 ] && MAX_SIZE=1000000
         if [ "$PERCHSIZE" -gt "$MAX_SIZE" ]; then
            echo "- persistent changes size ${PERCHSIZE}MB exceeds available space"
            echo "- using maximum available size ${MAX_SIZE}MB"
            PERCHSIZE=$MAX_SIZE
         fi
         ;;
      esac

      # Fixed single-file callers that need the FAT32 limit set FS_TYPE before
      # calling this helper. DynFileFS uses FAT32-safe split files instead.
      if [ "$FS_TYPE" = "vfat" ] && [ "$PERCHSIZE" -gt 4000 ]; then
         echo "- persistent changes size ${PERCHSIZE}MB exceeds FAT32 limit, using 4000MB"
         PERCHSIZE=4000
      fi
   }

   update_session() {
      local SESSIONS VERSION EDITION UNION EXISTING_SIZE

      if [ -f /etc/minios-release ]; then
         VERSION=$(config_value "/etc/minios-release" VERSION)
         EDITION=$(config_value "/etc/minios-release" EDITION)
      fi
      UNION=$(get_union_fs)
      SESSIONS="$CHANDIR/session.conf"

      case "$PERCHMODE" in
      dynfilefs | dynblk | vmdk)
         EXISTING_SIZE=$(sed -n "s/^session_size\[$PERCHDIR\]=//p" "$SESSIONS" 2>/dev/null)
         if { [ -z "$PERCHSIZE" ] || [ "$PERCHSIZE" = "0" ]; } && [ -n "$EXISTING_SIZE" ]; then
            PERCHSIZE="$EXISTING_SIZE"
         fi
         ;;
      esac

      session_conf_commit "$SESSIONS" "$PERCHDIR" "$PERCHMODE" "$VERSION" "$EDITION" "$UNION" "$PERCHSIZE" "$PERCHENCRYPT" || return 1
      perch_state_prepare "$PERCHMODE" "$PERCHDIR" "$CHANDIR" current "$CHANGES" "" "$DYNBLK_DEVICE" "$PERCHENCRYPT" "$CRYPT_MAPPER" "$LOOP_DEVICE"
      touch "$CHANDIR/$PERCHDIR" 2>/dev/null || true
   }

   luks_secret_read() {
      local READ_STATUS
      printf '%s' "$1" >"$MINIOS_PERSISTENCE_TTY_OUTPUT" || return 1
      stty -echo <&9 || return 1
      IFS= read -r LUKS_SECRET <&9
      READ_STATUS=$?
      stty echo <&9 || return 1
      printf '\n' >"$MINIOS_PERSISTENCE_TTY_OUTPUT" || return 1
      return "$READ_STATUS"
   }

   luks_secret_begin() {
      LUKS_TRACE_WAS_ENABLED=""
      case "$-" in *x*)
         LUKS_TRACE_WAS_ENABLED=1
         set +x
         ;;
      esac
      exec 9<"$MINIOS_PERSISTENCE_TTY" || {
         [ -z "$LUKS_TRACE_WAS_ENABLED" ] || set -x
         return 1
      }
      LUKS_TTY_OPEN=true
   }

   luks_secret_end() {
      if [ "$LUKS_TTY_OPEN" = true ]; then
         stty echo <&9 2>/dev/null || true
         exec 9>&-
         LUKS_TTY_OPEN=false
      fi
      unset LUKS_SECRET LUKS_CONFIRM
      [ -z "$LUKS_TRACE_WAS_ENABLED" ] || set -x
   }

   luks_attach_loop() {
      local LOOP_INDEX
      LOOP_DEVICE=$(losetup --find --show -- "$1" 2>/dev/null) || return 1
      case "$LOOP_DEVICE" in
      /dev/loop*)
         LOOP_INDEX=${LOOP_DEVICE#/dev/loop}
         case "$LOOP_INDEX" in '' | *[!0-9]*) LOOP_DEVICE=none; return 1 ;; esac
         ;;
      *) LOOP_DEVICE=none; return 1 ;;
      esac
   }

   luks_detach_loop() {
      [ "$LOOP_DEVICE" != none ] || return 0
      losetup --detach "$LOOP_DEVICE" 2>/dev/null || return 1
      LOOP_DEVICE=none
   }

   luks_close() {
      [ "$CRYPT_MAPPER" != none ] || return 0
      cryptsetup close "$CRYPT_MAPPER" 2>/dev/null || return 1
      CRYPT_MAPPER=none
   }

   luks_create_open() {
      local SOURCE="$1"
      CRYPT_MAPPER="minios-perch-$PERCHDIR"
      luks_secret_begin || return 1
      luks_secret_read "Create encryption password: " || {
         luks_secret_end
         return 1
      }
      LUKS_PASSWORD="$LUKS_SECRET"
      unset LUKS_SECRET
      luks_secret_read "Confirm encryption password: " || {
         luks_secret_end
         unset LUKS_PASSWORD
         return 1
      }
      LUKS_CONFIRM="$LUKS_SECRET"
      unset LUKS_SECRET
      if [ -z "$LUKS_PASSWORD" ] || [ "$LUKS_PASSWORD" != "$LUKS_CONFIRM" ]; then
         echo "Encryption passwords did not match" >&2
         luks_secret_end
         unset LUKS_PASSWORD
         return 1
      fi
      if ! printf '%s' "$LUKS_PASSWORD" | cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$SOURCE" ||
         ! printf '%s' "$LUKS_PASSWORD" | cryptsetup open --type luks --key-file - "$SOURCE" "$CRYPT_MAPPER"; then
         luks_secret_end
         unset LUKS_PASSWORD
         CRYPT_MAPPER=none
         return 1
      fi
      luks_secret_end
      luks_mapper_ready "$CRYPT_MAPPER"
   }

   # Returns 2 only when all passphrase attempts were rejected. Callers release
   # their backend resources before turning that result into a fatal boot stop.
   luks_open_existing() {
      local SOURCE="$1" ATTEMPT=1
      CRYPT_MAPPER="minios-perch-$PERCHDIR"
      luks_secret_begin || return 1
      while [ "$ATTEMPT" -le 3 ]; do
         luks_secret_read "Unlock encrypted persistent changes (attempt $ATTEMPT/3): " || {
            luks_secret_end
            CRYPT_MAPPER=none
            return 1
         }
         LUKS_PASSWORD="$LUKS_SECRET"
         unset LUKS_SECRET
         if printf '%s' "$LUKS_PASSWORD" | cryptsetup open --type luks --key-file - "$SOURCE" "$CRYPT_MAPPER"; then
            luks_secret_end
            luks_mapper_ready "$CRYPT_MAPPER" && return 0
            CRYPT_MAPPER=none
            unset LUKS_PASSWORD
            return 1
         fi
         unset LUKS_PASSWORD
         ATTEMPT=$((ATTEMPT + 1))
      done
      luks_secret_end
      CRYPT_MAPPER=none
      return 2
   }

   luks_reopen() {
      local SOURCE="$1"
      CRYPT_MAPPER="minios-perch-$PERCHDIR"
      [ -n "$LUKS_PASSWORD" ] || return 1
      printf '%s' "$LUKS_PASSWORD" | cryptsetup open --type luks --key-file - \
         "$SOURCE" "$CRYPT_MAPPER" || {
         CRYPT_MAPPER=none
         return 1
      }
      luks_mapper_ready "$CRYPT_MAPPER"
   }

   luks_unwind() {
      local STATUS=0
      umount "$CHANGES" 2>/dev/null || true
      luks_close || STATUS=1
      luks_detach_loop || STATUS=1
      unset LUKS_PASSWORD
      return "$STATUS"
   }

   native_mode() {
      local T1="$CHANDIR/.empty"
      local T2="${T1}2"
      local FS
      PERCHMODE="native"

      # Check filesystem type first - reject non-POSIX filesystems
      FS="$(device_bestfs "$DRIVE")"
      if [ "$FS" = "ntfs3" ] || [ "$FS" = "ntfs-3g" ] || [ "$FS" = "vfat" ] || [ "$FS" = "exfat" ]; then
         echo_yellow_star
         # This is expected documented behaviour on non-POSIX media; no warning
         # record is written since it is not an unplanned event.
         if dynblk_available; then
            echo "Native mode not supported on $FS filesystem, using DynBlk"
            PERCHMODE=dynblk
            dynblk_mode
         else
            echo "Native mode not supported on $FS filesystem, using DynFileFS"
            dynfilefs_mode
         fi
         return
      fi

      # Test POSIX compatibility
      if touch "$T1" && ln -sf "$T1" "$T2" 2>/dev/null &&
         chmod +x "$T1" 2>/dev/null && test -x "$T1" &&
         chmod -x "$T1" 2>/dev/null && test ! -x "$T1" &&
         rm "$T1" "$T2" 2>/dev/null; then
         echo "* Activating native persistent changes for session #$PERCHDIR"
         if mount --bind "$CHANDIR/$PERCHDIR" "$CHANGES"; then
            if ! update_session; then
               if perch_activation_unwind "$CHANGES" && [ "$NEW_SESSION" = "true" ]; then
                  rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
               fi
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: metadata could not be updated; persistence was disabled for this boot."
               return
            fi
         else
            boot_warning_notify error persistence "Session #$PERCHDIR: cannot bind native persistent changes."
         fi
      else
         if dynblk_available; then
            boot_warning_notify warning mode \
               "Native mode failed, falling back to DynBlk."
            PERCHMODE=dynblk
            dynblk_mode
         else
            boot_warning_notify warning mode \
               "Native mode failed, falling back to DynFileFS."
            dynfilefs_mode
         fi
      fi
   }

   dynfilefs_mode() {
      local OPEN_STATUS CURRENT_BYTES TARGET_BYTES STORED_SIZE RETRY NEW_CONTAINER=false
      PERCHMODE="dynfilefs"
      PERCHFILE="$PERCHDIR/changes.dat"
      [ -e "$CHANDIR/$PERCHFILE" ] && PERCHFILE_EXISTS="true"
      [ -n "$PERCHFILE_EXISTS" ] || NEW_CONTAINER=true
      if [ "$NEW_CONTAINER" != true ] && [ "$PERCHSIZE_SPECIFIED" != true ]; then
         STORED_SIZE=$(sed -n "s/^session_size\[$PERCHDIR\]=//p" \
            "$CHANDIR/session.conf" 2>/dev/null)
         case "$STORED_SIZE" in
         [1-9] | [1-9][0-9]*) PERCHSIZE="$STORED_SIZE" ;;
         esac
      fi
      if ! calculate_perch_size; then
         [ "$NEW_SESSION" = true ] && rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: DynFileFS size is not safe for the available RAM; continuing in memory."
         return
      fi
      if [ "$NEW_CONTAINER" = true ] && [ "$PERCHSIZE" -le 0 ]; then
         [ "$NEW_SESSION" = true ] && rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: no space is available for a DynFileFS container; continuing in memory."
         return
      fi

      if [ "$PERCHENCRYPT" = luks ]; then
         if ! luks_layer_available || ! command -v losetup >/dev/null 2>&1; then
            [ "$NEW_SESSION" = true ] && rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: encrypted DynFileFS persistence is unavailable."
            return
         fi
         modprobe dm-crypt 2>/dev/null || true
         MOUNT_OPTS="-f $CHANDIR/$PERCHFILE -m $CHANGES -p 4000"
         [ "$NEW_CONTAINER" != true ] || MOUNT_OPTS="$MOUNT_OPTS -s $PERCHSIZE"
         @mount.dynfilefs $MOUNT_OPTS || {
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: DynFileFS backend did not start."
            return
         }
         [ -e "$CHANGES/virtual.dat" ] || {
            umount "$CHANGES" 2>/dev/null || true
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: DynFileFS container did not appear."
            return
         }
         luks_attach_loop "$CHANGES/virtual.dat" || {
            umount "$CHANGES" 2>/dev/null || true
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: cannot attach DynFileFS virtual image."
            return
         }
         if [ "$NEW_CONTAINER" = true ]; then
            if ! luks_create_open "$LOOP_DEVICE" ||
               ! mke2fs -t ext4 -F "/dev/mapper/$CRYPT_MAPPER" >/dev/null 2>&1; then
               luks_unwind || true
               umount "$CHANGES" 2>/dev/null || true
               rm -f -- "$CHANDIR/$PERCHFILE" "$CHANDIR/$PERCHFILE".*
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: encrypted DynFileFS persistence could not be created."
               return
            fi
         else
            luks_open_existing "$LOOP_DEVICE"
            OPEN_STATUS=$?
            if [ "$OPEN_STATUS" -eq 2 ]; then
               luks_detach_loop || true
               umount "$CHANGES" 2>/dev/null || true
               fatal "Incorrect password for encrypted persistence session #$PERCHDIR"
               return
            elif [ "$OPEN_STATUS" -ne 0 ]; then
               luks_unwind || true
               umount "$CHANGES" 2>/dev/null || true
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: encrypted DynFileFS persistence could not be opened."
               return
            fi
            CURRENT_BYTES=$(LC_ALL=C ls -ln "$CHANGES/virtual.dat" 2>/dev/null |
               awk 'NR == 1 && $5 ~ /^[0-9]+$/ { print $5; found=1 } END { if (!found) exit 1 }') || {
               luks_unwind || true
               umount "$CHANGES" 2>/dev/null || true
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: cannot determine DynFileFS virtual capacity."
               return
            }
            TARGET_BYTES=$((PERCHSIZE * 1048576))
            if [ "$PERCHSIZE" -gt 0 ] && [ "$TARGET_BYTES" -gt "$CURRENT_BYTES" ]; then
               if ! luks_close || ! luks_detach_loop || ! umount "$CHANGES"; then
                  luks_unwind || true
                  perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                     "Session #$PERCHDIR: encrypted DynFileFS could not be detached for growth."
                  return
               fi
               MOUNT_OPTS="-f $CHANDIR/$PERCHFILE -m $CHANGES -p 4000 -s $PERCHSIZE"
               OPEN_STATUS=1
               for RETRY in 1 2 3 4 5; do
                  if @mount.dynfilefs $MOUNT_OPTS; then
                     OPEN_STATUS=0
                     break
                  fi
                  sleep 1
               done
               [ "$OPEN_STATUS" -eq 0 ] && [ -e "$CHANGES/virtual.dat" ] &&
                  luks_attach_loop "$CHANGES/virtual.dat" && luks_reopen "$LOOP_DEVICE" || {
                  luks_unwind || true
                  umount "$CHANGES" 2>/dev/null || true
                  perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                     "Session #$PERCHDIR: encrypted DynFileFS could not be reopened after growth."
                  return
               }
            fi
            e2fsck -f -p "/dev/mapper/$CRYPT_MAPPER" >/dev/null 2>&1
            if [ "$?" -gt 1 ] || ! resize2fs -f "/dev/mapper/$CRYPT_MAPPER" >/dev/null 2>&1; then
               luks_unwind || true
               umount "$CHANGES" 2>/dev/null || true
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: encrypted DynFileFS filesystem could not be prepared."
               return
            fi
         fi
         unset LUKS_PASSWORD
         mount -o errors=remount-ro "/dev/mapper/$CRYPT_MAPPER" "$CHANGES" || {
            luks_unwind || true
            umount "$CHANGES" 2>/dev/null || true
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: encrypted DynFileFS persistence could not be mounted."
            return
         }
         if ! update_session; then
            umount "$CHANGES" 2>/dev/null || true
            luks_close || true
            luks_detach_loop || true
            umount "$CHANGES" 2>/dev/null || true
            if [ "$NEW_SESSION" = true ]; then
               rm -f -- "$CHANDIR/$PERCHFILE" "$CHANDIR/$PERCHFILE".*
               rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
            fi
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: metadata could not be updated; persistence was disabled for this boot."
         fi
         return
      fi

      MOUNT_OPTS="-f $CHANDIR/$PERCHFILE -m $CHANGES -p 4000"
      if [ -z "$PERCHFILE_EXISTS" ] || [ "$PERCHSIZE" -gt 0 ]; then
         MOUNT_OPTS="$MOUNT_OPTS -s $PERCHSIZE"
      fi
      @mount.dynfilefs $MOUNT_OPTS || {
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: DynFileFS backend did not start."
         return
      }
      # Confirm the FUSE mount actually exposed virtual.dat before touching it;
      # otherwise handle_perch_file would create a container in RAM and appear
      # persistent while silently discarding data.
      [ -e "$CHANGES/virtual.dat" ] || {
         umount "$CHANGES" 2>/dev/null || true
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: DynFileFS container did not appear."
         return
      }
      if ! handle_perch_file "$CHANGES/virtual.dat"; then
         perch_activation_unwind "$CHANGES" || true
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: DynFileFS persistence could not be activated."
         return
      fi
      if ! update_session; then
         if perch_activation_unwind "$CHANGES" && [ "$NEW_SESSION" = "true" ]; then
            rm -f -- "$CHANDIR/$PERCHFILE" "$CHANDIR/$PERCHFILE".*
            rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
         fi
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: metadata could not be updated; persistence was disabled for this boot."
         return
      fi
   }

   dynblk_mode() {
      local VOLUME TARGET_DEVICE OPEN_STATUS GROWN="false"
      : "${PERCHMODE:=dynblk}"
      case "$PERCHMODE" in
      vmdk) PERCHFILE="$PERCHDIR/volume.vmdk" ;;
      *) PERCHFILE="$PERCHDIR/volume000.db" ;;
      esac
      if { [ "$PERCHMODE" = vmdk ] && [ -e "$CHANDIR/$PERCHDIR/volume000.db" ]; } ||
         { [ "$PERCHMODE" = dynblk ] && [ -e "$CHANDIR/$PERCHDIR/volume.vmdk" ]; }; then
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" "Session #$PERCHDIR metadata does not match its block image."
         return
      fi
      if [ "$PERCHMODE" = vmdk ] && [ "$PERCHCOMP" != none ]; then
         boot_warning_notify warning mode "VMDK does not support compression; using none."
         PERCHCOMP=none
      fi
      VOLUME="$CHANDIR/$PERCHFILE"
      DYNBLK_DEVICE="none"
      [ -e "$VOLUME" ] && PERCHFILE_EXISTS="true"
      calculate_perch_size
      if [ -z "$PERCHFILE_EXISTS" ] && [ "$PERCHSIZE" -le 0 ]; then
         [ "$NEW_SESSION" = true ] && rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: no space is available for a DynBlk container; continuing in memory."
         return
      fi

      if [ "$PERCHENCRYPT" = luks ]; then
         if ! luks_layer_available; then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: encrypted DynBlk persistence is unavailable."
            [ "$NEW_SESSION" = true ] && rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
            return
         fi
         modprobe dm-crypt 2>/dev/null || true
         if [ "$PERCHCOMP" != none ]; then
            boot_warning_notify warning mode \
               "Session #$PERCHDIR: DynBlk compression '$PERCHCOMP' is ignored below LUKS; using none."
            PERCHCOMP=none
         fi
      fi

      if [ -z "$PERCHFILE_EXISTS" ]; then
         case "$PERCHCOMP" in
         none | lz4 | lz4hc | lzo | lzo-rle | zstd | deflate | 842) ;;
         *)
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: unsupported DynBlk compression '$PERCHCOMP'."
            return
            ;;
         esac
         if [ "$PERCHCOMP" != none ] && ! dynblk_codec_available "$PERCHCOMP"; then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: DynBlk compression '$PERCHCOMP' is unavailable in this initramfs."
            return
         fi
         echo "* Creating new DynBlk persistent changes for session #$PERCHDIR"
         if ! DYNBLK_DEVICE=$(dynblk create "$VOLUME" --size "${PERCHSIZE}MiB" \
               --compression "$PERCHCOMP" --format "$PERCHMODE" --execute); then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: cannot create DynBlk device."
            DYNBLK_DEVICE="none"
            return
         fi
         if ! dynblk_device_ready "$DYNBLK_DEVICE"; then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: DynBlk returned an invalid block-device path."
            DYNBLK_DEVICE="none"
            return
         fi
         TARGET_DEVICE="$DYNBLK_DEVICE"
         if [ "$PERCHENCRYPT" = luks ]; then
            if ! luks_create_open "$DYNBLK_DEVICE"; then
               dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
               DYNBLK_DEVICE="none"
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: cannot create encrypted DynBlk container."
               return
            fi
            TARGET_DEVICE="/dev/mapper/$CRYPT_MAPPER"
         fi
         echo "- creating filesystem"
         if ! mke2fs -t ext4 -F -E nodiscard "$TARGET_DEVICE" >/dev/null 2>&1; then
            luks_close || true
            dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
            DYNBLK_DEVICE="none"
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: cannot create filesystem on DynBlk device."
            return
         fi
      else
         echo "* Resuming DynBlk persistent changes for session #$PERCHDIR"
         if ! DYNBLK_DEVICE=$(dynblk load "$VOLUME" --format "$PERCHMODE" --execute); then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: cannot load DynBlk device."
            DYNBLK_DEVICE="none"
            return
         fi
         if ! dynblk_device_ready "$DYNBLK_DEVICE"; then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: DynBlk returned an invalid block-device path."
            DYNBLK_DEVICE="none"
            return
         fi
         TARGET_DEVICE="$DYNBLK_DEVICE"
         if [ "$PERCHENCRYPT" = luks ]; then
            luks_open_existing "$DYNBLK_DEVICE"
            OPEN_STATUS=$?
            if [ "$OPEN_STATUS" -eq 2 ]; then
               dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
               DYNBLK_DEVICE=none
               fatal "Incorrect password for encrypted persistence session #$PERCHDIR"
               return
            elif [ "$OPEN_STATUS" -ne 0 ]; then
               dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
               DYNBLK_DEVICE=none
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: encrypted DynBlk persistence could not be opened."
               return
            fi
            TARGET_DEVICE="/dev/mapper/$CRYPT_MAPPER"
         fi
         if [ "$PERCHSIZE_SPECIFIED" = "true" ] && [ "$PERCHSIZE" -gt 0 ]; then
            echo "- grow if needed"
            if [ "$PERCHENCRYPT" = luks ]; then
               if ! luks_close; then
                  dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
                  DYNBLK_DEVICE=none
                  perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                     "Session #$PERCHDIR: encrypted DynBlk mapper could not be closed for growth."
                  return
               fi
            fi
            if dynblk grow "$DYNBLK_DEVICE" "${PERCHSIZE}MiB" --execute; then
               GROWN="true"
            else
               boot_warning_notify warning persistence \
                  "Session #$PERCHDIR: requested DynBlk size could not be applied; using the stored capacity."
            fi
            if [ "$PERCHENCRYPT" = luks ]; then
               if ! luks_reopen "$DYNBLK_DEVICE"; then
                  dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
                  DYNBLK_DEVICE=none
                  perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                     "Session #$PERCHDIR: encrypted DynBlk mapper could not be reopened after growth."
                  return
               fi
               TARGET_DEVICE="/dev/mapper/$CRYPT_MAPPER"
            fi
         fi
         if command -v e2fsck >/dev/null; then
            echo "- checking filesystem for errors"
            e2fsck -p "$TARGET_DEVICE" >/dev/null 2>&1
            if [ "$?" -gt 1 ]; then
               luks_close || true
               dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
               DYNBLK_DEVICE="none"
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: filesystem check failed; DynBlk persistence was not mounted."
               return
            fi
         fi
         if [ "$GROWN" = "true" ] && ! resize2fs -f "$TARGET_DEVICE" >/dev/null 2>&1; then
            boot_warning_notify warning persistence \
               "Session #$PERCHDIR: DynBlk device grew, but its filesystem remains at the previous size."
         fi
      fi

      : "${TARGET_DEVICE:=$DYNBLK_DEVICE}"
      unset LUKS_PASSWORD
      echo "- mounting persistent changes"
      mount -o errors=remount-ro "$TARGET_DEVICE" "$CHANGES" || {
         luks_close || true
         dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
         DYNBLK_DEVICE="none"
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: cannot mount DynBlk persistent changes."
         return
      }
      if ! update_session; then
         umount "$CHANGES" 2>/dev/null || true
         luks_close || true
         dynblk unload "$DYNBLK_DEVICE" --execute 2>/dev/null || true
         DYNBLK_DEVICE="none"
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: metadata could not be updated; persistence was disabled for this boot."
         return
      fi
   }

   raw_mode() {
      local SOURCE OPEN_STATUS CURRENT_BYTES TARGET_BYTES NEW_CONTAINER=false
      PERCHMODE="raw"
      PERCHFILE="$PERCHDIR/changes.img"
      [ -e "$CHANDIR/$PERCHFILE" ] && PERCHFILE_EXISTS="true"
      [ -n "$PERCHFILE_EXISTS" ] || NEW_CONTAINER=true
      FS_TYPE="$(device_bestfs "$DRIVE")"
      calculate_perch_size
      if [ "$PERCHENCRYPT" = luks ]; then
         if ! luks_layer_available || ! command -v losetup >/dev/null 2>&1; then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: encrypted Raw persistence is unavailable."
            [ "$NEW_SESSION" = true ] && rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
            return
         fi
         modprobe dm-crypt 2>/dev/null || true
         if [ "$NEW_CONTAINER" = true ]; then
            truncate -s "${PERCHSIZE}M" "$CHANDIR/$PERCHFILE" || {
               rm -f "$CHANDIR/$PERCHFILE"
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: cannot allocate encrypted Raw container."
               return
            }
         fi
         luks_attach_loop "$CHANDIR/$PERCHFILE" || {
            [ "$NEW_CONTAINER" = true ] && rm -f "$CHANDIR/$PERCHFILE"
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: cannot attach encrypted Raw container."
            return
         }
         SOURCE="$LOOP_DEVICE"
         if [ "$NEW_CONTAINER" = true ]; then
            if ! luks_create_open "$SOURCE" ||
               ! mke2fs -t ext4 -F "/dev/mapper/$CRYPT_MAPPER" >/dev/null 2>&1; then
               luks_unwind || true
               rm -f "$CHANDIR/$PERCHFILE"
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: encrypted Raw persistence could not be created."
               return
            fi
         else
            luks_open_existing "$SOURCE"
            OPEN_STATUS=$?
            if [ "$OPEN_STATUS" -eq 2 ]; then
               luks_detach_loop || true
               fatal "Incorrect password for encrypted persistence session #$PERCHDIR"
               return
            elif [ "$OPEN_STATUS" -ne 0 ]; then
               luks_unwind || true
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: encrypted Raw persistence could not be opened."
               return
            fi
            CURRENT_BYTES=$(LC_ALL=C ls -ln "$CHANDIR/$PERCHFILE" 2>/dev/null |
               awk 'NR == 1 && $5 ~ /^[0-9]+$/ { print $5; found=1 } END { if (!found) exit 1 }') || {
               luks_unwind || true
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: cannot determine encrypted Raw capacity."
               return
            }
            TARGET_BYTES=$((PERCHSIZE * 1048576))
            if [ "$PERCHSIZE" -gt 0 ] && [ "$TARGET_BYTES" -gt "$CURRENT_BYTES" ]; then
               luks_close && luks_detach_loop &&
                  truncate -s "${PERCHSIZE}M" "$CHANDIR/$PERCHFILE" &&
                  luks_attach_loop "$CHANDIR/$PERCHFILE" && luks_reopen "$LOOP_DEVICE" || {
                  luks_unwind || true
                  perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                     "Session #$PERCHDIR: encrypted Raw container could not be grown."
                  return
               }
            fi
            e2fsck -f -p "/dev/mapper/$CRYPT_MAPPER" >/dev/null 2>&1
            if [ "$?" -gt 1 ] || ! resize2fs -f "/dev/mapper/$CRYPT_MAPPER" >/dev/null 2>&1; then
               luks_unwind || true
               perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
                  "Session #$PERCHDIR: encrypted Raw filesystem could not be prepared."
               return
            fi
         fi
         unset LUKS_PASSWORD
         mount -o errors=remount-ro "/dev/mapper/$CRYPT_MAPPER" "$CHANGES" || {
            luks_unwind || true
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: encrypted Raw persistence could not be mounted."
            return
         }
         if ! update_session; then
            if luks_unwind && [ "$NEW_SESSION" = true ]; then
               rm -f "$CHANDIR/$PERCHFILE"
               rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
            fi
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR: metadata could not be updated; persistence was disabled for this boot."
         fi
         return
      fi
      if ! handle_perch_file "$CHANDIR/$PERCHFILE"; then
         perch_activation_unwind "$CHANGES" || true
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: raw persistence could not be activated."
         return
      fi
      if ! update_session; then
         if perch_activation_unwind "$CHANGES" && [ "$NEW_SESSION" = "true" ]; then
            rm -f -- "$CHANDIR/$PERCHFILE"
            rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
         fi
         perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
            "Session #$PERCHDIR: metadata could not be updated; persistence was disabled for this boot."
         return
      fi
   }

   squashfs_mode() {
      local PREVIOUS_STATE
      if [ "$NEW_SESSION" = true ]; then
         if ! squashfs_metadata_create "$CHANDIR" "$PERCHDIR" "$(get_union_fs)"; then
            rmdir "$CHANDIR/$PERCHDIR" 2>/dev/null || true
            perch_state_fail_now squashfs "$PERCHDIR" \
               "SquashFS session #$PERCHDIR could not create its metadata; continuing in memory."
            return
         fi
      fi
      MINIOS_SQUASHFS_CONF=$(session_metadata_select "$CHANDIR") || return 1
      MINIOS_SQUASHFS_POLICY=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" \
         "$PERCHDIR" policy) || MINIOS_SQUASHFS_POLICY=manual
      MINIOS_SQUASHFS_VERSION=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" \
         "$PERCHDIR" version) || MINIOS_SQUASHFS_VERSION=""
      MINIOS_SQUASHFS_EDITION=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" \
         "$PERCHDIR" edition) || MINIOS_SQUASHFS_EDITION=""
      MINIOS_SQUASHFS_SIZE=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" \
         "$PERCHDIR" size) || MINIOS_SQUASHFS_SIZE=""
      MINIOS_SQUASHFS_SESSION="$PERCHDIR"
      MINIOS_SQUASHFS_SESSION_DIR="$CHANDIR/$PERCHDIR"
      MINIOS_SQUASHFS_STORE="$CHANDIR"
      MINIOS_SQUASHFS_SYSTEM_UNION=$(get_union_fs)
      case "$MINIOS_SQUASHFS_POLICY" in
      manual | shutdown) ;;
      *)
         perch_state_fail_now squashfs "$PERCHDIR" \
            "SquashFS session #$PERCHDIR has an invalid save policy; continuing in memory."
         return
         ;;
      esac
      PREVIOUS_STATE=$(squashfs_metadata_value "$MINIOS_SQUASHFS_CONF" \
         "$PERCHDIR" state) || PREVIOUS_STATE=""
      if [ "$PREVIOUS_STATE" = dirty ]; then
         boot_warning_notify warning persistence \
            "SquashFS session #$PERCHDIR did not finish cleanly; restoring the last successfully saved snapshot."
      fi
      if ! squashfs_generation_restore "$CHANGES"; then
         squashfs_upper_unwind "$CHANGES" || return
         perch_state_fail_now squashfs "$PERCHDIR" \
            "SquashFS session #$PERCHDIR could not be restored; continuing in memory."
         return
      fi
      perch_state_prepare squashfs "$PERCHDIR" "$CHANDIR" \
         "$SQUASHFS_ACTIVE_GENERATION" "$CHANGES" "$MINIOS_SQUASHFS_CONF"
      touch "$CHANDIR/$PERCHDIR" 2>/dev/null || true
   }

   # Setup the directory anyway, it will be used in all cases
   mkdir -p "$CHANGES"

   # If persistent changes are not requested, end here,
   # so memory will be used to save changes temporarily
   if ! persistence_requested; then
      return
   fi

   if [ "$PERCHDIR" = "resume" ] || [ "$PERCHDIR" = "new" ] || [ "$PERCHDIR" = "setup" ] || [ "$PERCHDIR" = "ask" ]; then
      ACTION="$PERCHDIR"
   else
      ACTION="resume"
   fi

   PERCHDIR=$(ask_disk "$PERCHDIR" perchdir)
   PERCHDIR=$(manage_perch_partition "$DRIVE" "$PERCHDIR")

   # Check if changes directory exists and is writable. Resume is best-effort:
   # when no writable persistence store is available, continue in memory.
   if ! check_write_access "$CHANDIR" "$PERCHDIR"; then
      if [ "$AUTO_RESUME" = "true" ]; then
         echo_yellow_star
         echo "Persistent changes not writable or not used"
         return
      fi
      perch_state_fail_now "$PERCHMODE" "${PERCHDIR:-unknown}" \
         "Persistent changes were requested but the selected store is not writable."
      return
   fi

   if ! PERCHSESSION=$(restore_perch_session "$DRIVE" "$CHANDIR" "$PERCHDIR" "$ACTION" "$PERCHMODE" "$AUTO_RESUME" "$PERCHENCRYPT" "$PERCHCOMP"); then
      boot_warning_notify warning persistence \
         "Persistent changes could not select a usable session; continuing in memory."
      perch_state_publish failed "${PERCHMODE:-unknown}" "${PERCHDIR:-unknown}"
      return
   fi

   set -- $PERCHSESSION
   PERCHDIR=$1
   : "${PERCHMODE:=$2}"
   NEW_SESSION=$3
   PERCHENCRYPT=${4:-none}
   PERCHCOMP=${5:-none}

   # A dynblk session can be selected implicitly by resume even when the current
   # initramfs has no dynblk support. Never reinterpret that directory as native:
   # automatic resume creates a new standard session and preserves the old one.
   if ! block_session_available "$PERCHMODE"; then
      if [ "$AUTO_RESUME" = "true" ]; then
         if secure_boot_enabled && { [ "$PERCHMODE" = dynblk ] || [ "$PERCHMODE" = vmdk ]; }; then
            boot_warning_notify warning mode \
               "Session #$PERCHDIR requires $PERCHMODE, which is unavailable while Secure Boot is enabled; creating a new standard persistence session."
         else
            boot_warning_notify warning mode \
               "Session #$PERCHDIR requires DynBlk, which is unavailable; creating a new standard persistence session."
         fi
         if ! PERCHSESSION=$(restore_perch_session "$DRIVE" "$CHANDIR" new new native false none none); then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "DynBlk is unavailable and a standard replacement session could not be created."
            return
         fi
         set -- $PERCHSESSION
         PERCHDIR=$1
         PERCHMODE=$2
         NEW_SESSION=$3
         PERCHENCRYPT=${4:-none}
         PERCHCOMP=${5:-none}
      else
         if secure_boot_enabled && { [ "$PERCHMODE" = dynblk ] || [ "$PERCHMODE" = vmdk ]; }; then
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR requires $PERCHMODE, which is unavailable while Secure Boot is enabled."
         else
            perch_state_fail_now "$PERCHMODE" "$PERCHDIR" \
               "Session #$PERCHDIR requires DynBlk, which is unavailable in this initramfs."
         fi
         return
      fi
   fi

   # Device-qualified stores are mounted by session selection, so measure free
   # space only now rather than accidentally checking the read-only ISO.
   perch_space_warn "$CHANDIR" || true

   if [ -z "$PERCHMODE" ]; then
      native_mode
   else
      case "$PERCHMODE" in
      "native") native_mode ;;
      "dynfilefs") dynfilefs_mode ;;
      dynblk | vmdk) dynblk_mode ;;
      "raw") raw_mode ;;
      "squashfs") squashfs_mode ;;
      *)
         boot_warning_notify warning mode \
            "Unknown persistence mode '$PERCHMODE'; falling back to native."
         native_mode
         ;;
      esac
   fi

   rmdir "$CHANGES/lost+found" 2>/dev/null
}

# Copy content of rootcopy directory to union
