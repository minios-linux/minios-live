machine minios {
    cpus: 2
    ram: 4Gb
    disk main: { source: "${DISK}" }
    video main: { adapter_type: "qxl" }
}

test ventoy_ram_bios {
    minios {
        start
        wait "MiniOS.iso" timeout 30s
        press End
        press Enter
        wait "Boot in normal mode" || "Start MiniOS" timeout 30s
        if (check "Boot in normal mode") { press Enter; }
        wait "Start MiniOS" timeout 30s
        press Enter
        wait "Toolbox" timeout 5m
        press LeftCtrl+LeftAlt+t
        wait "live@" timeout 30s
        press F11
        press LeftCtrl+LeftShift+Equalsign
        press LeftCtrl+LeftShift+Equalsign
        type "sudo sh -c 'S=/run/initramfs/minios-persistence; grep -qx boot_level=ok $S/boot-state && grep -qx durable=0 $S/boot-state && test -f $S/ram-origin && test -f /etc/perchtoram-session && test -f /etc/minios-external-module && test ! -e /run/initramfs/memory/data/minios/changes/2 && ! mountpoint -q /run/initramfs/memory/perch' && printf 'VENTOY %s SUCCESS\\n' RAM"
        press Enter
        wait "VENTOY RAM SUCCESS" timeout 30s
        type "sudo sh -c 'test -f /sys/class/block/sda/device/delete && echo 1 > /sys/class/block/sda/device/delete && test ! -e /sys/class/block/sda && touch /root/after-media-removal && sync -f /root/after-media-removal && sha256sum /usr/bin/python3.13 >/dev/null' && printf 'VENTOY %s SUCCESS\\n' DETACHED"
        press Enter
        wait "VENTOY DETACHED SUCCESS" timeout 30s
    }
}
