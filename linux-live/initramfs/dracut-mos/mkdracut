#!/bin/bash
# Build dracut-based initramfs for MiniOS

set -euo pipefail

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Options:
  -k,  --kernel <KERNEL VERSION>         Specify the kernel version (required)
  -o,  --output <OUTPUT FILE>            Output initramfs file path
  -n,  --network                         Enable network support
  -c,  --cloud                           Enable cloud support
  --crypt                                Include encrypted persistence support
  -d,  --debug                           Enable debug mode
  -h,  --help                            Display this help message and exit

Examples:
  $(basename "$0") --kernel 5.10.0-8-amd64
  $(basename "$0") -k 6.1.0-13-amd64 -o /boot/initrd.img -n -c

EOF
    exit 1
}

# Default parameters
KERNEL=""
OUTPUT=""
NETWORK="false"
CLOUD="false"
DEBUG="false"
CRYPT="false"

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
    -k | --kernel)
        KERNEL="$2"
        shift 2
        ;;
    -o | --output)
        OUTPUT="$2"
        shift 2
        ;;
    -n | --network)
        NETWORK="true"
        shift
        ;;
    -c | --cloud)
        CLOUD="true"
        shift
        ;;
    -d | --debug)
        DEBUG="true"
        shift
        ;;
    --crypt)
        CRYPT="true"
        shift
        ;;
    -h | --help)
        usage
        ;;
    *)
        echo "Unknown option: $1" >&2
        usage
        ;;
    esac
done

# Validate required parameters
if [ -z "$KERNEL" ]; then
    KERNEL="$(uname -r)"
    #echo "E: Kernel version is required" >&2
    #usage
fi

# Set default output (using non-versioned name for compatibility)
if [ -z "$OUTPUT" ]; then
    OUTPUT="/boot/initrfs.img"
fi

# Check if dracut is installed
if ! command -v dracut >/dev/null 2>&1; then
    echo "E: dracut is not installed" >&2
    echo "   Install it with: apt-get install dracut-core" >&2
    exit 1
fi

KERNEL_CONFIG="/boot/config-$KERNEL"
if [ ! -r "$KERNEL_CONFIG" ]; then
    echo "E: Kernel configuration not found: $KERNEL_CONFIG" >&2
    exit 1
fi

if grep -q '^CONFIG_RD_ZSTD=y$' "$KERNEL_CONFIG" && command -v zstd >/dev/null 2>&1; then
    COMPRESSION="zstd"
elif grep -q '^CONFIG_RD_GZIP=y$' "$KERNEL_CONFIG" && command -v gzip >/dev/null 2>&1; then
    COMPRESSION="gzip"
elif grep -q '^CONFIG_RD_XZ=y$' "$KERNEL_CONFIG" && command -v xz >/dev/null 2>&1; then
    COMPRESSION="xz"
else
    echo "E: No initramfs compression is supported by both kernel $KERNEL and the build environment" >&2
    exit 1
fi

if [ "$CRYPT" = "true" ]; then
    if ! compgen -G "/lib/modules/$KERNEL/kernel/drivers/md/dm-crypt.*" >/dev/null &&
        ! grep -q '^CONFIG_DM_CRYPT=y$' "/boot/config-$KERNEL" 2>/dev/null; then
        echo "E: --crypt requires dm-crypt support in kernel $KERNEL" >&2
        exit 1
    fi
fi

DRACUT_BASE="$(mktemp -d /tmp/minios-dracut.XXXXXX)" || exit 1
trap 'rm -rf "$DRACUT_BASE"' EXIT
trap 'exit 1' HUP INT TERM
cp -a /usr/lib/dracut/. "$DRACUT_BASE/"
export dracutbasedir="$DRACUT_BASE"

DRACUT_INSTALL="$DRACUT_BASE/dracut-install"
DRACUT_INSTALL_REAL="${DRACUT_INSTALL}.minios-real"
if grep -q '^CONFIG_CRYPTO_CRC32C=y$' "$KERNEL_CONFIG" &&
    [ -x "$DRACUT_INSTALL" ] && [ ! -e "$DRACUT_INSTALL_REAL" ]; then
    mv "$DRACUT_INSTALL" "$DRACUT_INSTALL_REAL"
    cat >"$DRACUT_INSTALL" <<'EOF'
#!/bin/bash
args=()
for arg in "$@"; do
    [ "$arg" = "crc32c" ] || args+=("$arg")
done
exec "${0}.minios-real" "${args[@]}"
EOF
    chmod 755 "$DRACUT_INSTALL"
fi

# Check if kernel modules exist
if [ ! -d "/lib/modules/$KERNEL" ]; then
    echo "E: Kernel modules not found for version $KERNEL" >&2
    exit 1
fi

# Install MiniOS dracut modules to build environment
if [ -d "/run/initramfs/dracut-mos" ]; then
    DRACUT_MOS="/run/initramfs/dracut-mos"
elif [ -d /linux-live/initramfs/dracut-mos ]; then
    DRACUT_MOS="/linux-live/initramfs/dracut-mos"
else
    echo "E: Build scripts directory not found" >&2
    exit 1
fi

DRACUT_MODULES_DIR="$DRACUT_BASE/modules.d"
if [ -d "$DRACUT_MODULES_DIR" ]; then
    rm -rf "$DRACUT_MODULES_DIR/90minios" "$DRACUT_MODULES_DIR/99minios-cleanup"
    cp -r "$DRACUT_MOS/90minios" "$DRACUT_MODULES_DIR/"
    cp -r "$DRACUT_MOS/99minios-cleanup" "$DRACUT_MODULES_DIR/"
    #chmod 755 "$DRACUT_MODULES_DIR/90minios"/*.sh
    #chmod 755 "$DRACUT_MODULES_DIR/99minios-cleanup"/*.sh
fi

# Build filesystem driver list for --add-drivers
AVAILABLE_DRIVERS=""
REQUIRED_DRIVERS="squashfs overlay loop zram ext4 vfat isofs ahci"
OPTIONAL_DRIVERS="aufs aufs-ng ntfs ntfs3 exfat"

if [ "$CLOUD" = "true" ]; then
    REQUIRED_DRIVERS="$REQUIRED_DRIVERS virtio_pci virtio_net"
fi

for driver in $REQUIRED_DRIVERS $OPTIONAL_DRIVERS; do
    if modinfo -k "$KERNEL" "$driver" >/dev/null 2>&1; then
        AVAILABLE_DRIVERS="$AVAILABLE_DRIVERS $driver"
    fi
done

if [ "$CRYPT" = "true" ] && modinfo -k "$KERNEL" dm-crypt >/dev/null 2>&1; then
    AVAILABLE_DRIVERS="$AVAILABLE_DRIVERS dm-crypt"
fi

# Export flags for use in installkernel()
export MINIOS_CLOUD="$CLOUD"
export MINIOS_NETWORK="$NETWORK"
export MINIOS_CRYPT="$CRYPT"

# Prepare dracut command
DRACUT_CMD=(
    dracut
    --force
    --conf "$(dirname "$0")/90-minios.conf"
    --kver "$KERNEL"
    --compress "$COMPRESSION"
    --add-drivers "$AVAILABLE_DRIVERS"
    --strip
    --hardlink
)

# Add debug mode
if [ "$DEBUG" = "true" ]; then
    DRACUT_CMD+=(--verbose --debug)
fi

# Add output file
DRACUT_CMD+=("$OUTPUT")

# Create output directory if needed
mkdir -p "$(dirname "$OUTPUT")"

# Display configuration
echo "Building dracut initramfs:"
echo "  Kernel: $KERNEL"
echo "  Output: $OUTPUT"
echo "  Network: $NETWORK"
echo "  Cloud: $CLOUD"
echo "  Crypt: $CRYPT"
echo "  Compression: $COMPRESSION"
echo "  Debug: $DEBUG"
echo

# Run dracut
echo "Running dracut..."
if "${DRACUT_CMD[@]}"; then
    echo
    echo "Successfully created initramfs: $OUTPUT"
    # Don't output the path since file is already in place
    exit 0
else
    echo
    echo "E: Failed to create initramfs" >&2
    exit 1
fi
