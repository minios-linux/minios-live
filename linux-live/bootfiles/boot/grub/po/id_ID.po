msgid "MiniOS"
msgstr "MiniOS"

msgid "Start MiniOS"
msgstr "Mulai MiniOS"

msgid "Start a new session"
msgstr "Mulai sesi baru"

msgid "Choose a saved session"
msgstr "Pilih sesi yang disimpan"

msgid "Start without saving"
msgstr "Mulai tanpa menyimpan"

msgid "Run from RAM"
msgstr "Jalankan dari RAM"

msgid "Loading kernel and ramdisk..."
msgstr "Memuat kernel dan ramdisk..."

msgid "Back to language selection"
msgstr "Kembali ke pilihan bahasa"

msgid "Press Esc for options, automatic boot in # second{,s} ..."
msgstr "Tekan Esc untuk opsi, boot otomatis dalam # detik ..."

msgid "[F1] help"
msgstr "[F1] bantuan"

msgid "[Tab] cmdline >"
msgstr "[Tab] baris perintah >"

msgid "Choose Language"
msgstr "Pilih Bahasa"

msgid "Help"
msgstr "Bantuan"

msgid "[Enter] Select  [F1] Help  [F2] Language  [E] Edit  [C] Console"
msgstr "[Enter] Pilih  [F1] Bantuan  [F2] Bahasa  [E] Edit  [C] Konsol"

msgid "[Enter] Apply language  [Esc] Back without changes"
msgstr "[Enter] Terapkan bahasa  [Esc] Kembali tanpa perubahan"

msgid "MiniOS boot modes"
msgstr "MiniOS mode boot"

msgid "Resume the last saved session, if available. Recommended for normal use."
msgstr "Lanjutkan sesi terakhir yang disimpan, jika tersedia. Direkomendasikan untuk penggunaan normal."

msgid "Set up a new saved session. Existing sessions are kept."
msgstr "Siapkan sesi baru yang disimpan. Sesi yang sudah ada tetap disimpan."

msgid "Choose which saved session to restore during startup."
msgstr "Pilih sesi yang disimpan untuk dipulihkan saat startup."

msgid "Start clean, without restoring a session or saving changes."
msgstr "Mulai dari awal, tanpa memulihkan sesi atau menyimpan perubahan."

msgid "Copy the system to RAM before starting. Needs extra RAM and startup time."
msgstr "Salin sistem ke RAM sebelum memulai. Membutuhkan RAM dan waktu startup tambahan."

msgid "A saved session keeps your settings and files between restarts."
msgstr "Sesi yang disimpan menjaga pengaturan dan file Anda di antara restart."

msgid "Saving requires writable storage."
msgstr "Menyimpan membutuhkan media penyimpanan yang dapat ditulis."

msgid "[F2] changes the menu and system language, keyboard and time zone defaults."
msgstr "[F2] mengubah bahasa menu dan sistem, serta pengaturan default keyboard dan zona waktu."

msgid "[E] edits boot parameters; [C] opens the GRUB command line."
msgstr "[E] mengedit parameter boot; [C] membuka command line GRUB."

msgid "Press [Esc] to return to the boot menu."
msgstr "Tekan [Esc] untuk kembali ke menu boot."

msgid "Starting MiniOS in # second{,s} ..."
msgstr "Memulai MiniOS dalam # detik ..."

msgid "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"
msgstr "[Enter] Mulai  [F1] Bantuan  [F2] Bahasa  [Tab] Edit opsi"

msgid "[Tab] edits boot parameters for the selected mode."
msgstr "[Tab] mengedit parameter boot untuk mode yang dipilih."

msgid "Press any key to return to the menu."
msgstr "Tekan tombol apa saja untuk kembali ke menu."

#~ msgid "F2 changes the menu and system language, keyboard and time zone defaults."
#~ msgstr "F2 mengubah bahasa menu dan sistem, serta pengaturan default keyboard dan zona waktu."

