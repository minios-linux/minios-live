msgid "MiniOS"
msgstr "MiniOS"

msgid "Start MiniOS"
msgstr "Iniciar MiniOS"

msgid "Start a new session"
msgstr "Iniciar nova sessão"

msgid "Choose a saved session"
msgstr "Escolher uma sessão guardada"

msgid "Start without saving"
msgstr "Iniciar sem guardar"

msgid "Run from RAM"
msgstr "Executar a partir da RAM"

msgid "Loading kernel and ramdisk..."
msgstr "A carregar o kernel e o ramdisk..."

msgid "Back to language selection"
msgstr "Voltar à seleção de idioma"

msgid "Press Esc for options, automatic boot in # second{,s} ..."
msgstr "Prima Esc para opções, arranque automático em # segundo{,s} ..."

msgid "[F1] help"
msgstr "[F1] ajuda"

msgid "[Tab] cmdline >"
msgstr "[Tab] linha de comandos >"

msgid "Choose Language"
msgstr "Escolher idioma"

msgid "Help"
msgstr "Ajuda"

msgid "[Enter] Select  [F1] Help  [F2] Language  [E] Edit  [C] Console"
msgstr "[Enter] Selecionar  [F1] Ajuda  [F2] Idioma  [E] Editar  [C] Consola"

msgid "[Enter] Apply language  [Esc] Back without changes"
msgstr "[Enter] Aplicar idioma  [Esc] Voltar sem alterações"

msgid "MiniOS boot modes"
msgstr "modos de arranque MiniOS"

msgid "Resume the last saved session, if available. Recommended for normal use."
msgstr "Retomar a última sessão guardada, se disponível. Recomendado para uso normal."

msgid "Set up a new saved session. Existing sessions are kept."
msgstr "Configurar uma nova sessão guardada. As sessões existentes são mantidas."

msgid "Choose which saved session to restore during startup."
msgstr "Escolha qual sessão guardada restaurar durante o arranque."

msgid "Start clean, without restoring a session or saving changes."
msgstr "Iniciar limpo, sem restaurar uma sessão ou guardar alterações."

msgid "Copy the system to RAM before starting. Needs extra RAM and startup time."
msgstr "Copiar o sistema para RAM antes de iniciar. Requer espaço extra em RAM e mais tempo de arranque."

msgid "A saved session keeps your settings and files between restarts."
msgstr "Uma sessão guardada mantém as suas definições e ficheiros entre reinícios."

msgid "Saving requires writable storage."
msgstr "Guardar requer armazenamento com permissão de escrita."

msgid "[F2] changes the menu and system language, keyboard and time zone defaults."
msgstr "[F2] altera o idioma do menu e do sistema, bem como as predefinições do teclado e do fuso horário."

msgid "[E] edits boot parameters; [C] opens the GRUB command line."
msgstr "[E] edita os parâmetros de arranque; [C] abre a linha de comandos do GRUB."

msgid "Press [Esc] to return to the boot menu."
msgstr "Prima [Esc] para voltar ao menu de arranque."

msgid "Starting MiniOS in # second{,s} ..."
msgstr "A iniciar MiniOS em # segundo{,s} ..."

msgid "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"
msgstr "[Enter] Iniciar  [F1] Ajuda  [F2] Idioma  [Tab] Editar opções"

msgid "[Tab] edits boot parameters for the selected mode."
msgstr "[Tab] edita os parâmetros de arranque para o modo selecionado."

msgid "Press any key to return to the menu."
msgstr "Prima qualquer tecla para voltar ao menu."

#~ msgid "F2 changes the menu and system language, keyboard and time zone defaults."
#~ msgstr "F2 altera o idioma do menu e do sistema, o teclado e as predefinições do fuso horário."

#~ msgid "E edits boot parameters; C opens the GRUB command line."
#~ msgstr "E edita os parâmetros de arranque; C abre a linha de comandos do GRUB."

#~ msgid "Press Esc to return to the boot menu."
#~ msgstr "Prima Esc para voltar ao menu de arranque."

#~ msgid "Tab edits boot parameters for the selected mode."
#~ msgstr "A tecla Tab edita os parâmetros de arranque para o modo selecionado."
