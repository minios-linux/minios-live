msgid "MiniOS"
msgstr "MiniOS"

msgid "Start MiniOS"
msgstr "Avviare MiniOS"

msgid "Start a new session"
msgstr "Avviare una nuova sessione"

msgid "Choose a saved session"
msgstr "Scegliere una sessione salvata"

msgid "Start without saving"
msgstr "Avviare senza salvare"

msgid "Run from RAM"
msgstr "Eseguire dalla RAM"

msgid "Loading kernel and ramdisk..."
msgstr "Caricamento del kernel e del ramdisk..."

msgid "Back to language selection"
msgstr "Tornare alla selezione della lingua"

msgid "Press Esc for options, automatic boot in # second{,s} ..."
msgstr "Premere Esc per le opzioni, avvio automatico tra # secondo{,i} ..."

msgid "[F1] help"
msgstr "[F1] aiuto"

msgid "[Tab] cmdline >"
msgstr "[Tab] riga di comando >"

msgid "Choose Language"
msgstr "Scegliere la lingua"

msgid "Help"
msgstr "Aiuto"

msgid "[Enter] Select  [F1] Help  [F2] Language  [E] Edit  [C] Console"
msgstr "[Invio] Seleziona  [F1] Aiuto  [F2] Lingua  [E] Modifica  [C] Console"

msgid "[Enter] Apply language  [Esc] Back without changes"
msgstr "[Invio] Applica lingua  [Esc] Indietro senza modifiche"

msgid "MiniOS boot modes"
msgstr "modalità di avvio MiniOS"

msgid "Resume the last saved session, if available. Recommended for normal use."
msgstr "Riprendi l'ultima sessione salvata, se disponibile. Consigliato per l'uso normale."

msgid "Set up a new saved session. Existing sessions are kept."
msgstr "Configura una nuova sessione salvata. Le sessioni esistenti vengono mantenute."

msgid "Choose which saved session to restore during startup."
msgstr "Scegli quale sessione salvata ripristinare all'avvio."

msgid "Start clean, without restoring a session or saving changes."
msgstr "Avvia senza ripristinare una sessione o salvare le modifiche."

msgid "Copy the system to RAM before starting. Needs extra RAM and startup time."
msgstr "Copia il sistema su RAM prima di avviare. Sono necessari spazio RAM aggiuntivo e più tempo per l'avvio."

msgid "A saved session keeps your settings and files between restarts."
msgstr "Una sessione salvata mantiene le tue impostazioni e i tuoi file tra i riavvii."

msgid "Saving requires writable storage."
msgstr "Il salvataggio richiede uno spazio di archiviazione scrivibile."

msgid "F2 changes the menu and system language, keyboard and time zone defaults."
msgstr "F2 cambia la lingua del menu e del sistema, la tastiera e i fusi orari predefiniti."

msgid "E edits boot parameters; C opens the GRUB command line."
msgstr "E modifica i parametri di avvio; C apre la riga di comando di GRUB."

msgid "Press Enter to return to the boot menu."
msgstr "Premi Invio per tornare al menu di avvio."

msgid "Starting MiniOS in # second{,s} ..."
msgstr "Avvio di MiniOS tra # secondo{,i} ..."

msgid "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"
msgstr "[Invio] Avvia  [F1] Aiuto  [F2] Lingua  [Tab] Modifica opzioni"

msgid "Tab edits boot parameters for the selected mode."
msgstr "Tab modifica i parametri di avvio per la modalità selezionata."

msgid "Press any key to return to the menu."
msgstr "Premere un tasto per tornare al menu."
