msgid "MiniOS"
msgstr "MiniOS"

msgid "Start MiniOS"
msgstr "Démarrer MiniOS"

msgid "Start a new session"
msgstr "Démarrer une nouvelle session"

msgid "Choose a saved session"
msgstr "Choisir une session enregistrée"

msgid "Start without saving"
msgstr "Démarrer sans enregistrer"

msgid "Run from RAM"
msgstr "Exécuter depuis la RAM"

msgid "Loading kernel and ramdisk..."
msgstr "Chargement du noyau et du ramdisk..."

msgid "Back to language selection"
msgstr "Retour à la sélection de la langue"

msgid "Press Esc for options, automatic boot in # second{,s} ..."
msgstr "Appuyez sur Esc pour les options, démarrage automatique dans # seconde{,s} ..."

msgid "[F1] help"
msgstr "[F1] aide"

msgid "[Tab] cmdline >"
msgstr "[Tab] ligne de commande >"

msgid "Choose Language"
msgstr "Choisir la langue"

msgid "Help"
msgstr "Aide"

msgid "[Enter] Select  [F1] Help  [F2] Language  [E] Edit  [C] Console"
msgstr "[Entrée] Sélectionner  [F1] Aide  [F2] Langue  [E] Éditer  [C] Console"

msgid "[Enter] Apply language  [Esc] Back without changes"
msgstr "[Entrée] Appliquer la langue  [Échap] Retour sans modifications"

msgid "MiniOS boot modes"
msgstr "MiniOS modes de démarrage"

msgid "Resume the last saved session, if available. Recommended for normal use."
msgstr "Reprendre la dernière session enregistrée, si disponible. Recommandé pour une utilisation normale."

msgid "Set up a new saved session. Existing sessions are kept."
msgstr "Configurer une nouvelle session enregistrée. Les sessions existantes sont conservées."

msgid "Choose which saved session to restore during startup."
msgstr "Choisissez la session enregistrée à restaurer au démarrage."

msgid "Start clean, without restoring a session or saving changes."
msgstr "Démarrer sans restauration de session ni sauvegarde des modifications."

msgid "Copy the system to RAM before starting. Needs extra RAM and startup time."
msgstr "Copier le système sur RAM avant de démarrer. Nécessite un espace de stockage supplémentaire RAM et plus de temps de démarrage."

msgid "A saved session keeps your settings and files between restarts."
msgstr "Une session enregistrée conserve vos paramètres et fichiers entre les redémarrages."

msgid "Saving requires writable storage."
msgstr "La sauvegarde nécessite un support d’enregistrement accessible en écriture."

msgid "[F2] changes the menu and system language, keyboard and time zone defaults."
msgstr "[F2] modifie la langue du menu et du système, ainsi que les paramètres par défaut du clavier et du fuseau horaire."

msgid "[E] edits boot parameters; [C] opens the GRUB command line."
msgstr "[E] permet de modifier les paramètres de démarrage ; [C] ouvre la ligne de commande GRUB."

msgid "Press [Esc] to return to the boot menu."
msgstr "Appuyez sur [Échap] pour revenir au menu de démarrage."

msgid "Starting MiniOS in # second{,s} ..."
msgstr "Démarrage de MiniOS dans # seconde{,s} ..."

msgid "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"
msgstr "[Entrée] Démarrer  [F1] Aide  [F2] Langue  [Tab] Modifier les options"

msgid "[Tab] edits boot parameters for the selected mode."
msgstr "[Tab] permet de modifier les paramètres de démarrage pour le mode sélectionné."

msgid "Press any key to return to the menu."
msgstr "Appuyez sur une touche pour revenir au menu."

#~ msgid "F2 changes the menu and system language, keyboard and time zone defaults."
#~ msgstr "F2 modifie la langue du menu et du système, ainsi que les paramètres par défaut du clavier et du fuseau horaire."

#~ msgid "E edits boot parameters; C opens the GRUB command line."
#~ msgstr "E édite les paramètres de démarrage ; C ouvre la ligne de commande GRUB."

#~ msgid "Press Esc to return to the boot menu."
#~ msgstr "Appuyez sur Échap pour revenir au menu de démarrage."

#~ msgid "Tab edits boot parameters for the selected mode."
#~ msgstr "La touche Tab permet de modifier les paramètres de démarrage pour le mode sélectionné."
