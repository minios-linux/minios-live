msgid "MiniOS"
msgstr "MiniOS"

msgid "Start MiniOS"
msgstr "Iniciar MiniOS"

msgid "Start a new session"
msgstr "Iniciar nueva sesión"

msgid "Choose a saved session"
msgstr "Elegir una sesión guardada"

msgid "Start without saving"
msgstr "Iniciar sin guardar"

msgid "Run from RAM"
msgstr "Ejecutar desde RAM"

msgid "Loading kernel and ramdisk..."
msgstr "Cargando kernel y ramdisk..."

msgid "Back to language selection"
msgstr "Volver a la selección de idioma"

msgid "Press Esc for options, automatic boot in # second{,s} ..."
msgstr "Pulse Esc para ver las opciones, arranque automático en # segundo{,s} ..."

msgid "[F1] help"
msgstr "[F1] ayuda"

msgid "[Tab] cmdline >"
msgstr "[Tab] línea de comandos >"

msgid "Choose Language"
msgstr "Elegir idioma"

msgid "Help"
msgstr "Ayuda"

msgid "[Enter] Select  [F1] Help  [F2] Language  [E] Edit  [C] Console"
msgstr "[Enter] Seleccionar  [F1] Ayuda  [F2] Idioma  [E] Editar  [C] Consola"

msgid "[Enter] Apply language  [Esc] Back without changes"
msgstr "[Enter] Aplicar idioma  [Esc] Volver sin cambios"

msgid "MiniOS boot modes"
msgstr "modos de arranque MiniOS"

msgid "Resume the last saved session, if available. Recommended for normal use."
msgstr "Reanuda la última sesión guardada, si está disponible. Recomendado para uso normal."

msgid "Set up a new saved session. Existing sessions are kept."
msgstr "Configura una nueva sesión guardada. Las sesiones existentes se mantienen."

msgid "Choose which saved session to restore during startup."
msgstr "Elige qué sesión guardada restaurar durante el inicio."

msgid "Start clean, without restoring a session or saving changes."
msgstr "Inicia limpio, sin restaurar una sesión ni guardar cambios."

msgid "Copy the system to RAM before starting. Needs extra RAM and startup time."
msgstr "Copia el sistema en RAM antes de iniciar. Se necesita espacio adicional en RAM y más tiempo de inicio."

msgid "A saved session keeps your settings and files between restarts."
msgstr "Una sesión guardada mantiene tus configuraciones y archivos entre reinicios."

msgid "Saving requires writable storage."
msgstr "Guardar requiere un almacenamiento con permisos de escritura."

msgid "[F2] changes the menu and system language, keyboard and time zone defaults."
msgstr "[F2] cambia el idioma del menú y del sistema, así como las configuraciones predeterminadas de teclado y zona horaria."

msgid "[E] edits boot parameters; [C] opens the GRUB command line."
msgstr "[E] edita los parámetros de arranque; [C] abre la línea de comandos de GRUB."

msgid "Press [Esc] to return to the boot menu."
msgstr "Presione [Esc] para volver al menú de arranque."

msgid "Starting MiniOS in # second{,s} ..."
msgstr "Iniciando MiniOS en # segundo{,s} ..."

msgid "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"
msgstr "[Enter] Iniciar  [F1] Ayuda  [F2] Idioma  [Tab] Editar opciones"

msgid "[Tab] edits boot parameters for the selected mode."
msgstr "[Tab] edita los parámetros de arranque para el modo seleccionado."

msgid "Press any key to return to the menu."
msgstr "Presione cualquier tecla para volver al menú."

#~ msgid "F2 changes the menu and system language, keyboard and time zone defaults."
#~ msgstr "F2 cambia el idioma del menú y del sistema, el teclado y las zonas horarias predeterminadas."

#~ msgid "E edits boot parameters; C opens the GRUB command line."
#~ msgstr "E edita los parámetros de arranque; C abre la línea de comandos de GRUB."

#~ msgid "Press Esc to return to the boot menu."
#~ msgstr "Presiona Esc para volver al menú de arranque."

#~ msgid "Tab edits boot parameters for the selected mode."
#~ msgstr "Tab edita los parámetros de arranque para el modo seleccionado."
