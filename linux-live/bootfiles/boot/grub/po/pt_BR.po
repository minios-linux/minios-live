msgid "MiniOS"
msgstr "MiniOS"

msgid "Start MiniOS"
msgstr "Iniciar MiniOS"

msgid "Start a new session"
msgstr "Iniciar nova sessão"

msgid "Choose a saved session"
msgstr "Escolher uma sessão salva"

msgid "Start without saving"
msgstr "Iniciar sem salvar"

msgid "Run from RAM"
msgstr "Executar a partir da RAM"

msgid "Loading kernel and ramdisk..."
msgstr "Carregando kernel e ramdisk..."

msgid "Back to language selection"
msgstr "Voltar à seleção de idioma"

msgid "Press Esc for options, automatic boot in # second{,s} ..."
msgstr "Pressione Esc para opções, inicialização automática em # segundo{,s} ..."

msgid "[F1] help"
msgstr "[F1] ajuda"

msgid "[Tab] cmdline >"
msgstr "[Tab] linha de comando >"

msgid "Choose Language"
msgstr "Escolher idioma"

msgid "Help"
msgstr "Ajuda"

msgid "[Enter] Select  [F1] Help  [F2] Language  [E] Edit  [C] Console"
msgstr "[Enter] Selecionar  [F1] Ajuda  [F2] Idioma  [E] Editar  [C] Console"

msgid "[Enter] Apply language  [Esc] Back without changes"
msgstr "[Enter] Aplicar idioma  [Esc] Voltar sem alterações"

msgid "MiniOS boot modes"
msgstr "modos de inicialização MiniOS"

msgid "Resume the last saved session, if available. Recommended for normal use."
msgstr "Retomar a última sessão salva, se disponível. Recomendado para uso normal."

msgid "Set up a new saved session. Existing sessions are kept."
msgstr "Configurar uma nova sessão salva. Sessões existentes serão mantidas."

msgid "Choose which saved session to restore during startup."
msgstr "Escolha qual sessão salva restaurar durante a inicialização."

msgid "Start clean, without restoring a session or saving changes."
msgstr "Iniciar limpo, sem restaurar uma sessão ou salvar alterações."

msgid "Copy the system to RAM before starting. Needs extra RAM and startup time."
msgstr "Copie o sistema para RAM antes de iniciar. É necessário espaço extra em RAM e mais tempo de inicialização."

msgid "A saved session keeps your settings and files between restarts."
msgstr "Uma sessão salva mantém suas configurações e arquivos entre reinicializações."

msgid "Saving requires writable storage."
msgstr "Salvar requer armazenamento gravável."

msgid "[F2] changes the menu and system language, keyboard and time zone defaults."
msgstr "[F2] altera o idioma do menu e do sistema, além dos padrões de teclado e fuso horário."

msgid "[E] edits boot parameters; [C] opens the GRUB command line."
msgstr "[E] edita os parâmetros de boot; [C] abre a linha de comando do GRUB."

msgid "Press [Esc] to return to the boot menu."
msgstr "Pressione [Esc] para voltar ao menu de boot."

msgid "Starting MiniOS in # second{,s} ..."
msgstr "Iniciando MiniOS em # segundo{,s} ..."

msgid "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"
msgstr "[Enter] Iniciar  [F1] Ajuda  [F2] Idioma  [Tab] Editar opções"

msgid "[Tab] edits boot parameters for the selected mode."
msgstr "[Tab] edita os parâmetros de boot para o modo selecionado."

msgid "Press any key to return to the menu."
msgstr "Pressione qualquer tecla para voltar ao menu."

#~ msgid "F2 changes the menu and system language, keyboard and time zone defaults."
#~ msgstr "F2 altera o idioma do menu e do sistema, o teclado e os padrões de fuso horário."

#~ msgid "E edits boot parameters; C opens the GRUB command line."
#~ msgstr "E edita os parâmetros de inicialização; C abre a linha de comando do GRUB."

#~ msgid "Press Esc to return to the boot menu."
#~ msgstr "Pressione Esc para voltar ao menu de boot."

#~ msgid "Tab edits boot parameters for the selected mode."
#~ msgstr "Tab edita os parâmetros de boot para o modo selecionado."
