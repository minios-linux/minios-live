msgstr "[Enter] Select  [F1] Help  [F2] Language  [E] Edit  [C] Console"

msgid "[Enter] Apply language  [Esc] Back without changes"
msgstr "[Enter] Apply language  [Esc] Back without changes"

msgid "MiniOS boot modes"
msgstr "MiniOS boot modes"

msgid "Resume the last saved session, if available. Recommended for normal use."
msgstr "Resume the last saved session, if available. Recommended for normal use."

msgid "Set up a new saved session. Existing sessions are kept."
msgstr "Set up a new saved session. Existing sessions are kept."

msgid "Choose which saved session to restore during startup."
msgstr "Choose which saved session to restore during startup."

msgid "Start clean, without restoring a session or saving changes."
msgstr "Start clean, without restoring a session or saving changes."

msgid "Copy the system to RAM before starting. Needs extra RAM and startup time."
msgstr "Copy the system to RAM before starting. Needs extra RAM and startup time."

msgid "A saved session keeps your settings and files between restarts."
msgstr "A saved session keeps your settings and files between restarts."

msgid "Saving requires writable storage."
msgstr "Saving requires writable storage."

