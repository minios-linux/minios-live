msgstr "[E] edits boot parameters; [C] opens the GRUB command line."

msgid "Press [Esc] to return to the boot menu."
msgstr "Press [Esc] to return to the boot menu."

msgid "Starting MiniOS in # second{,s} ..."
msgstr "Starting MiniOS in # second{,s} ..."

msgid "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"
msgstr "[Enter] Start  [F1] Help  [F2] Language  [Tab] Edit options"

msgid "[Tab] edits boot parameters for the selected mode."
msgstr "[Tab] edits boot parameters for the selected mode."

msgid "Press any key to return to the menu."
msgstr "Press any key to return to the menu."
