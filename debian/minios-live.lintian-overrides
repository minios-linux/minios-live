# MiniOS Live deliberately ships architecture-specific boot and initramfs
# payload below /usr/share/minios-live. These files execute in the target image,
# not as host programs or libraries from this Debian package.
minios-live: arch-dependent-file-in-usr-share
minios-live: unstripped-binary-or-object
minios-live: statically-linked-binary
minios-live: library-not-linked-against-libc
minios-live: missing-dependency-on-libc
minios-live: shared-library-is-executable
minios-live: shared-library-lacks-prerequisites
minios-live: embedded-library
minios-live: executable-stack-in-shared-library
minios-live: hardening-no-relro

# Build hooks and rootcopy scripts are data templates. The builder copies them
# into a chroot or target tree and applies executable modes where required.
minios-live: script-not-executable

minios-live: service-file-is-not-a-file

# These files are deliberate copies in target rootcopy trees.
minios-live: duplicate-font-file
minios-live: executable-not-elf-or-script
minios-live: icon-size-and-directory-name-mismatch

# The builder inspects package state while composing isolated target roots.
minios-live: uses-dpkg-database-directly
