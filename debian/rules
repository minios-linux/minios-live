#!/usr/bin/make -f

# Executable and build scripts
EXECUTABLES := minios-live minios-cmd
BUILD_SCRIPTS := linux-live
BASH_COMPLETIONS := completions/minios-live completions/minios-cmd

# Directories
BIN_DIR := usr/bin
SHARE_DIR := usr/share
ETC_DIR := etc/minios-live
LOCALE_DIR := usr/share/locale
BASH_COMPLETIONS_DIR := usr/share/bash-completion/completions
MAN_DIR := usr/share/man

# Localization and pre-rendered manual files
PO_FILES := $(shell find po -maxdepth 1 -name "*.po")
MO_FILES := $(patsubst %.po,%.mo,$(PO_FILES))
MAN_LANGS := $(notdir $(wildcard manpages/po/*))

%:
	dh $@

# Build targets. Manual pages are prepared by Lokit before packaging and are
# intentionally not regenerated by the Debian build.
override_dh_auto_build:
	for PO_FILE in $(PO_FILES); do \
		MO_FILE=$$(echo $$PO_FILE | sed 's|\.po$$|.mo|'); \
		echo "Generating mo file for $$PO_FILE"; \
		msgfmt -o "$$MO_FILE" "$$PO_FILE"; \
		chmod 644 "$$MO_FILE"; \
	done

# Localization
locale: $(MO_FILES)
%.mo: %.po
	@echo "Generating mo file for $<"
	msgfmt -o $@ $<
	chmod 644 $@

# Regression tests that are safe in a package-build environment.
override_dh_auto_test:
ifeq ($(filter nocheck,$(DEB_BUILD_OPTIONS)),)
	bash -n minios-live minios-cmd linux-live/minioslib \
		linux-live/efi-acquire linux-live/build-initramfs linux-live/install-chroot
	bats linux-live/tests/boot_config.bats \
		linux-live/tests/kernel_dkms.bats \
		linux-live/tests/squashfs_shutdown.bats
	set -e; TMPDIR=$$(mktemp -d); \
		cp linux-live/condinapt "$$TMPDIR/condinapt"; \
		chmod +x "$$TMPDIR/condinapt"; \
		cd "$$TMPDIR" && bash "$(CURDIR)/linux-live/test_condinapt.sh" "$$TMPDIR/condinapt"; \
		STATUS=$$?; cd "$(CURDIR)"; rm -rf "$$TMPDIR"; exit $$STATUS
endif

# Clean target. Pre-rendered manpages are source artifacts and must survive clean.
override_dh_auto_clean:
	rm -f $(MO_FILES)

# Install target
override_dh_auto_install:
	install -d debian/minios-live/$(BIN_DIR) \
		debian/minios-live/$(SHARE_DIR) \
		debian/minios-live/$(ETC_DIR) \
		debian/minios-live/$(LOCALE_DIR) \
		debian/minios-live/$(BASH_COMPLETIONS_DIR)

	cp $(EXECUTABLES) debian/minios-live/$(BIN_DIR)
	cp -a $(BUILD_SCRIPTS) debian/minios-live/$(SHARE_DIR)/minios-live
	# Keep regression suites in the source package, but not in the runtime builder.
	rm -rf debian/minios-live/$(SHARE_DIR)/minios-live/tests \
		debian/minios-live/$(SHARE_DIR)/minios-live/initramfs/tests
	rm -f debian/minios-live/$(SHARE_DIR)/minios-live/test_condinapt.sh
	cp $(BUILD_SCRIPTS)/build.conf debian/minios-live/$(ETC_DIR)
	cp $(BASH_COMPLETIONS) debian/minios-live/$(BASH_COMPLETIONS_DIR)
	
	# Install lintian overrides
	install -d debian/minios-live/usr/share/lintian/overrides
	cp debian/minios-live.lintian-overrides debian/minios-live/usr/share/lintian/overrides/minios-live

	# Copy MO files
	for MO_FILE in $(MO_FILES); do \
		LOCALE=$$(basename $$MO_FILE .mo); \
		echo "Copying mo file $$MO_FILE to debian/minios-live/usr/share/locale/$$LOCALE/LC_MESSAGES/minios-live.mo"; \
		install -Dm644 "$$MO_FILE" "debian/minios-live/usr/share/locale/$$LOCALE/LC_MESSAGES/minios-live.mo"; \
	done

	# Install the pre-rendered manpages. Missing files are a packaging error:
	# run the Lokit manpage target before creating the source package.
	install -d "debian/minios-live/$(MAN_DIR)/man1" \
		"debian/minios-live/$(MAN_DIR)/man7"
	install -m644 manpages/minios-live.1 manpages/minios-cmd.1 \
		manpages/condinapt.1 "debian/minios-live/$(MAN_DIR)/man1/"
	install -m644 manpages/condinapt-minios.7 \
		"debian/minios-live/$(MAN_DIR)/man7/"
	for LANG in $(MAN_LANGS); do \
		install -d "debian/minios-live/$(MAN_DIR)/$$LANG/man1" \
			"debian/minios-live/$(MAN_DIR)/$$LANG/man7"; \
		install -m644 "manpages/$$LANG/minios-live.1" \
			"manpages/$$LANG/minios-cmd.1" "manpages/$$LANG/condinapt.1" \
			"debian/minios-live/$(MAN_DIR)/$$LANG/man1/"; \
		install -m644 "manpages/$$LANG/condinapt-minios.7" \
			"debian/minios-live/$(MAN_DIR)/$$LANG/man7/"; \
	done

override_dh_dwz:
	# Target boot/initramfs ELF payload is prebuilt and has no host debug data.
	:

override_dh_makeshlibs:
	# Bundled shared libraries belong to target boot/initramfs payloads.
	:

override_dh_shlibdeps:
	# The ELF files below usr/share/minios-live are target boot/initramfs payloads,
	# not host executables or libraries of the Debian package.
	dh_shlibdeps -X/usr/share/minios-live/

override_dh_strip:
